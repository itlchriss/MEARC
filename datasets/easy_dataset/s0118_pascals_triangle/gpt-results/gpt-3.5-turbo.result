- public List<List<Integer>> generate(int numRows)
- requires numRows >= 1 && numRows <= 30;
- ensures \result.size() == numRows;
- ensures (\forall int i; 0 <= i && i < numRows; \result.get(i).size() == i + 1);
- ensures (\forall int i, j; 0 <= i && i < numRows && 0 <= j && j < \result.get(i).size(); 
    (j == 0 || j == \result.get(i).size() - 1) ==> \result.get(i).get(j) == 1);
- ensures (\forall int i; 1 <= i && i < numRows; 
    (\forall int j; 1 <= j && j < \result.get(i).size() - 1; 
        \result.get(i).get(j) == \result.get(i - 1).get(j - 1) + \result.get(i - 1).get(j)));