- public void setZeroes(int[][] matrix)
- requires matrix != null;
- requires matrix.length > 0;
- requires matrix[0].length > 0;
- ensures \forall int i, j; 0 <= i && i < matrix.length && 0 <= j && j < matrix[0].length; 
  (matrix[i][j] == 0 ==> (\forall int k; 0 <= k && k < matrix.length; matrix[k][j] == 0 && \forall int l; 0 <= l && l < matrix[0].length; matrix[i][l] == 0));