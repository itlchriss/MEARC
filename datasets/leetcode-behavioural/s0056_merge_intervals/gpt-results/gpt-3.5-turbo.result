- public int[][] merge(int[][] intervals)
- requires intervals != null && intervals.length > 0;
- ensures \result != null && \result.length <= intervals.length;
- ensures (\forall int i; 0 <= i && i < \result.length; 
    (\exists int j; 0 <= j && j < intervals.length; 
        \result[i][0] <= intervals[j][0] && \result[i][1] >= intervals[j][1]));
- ensures (\forall int i, j; 0 <= i && i < \result.length && 0 <= j && j < \result.length && i != j; 
    (\result[i][0] > \result[j][1] || \result[j][0] > \result[i][1]));