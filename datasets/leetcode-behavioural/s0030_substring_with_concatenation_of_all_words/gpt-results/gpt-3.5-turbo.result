- requires s != null && words != null
- requires s.length() > 0 && words.length > 0
- requires (\forall int i; 0 <= i && i < words.length; words[i] != null && words[i].length() > 0)
- ensures \result != null
- ensures (\forall int i; 0 <= i && i < \result.size(); \result.get(i) >= 0 && \result.get(i) <= s.length() - words[0].length() * words.length)
- pure method