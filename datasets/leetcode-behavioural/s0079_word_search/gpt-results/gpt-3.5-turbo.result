- public boolean exist(char[][] board, String word)
- requires board != null && word != null
- requires board.length > 0 && board[0].length > 0
- requires word.length() > 0
- requires (\forall int i; 0 <= i && i < board.length; board[i].length == board[0].length)
- requires (\forall int i, j; 0 <= i && i < board.length && 0 <= j && j < board[0].length; Character.isLetter(board[i][j]))
- requires (\forall int i; 0 <= i && i < word.length(); Character.isLetter(word.charAt(i)))
- ensures \result == true || \result == false
- ensures \result == true <==> word exists in the grid
- ensures \result == false <==> word does not exist in the grid