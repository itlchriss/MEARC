- public int lengthOfLongestSubstring(String s)
- requires s != null;
- ensures \result >= 0;
- ensures (\forall int i, j; 0 <= i <= j < s.length(); (\forall int k; i <= k < j; (\forall int l; i <= l < j; k != l)));
- ensures (\forall int i, j; 0 <= i <= j < s.length(); (\exists int k; i <= k <= j; (\forall int l; i <= l <= j; k != l)));
- ensures (\forall int i, j; 0 <= i <= j < s.length(); j - i <= \result);
- ensures (\exists int i, j; 0 <= i <= j < s.length(); j - i == \result);