- public int maximalRectangle(char[][] matrix)
- requires matrix != null
- requires matrix.length > 0
- requires matrix[0].length > 0
- requires (\forall int i; 0 <= i && i < matrix.length; matrix[i].length == matrix[0].length)
- requires (\forall int i, j; 0 <= i && i < matrix.length && 0 <= j && j < matrix[0].length; matrix[i][j] == '0' || matrix[i][j] == '1')
- ensures \result >= 0
- ensures (\forall int i, j; 0 <= i && i < matrix.length && 0 <= j && j < matrix[0].length; matrix[i][j] == '1' ==> \result >= (i+1)*(j+1))
- pure