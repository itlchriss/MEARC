- requires s != null;
- requires s.length() >= 1 && s.length() <= 1000;
- requires s.matches("[a-zA-Z0-9]+");
- ensures \result != null;
- ensures (\forall int i, j; 0 <= i && i <= j && j < \result.length(); isPalindrome(\result.substring(i, j+1)));
- ensures (\forall String p; p.length() > \result.length() && isPalindrome(p); !isPalindrome(\result + p));
- pure String longestPalindrome(String s);