- requires grid != null && grid.length > 0 && grid[0].length > 0;
- requires grid.length <= 200 && grid[0].length <= 200;
- requires (\forall int i; 0 <= i && i < grid.length; grid[i].length == grid[0].length);
- requires (\forall int i, j; 0 <= i && i < grid.length && 0 <= j && j < grid[0].length; 0 <= grid[i][j] && grid[i][j] <= 100);
- ensures \result >= 0;
- ensures \result == minimum path sum from top left to bottom right in the grid;
- assignable \nothing;