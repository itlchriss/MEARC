- public int longestValidParentheses(String s)
- requires s != null
- ensures \result >= 0
- ensures \forall int i; 0 <= i < s.length() && s.charAt(i) == '(' ==> \result == 0
- ensures \forall int i; 0 <= i < s.length() && s.charAt(i) == ')' ==> \result == 0
- ensures \result == 2 || \result == 4 || \result == 0