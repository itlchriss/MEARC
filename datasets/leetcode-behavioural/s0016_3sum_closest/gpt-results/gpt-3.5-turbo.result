- requires nums != null && nums.length >= 3;
- requires (\forall int i; 0 <= i && i < nums.length; -1000 <= nums[i] && nums[i] <= 1000);
- requires -10000 <= target && target <= 10000;
- ensures \result == (\min int sum; (\exists int i, j, k; 0 <= i && i < j && j < k && k < nums.length; sum = nums[i] + nums[j] + nums[k]; (\forall int s; (\exists int x, y, z; 0 <= x && x < y && y < z && z < nums.length; s = nums[x] + nums[y] + nums[z]; Math.abs(s - target) <= Math.abs(sum - target))));
- ensures (\exists int i, j, k; 0 <= i && i < j && j < k && k < nums.length; \result == nums[i] + nums[j] + nums[k]);