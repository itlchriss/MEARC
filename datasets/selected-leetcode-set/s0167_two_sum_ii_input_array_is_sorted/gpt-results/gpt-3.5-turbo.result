- requires numbers != null && numbers.length >= 2;
- requires (\forall int i; 0 <= i && i < numbers.length - 1; numbers[i] <= numbers[i + 1]);
- requires target >= -1000 && target <= 1000;
- ensures \result != null && \result.length == 2;
- ensures \result[0] >= 1 && \result[0] <= numbers.length;
- ensures \result[1] >= 1 && \result[1] <= numbers.length;
- ensures numbers[\result[0] - 1] + numbers[\result[1] - 1] == target;
- ensures (\forall int i, j; 0 <= i && i < numbers.length && 0 <= j && j < numbers.length && i != j; numbers[i] + numbers[j] != target);