<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="lex" cat="NP">
    <rule type="fa" cat="N">
     <lf start="0" span="1" word="Only" lemma="only" pos="RB" chunk="I-NP" entity="O" cat="N/N" />
     <lf start="1" span="1" word="digits" lemma="digit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="2" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
    <rule type="fa" cat="S[pss]\NP">
     <lf start="3" span="1" word="considered" lemma="consider" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/PP" />
     <rule type="fa" cat="PP">
      <lf start="4" span="1" word="for" lemma="for" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
      <rule type="ba" cat="NP">
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <lf start="5" span="1" word="conversion" lemma="conversion" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="6" span="1" word="into" lemma="into" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
         <rule type="fa" cat="NP[nb]">
          <lf start="7" span="1" word="an" lemma="an" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <lf start="8" span="1" word="integer." lemma="integer." pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
       <rule type="lex" cat="NP\NP">
        <rule type="fc" cat="S[dcl]/NP">
         <rule type="tr" cat="S[X]/(S[X]\NP)">
          <rule type="fa" cat="NP[nb]">
           <lf start="9" span="1" word="Any" lemma="any" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
           <rule type="fa" cat="N">
            <lf start="10" span="1" word="non-digit" lemma="non-digit" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="11" span="1" word="character" lemma="character" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
         <rule type="bx" cat="(S[dcl]\NP)/NP">
          <lf start="12" span="1" word="encountered" lemma="encounter" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
          <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
           <lf start="13" span="1" word="after" lemma="after" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/(S[ng]\NP)" />
           <rule type="fa" cat="S[ng]\NP">
            <lf start="14" span="1" word="reading" lemma="read" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
            <rule type="ba" cat="NP">
             <rule type="lex" cat="NP">
              <lf start="15" span="1" word="digits" lemma="digit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
             </rule>
             <rule type="lex" cat="NP\NP">
              <rule type="fa" cat="S[dcl]\NP">
               <lf start="16" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
               <lf start="17" span="1" word="ignored" lemma="ignore" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="18" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
