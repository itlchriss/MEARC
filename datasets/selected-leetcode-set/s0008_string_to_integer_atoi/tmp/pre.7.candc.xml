<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP">
    <lf start="0" span="1" word="Only" lemma="only" pos="RB" chunk="I-NP" entity="O" cat="NP/NP" />
    <rule type="fa" cat="NP[nb]">
     <rule type="ba" cat="NP[nb]/N">
      <rule type="fa" cat="NP[nb]">
       <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <rule type="fa" cat="N">
        <lf start="2" span="1" word="space" lemma="space" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="3" span="1" word="character" lemma="character" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
      <lf start="4" span="1" word="'" lemma="'" pos="POS" chunk="B-NP" entity="O" cat="(NP[nb]/N)\NP" />
     </rule>
     <lf start="5" span="1" word="'" lemma="'" pos="POS" chunk="O" entity="O" cat="N" />
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="6" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
    <rule type="fa" cat="S[pss]\NP">
     <lf start="7" span="1" word="considered" lemma="consider" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/NP" />
     <rule type="fa" cat="NP[nb]">
      <lf start="8" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="fa" cat="N">
       <lf start="9" span="1" word="whitespace" lemma="whitespace" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <lf start="10" span="1" word="character" lemma="character" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="11" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
