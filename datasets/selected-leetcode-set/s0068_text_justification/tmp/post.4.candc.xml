<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="lex" cat="NP">
    <lf start="0" span="1" word="Extra" lemma="Extra" pos="NNP" chunk="I-NP" entity="O" cat="N" />
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="1" span="1" word="spaces" lemma="space" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/PP" />
    <rule type="fa" cat="PP">
     <lf start="2" span="1" word="between" lemma="between" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
     <rule type="ba" cat="NP">
      <rule type="lex" cat="NP">
       <lf start="3" span="1" word="words" lemma="word" pos="NNS" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="4" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
       <rule type="ba" cat="NP">
        <rule type="fa" cat="NP[nb]">
         <lf start="5" span="1" word="each" lemma="each" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <lf start="6" span="1" word="line" lemma="line" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="lex" cat="NP\NP">
         <rule type="fa" cat="S[dcl]\NP">
          <lf start="7" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
          <rule type="fa" cat="S[pss]\NP">
           <rule type="bx" cat="(S[pss]\NP)/PP">
            <lf start="8" span="1" word="distributed" lemma="distribute" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/PP" />
            <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
             <lf start="9" span="1" word="as" lemma="as" pos="RB" chunk="I-ADVP" entity="O" cat="((S\NP)\(S\NP))/((S\NP)\(S\NP))" />
             <lf start="10" span="1" word="evenly" lemma="evenly" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
            </rule>
           </rule>
           <rule type="fa" cat="PP">
            <lf start="11" span="1" word="as" lemma="as" pos="IN" chunk="I-PP" entity="O" cat="PP/(S[adj]\NP)" />
            <lf start="12" span="1" word="possible" lemma="possible" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="13" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
