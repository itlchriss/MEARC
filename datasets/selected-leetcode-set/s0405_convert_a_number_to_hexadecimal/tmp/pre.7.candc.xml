<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="S[dcl]">
  <rule type="ba" cat="NP">
   <rule type="lex" cat="NP">
    <lf start="0" span="1" word="Element" lemma="Element" pos="NNP" chunk="I-NP" entity="O" cat="N" />
   </rule>
   <rule type="lex" cat="NP\NP">
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="1" span="1" word="not" lemma="not" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)/(S\NP)" />
     <rule type="rp" cat="S[dcl]\NP">
      <lf start="2" span="1" word="found" lemma="find" pos="VBD" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
      <lf start="3" span="1" word=":" lemma=":" pos=":" chunk="O" entity="O" cat=":" />
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="4" span="1" word="requires" lemma="require" pos="VBZ" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
 </rule>
</ccg>
</candc>
