<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP[nb]">
     <lf start="0" span="1" word="Each" lemma="each" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <lf start="1" span="1" word="element" lemma="element" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="2" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
     <rule type="fa" cat="NP[nb]">
      <lf start="3" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="fa" cat="N">
       <lf start="4" span="1" word="type_string_" lemma="type_string_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="fa" cat="N">
        <lf start="5" span="1" word="type_list_" lemma="type_list_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="6" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="ba" cat="S[dcl]\NP">
    <rule type="bx" cat="(S[dcl]\NP)/NP">
     <lf start="7" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
     <lf start="8" span="1" word="either" lemma="either" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
    </rule>
    <rule type="ba" cat="(S[X]\NP)\((S[X]\NP)/NP)">
     <rule type="bc" cat="(S[X]\NP)\((S[X]\NP)/NP)">
      <rule type="tr" cat="(S[X]\NP)\((S[X]\NP)/NP)">
       <rule type="lp" cat="NP">
        <lf start="9" span="1" word="``" lemma="``" pos="LQU" chunk="O" entity="O" cat="LQU" />
        <rule type="rp" cat="NP">
         <rule type="lex" cat="NP">
          <lf start="10" span="1" word="FizzBuzz" lemma="FizzBuzz" pos="NNP" chunk="I-NP" entity="I-PER" cat="N" />
         </rule>
         <lf start="11" span="1" word="''" lemma="''" pos="RQU" chunk="O" entity="O" cat="RQU" />
        </rule>
       </rule>
      </rule>
      <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
       <lf start="12" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
       <rule type="ba" cat="S[dcl]">
        <rule type="fa" cat="NP[nb]">
         <lf start="13" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <lf start="14" span="1" word="index" lemma="index" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="15" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
         <rule type="fa" cat="S[adj]\NP">
          <lf start="16" span="1" word="divisible" lemma="divisible" pos="JJ" chunk="I-ADJP" entity="O" cat="(S[adj]\NP)/PP" />
          <rule type="fa" cat="PP">
           <lf start="17" span="1" word="by" lemma="by" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
           <rule type="fa" cat="NP[nb]">
            <lf start="18" span="1" word="both" lemma="both" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
            <lf start="19" span="1" word="3" lemma="3" pos="CD" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
     <rule type="conj" cat="((S[X]\NP)\((S[X]\NP)/NP))\((S[X]\NP)\((S[X]\NP)/NP))">
      <lf start="20" span="1" word="and" lemma="and" pos="CC" chunk="I-NP" entity="O" cat="conj" />
      <rule type="ba" cat="(S[X]\NP)\((S[X]\NP)/NP)">
       <rule type="bc" cat="(S[X]\NP)\((S[X]\NP)/NP)">
        <rule type="bc" cat="(S[X]\NP)\((S[X]\NP)/NP)">
         <rule type="bc" cat="(S[X]\NP)\((S[X]\NP)/NP)">
          <rule type="tr" cat="(S[X]\NP)\((S[X]\NP)/NP)">
           <rule type="ba" cat="NP">
            <rule type="lex" cat="NP">
             <lf start="21" span="1" word="5" lemma="5" pos="CD" chunk="I-NP" entity="O" cat="N" />
            </rule>
            <rule type="conj" cat="NP\NP">
             <lf start="22" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
             <rule type="lp" cat="NP">
              <lf start="23" span="1" word="``" lemma="``" pos="LQU" chunk="O" entity="O" cat="LQU" />
              <rule type="rp" cat="NP">
               <rule type="lex" cat="NP">
                <lf start="24" span="1" word="Fizz" lemma="Fizz" pos="NNP" chunk="I-NP" entity="O" cat="N" />
               </rule>
               <lf start="25" span="1" word="''" lemma="''" pos="RQU" chunk="O" entity="O" cat="RQU" />
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
          <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
           <lf start="26" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
           <rule type="ba" cat="S[dcl]">
            <rule type="fa" cat="NP[nb]">
             <lf start="27" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
             <lf start="28" span="1" word="index" lemma="index" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
            <rule type="fa" cat="S[dcl]\NP">
             <lf start="29" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
             <lf start="30" span="1" word="divisible" lemma="divisible" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
            </rule>
           </rule>
          </rule>
         </rule>
         <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
          <lf start="31" span="1" word="by" lemma="by" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
          <rule type="ba" cat="NP">
           <rule type="lex" cat="NP">
            <lf start="32" span="1" word="3" lemma="3" pos="CD" chunk="I-NP" entity="I-DAT" cat="N" />
           </rule>
           <rule type="conj" cat="NP\NP">
            <lf start="33" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
            <rule type="lp" cat="NP">
             <lf start="34" span="1" word="``" lemma="``" pos="LQU" chunk="O" entity="O" cat="LQU" />
             <rule type="rp" cat="NP">
              <rule type="lex" cat="NP">
               <lf start="35" span="1" word="Buzz" lemma="Buzz" pos="NNP" chunk="I-NP" entity="O" cat="N" />
              </rule>
              <lf start="36" span="1" word="''" lemma="''" pos="RQU" chunk="O" entity="O" cat="RQU" />
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
        <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
         <lf start="37" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
         <rule type="ba" cat="S[dcl]">
          <rule type="fa" cat="NP[nb]">
           <lf start="38" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
           <lf start="39" span="1" word="index" lemma="index" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
          <rule type="rp" cat="S[dcl]\NP">
           <rule type="fa" cat="S[dcl]\NP">
            <lf start="40" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
            <rule type="fa" cat="S[adj]\NP">
             <lf start="41" span="1" word="divisible" lemma="divisible" pos="JJ" chunk="I-ADJP" entity="O" cat="(S[adj]\NP)/PP" />
             <rule type="fa" cat="PP">
              <lf start="42" span="1" word="by" lemma="by" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
              <rule type="lex" cat="NP">
               <lf start="43" span="1" word="5" lemma="5" pos="CD" chunk="I-NP" entity="I-DAT" cat="N" />
              </rule>
             </rule>
            </rule>
           </rule>
           <lf start="44" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
          </rule>
         </rule>
        </rule>
       </rule>
       <rule type="conj" cat="((S[X]\NP)\((S[X]\NP)/NP))\((S[X]\NP)\((S[X]\NP)/NP))">
        <lf start="45" span="1" word="or" lemma="or" pos="CC" chunk="O" entity="O" cat="conj" />
        <rule type="bc" cat="(S[X]\NP)\((S[X]\NP)/NP)">
         <rule type="tr" cat="(S[X]\NP)\((S[X]\NP)/NP)">
          <rule type="ba" cat="NP">
           <rule type="ba" cat="NP">
            <rule type="fa" cat="NP[nb]">
             <lf start="46" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
             <lf start="47" span="1" word="index" lemma="index" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
            <lf start="48" span="1" word="itself" lemma="itself" pos="PRP" chunk="B-NP" entity="O" cat="NP\NP" />
           </rule>
           <rule type="fa" cat="NP\NP">
            <lf start="49" span="1" word="as" lemma="as" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
            <rule type="fa" cat="NP[nb]">
             <lf start="50" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
             <lf start="51" span="1" word="type_string_" lemma="type_string_" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
         <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
          <lf start="52" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
          <rule type="ba" cat="S[dcl]">
           <rule type="ba" cat="NP">
            <rule type="lex" cat="NP">
             <lf start="53" span="1" word="none" lemma="none" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
            <rule type="fa" cat="NP\NP">
             <lf start="54" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
             <rule type="fa" cat="NP[nb]">
              <lf start="55" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
              <lf start="56" span="1" word="conditions" lemma="condition" pos="NNS" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
           <rule type="fa" cat="S[dcl]\NP">
            <lf start="57" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
            <lf start="58" span="1" word="met" lemma="meet" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="59" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
