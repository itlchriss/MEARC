<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <lf start="1" span="1" word="count" lemma="count" pos="NN" chunk="I-NP" entity="O" cat="N" />
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <rule type="fa" cat="(S[dcl]\NP)/PP">
     <lf start="2" span="1" word="excludes" lemma="exclude" pos="VBZ" chunk="I-VP" entity="O" cat="((S[dcl]\NP)/PP)/NP" />
     <rule type="lex" cat="NP">
      <lf start="3" span="1" word="numbers" lemma="number" pos="NNS" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
    <rule type="fa" cat="PP">
     <lf start="4" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="PP/(S[ng]\NP)" />
     <rule type="fa" cat="S[ng]\NP">
      <lf start="5" span="1" word="repeating" lemma="repeat" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
      <rule type="ba" cat="NP">
       <rule type="lex" cat="NP">
        <lf start="6" span="1" word="digits" lemma="digit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
       </rule>
       <rule type="fa" cat="NP\NP">
        <lf start="7" span="1" word="such" lemma="such" pos="JJ" chunk="I-PP" entity="O" cat="(NP\NP)/(NP\NP)" />
        <rule type="fa" cat="NP\NP">
         <lf start="8" span="1" word="as" lemma="as" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
         <rule type="lex" cat="NP">
          <rule type="ba" cat="N">
           <lf start="9" span="1" word="11" lemma="11" pos="CD" chunk="I-NP" entity="I-DAT" cat="N" />
           <rule type="conj" cat="N\N">
            <lf start="10" span="1" word="," lemma="," pos="," chunk="I-NP" entity="I-DAT" cat="," />
            <rule type="ba" cat="N">
             <lf start="11" span="1" word="22" lemma="22" pos="CD" chunk="I-NP" entity="I-DAT" cat="N" />
             <rule type="conj" cat="N\N">
              <lf start="12" span="1" word="," lemma="," pos="," chunk="I-NP" entity="I-DAT" cat="," />
              <rule type="ba" cat="N">
               <lf start="13" span="1" word="33" lemma="33" pos="CD" chunk="I-NP" entity="I-DAT" cat="N" />
               <rule type="conj" cat="N\N">
                <lf start="14" span="1" word="," lemma="," pos="," chunk="I-NP" entity="O" cat="," />
                <lf start="15" span="1" word="etc" lemma="etc" pos="NN" chunk="I-NP" entity="O" cat="N" />
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="16" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
