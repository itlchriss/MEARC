<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <rule type="fa" cat="N">
     <lf start="1" span="1" word="Roman" lemma="Roman" pos="NNP" chunk="I-NP" entity="I-ORG" cat="N/N" />
     <rule type="fa" cat="N">
      <lf start="2" span="1" word="numeral" lemma="numeral" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
      <lf start="3" span="1" word="representation" lemma="representation" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
   <rule type="ba" cat="S[dcl]\NP">
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="4" span="1" word="uses" lemma="use" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
     <rule type="fa" cat="NP[nb]">
      <lf start="5" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="ba" cat="N">
       <rule type="fa" cat="N">
        <lf start="6" span="1" word="symbols" lemma="symbol" pos="NNS" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="7" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
       <rule type="conj" cat="N\N">
        <lf start="8" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
        <rule type="ba" cat="N">
         <lf start="9" span="1" word="expr_b" lemma="expr_b" pos="NN" chunk="I-NP" entity="O" cat="N" />
         <rule type="conj" cat="N\N">
          <lf start="10" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
          <rule type="ba" cat="N">
           <lf start="11" span="1" word="expr_c" lemma="expr_c" pos="NN" chunk="I-NP" entity="O" cat="N" />
           <rule type="conj" cat="N\N">
            <lf start="12" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
            <rule type="ba" cat="N">
             <lf start="13" span="1" word="expr_d" lemma="expr_d" pos="NN" chunk="I-NP" entity="O" cat="N" />
             <rule type="conj" cat="N\N">
              <lf start="14" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
              <rule type="ba" cat="N">
               <lf start="15" span="1" word="expr_e" lemma="expr_e" pos="NN" chunk="I-NP" entity="O" cat="N" />
               <rule type="conj" cat="N\N">
                <lf start="16" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
                <rule type="ba" cat="N">
                 <lf start="17" span="1" word="expr_f" lemma="expr_f" pos="NN" chunk="I-NP" entity="O" cat="N" />
                 <rule type="conj" cat="N\N">
                  <lf start="18" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
                  <rule type="conj" cat="N\N">
                   <lf start="19" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
                   <lf start="20" span="1" word="expr_g" lemma="expr_g" pos="NN" chunk="I-NP" entity="O" cat="N" />
                  </rule>
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
     <lf start="21" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
     <rule type="ba" cat="NP">
      <rule type="lex" cat="NP">
       <lf start="22" span="1" word="accordance" lemma="accordance" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="23" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
       <rule type="fa" cat="NP[nb]">
        <lf start="24" span="1" word="their" lemma="their" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <rule type="fa" cat="N">
         <lf start="25" span="1" word="respective" lemma="respective" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="26" span="1" word="values" lemma="value" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="27" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
