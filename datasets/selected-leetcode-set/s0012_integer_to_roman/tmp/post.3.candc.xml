<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <rule type="fa" cat="N">
     <lf start="1" span="1" word="Roman" lemma="Roman" pos="NNP" chunk="I-NP" entity="I-ORG" cat="N/N" />
     <rule type="fa" cat="N">
      <lf start="2" span="1" word="numeral" lemma="numeral" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
      <lf start="3" span="1" word="representation" lemma="representation" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="4" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
    <rule type="ba" cat="S[pss]\NP">
     <rule type="ba" cat="S[pss]\NP">
      <rule type="fa" cat="S[pss]\NP">
       <lf start="5" span="1" word="constructed" lemma="construct" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/NP" />
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <lf start="6" span="1" word="largest" lemma="largest" pos="JJS" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="7" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
         <rule type="lex" cat="NP">
          <lf start="8" span="1" word="smallest" lemma="smallest" pos="JJS" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
      <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
       <lf start="9" span="1" word="from" lemma="from" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/(S[adj]\NP)" />
       <lf start="10" span="1" word="left" lemma="leave" pos="VBN" chunk="I-VP" entity="O" cat="S[adj]\NP" />
      </rule>
     </rule>
     <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
      <lf start="11" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
      <rule type="lex" cat="NP">
       <lf start="12" span="1" word="right" lemma="right" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="13" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
