- requires nums != null && nums.length > 0;
- requires target >= -10000 && target <= 10000;
- requires (\forall int i; 0 <= i && i < nums.length - 1; nums[i] < nums[i + 1]);
- ensures \result >= -1 && \result < nums.length;
- ensures (\result == -1) ==> (\forall int i; 0 <= i && i < nums.length; nums[i] != target);
- ensures (\result != -1) ==> nums[\result] == target;