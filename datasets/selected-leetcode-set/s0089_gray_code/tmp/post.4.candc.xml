<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP[nb]">
     <lf start="0" span="1" word="Each" lemma="each" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <lf start="1" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="2" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
     <rule type="fa" cat="NP[nb]">
      <lf start="3" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="4" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
   <rule type="ba" cat="S[dcl]\NP">
    <lf start="5" span="1" word="appears" lemma="appear" pos="VBZ" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
    <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
     <lf start="6" span="1" word="no" lemma="no" pos="RB" chunk="I-ADVP" entity="O" cat="((S\NP)\(S\NP))/((S\NP)\(S\NP))" />
     <rule type="ba" cat="(S[X]\NP)\(S[X]\NP)">
      <lf start="7" span="1" word="more" lemma="more" pos="JJR" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
      <rule type="fa" cat="((S[X]\NP)\(S[X]\NP))\((S[X]\NP)\(S[X]\NP))">
       <lf start="8" span="1" word="than" lemma="than" pos="IN" chunk="I-ADVP" entity="O" cat="(((S\NP)\(S\NP))\((S\NP)\(S\NP)))/(S[adj]\NP)" />
       <lf start="9" span="1" word="once" lemma="once" pos="RB" chunk="I-ADVP" entity="O" cat="S[adj]\NP" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="10" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
