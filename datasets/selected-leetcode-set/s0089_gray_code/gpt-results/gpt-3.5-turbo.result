- requires n >= 1 && n <= 16;
- ensures \result != null;
- ensures (\forall int i; 0 <= i && i < \result.size(); \result.get(i) >= 0 && \result.get(i) <= Math.pow(2, n) - 1);
- ensures \result.size() == Math.pow(2, n);
- ensures \result.get(0) == 0;
- ensures (\forall int i, j; 0 <= i && i < \result.size() && 0 <= j && j < \result.size() && i != j; binaryDiff(\result.get(i), \result.get(j)) == 1);
- ensures binaryDiff(\result.get(0), \result.get(\result.size() - 1)) == 1;