- public int lengthOfLongestSubstring(String s)
- requires s != null;
- ensures \result >= 0;
- ensures (\forall int i, j; 0 <= i <= j < s.length(); (\forall int k; i <= k < j; s.charAt(k) != s.charAt(j)));
- ensures (\forall int i, j; 0 <= i <= j < s.length(); (\forall int k; i <= k < j; s.charAt(k) != s.charAt(j)) ==> j - i + 1 <= \result);