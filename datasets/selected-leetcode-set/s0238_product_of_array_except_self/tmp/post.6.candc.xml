<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <lf start="1" span="1" word="algorithm" lemma="algorithm" pos="NN" chunk="I-NP" entity="O" cat="N" />
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="2" span="1" word="must" lemma="must" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
    <rule type="ba" cat="S[b]\NP">
     <rule type="fa" cat="S[b]\NP">
      <lf start="3" span="1" word="solve" lemma="solve" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
      <rule type="fa" cat="NP[nb]">
       <lf start="4" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <lf start="5" span="1" word="problem" lemma="problem" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
     <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
      <lf start="6" span="1" word="without" lemma="without" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/(S[ng]\NP)" />
      <rule type="fa" cat="S[ng]\NP">
       <rule type="bx" cat="(S[ng]\NP)/NP">
        <lf start="7" span="1" word="using" lemma="use" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
        <rule type="lex" cat="(S[X]\NP)\(S[X]\NP)">
         <rule type="ba" cat="S[adj]\NP">
          <lf start="8" span="1" word="more" lemma="more" pos="JJR" chunk="I-NP" entity="O" cat="S[adj]\NP" />
          <rule type="fa" cat="(S[adj]\NP)\(S[adj]\NP)">
           <lf start="9" span="1" word="than" lemma="than" pos="IN" chunk="I-PP" entity="O" cat="((S[adj]\NP)\(S[adj]\NP))/NP" />
           <rule type="ba" cat="NP">
            <rule type="lex" cat="NP">
             <lf start="10" span="1" word="O" lemma="O" pos="NNP" chunk="I-NP" entity="O" cat="N" />
            </rule>
            <rule type="rp" cat="NP\NP">
             <rule type="fa" cat="NP\NP">
              <lf start="11" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
              <rule type="lex" cat="NP">
               <lf start="12" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N" />
              </rule>
             </rule>
             <lf start="13" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
       <rule type="lex" cat="NP">
        <rule type="fa" cat="N">
         <lf start="14" span="1" word="extra" lemma="extra" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="15" span="1" word="space" lemma="space" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="16" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
