package g0001_0100.s0005_longest_palindromic_substring;

// #Medium #Top_100_Liked_Questions #Top_Interview_Questions #String #Dynamic_Programming
// #Data_Structure_II_Day_9_String #Algorithm_II_Day_14_Dynamic_Programming
// #Dynamic_Programming_I_Day_17 #Udemy_Strings #Big_O_Time_O(n)_Space_O(n)
// #2024_01_04_Time_7_ms_(96.96%)_Space_42.7_MB_(66.12%)

public class Solution {
    public String longestPalindrome(String s) {
        //@ assume Integer.MIN_VALUE + 1 <= s.length() * 2 + 1 <= Integer.MAX_VALUE - 1;
        char[] newStr = new char[s.length() * 2 + 1];
        newStr[0] = '#';
        //@ loop_invariant 0 <= i <= s.length();
        for (int i = 0; i < s.length(); i++) {
            newStr[2 * i + 1] = s.charAt(i);
            newStr[2 * i + 2] = '#';
        }
        int[] dp = new int[newStr.length];
        int friendCenter = 0;
        int friendRadius = 0;
        int lpsCenter = 0;
        int lpsRadius = 0;
        //@ loop_invariant 0 <= i <= newStr.length;
        for (int i = 0; i < newStr.length; i++) {
            //@ assume Integer.MIN_VALUE + 1 <= friendCenter + friendRadius <= Integer.MAX_VALUE - 1;
            //@ assume Integer.MIN_VALUE + 1 <= friendCenter * 2 - i <= Integer.MAX_VALUE - 1;
            //@ assume friendCenter == i;
            //@ assume 0 <= friendCenter * 2 - i < dp.length;
            //@ assume Integer.MIN_VALUE + 1 <= (friendCenter + friendRadius) - i <= Integer.MAX_VALUE - 1;
            dp[i] =
                    friendCenter + friendRadius > i
                            ? Math.min(dp[friendCenter * 2 - i], (friendCenter + friendRadius) - i)
                            : 1;
            //@ assume 0 <= i + dp[i] < newStr.length;
            //@ assume 0 <= i - dp[i] < newStr.length;
            //@ assume 0 <= i + dp[i] < newStr.length;            
            //@ maintaining 0 <= i + dp[i] < newStr.length;
            //@ maintaining 0 <= i < dp.length;
            while (i + dp[i] < newStr.length
                    && i - dp[i] >= 0
                    && newStr[i + dp[i]] == newStr[i - dp[i]]) {
                dp[i]++;
            }
            //@ assume Integer.MIN_VALUE + 1 <= i + dp[i] <= Integer.MAX_VALUE - 1;
            if (friendCenter + friendRadius < i + dp[i]) {
                friendCenter = i;
                friendRadius = dp[i];
            }
            if (lpsRadius < dp[i]) {
                lpsCenter = i;
                lpsRadius = dp[i];
            }
        }
        //@ assume 0 <= lpsCenter - lpsRadius + 1 <= s.length();
        //@ assume 0 <= lpsCenter + lpsRadius - 1 <= s.length();
        //@ assume lpsCenter - lpsRadius + 1 <= lpsCenter + lpsRadius - 1;
        return s.substring((lpsCenter - lpsRadius + 1) / 2, (lpsCenter + lpsRadius - 1) / 2);
    }
}
