<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP[nb]">
     <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <lf start="1" span="1" word="List" lemma="list" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="2" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
     <rule type="ba" cat="NP">
      <rule type="lex" cat="NP">
       <lf start="3" span="1" word="List" lemma="list" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="4" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
       <rule type="lex" cat="NP">
        <rule type="fa" cat="N">
         <lf start="5" span="1" word="String" lemma="string" pos="VBG" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="6" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="ba" cat="S[dcl]\NP">
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="7" span="1" word="contains" lemma="contain" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
     <rule type="ba" cat="NP">
      <rule type="fa" cat="NP">
       <lf start="8" span="1" word="all" lemma="all" pos="PDT" chunk="I-NP" entity="O" cat="NP/NP" />
       <rule type="fa" cat="NP[nb]">
        <lf start="9" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <rule type="fa" cat="N">
         <lf start="10" span="1" word="shortest" lemma="shortest" pos="JJS" chunk="I-NP" entity="O" cat="N/N" />
         <rule type="fa" cat="N">
          <lf start="11" span="1" word="transformation" lemma="transformation" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="12" span="1" word="sequences" lemma="sequence" pos="NNS" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="13" span="1" word="from" lemma="from" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
       <rule type="ba" cat="NP">
        <rule type="fa" cat="NP[nb]">
         <lf start="14" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <lf start="15" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="I-LOC" cat="N" />
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="16" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
         <rule type="ba" cat="NP[nb]">
          <rule type="fa" cat="NP[nb]">
           <lf start="17" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="I-LOC" cat="NP[nb]/N" />
           <lf start="18" span="1" word="expr_b" lemma="expr_b" pos="NN" chunk="I-NP" entity="I-LOC" cat="N" />
          </rule>
          <rule type="conj" cat="NP[nb]\NP[nb]">
           <lf start="19" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
           <rule type="conj" cat="NP[nb]\NP[nb]">
            <lf start="20" span="1" word="or" lemma="or" pos="CC" chunk="O" entity="O" cat="conj" />
            <rule type="fa" cat="NP[nb]">
             <lf start="21" span="1" word="an" lemma="an" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
             <rule type="fa" cat="N">
              <lf start="22" span="1" word="empty" lemma="empty" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
              <lf start="23" span="1" word="type_list_" lemma="type_list_" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
     <lf start="24" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
     <rule type="ba" cat="S[dcl]">
      <rule type="fa" cat="NP[nb]">
       <lf start="25" span="1" word="no" lemma="no" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <rule type="fa" cat="N">
        <lf start="26" span="1" word="such" lemma="such" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="27" span="1" word="sequence" lemma="sequence" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
      <lf start="28" span="1" word="exists" lemma="exist" pos="VBZ" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="29" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
