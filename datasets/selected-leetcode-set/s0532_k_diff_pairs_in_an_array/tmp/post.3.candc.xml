<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="A" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <rule type="fa" cat="N">
     <lf start="1" span="1" word="k-diff" lemma="k-diff" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
     <lf start="2" span="1" word="pair" lemma="pair" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="3" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
    <rule type="ba" cat="NP">
     <rule type="ba" cat="NP">
      <rule type="fa" cat="NP[nb]">
       <lf start="4" span="1" word="an" lemma="an" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <rule type="fa" cat="N">
        <lf start="5" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="6" span="1" word="pair" lemma="pair" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
      <rule type="rp" cat="NP\NP">
       <rule type="fa" cat="NP\NP">
        <lf start="7" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/S[dcl]" />
        <rule type="ba" cat="S[dcl]">
         <rule type="ba" cat="S[dcl]">
          <rule type="lex" cat="NP">
           <lf start="8" span="1" word="nums" lemma="num" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
          <rule type="fa" cat="S[dcl]\NP">
           <lf start="9" span="1" word="[" lemma="[" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
           <rule type="lex" cat="NP">
            <rule type="fa" cat="N">
             <lf start="10" span="1" word="i" lemma="i" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="11" span="1" word="]" lemma="]" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
         <rule type="lp" cat="S[dcl]\S[dcl]">
          <lf start="12" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
          <rule type="fa" cat="S[dcl]\S[dcl]">
           <lf start="13" span="1" word="nums" lemma="num" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\S[dcl])/NP" />
           <rule type="lex" cat="NP">
            <rule type="fa" cat="N">
             <lf start="14" span="1" word="[" lemma="[" pos="NNP" chunk="I-NP" entity="I-PER" cat="N/N" />
             <rule type="fa" cat="N">
              <lf start="15" span="1" word="j" lemma="j" pos="NNP" chunk="I-NP" entity="I-PER" cat="N/N" />
              <lf start="16" span="1" word="]" lemma="]" pos="NNP" chunk="I-NP" entity="I-PER" cat="N" />
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
       <lf start="17" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
      </rule>
     </rule>
     <rule type="fa" cat="NP\NP">
      <lf start="18" span="1" word="that" lemma="that" pos="IN" chunk="I-SBAR" entity="O" cat="(NP\NP)/(S[dcl]/NP)" />
      <rule type="fc" cat="S[dcl]/NP">
       <rule type="tr" cat="S[X]/(S[X]\NP)">
        <rule type="ba" cat="NP">
         <rule type="lex" cat="NP">
          <rule type="fa" cat="N">
           <lf start="19" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
           <rule type="fa" cat="N">
            <lf start="20" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
            <rule type="fa" cat="N">
             <lf start="21" span="1" word="=" lemma="=" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
             <rule type="fa" cat="N">
              <lf start="22" span="1" word="i" lemma="i" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
              <rule type="fa" cat="N">
               <lf start="23" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
               <rule type="fa" cat="N">
                <lf start="24" span="1" word="j" lemma="j" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                <rule type="fa" cat="N">
                 <lf start="25" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                 <lf start="26" span="1" word="nums.length" lemma="nums.length" pos="NN" chunk="I-NP" entity="O" cat="N" />
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
         <rule type="conj" cat="NP\NP">
          <lf start="27" span="1" word="and" lemma="and" pos="CC" chunk="I-NP" entity="O" cat="conj" />
          <rule type="lex" cat="NP">
           <lf start="28" span="1" word="|nums" lemma="|nums" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
       <rule type="fc" cat="(S[dcl]\NP)/NP">
        <lf start="29" span="1" word="[" lemma="[" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/S[dcl]" />
        <rule type="fc" cat="S[dcl]/NP">
         <rule type="tr" cat="S[X]/(S[X]\NP)">
          <rule type="rp" cat="NP">
           <rule type="lex" cat="NP">
            <rule type="fa" cat="N">
             <lf start="30" span="1" word="i" lemma="i" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="31" span="1" word="]" lemma="]" pos="SYM" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
           <lf start="32" span="1" word="-" lemma="-" pos=":" chunk="O" entity="O" cat=":" />
          </rule>
         </rule>
         <rule type="fa" cat="(S[dcl]\NP)/NP">
          <lf start="33" span="1" word="nums" lemma="num" pos="VBZ" chunk="I-VP" entity="O" cat="((S[dcl]\NP)/NP)/NP" />
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="34" span="1" word="[" lemma="[" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
            <rule type="fa" cat="N">
             <lf start="35" span="1" word="j" lemma="j" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
             <rule type="fa" cat="N">
              <lf start="36" span="1" word="]" lemma="]" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
              <rule type="fa" cat="N">
               <lf start="37" span="1" word="|" lemma="|" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
               <rule type="fa" cat="N">
                <lf start="38" span="1" word="==" lemma="==" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                <lf start="39" span="1" word="k" lemma="k" pos="NN" chunk="I-NP" entity="O" cat="N" />
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="40" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
