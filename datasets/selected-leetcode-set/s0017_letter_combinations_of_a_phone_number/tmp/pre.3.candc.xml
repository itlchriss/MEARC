<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <rule type="fa" cat="N">
     <lf start="1" span="1" word="type_string_" lemma="type_string_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
     <lf start="2" span="1" word="param_digits_" lemma="param_digits_" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="3" span="1" word="must" lemma="must" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
    <rule type="ba" cat="S[b]\NP">
     <rule type="fa" cat="S[b]\NP">
      <lf start="4" span="1" word="contain" lemma="contain" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
      <rule type="lex" cat="NP">
       <lf start="5" span="1" word="digits" lemma="digit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
     <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
      <rule type="fa" cat="((S[X]\NP)\(S[X]\NP))/((S[X]\NP)\(S[X]\NP))">
       <lf start="6" span="1" word="from" lemma="from" pos="IN" chunk="I-PP" entity="I-DAT" cat="(((S\NP)\(S\NP))/((S\NP)\(S\NP)))/NP" />
       <rule type="lex" cat="NP">
        <lf start="7" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="I-DAT" cat="N" />
       </rule>
      </rule>
      <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
       <lf start="8" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="I-DAT" cat="((S\NP)\(S\NP))/NP" />
       <rule type="lex" cat="NP">
        <rule type="ba" cat="N">
         <lf start="9" span="1" word="9" lemma="9" pos="CD" chunk="I-NP" entity="I-DAT" cat="N" />
         <lf start="10" span="1" word="inclusive" lemma="inclusive" pos="JJ" chunk="I-NP" entity="I-DAT" cat="N\N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="11" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
