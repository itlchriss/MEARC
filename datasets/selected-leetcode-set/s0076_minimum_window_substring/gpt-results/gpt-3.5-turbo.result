- public String minWindow(String s, String t)
- requires s != null && t != null;
- requires s.length() >= t.length();
- ensures \result != null;
- ensures (\forall char c; t.contains(c); \result.contains(c));
- ensures (\forall String sub; s.contains(sub) && sub.length() < \result.length(); !(\forall char c; t.contains(c); sub.contains(c)));
- ensures (\forall String sub; s.contains(sub) && sub.length() == \result.length(); (\forall char c; t.contains(c); sub.contains(c)));
- ensures \result.equals("") || (\forall char c; t.contains(c); \result.contains(c));
- ensures \result.equals("") || (\forall String sub; s.contains(sub) && sub.length() < \result.length(); !(\forall char c; t.contains(c); sub.contains(c)));
- ensures \result.equals("") || (\forall String sub; s.contains(sub) && sub.length() == \result.length(); (\forall char c; t.contains(c); sub.contains(c)));