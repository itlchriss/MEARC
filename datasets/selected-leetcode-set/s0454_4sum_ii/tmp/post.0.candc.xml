<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP[nb]">
     <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <rule type="fa" cat="N">
      <lf start="1" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
      <rule type="ba" cat="N">
       <lf start="2" span="1" word="type_arrays_" lemma="type_arrays_" pos="NN" chunk="I-NP" entity="O" cat="N" />
       <lf start="3" span="1" word="expr0" lemma="expr0" pos="CD" chunk="I-NP" entity="O" cat="N\N" />
      </rule>
     </rule>
    </rule>
    <rule type="conj" cat="NP\NP">
     <lf start="4" span="1" word="," lemma="," pos="," chunk="I-NP" entity="O" cat="," />
     <rule type="lex" cat="NP">
      <rule type="ba" cat="N">
       <lf start="5" span="1" word="expr1" lemma="expr1" pos="CD" chunk="I-NP" entity="O" cat="N" />
       <rule type="conj" cat="N\N">
        <lf start="6" span="1" word="," lemma="," pos="," chunk="I-NP" entity="O" cat="," />
        <rule type="ba" cat="N">
         <lf start="7" span="1" word="expr2" lemma="expr2" pos="CD" chunk="I-NP" entity="O" cat="N" />
         <rule type="conj" cat="N\N">
          <lf start="8" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
          <rule type="conj" cat="N\N">
           <lf start="9" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
           <lf start="10" span="1" word="expr3" lemma="expr3" pos="CD" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <rule type="bx" cat="(S[dcl]\NP)/(S[adj]\NP)">
     <lf start="11" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
     <lf start="12" span="1" word="not" lemma="not" pos="RB" chunk="O" entity="O" cat="(S\NP)\(S\NP)" />
    </rule>
    <lf start="13" span="1" word="null" lemma="null" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
   </rule>
  </rule>
  <lf start="14" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
