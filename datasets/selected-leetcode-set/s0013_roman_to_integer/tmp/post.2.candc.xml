<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <rule type="fa" cat="N">
     <lf start="1" span="1" word="type_string_" lemma="type_string_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
     <lf start="2" span="1" word="param_s_" lemma="param_s_" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="3" span="1" word="only" lemma="only" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)/(S\NP)" />
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="4" span="1" word="contains" lemma="contain" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
     <rule type="fa" cat="NP[nb]">
      <lf start="5" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="ba" cat="N">
       <rule type="fa" cat="N">
        <lf start="6" span="1" word="characters" lemma="character" pos="NNS" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="7" span="1" word="str_a" lemma="str_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
       <rule type="conj" cat="N\N">
        <lf start="8" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
        <rule type="ba" cat="N">
         <lf start="9" span="1" word="str_b" lemma="str_b" pos="NN" chunk="I-NP" entity="O" cat="N" />
         <rule type="conj" cat="N\N">
          <lf start="10" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
          <rule type="ba" cat="N">
           <lf start="11" span="1" word="str_c" lemma="str_c" pos="NN" chunk="I-NP" entity="O" cat="N" />
           <rule type="conj" cat="N\N">
            <lf start="12" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
            <rule type="ba" cat="N">
             <lf start="13" span="1" word="str_d" lemma="str_d" pos="NN" chunk="I-NP" entity="O" cat="N" />
             <rule type="conj" cat="N\N">
              <lf start="14" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
              <rule type="ba" cat="N">
               <lf start="15" span="1" word="str_e" lemma="str_e" pos="NN" chunk="I-NP" entity="O" cat="N" />
               <rule type="conj" cat="N\N">
                <lf start="16" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
                <rule type="ba" cat="N">
                 <lf start="17" span="1" word="str_f" lemma="str_f" pos="NN" chunk="I-NP" entity="O" cat="N" />
                 <rule type="conj" cat="N\N">
                  <lf start="18" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
                  <lf start="19" span="1" word="str_g" lemma="str_g" pos="NN" chunk="I-NP" entity="O" cat="N" />
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="20" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
