<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[dcl]">
  <rule type="fa" cat="S[X]/S[X]">
   <lf start="0" span="1" word="For" lemma="for" pos="IN" chunk="I-PP" entity="O" cat="(S/S)/NP" />
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP[nb]">
     <lf start="1" span="1" word="an" lemma="an" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <rule type="fa" cat="N">
      <lf start="2" span="1" word="n-bytes" lemma="n-bytes" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
      <lf start="3" span="1" word="character" lemma="character" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="4" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
     <rule type="fa" cat="NP[nb]">
      <lf start="5" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="fa" cat="N">
       <lf start="6" span="1" word="UTF-8" lemma="UTF-8" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
       <lf start="7" span="1" word="encoding" lemma="encoding" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <rule type="lp" cat="S[dcl]">
   <lf start="8" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <rule type="fa" cat="NP[nb]">
      <lf start="9" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="fa" cat="N">
       <lf start="10" span="1" word="first" lemma="first" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="fa" cat="N">
        <lf start="11" span="1" word="n" lemma="n" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="12" span="1" word="bits" lemma="bit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="13" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      <rule type="ba" cat="NP">
       <rule type="rp" cat="NP">
        <rule type="ba" cat="NP">
         <rule type="fa" cat="NP[nb]">
          <lf start="14" span="1" word="all" lemma="all" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <lf start="15" span="1" word="ones" lemma="one" pos="NNS" chunk="I-NP" entity="O" cat="N" />
         </rule>
         <rule type="lex" cat="NP\NP">
          <rule type="lp" cat="S[dcl]">
           <lf start="16" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
           <rule type="ba" cat="S[dcl]">
            <rule type="fa" cat="NP[nb]">
             <lf start="17" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
             <lf start="18" span="1" word="n" lemma="n" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
            <rule type="fa" cat="S[dcl]\NP">
             <lf start="19" span="1" word="+" lemma="+" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
             <rule type="ba" cat="NP">
              <rule type="lex" cat="NP">
               <rule type="fa" cat="N">
                <lf start="20" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
                <lf start="21" span="1" word="bit" lemma="bit" pos="NN" chunk="I-NP" entity="O" cat="N" />
               </rule>
              </rule>
              <rule type="lex" cat="NP\NP">
               <rule type="fa" cat="S[dcl]\NP">
                <lf start="22" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
                <rule type="lex" cat="NP">
                 <lf start="23" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="O" cat="N" />
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
        <lf start="24" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
       </rule>
       <rule type="lex" cat="NP\NP">
        <rule type="ba" cat="S[pss]\NP">
         <lf start="25" span="1" word="followed" lemma="follow" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
         <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
          <lf start="26" span="1" word="by" lemma="by" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
          <rule type="ba" cat="NP">
           <rule type="lex" cat="NP">
            <lf start="27" span="1" word="n" lemma="n" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
           <rule type="fa" cat="NP\NP">
            <lf start="28" span="1" word="-" lemma="-" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
            <rule type="ba" cat="NP">
             <rule type="lex" cat="NP">
              <rule type="fa" cat="N">
               <lf start="29" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
               <lf start="30" span="1" word="bytes" lemma="byte" pos="NNS" chunk="I-NP" entity="O" cat="N" />
              </rule>
             </rule>
             <rule type="fa" cat="NP\NP">
              <lf start="31" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
              <rule type="ba" cat="NP">
               <rule type="fa" cat="NP[nb]">
                <lf start="32" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                <rule type="fa" cat="N">
                 <rule type="fa" cat="N/N">
                  <lf start="33" span="1" word="most" lemma="most" pos="RBS" chunk="I-NP" entity="O" cat="(N/N)/(N/N)" />
                  <lf start="34" span="1" word="significant" lemma="significant" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                 </rule>
                 <rule type="fa" cat="N">
                  <lf start="35" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
                  <lf start="36" span="1" word="bits" lemma="bit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
                 </rule>
                </rule>
               </rule>
               <rule type="lex" cat="NP\NP">
                <rule type="fa" cat="S[ng]\NP">
                 <lf start="37" span="1" word="being" lemma="be" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
                 <rule type="lex" cat="NP">
                  <lf start="38" span="1" word="10" lemma="10" pos="CD" chunk="I-NP" entity="O" cat="N" />
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="39" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
