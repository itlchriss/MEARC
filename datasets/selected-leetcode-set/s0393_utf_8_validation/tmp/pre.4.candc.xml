<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <rule type="fa" cat="N">
     <lf start="1" span="1" word="type_array_" lemma="type_array_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
     <lf start="2" span="1" word="param_data_" lemma="param_data_" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <rule type="fa" cat="(S[dcl]\NP)/S[em]">
     <lf start="3" span="1" word="contains" lemma="contain" pos="VBZ" chunk="I-VP" entity="O" cat="((S[dcl]\NP)/S[em])/NP" />
     <rule type="lex" cat="NP">
      <lf start="4" span="1" word="integers" lemma="integer" pos="NNS" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
    <rule type="fa" cat="S[em]">
     <lf start="5" span="1" word="that" lemma="that" pos="WDT" chunk="B-NP" entity="O" cat="S[em]/S[dcl]" />
     <rule type="ba" cat="S[dcl]">
      <rule type="ba" cat="NP">
       <rule type="fa" cat="NP">
        <lf start="6" span="1" word="only" lemma="only" pos="RB" chunk="B-NP" entity="O" cat="NP/NP" />
        <rule type="fa" cat="NP[nb]">
         <lf start="7" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="fa" cat="N">
          <lf start="8" span="1" word="least" lemma="least" pos="JJS" chunk="I-NP" entity="O" cat="N/N" />
          <rule type="fa" cat="N">
           <lf start="9" span="1" word="significant" lemma="significant" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
           <rule type="fa" cat="N">
            <lf start="10" span="1" word="8" lemma="8" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="11" span="1" word="bits" lemma="bit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
       <rule type="fa" cat="NP\NP">
        <lf start="12" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
        <rule type="fa" cat="NP[nb]">
         <lf start="13" span="1" word="each" lemma="each" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <lf start="14" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="15" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
       <rule type="fa" cat="S[pss]\NP">
        <lf start="16" span="1" word="used" lemma="use" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/(S[to]\NP)" />
        <rule type="fa" cat="S[to]\NP">
         <lf start="17" span="1" word="to" lemma="to" pos="TO" chunk="B-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
         <rule type="fa" cat="S[b]\NP">
          <lf start="18" span="1" word="store" lemma="store" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
          <rule type="fa" cat="NP[nb]">
           <lf start="19" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
           <lf start="20" span="1" word="data" lemma="datum" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="21" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
