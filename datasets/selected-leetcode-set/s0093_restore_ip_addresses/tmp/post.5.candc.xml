<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP[nb]">
     <lf start="0" span="1" word="Each" lemma="each" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <lf start="1" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="2" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
     <rule type="fa" cat="NP[nb]">
      <lf start="3" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="fa" cat="N">
       <lf start="4" span="1" word="valid" lemma="valid" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="fa" cat="N">
        <lf start="5" span="1" word="IP" lemma="IP" pos="NNP" chunk="I-NP" entity="I-ORG" cat="N/N" />
        <lf start="6" span="1" word="address" lemma="address" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <rule type="rp" cat="(S[dcl]\NP)/(S[adj]\NP)">
     <rule type="bx" cat="(S[dcl]\NP)/(S[adj]\NP)">
      <lf start="7" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
      <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
       <lf start="8" span="1" word="between" lemma="between" pos="IN" chunk="I-PP" entity="I-DAT" cat="((S\NP)\(S\NP))/NP" />
       <rule type="lex" cat="NP">
        <rule type="ba" cat="N">
         <lf start="9" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="I-DAT" cat="N" />
         <rule type="conj" cat="N\N">
          <lf start="10" span="1" word="and" lemma="and" pos="CC" chunk="I-NP" entity="I-DAT" cat="conj" />
          <lf start="11" span="1" word="255" lemma="255" pos="CD" chunk="I-NP" entity="I-DAT" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
     <lf start="12" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    </rule>
    <lf start="13" span="1" word="inclusive" lemma="inclusive" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
   </rule>
  </rule>
  <lf start="14" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
