<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="fa" cat="NP[nb]">
   <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
   <rule type="fa" cat="N">
    <lf start="1" span="1" word="overall" lemma="overall" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
    <lf start="2" span="1" word="run" lemma="run" pos="NN" chunk="I-NP" entity="O" cat="N" />
   </rule>
  </rule>
  <rule type="lex" cat="NP\NP">
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <rule type="ba" cat="NP">
      <rule type="lex" cat="NP">
       <rule type="fa" cat="N">
        <lf start="3" span="1" word="time" lemma="time" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="4" span="1" word="complexity" lemma="complexity" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="5" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
       <rule type="fa" cat="NP[nb]">
        <lf start="6" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <lf start="7" span="1" word="method" lemma="method" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="8" span="1" word="should" lemma="should" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
      <rule type="fa" cat="S[b]\NP">
       <lf start="9" span="1" word="be" lemma="be" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <lf start="10" span="1" word="O" lemma="O" pos="NNP" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="rp" cat="NP\NP">
         <rule type="rp" cat="NP\NP">
          <rule type="fa" cat="NP\NP">
           <lf start="11" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
           <rule type="lex" cat="NP">
            <rule type="fa" cat="N">
             <lf start="12" span="1" word="log" lemma="log" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
             <rule type="lp" cat="N">
              <lf start="13" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
              <lf start="14" span="1" word="m+n" lemma="m+n" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
          </rule>
          <lf start="15" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
         </rule>
         <lf start="16" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="17" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
