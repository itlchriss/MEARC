- requires nums != null && nums.length >= 3;
- requires (\forall int i; 0 <= i && i < nums.length; -1000 <= nums[i] && nums[i] <= 1000);
- requires -10000 <= target && target <= 10000;
- ensures \result == (\min int sum; (\exists int i, j, k; 0 <= i && i < nums.length && 0 <= j && j < nums.length && 0 <= k && k < nums.length && i != j && j != k && i != k; Math.abs(nums[i] + nums[j] + nums[k] - target) == sum));
- ensures (\exists int i, j, k; 0 <= i && i < nums.length && 0 <= j && j < nums.length && 0 <= k && k < nums.length && i != j && j != k && i != k; nums[i] + nums[j] + nums[k] == \result);