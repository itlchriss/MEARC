- public int findKthLargest(int[] nums, int k)
- requires nums != null && k > 0 && nums.length >= k;
- ensures \result == \old(Arrays.stream(nums).sorted().toArray())[nums.length - k];
- ensures (\forall int i; 0 <= i < nums.length; \old(Arrays.stream(nums).sorted().toArray())[i] <= \result);
- ensures (\forall int i; 0 <= i < nums.length - k; \old(Arrays.stream(nums).sorted().toArray())[i] < \result);