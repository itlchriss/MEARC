<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <rule type="ba" cat="N">
     <lf start="1" span="1" word="method" lemma="method" pos="NN" chunk="I-NP" entity="O" cat="N" />
     <lf start="2" span="1" word="expr0" lemma="expr0" pos="CD" chunk="I-NP" entity="O" cat="N\N" />
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="3" span="1" word="should" lemma="should" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
    <rule type="fa" cat="S[b]\NP">
     <lf start="4" span="1" word="aim" lemma="aim" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/(S[to]\NP)" />
     <rule type="fa" cat="S[to]\NP">
      <lf start="5" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
      <rule type="fa" cat="S[b]\NP">
       <lf start="6" span="1" word="minimize" lemma="minimize" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
       <rule type="ba" cat="NP">
        <rule type="fa" cat="NP[nb]">
         <lf start="7" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <lf start="8" span="1" word="number" lemma="number" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="9" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
         <rule type="ba" cat="NP">
          <rule type="ba" cat="NP">
           <rule type="lex" cat="NP">
            <lf start="10" span="1" word="calls" lemma="call" pos="NNS" chunk="I-NP" entity="O" cat="N" />
           </rule>
           <rule type="fa" cat="NP\NP">
            <lf start="11" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
            <rule type="fa" cat="NP[nb]">
             <lf start="12" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
             <rule type="fa" cat="N">
              <lf start="13" span="1" word="expr1" lemma="expr1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
              <lf start="14" span="1" word="API" lemma="API" pos="NNP" chunk="I-NP" entity="I-ORG" cat="N" />
             </rule>
            </rule>
           </rule>
          </rule>
          <rule type="lex" cat="NP\NP">
           <rule type="fa" cat="S[to]\NP">
            <lf start="15" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
            <rule type="fa" cat="S[b]\NP">
             <lf start="16" span="1" word="optimize" lemma="optimize" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
             <rule type="lex" cat="NP">
              <lf start="17" span="1" word="performance" lemma="performance" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="18" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
