- requires nums != null && nums.length >= 1;
- requires target >= -1000000000 && target <= 1000000000;
- ensures \result != null;
- ensures (\forall List<Integer> quad : \result; quad.size() == 4);
- ensures (\forall List<Integer> quad : \result; nums[quad.get(0)] + nums[quad.get(1)] + nums[quad.get(2)] + nums[quad.get(3)] == target);
- ensures (\forall List<Integer> quad1, quad2 : \result; quad1 != quad2 ==> !quad1.equals(quad2));