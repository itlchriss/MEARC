- public boolean search(int[] nums, int target)
- requires nums != null && nums.length >= 1;
- requires (\forall int i; 0 <= i && i < nums.length - 1; nums[i] <= nums[i + 1]);
- requires (\exists int k; 0 <= k && k < nums.length; nums == \old(nums[k], nums[k+1], ..., nums[nums.length-1], nums[0], nums[1], ..., nums[k-1]));
- ensures \result == (\exists int i; 0 <= i && i < nums.length; nums[i] == target);