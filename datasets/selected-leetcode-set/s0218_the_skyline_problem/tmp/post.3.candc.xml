<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <rule type="fa" cat="N">
     <lf start="1" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
     <lf start="2" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="3" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
    <rule type="ba" cat="NP">
     <rule type="fa" cat="NP[nb]">
      <lf start="4" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="5" span="1" word="type_list_" lemma="type_list_" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="fa" cat="NP\NP">
      <lf start="6" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
      <rule type="ba" cat="NP">
       <rule type="lex" cat="NP">
        <rule type="fa" cat="N">
         <lf start="7" span="1" word="key" lemma="key" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="8" span="1" word="points" lemma="point" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
       <rule type="lex" cat="NP\NP">
        <rule type="ba" cat="S[pss]\NP">
         <lf start="9" span="1" word="sorted" lemma="sort" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
         <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
          <lf start="10" span="1" word="by" lemma="by" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
          <rule type="ba" cat="NP">
           <rule type="ba" cat="NP">
            <rule type="ba" cat="NP">
             <rule type="fa" cat="NP[nb]">
              <lf start="11" span="1" word="their" lemma="their" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
              <lf start="12" span="1" word="x-coordinate" lemma="x-coordinate" pos="JJ" chunk="I-NP" entity="O" cat="N" />
             </rule>
             <rule type="fa" cat="NP\NP">
              <lf start="13" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
              <rule type="rp" cat="NP">
               <rule type="ba" cat="NP">
                <rule type="fa" cat="NP[nb]">
                 <lf start="14" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                 <lf start="15" span="1" word="form" lemma="form" pos="NN" chunk="I-NP" entity="O" cat="N" />
                </rule>
                <rule type="lex" cat="NP\NP">
                 <rule type="fa" cat="S[dcl]\NP">
                  <lf start="16" span="1" word="[" lemma="[" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
                  <rule type="ba" cat="NP">
                   <rule type="lex" cat="NP">
                    <rule type="fa" cat="N">
                     <lf start="17" span="1" word="[" lemma="[" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                     <lf start="18" span="1" word="x1" lemma="x1" pos="CD" chunk="I-NP" entity="O" cat="N" />
                    </rule>
                   </rule>
                   <rule type="conj" cat="NP\NP">
                    <lf start="19" span="1" word="," lemma="," pos="," chunk="I-NP" entity="O" cat="," />
                    <rule type="lex" cat="NP">
                     <rule type="fa" cat="N">
                      <lf start="20" span="1" word="y1" lemma="y1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
                      <lf start="21" span="1" word="]" lemma="]" pos="NNS" chunk="I-NP" entity="O" cat="N" />
                     </rule>
                    </rule>
                   </rule>
                  </rule>
                 </rule>
                </rule>
               </rule>
               <lf start="22" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
              </rule>
             </rule>
            </rule>
            <rule type="fa" cat="NP\NP">
             <lf start="23" span="1" word="[" lemma="[" pos="NNP" chunk="I-NP" entity="O" cat="(NP\NP)/N[num]" />
             <lf start="24" span="1" word="x2" lemma="x2" pos="CD" chunk="I-NP" entity="O" cat="N[num]" />
            </rule>
           </rule>
           <rule type="conj" cat="NP\NP">
            <lf start="25" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
            <rule type="ba" cat="NP">
             <rule type="lex" cat="NP">
              <rule type="fa" cat="N">
               <lf start="26" span="1" word="y2" lemma="y2" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
               <lf start="27" span="1" word="]" lemma="]" pos="NNS" chunk="I-NP" entity="O" cat="N" />
              </rule>
             </rule>
             <rule type="conj" cat="NP\NP">
              <lf start="28" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
              <rule type="ba" cat="NP">
               <rule type="lex" cat="NP">
                <rule type="lp" cat="N">
                 <lf start="29" span="1" word="..." lemma="..." pos=":" chunk="O" entity="O" cat=":" />
                 <lf start="30" span="1" word="]" lemma="]" pos="NNS" chunk="I-NP" entity="O" cat="N" />
                </rule>
               </rule>
               <rule type="lex" cat="NP\NP">
                <rule type="fa" cat="S[ng]\NP">
                 <lf start="31" span="1" word="representing" lemma="represent" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
                 <rule type="ba" cat="NP">
                  <rule type="fa" cat="NP[nb]">
                   <lf start="32" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                   <lf start="33" span="1" word="skyline" lemma="skyline" pos="NN" chunk="I-NP" entity="O" cat="N" />
                  </rule>
                  <rule type="lex" cat="NP\NP">
                   <rule type="ba" cat="S[pss]\NP">
                    <rule type="ba" cat="S[pss]\NP">
                     <lf start="34" span="1" word="formed" lemma="form" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
                     <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
                      <lf start="35" span="1" word="by" lemma="by" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
                      <rule type="fa" cat="NP[nb]">
                       <lf start="36" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                       <lf start="37" span="1" word="buildings" lemma="building" pos="NNS" chunk="I-NP" entity="O" cat="N" />
                      </rule>
                     </rule>
                    </rule>
                    <lf start="38" span="1" word="collectively" lemma="collectively" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
                   </rule>
                  </rule>
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="39" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
