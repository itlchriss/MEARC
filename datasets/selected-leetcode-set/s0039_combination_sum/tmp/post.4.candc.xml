<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="ba" cat="NP">
     <rule type="fa" cat="NP[nb]">
      <lf start="0" span="1" word="Each" lemma="each" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="1" span="1" word="combination" lemma="combination" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="fa" cat="NP\NP">
      <lf start="2" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
      <rule type="fa" cat="NP[nb]">
       <lf start="3" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <lf start="4" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
    <lf start="5" span="1" word="type_list_" lemma="type_list_" pos="NN" chunk="I-NP" entity="O" cat="NP\NP" />
   </rule>
   <rule type="ba" cat="S[dcl]\NP">
    <rule type="rp" cat="S[dcl]\NP">
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="6" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
      <lf start="7" span="1" word="unique" lemma="unique" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
     </rule>
     <lf start="8" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    </rule>
    <rule type="lex" cat="(S[X]\NP)\(S[X]\NP)">
     <rule type="fa" cat="S[ng]\NP">
      <lf start="9" span="1" word="meaning" lemma="mean" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/S[dcl]" />
      <rule type="ba" cat="S[dcl]">
       <rule type="ba" cat="NP">
        <rule type="fa" cat="NP[nb]">
         <lf start="10" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <lf start="11" span="1" word="frequency" lemma="frequency" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="12" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
         <rule type="fa" cat="NP">
          <rule type="fa" cat="NP/NP">
           <lf start="13" span="1" word="at" lemma="at" pos="IN" chunk="I-NP" entity="O" cat="(NP/NP)/(S[asup]\NP)" />
           <lf start="14" span="1" word="least" lemma="least" pos="JJS" chunk="I-NP" entity="O" cat="S[asup]\NP" />
          </rule>
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="15" span="1" word="one" lemma="one" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
            <rule type="fa" cat="N">
             <lf start="16" span="1" word="chosen" lemma="chosen" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="17" span="1" word="number" lemma="number" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
       <rule type="fa" cat="S[dcl]\NP">
        <lf start="18" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
        <lf start="19" span="1" word="different" lemma="different" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="20" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
