- public /*@ pure @*/ List<List<Integer>> combinationSum(int[] coins, int amount);
- requires coins != null;
- requires amount >= 0;
- ensures \result != null;
- ensures (\forall List<Integer> list; \result.contains(list); sumList(list) == amount);
- ensures (\forall List<Integer> list1, list2; \result.contains(list1) && \result.contains(list2) && list1 != list2; !isPermutation(list1, list2));
- ensures \result.size() < 150;
- pure int sumList(List<Integer> list);
- pure boolean isPermutation(List<Integer> list1, List<Integer> list2);