#!/bin/bash
SRCPATH=./test
MODEL=starchat

function _total() {
    # local result=`find $SRCPATH/*/$1 -type f -name "rnl.txt" | sort | xargs nl -bt | grep -v -e "Example$" | awk 'NF' | nl | tail -1 | awk '{print $1} END {if (NR == 0) print 0}'`
    local result=`find $SRCPATH/*/hafis/$1 -type f -name "rnl.txt" | sort | xargs grep -v -e "Example$" -e "\:$" -e "^$" | awk 'NF' | nl | tail -1 | awk '{print $1} END {if (NR == 0) print 0}'`
    echo $result
}

function _fitgrammar() {    
    local result=`find $SRCPATH/*/hafis/$1/tmp -type f -name "conditions.yml" | sort | xargs grep -v -e "^$" -e "^ensures\:$" -e "^requires\:$" -e "^ensures\: \[\]$" -e "^requires\: \[\]" | awk 'NF' | nl | tail -1 | awk '{print $1} END {if (NR == 0) print 0}'`
    echo $result
}

function _trans() {
    local postcount=`grep -r 'ensures' $SRCPATH/*/hafis/$1/jml/*.jml | grep -v 'Lexer:' | grep -v 'Parser:' | awk 'END {print NR}'`
    local precount=`grep -r 'requires' $SRCPATH/*/hafis/$1/jml/*.jml | grep -v 'Lexer:' | grep -v 'Parser:' | awk 'END {print NR}'`
    echo $(($postcount+$precount))

}

function _derive() {
    local failed=`find ./test/*/hafis/$1/tmp -type f -name "*.mr" | xargs grep "Failed" | awk 'END {print NR}'`
    local empty=`find ./test/*/hafis/$1/tmp -type f -name "*.mr" -empty | awk 'END {print NR}'`
    local incomplete=`find ./test/*/hafis/$1/tmp -type f -name "*.mr" | xargs grep -F '\' | awk 'END {print NR}'`
    # local failedtoparse=`grep 'Failed to parse' ./results/"$1"log  | nl | tail -1 | awk '{print $1} END {if (NR == 0) print 0}'`
    local total=`find ./test/*/hafis/$1/tmp -type f -name "*.mr" | nl | tail -1 | awk '{print $1} END {if (NR == 0) print 0}'`
    # echo $(($total-$failed-$empty-$incomplete-$failedtoparse))
    echo $(($total-$failed-$empty-$incomplete))
}

function _parse() {
    local parsing_error=`grep 'Parser: parse error' ./results/"$1"log  | nl | tail -1 | awk '{print $1} END {if (NR == 0) print 0}'`
    local sinotfounderror=`grep 'SI not found error' ./results/"$1"log  | nl | tail -1 | awk '{print $1} END {if (NR == 0) print 0}'`	
    local semanticerror=`grep 'Semantic error' ./results/"$1"log  | nl | tail -1 | awk '{print $1} END {if (NR == 0) print 0}'`
    local sianalysiserror=`grep 'Internal error' ./results/"$1"log  | nl | tail -1 | awk '{print $1} END {if (NR == 0) print 0}'`
    echo $(($parsing_error+$sinotfounderror+$semanticerror+$sianalysiserror))
}

date=20250121

echo '' > results/$date/starchat_report.txt
echo '' > results/$date/gpt4_report.txt
echo '' > results/$date/gpt35_report.txt

for entry in `find ./test/*/hafis/starchat/jml -type f -name "*.jml" | sort`
do
    echo $entry >> results/$date/starchat_report.txt
done

for entry in `find ./test/*/hafis/gpt4/jml -type f -name "*.jml" | sort`
do
    echo $entry >> results/$date/gpt4_report.txt
done

for entry in `find ./test/*/hafis/gpt35/jml -type f -name "*.jml" | sort`
do
    echo $entry >> results/$date/gpt35_report.txt
done



gpt35_jml_rate=`printf "%0.2f" $(bc -l <<< "($(_trans "gpt35") / $(_total "gpt35")) * 100")`
gpt4_jml_rate=`printf "%0.2f" $(bc -l <<< "($(_trans "gpt4") / $(_total "gpt4")) * 100")`
starchat_jml_rate=`printf "%0.2f" $(bc -l <<< "($(_trans "starchat") / $(_total "starchat")) * 100")`

gpt35_trans_rate=`printf "%0.2f" $(bc -l <<< "($(_trans "gpt35") / $(_fitgrammar "gpt35")) * 100")`
gpt4_trans_rate=`printf "%0.2f" $(bc -l <<< "($(_trans "gpt4") / $(_fitgrammar "gpt4")) * 100")`
starchat_trans_rate=`printf "%0.2f" $(bc -l <<< "($(_trans "starchat") / $(_fitgrammar "starchat")) * 100")`

gpt35_derive_rate=`printf "%0.2f" $(bc -l <<< "($(_derive "gpt35") / $(_fitgrammar "gpt35")) * 100")`
gpt4_derive_rate=`printf "%0.2f" $(bc -l <<< "($(_derive "gpt4") / $(_fitgrammar "gpt4")) * 100")`
starchat_derive_rate=`printf "%0.2f" $(bc -l <<< "($(_derive "starchat") / $(_fitgrammar "starchat")) * 100")`


echo "GPT-3.5: LLM_Output($(_fitgrammar "gpt35")) MR_rate($(_derive "gpt35") / $(_fitgrammar "gpt35") = $gpt35_derive_rate) JML_rate("$gpt35_trans_rate")"
echo "GPT-4: LLM_Output($(_fitgrammar "gpt4"))  MR_rate($(_derive "gpt4") / $(_fitgrammar "gpt4") = $gpt4_derive_rate) JML_rate($(_trans "gpt4") / $(_fitgrammar "gpt4") = "$gpt4_trans_rate")"
echo "Starchat: LLM_Output($(_fitgrammar "starchat"))  MR_rate($(_derive "starchat") / $(_fitgrammar "starchat") = $starchat_derive_rate)  JML_rate("$starchat_trans_rate")"

