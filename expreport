#!/bin/bash
SRCPATH=./test
MODEL=gpt35

function _total() {
    local result=`find $SRCPATH/*/$1 -type f -name "rnl.txt" | sort | xargs wc -l | tail -1 | sed 's/ total//'`
    echo $result
}

function _trans() {
    local postcount=`grep -r 'ensures' $SRCPATH/*/$1/jml/*.jml | grep -v 'Lexer:' | grep -v 'Parser:' | awk 'END {print NR}'`
    local precount=`grep -r 'requires' $SRCPATH/*/$1/jml/*.jml | grep -v 'Lexer:' | grep -v 'Parser:' | awk 'END {print NR}'`
    # local result=
    echo $(($postcount+$precount))
}


gpt35=`bc -l <<< "($(_trans "gpt35") / $(_total "gpt35")) * 100"`
gpt4=`bc -l <<< "($(_trans "gpt4") / $(_total "gpt4")) * 100"`
starchat=`bc -l <<< "($(_trans "starchat") / $(_total "starchat")) * 100"`
echo $(_trans "gpt35") $(_total "gpt35") $gpt35
echo $(_trans "gpt4") $(_total "gpt4") $gpt4
echo $(_trans "starchat") $(_total "starchat") $starchat


