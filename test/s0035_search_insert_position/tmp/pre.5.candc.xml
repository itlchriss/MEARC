<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <lf start="1" span="1" word="algorithm" lemma="algorithm" pos="NN" chunk="I-NP" entity="O" cat="N" />
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="2" span="1" word="must" lemma="must" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
    <rule type="fa" cat="S[b]\NP">
     <lf start="3" span="1" word="have" lemma="have" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
     <rule type="lex" cat="NP">
      <rule type="fa" cat="N">
       <lf start="4" span="1" word="O" lemma="O" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="fa" cat="N">
        <rule type="rp" cat="N/N">
         <rule type="fa" cat="N/N">
          <lf start="5" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(N/N)/NP" />
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="6" span="1" word="log" lemma="log" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="7" span="1" word="n" lemma="n" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
         <lf start="8" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
        </rule>
        <rule type="fa" cat="N">
         <lf start="9" span="1" word="runtime" lemma="runtime" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="10" span="1" word="complexity" lemma="complexity" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="11" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
