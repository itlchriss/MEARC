<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <rule type="fa" cat="N">
     <lf start="1" span="1" word="type_string_" lemma="type_string_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
     <lf start="2" span="1" word="param_s_" lemma="param_s_" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
   </rule>
   <rule type="ba" cat="S[dcl]\NP">
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="3" span="1" word="contains" lemma="contain" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
     <rule type="ba" cat="NP">
      <rule type="lex" cat="NP">
       <lf start="4" span="1" word="alphabets" lemma="alphabet" pos="NNS" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="rp" cat="NP\NP">
       <rule type="ba" cat="NP\NP">
        <rule type="fa" cat="NP\NP">
         <lf start="5" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
         <rule type="lex" cat="NP">
          <lf start="6" span="1" word="upper-case" lemma="upper-case" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="conj" cat="(NP\NP)\(NP\NP)">
         <lf start="7" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
         <lf start="8" span="1" word="lower-case" lemma="lower-case" pos="NN" chunk="I-NP" entity="O" cat="NP\NP" />
        </rule>
       </rule>
       <lf start="9" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
      </rule>
     </rule>
    </rule>
    <rule type="conj" cat="(S[dcl]\NP)\(S[dcl]\NP)">
     <lf start="10" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
     <rule type="ba" cat="S[dcl]\NP">
      <lf start="11" span="1" word="digits" lemma="digit" pos="VBZ" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
      <rule type="conj" cat="(S[dcl]\NP)\(S[dcl]\NP)">
       <lf start="12" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
       <rule type="conj" cat="(S[dcl]\NP)\(S[dcl]\NP)">
        <lf start="13" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="14" span="1" word="spaces" lemma="space" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
         <rule type="lex" cat="NP">
          <lf start="15" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="16" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
