<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <rule type="fa" cat="N">
     <lf start="1" span="1" word="elimination" lemma="elimination" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
     <rule type="fa" cat="N">
      <lf start="2" span="1" word="game" lemma="game" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
      <lf start="3" span="1" word="algorithm" lemma="algorithm" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
   <rule type="ba" cat="S[dcl]\NP">
    <lf start="4" span="1" word="alternates" lemma="alternate" pos="VBZ" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
    <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
     <lf start="5" span="1" word="between" lemma="between" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
     <rule type="lex" cat="NP">
      <rule type="fa" cat="S[ng]\NP">
       <rule type="bx" cat="(S[ng]\NP)/NP">
        <rule type="fc" cat="(S[ng]\NP)/NP">
         <rule type="fa" cat="(S[ng]\NP)/PP">
          <lf start="6" span="1" word="removing" lemma="remove" pos="VBG" chunk="I-VP" entity="O" cat="((S[ng]\NP)/PP)/NP" />
          <rule type="lex" cat="NP">
           <lf start="7" span="1" word="numbers" lemma="number" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
         <lf start="8" span="1" word="from" lemma="from" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
        </rule>
        <rule type="lex" cat="(S[X]\NP)\(S[X]\NP)">
         <rule type="fa" cat="S[pss]\NP">
          <lf start="9" span="1" word="left" lemma="leave" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/PP" />
          <rule type="fa" cat="PP">
           <lf start="10" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="PP/(S[adj]\NP)" />
           <lf start="11" span="1" word="right" lemma="right" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
          </rule>
         </rule>
        </rule>
       </rule>
       <rule type="lex" cat="NP">
        <rule type="funny" cat="N">
         <lf start="12" span="1" word="and" lemma="and" pos="CC" chunk="I-ADJP" entity="O" cat="conj" />
         <rule type="ba" cat="N">
          <lf start="13" span="1" word="right" lemma="right" pos="JJ" chunk="I-ADJP" entity="O" cat="N" />
          <rule type="lex" cat="N\N">
           <rule type="fa" cat="S[to]\NP">
            <lf start="14" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
            <rule type="ba" cat="S[b]\NP">
             <lf start="15" span="1" word="left" lemma="leave" pos="VB" chunk="I-VP" entity="O" cat="S[b]\NP" />
             <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
              <lf start="16" span="1" word="until" lemma="until" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
              <rule type="ba" cat="S[dcl]">
               <rule type="fa" cat="NP[nb]">
                <lf start="17" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                <rule type="fa" cat="N">
                 <lf start="18" span="1" word="single" lemma="single" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                 <lf start="19" span="1" word="number" lemma="number" pos="NN" chunk="I-NP" entity="O" cat="N" />
                </rule>
               </rule>
               <lf start="20" span="1" word="remains" lemma="remain" pos="VBZ" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="21" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
