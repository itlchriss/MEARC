<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <rule type="fa" cat="NP[nb]">
     <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <lf start="1" span="1" word="digits" lemma="digit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="2" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
     <rule type="fa" cat="S[pss]\NP">
      <lf start="3" span="1" word="converted" lemma="convert" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/PP" />
      <rule type="fa" cat="PP">
       <lf start="4" span="1" word="into" lemma="into" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
       <rule type="fa" cat="NP[nb]">
        <lf start="5" span="1" word="an" lemma="an" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <lf start="6" span="1" word="integer" lemma="integer" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="conj" cat="S[dcl]\S[dcl]">
    <lf start="7" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    <rule type="conj" cat="S[dcl]\S[dcl]">
     <lf start="8" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
     <rule type="fa" cat="S[dcl]">
      <rule type="fa" cat="S[X]/S[X]">
       <lf start="9" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="(S/S)/S[dcl]" />
       <rule type="ba" cat="S[dcl]">
        <rule type="fa" cat="NP[nb]">
         <lf start="10" span="1" word="no" lemma="no" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <lf start="11" span="1" word="digits" lemma="digit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="12" span="1" word="were" lemma="be" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
         <lf start="13" span="1" word="read" lemma="read" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
        </rule>
       </rule>
      </rule>
      <rule type="lp" cat="S[dcl]">
       <lf start="14" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
       <rule type="ba" cat="S[dcl]">
        <rule type="fa" cat="NP[nb]">
         <lf start="15" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <lf start="16" span="1" word="integer" lemma="integer" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="17" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
         <rule type="lex" cat="NP">
          <lf start="18" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="19" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
