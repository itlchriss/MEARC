<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="NP">
  <rule type="ba" cat="NP">
   <rule type="lex" cat="NP">
    <lf start="0" span="1" word="Read" lemma="Read" pos="NNP" chunk="I-NP" entity="O" cat="N" />
   </rule>
   <rule type="fa" cat="NP\NP">
    <lf start="1" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
    <rule type="lex" cat="NP">
     <rule type="funny" cat="N">
      <lf start="2" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
      <rule type="fa" cat="N">
       <lf start="3" span="1" word="ignore" lemma="ignore" pos="VB" chunk="I-VP" entity="O" cat="N/N" />
       <rule type="fa" cat="N">
        <rule type="fa" cat="N/N">
         <lf start="4" span="1" word="any" lemma="any" pos="DT" chunk="I-NP" entity="O" cat="(N/N)/(N/N)" />
         <lf start="5" span="1" word="leading" lemma="lead" pos="VBG" chunk="I-NP" entity="O" cat="N/N" />
        </rule>
        <lf start="6" span="1" word="whitespace" lemma="whitespace" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="7" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
