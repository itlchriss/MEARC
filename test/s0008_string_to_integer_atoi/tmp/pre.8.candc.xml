<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="lex" cat="NP">
     <lf start="0" span="1" word="Characters" lemma="character" pos="NNS" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="lex" cat="NP\NP">
     <rule type="ba" cat="S[adj]\NP">
      <lf start="1" span="1" word="other" lemma="other" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
      <rule type="fa" cat="(S[adj]\NP)\(S[adj]\NP)">
       <lf start="2" span="1" word="than" lemma="than" pos="IN" chunk="I-PP" entity="O" cat="((S[adj]\NP)\(S[adj]\NP))/NP" />
       <rule type="lex" cat="NP">
        <rule type="fa" cat="N">
         <lf start="3" span="1" word="leading" lemma="lead" pos="VBG" chunk="I-VP" entity="O" cat="N/N" />
         <rule type="ba" cat="N">
          <lf start="4" span="1" word="whitespace" lemma="whitespace" pos="NN" chunk="I-NP" entity="O" cat="N" />
          <rule type="conj" cat="N\N">
           <lf start="5" span="1" word="or" lemma="or" pos="CC" chunk="I-NP" entity="O" cat="conj" />
           <lf start="6" span="1" word="digits" lemma="digit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="7" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
    <lf start="8" span="1" word="ignored" lemma="ignore" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
   </rule>
  </rule>
  <lf start="9" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
