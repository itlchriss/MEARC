<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <rule type="fa" cat="N">
     <lf start="1" span="1" word="type_string_" lemma="type_string_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
     <lf start="2" span="1" word="param_str_" lemma="param_str_" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="3" span="1" word="contains" lemma="contain" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
    <rule type="ba" cat="NP">
     <rule type="lex" cat="NP">
      <lf start="4" span="1" word="alphabets" lemma="alphabet" pos="NNS" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="conj" cat="NP\NP">
      <lf start="5" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
      <rule type="ba" cat="NP">
       <rule type="rp" cat="NP[nb]">
        <rule type="fa" cat="NP[nb]">
         <rule type="ba" cat="NP[nb]/N">
          <rule type="rp" cat="NP">
           <rule type="lex" cat="NP">
            <lf start="6" span="1" word="digits" lemma="digit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
           </rule>
           <lf start="7" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
          </rule>
          <lf start="8" span="1" word="'" lemma="'" pos="POS" chunk="O" entity="O" cat="(NP[nb]/N)\NP" />
         </rule>
         <rule type="fa" cat="N">
          <lf start="9" span="1" word="comma+comma-" lemma="comma+comma-" pos="JJ" chunk="O" entity="I-PER" cat="N/N" />
          <lf start="10" span="1" word="'" lemma="'" pos="POS" chunk="O" entity="I-PER" cat="N" />
         </rule>
        </rule>
        <lf start="11" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
       </rule>
       <rule type="conj" cat="NP\NP">
        <lf start="12" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
        <rule type="lex" cat="NP">
         <lf start="13" span="1" word="period" lemma="period" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="14" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
