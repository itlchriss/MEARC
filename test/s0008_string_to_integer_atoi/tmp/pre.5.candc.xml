<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="bc" cat="(S[X]\NP)\((S[X]\NP)/NP)">
  <rule type="bc" cat="(S[X]\NP)\((S[X]\NP)/NP)">
   <rule type="tr" cat="(S[X]\NP)\((S[X]\NP)/NP)">
    <rule type="lex" cat="NP">
     <lf start="0" span="1" word="Read" lemma="Read" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N" />
    </rule>
   </rule>
   <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
    <lf start="1" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="I-DAT" cat="((S\NP)\(S\NP))/(S[adj]\NP)" />
    <lf start="2" span="1" word="next" lemma="next" pos="JJ" chunk="I-NP" entity="I-DAT" cat="S[adj]\NP" />
   </rule>
  </rule>
  <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
   <lf start="3" span="1" word="until" lemma="until" pos="IN" chunk="I-PP" entity="I-DAT" cat="((S\NP)\(S\NP))/S[dcl]" />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <rule type="ba" cat="NP">
      <rule type="fa" cat="NP[nb]">
       <lf start="4" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="I-DAT" cat="NP[nb]/N" />
       <rule type="fa" cat="N">
        <lf start="5" span="1" word="next" lemma="next" pos="JJ" chunk="I-NP" entity="I-DAT" cat="N/N" />
        <rule type="fa" cat="N">
         <lf start="6" span="1" word="non-digit" lemma="non-digit" pos="JJ" chunk="I-NP" entity="I-DAT" cat="N/N" />
         <lf start="7" span="1" word="character" lemma="character" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
      <rule type="conj" cat="NP\NP">
       <lf start="8" span="1" word="or" lemma="or" pos="CC" chunk="O" entity="O" cat="conj" />
       <rule type="ba" cat="NP">
        <rule type="fa" cat="NP[nb]">
         <lf start="9" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <lf start="10" span="1" word="end" lemma="end" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="11" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
         <rule type="fa" cat="NP[nb]">
          <lf start="12" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <lf start="13" span="1" word="input" lemma="input" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="14" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
      <rule type="fa" cat="S[adj]\NP">
       <lf start="15" span="1" word="reached." lemma="reached." pos="JJ" chunk="I-ADJP" entity="O" cat="(S[adj]\NP)/S[dcl]" />
       <rule type="ba" cat="S[dcl]">
        <rule type="ba" cat="NP">
         <rule type="fa" cat="NP[nb]">
          <lf start="16" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <lf start="17" span="1" word="rest" lemma="rest" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
         <rule type="fa" cat="NP\NP">
          <lf start="18" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
          <rule type="fa" cat="NP[nb]">
           <lf start="19" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
           <lf start="20" span="1" word="string" lemma="string" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="21" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
         <lf start="22" span="1" word="ignored" lemma="ignore" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="23" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
