<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="S[dcl]">
    <rule type="fa" cat="S[X]/S[X]">
     <lf start="0" span="1" word="If" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="(S/S)/S[dcl]" />
     <rule type="ba" cat="S[dcl]">
      <rule type="fa" cat="NP[nb]">
       <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <lf start="2" span="1" word="integer" lemma="integer" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="3" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/PP" />
       <rule type="fa" cat="PP">
        <lf start="4" span="1" word="out" lemma="out" pos="IN" chunk="I-PP" entity="O" cat="PP/PP" />
        <rule type="fa" cat="PP">
         <lf start="5" span="1" word="of" lemma="of" pos="IN" chunk="B-PP" entity="O" cat="PP/NP" />
         <rule type="fa" cat="NP[nb]">
          <lf start="6" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <rule type="fa" cat="N">
           <lf start="7" span="1" word="signedint" lemma="signedint" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
           <lf start="8" span="1" word="range" lemma="range" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="ba" cat="S[dcl]">
     <rule type="lex" cat="NP">
      <lf start="9" span="1" word="arr_a" lemma="arr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="lp" cat="S[dcl]\NP">
      <lf start="10" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="11" span="1" word="then" lemma="then" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)/(S\NP)" />
       <rule type="ba" cat="S[dcl]\NP">
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="12" span="1" word="clamp" lemma="clamp" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
         <rule type="fa" cat="NP[nb]">
          <lf start="13" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <lf start="14" span="1" word="integer" lemma="integer" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
         <lf start="15" span="1" word="so" lemma="so" pos="RB" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/((S\NP)\(S\NP))" />
         <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
          <lf start="16" span="1" word="that" lemma="that" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
          <rule type="ba" cat="S[dcl]">
           <lf start="17" span="1" word="it" lemma="it" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
           <rule type="ba" cat="S[dcl]\NP">
            <rule type="ba" cat="S[dcl]\NP">
             <lf start="18" span="1" word="remains" lemma="remain" pos="VBZ" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
             <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
              <lf start="19" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
              <rule type="fa" cat="NP[nb]">
               <lf start="20" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
               <lf start="21" span="1" word="range." lemma="range." pos="NN" chunk="I-NP" entity="I-ORG" cat="N" />
              </rule>
             </rule>
            </rule>
            <lf start="22" span="1" word="Specifically" lemma="specifically" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="conj" cat="S[dcl]\S[dcl]">
    <lf start="23" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    <rule type="ba" cat="S[dcl]">
     <rule type="ba" cat="S[dcl]">
      <rule type="ba" cat="NP">
       <rule type="lex" cat="NP">
        <lf start="24" span="1" word="integers" lemma="integer" pos="NNS" chunk="I-NP" entity="O" cat="N" />
       </rule>
       <rule type="lex" cat="NP\NP">
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="25" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
         <rule type="fa" cat="S[adj]\NP">
          <lf start="26" span="1" word="less_than" lemma="less_than" pos="JJ" chunk="I-ADJP" entity="O" cat="(S[adj]\NP)/PP" />
          <rule type="fa" cat="PP">
           <lf start="27" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="PP/NP" />
           <rule type="lex" cat="NP">
            <rule type="fa" cat="N">
             <lf start="28" span="1" word="negative" lemma="negative" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="29" span="1" word="2147483648" lemma="2147483648" pos="CD" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="30" span="1" word="should" lemma="should" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
       <rule type="fa" cat="S[b]\NP">
        <lf start="31" span="1" word="be" lemma="be" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/(S[pss]\NP)" />
        <rule type="fa" cat="S[pss]\NP">
         <lf start="32" span="1" word="clamped" lemma="clamp" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/PP" />
         <rule type="fa" cat="PP">
          <lf start="33" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="PP/NP" />
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="34" span="1" word="negative" lemma="negative" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="35" span="1" word="2147483648" lemma="2147483648" pos="CD" chunk="I-NP" entity="I-DAT" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
     <rule type="conj" cat="S[dcl]\S[dcl]">
      <lf start="36" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
      <rule type="conj" cat="S[dcl]\S[dcl]">
       <lf start="37" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
       <rule type="ba" cat="S[dcl]">
        <rule type="ba" cat="NP">
         <rule type="lex" cat="NP">
          <lf start="38" span="1" word="integers" lemma="integer" pos="NNS" chunk="I-NP" entity="O" cat="N" />
         </rule>
         <rule type="lex" cat="NP\NP">
          <rule type="fa" cat="S[dcl]\NP">
           <lf start="39" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
           <rule type="fa" cat="S[adj]\NP">
            <lf start="40" span="1" word="greater_than" lemma="greater_than" pos="JJ" chunk="I-ADJP" entity="O" cat="(S[adj]\NP)/PP" />
            <rule type="fa" cat="PP">
             <lf start="41" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="PP/NP" />
             <rule type="lex" cat="NP">
              <lf start="42" span="1" word="2147483647" lemma="2147483647" pos="CD" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="43" span="1" word="should" lemma="should" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
         <rule type="fa" cat="S[b]\NP">
          <lf start="44" span="1" word="be" lemma="be" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/(S[pss]\NP)" />
          <rule type="fa" cat="S[pss]\NP">
           <lf start="45" span="1" word="clamped" lemma="clamp" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/PP" />
           <rule type="fa" cat="PP">
            <lf start="46" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="PP/NP" />
            <rule type="lex" cat="NP">
             <lf start="47" span="1" word="2147483647" lemma="2147483647" pos="CD" chunk="I-NP" entity="I-DAT" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="48" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
