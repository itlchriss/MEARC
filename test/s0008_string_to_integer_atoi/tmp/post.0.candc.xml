<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="fa" cat="S[dcl]">
   <rule type="fa" cat="S[X]/S[X]">
    <lf start="0" span="1" word="If" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="(S/S)/S[dcl]" />
    <rule type="ba" cat="S[dcl]">
     <rule type="ba" cat="NP">
      <rule type="fa" cat="NP[nb]">
       <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <rule type="fa" cat="N">
        <lf start="2" span="1" word="next" lemma="next" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="3" span="1" word="character" lemma="character" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="4" span="1" word="after" lemma="after" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/(S[ng]\NP)" />
       <rule type="fa" cat="S[ng]\NP">
        <lf start="5" span="1" word="leading" lemma="lead" pos="VBG" chunk="I-NP" entity="O" cat="(S[ng]\NP)/NP" />
        <rule type="lex" cat="NP">
         <lf start="6" span="1" word="whitespaces" lemma="whitespace" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="7" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      <rule type="lex" cat="NP">
       <rule type="ba" cat="N">
        <lf start="8" span="1" word="strx_a" lemma="strx_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
        <rule type="conj" cat="N\N">
         <lf start="9" span="1" word="or" lemma="or" pos="CC" chunk="I-NP" entity="O" cat="conj" />
         <lf start="10" span="1" word="strx_b" lemma="strx_b" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="lp" cat="S[dcl]">
    <lf start="11" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    <rule type="ba" cat="S[dcl]">
     <rule type="fa" cat="NP[nb]">
      <lf start="12" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="13" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="ba" cat="S[dcl]\NP">
      <rule type="rp" cat="S[dcl]\NP">
       <rule type="fa" cat="S[dcl]\NP">
        <lf start="14" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
        <rule type="ba" cat="S[adj]\NP">
         <lf start="15" span="1" word="negative" lemma="negative" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
         <rule type="conj" cat="(S[adj]\NP)\(S[adj]\NP)">
          <lf start="16" span="1" word="or" lemma="or" pos="CC" chunk="I-ADJP" entity="O" cat="conj" />
          <lf start="17" span="1" word="positive" lemma="positive" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
         </rule>
        </rule>
       </rule>
       <lf start="18" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
      </rule>
      <lf start="19" span="1" word="respectively" lemma="respectively" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="20" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
