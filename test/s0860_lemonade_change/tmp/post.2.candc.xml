<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="fa" cat="S[dcl]">
   <rule type="fa" cat="S[X]/S[X]">
    <lf start="0" span="1" word="If" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="(S/S)/S[dcl]" />
    <rule type="ba" cat="S[dcl]">
     <rule type="fa" cat="NP[nb]">
      <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="fa" cat="N">
       <lf start="2" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="fa" cat="N">
        <lf start="3" span="1" word="type_array_" lemma="type_array_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="4" span="1" word="param_bills_" lemma="param_bills_" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="5" span="1" word="contains" lemma="contain" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      <rule type="fa" cat="NP[nb]">
       <lf start="6" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <rule type="ba" cat="N">
        <lf start="7" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N" />
        <lf start="8" span="1" word="20" lemma="20" pos="CD" chunk="I-NP" entity="O" cat="N\N" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="lp" cat="S[dcl]">
    <lf start="9" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    <rule type="ba" cat="S[dcl]">
     <rule type="fa" cat="NP[nb]">
      <lf start="10" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="fa" cat="N">
       <lf start="11" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="fa" cat="N">
        <lf start="12" span="1" word="type_array_" lemma="type_array_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="13" span="1" word="param_bills_" lemma="param_bills_" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="14" span="1" word="must" lemma="must" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
      <rule type="ba" cat="S[b]\NP">
       <rule type="fa" cat="S[b]\NP">
        <lf start="15" span="1" word="contain" lemma="contain" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
        <rule type="ba" cat="NP">
         <rule type="fa" cat="NP[nb]">
          <lf start="16" span="1" word="either" lemma="either" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <rule type="fa" cat="N">
           <lf start="17" span="1" word="one" lemma="one" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
           <rule type="ba" cat="N">
            <lf start="18" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N" />
            <lf start="19" span="1" word="10" lemma="10" pos="CD" chunk="B-NP" entity="O" cat="N\N" />
           </rule>
          </rule>
         </rule>
         <rule type="conj" cat="NP\NP">
          <lf start="20" span="1" word="and" lemma="and" pos="CC" chunk="I-NP" entity="O" cat="conj" />
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="21" span="1" word="one" lemma="one" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
            <rule type="fa" cat="N">
             <lf start="22" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
             <rule type="ba" cat="N">
              <rule type="fa" cat="N">
               <rule type="ba" cat="N/N">
                <lf start="23" span="1" word="5" lemma="5" pos="CD" chunk="B-NP" entity="O" cat="N/N" />
                <rule type="conj" cat="(N/N)\(N/N)">
                 <lf start="24" span="1" word="or" lemma="or" pos="CC" chunk="I-NP" entity="O" cat="conj" />
                 <lf start="25" span="1" word="three" lemma="three" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
                </rule>
               </rule>
               <lf start="26" span="1" word="integers" lemma="integer" pos="NNS" chunk="I-NP" entity="O" cat="N" />
              </rule>
              <lf start="27" span="1" word="5" lemma="5" pos="CD" chunk="B-NP" entity="O" cat="N\N" />
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
       <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
        <lf start="28" span="1" word="before" lemma="before" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/NP" />
        <rule type="fa" cat="NP[nb]">
         <lf start="29" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="ba" cat="N">
          <lf start="30" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="I-DAT" cat="N" />
          <lf start="31" span="1" word="20" lemma="20" pos="CD" chunk="I-NP" entity="I-DAT" cat="N\N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="32" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
