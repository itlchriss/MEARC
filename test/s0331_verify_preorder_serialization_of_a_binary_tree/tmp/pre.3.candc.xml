<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP[nb]">
     <lf start="0" span="1" word="Each" lemma="each" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <lf start="1" span="1" word="value" lemma="value" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="2" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
     <rule type="fa" cat="NP[nb]">
      <lf start="3" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="fa" cat="N">
       <lf start="4" span="1" word="type_string_" lemma="type_string_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <lf start="5" span="1" word="param_preorder_" lemma="param_preorder_" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="6" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
    <rule type="fa" cat="NP">
     <lf start="7" span="1" word="either" lemma="either" pos="RB" chunk="I-ADVP" entity="O" cat="NP/NP" />
     <rule type="ba" cat="NP[nb]">
      <rule type="ba" cat="NP">
       <rule type="fa" cat="NP[nb]">
        <lf start="8" span="1" word="an" lemma="an" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <lf start="9" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
       <rule type="fa" cat="NP\NP">
        <lf start="10" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
        <rule type="ba" cat="NP">
         <rule type="ba" cat="NP">
          <rule type="fa" cat="NP[nb]">
           <lf start="11" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
           <lf start="12" span="1" word="range" lemma="range" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
          <rule type="ba" cat="NP\NP">
           <lf start="13" span="1" word="[" lemma="[" pos="NN" chunk="I-NP" entity="O" cat="NP\NP" />
           <lf start="14" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="O" cat="(NP\NP)\(NP\NP)" />
          </rule>
         </rule>
         <rule type="conj" cat="NP\NP">
          <lf start="15" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="16" span="1" word="100" lemma="100" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="17" span="1" word="]" lemma="]" pos="NNS" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
      <rule type="conj" cat="NP[nb]\NP[nb]">
       <lf start="18" span="1" word="or" lemma="or" pos="CC" chunk="O" entity="O" cat="conj" />
       <rule type="fa" cat="NP[nb]">
        <lf start="19" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <rule type="fa" cat="N">
         <lf start="20" span="1" word="character" lemma="character" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="21" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="22" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
