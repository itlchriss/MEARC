<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP[nb]">
     <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <lf start="1" span="1" word="method" lemma="method" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <lf start="2" span="1" word="expr0" lemma="expr0" pos="NN" chunk="I-NP" entity="O" cat="NP\NP" />
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="3" span="1" word="should" lemma="should" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
    <rule type="fa" cat="S[b]\NP">
     <lf start="4" span="1" word="be" lemma="be" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/(S[pss]\NP)" />
     <rule type="ba" cat="S[pss]\NP">
      <lf start="5" span="1" word="implemented" lemma="implement" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
      <rule type="lex" cat="(S[X]\NP)\(S[X]\NP)">
       <rule type="fa" cat="S[to]\NP">
        <lf start="6" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
        <rule type="ba" cat="S[b]\NP">
         <rule type="fa" cat="S[b]\NP">
          <lf start="7" span="1" word="generate" lemma="generate" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
          <rule type="ba" cat="NP">
           <rule type="fa" cat="NP[nb]">
            <lf start="8" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
            <rule type="fa" cat="N">
             <lf start="9" span="1" word="uniform" lemma="uniform" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
             <rule type="fa" cat="N">
              <lf start="10" span="1" word="random" lemma="random" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
              <lf start="11" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
           <rule type="fa" cat="NP\NP">
            <lf start="12" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
            <rule type="fa" cat="NP[nb]">
             <lf start="13" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
             <rule type="ba" cat="N">
              <lf start="14" span="1" word="range" lemma="range" pos="NN" chunk="I-NP" entity="O" cat="N" />
              <lf start="15" span="1" word="expr1" lemma="expr1" pos="CD" chunk="I-NP" entity="O" cat="N\N" />
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
         <rule type="lex" cat="(S[X]\NP)\(S[X]\NP)">
          <rule type="fa" cat="S[ng]\NP">
           <lf start="16" span="1" word="using" lemma="use" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
           <rule type="fa" cat="NP[nb]">
            <lf start="17" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
            <rule type="fa" cat="N">
             <lf start="18" span="1" word="expr2" lemma="expr2" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="19" span="1" word="API" lemma="API" pos="NNP" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="20" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
