<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <lf start="0" span="1" word="There" lemma="there" pos="EX" chunk="I-NP" entity="O" cat="NP[thr]" />
   <rule type="fa" cat="S[dcl]\NP[thr]">
    <lf start="1" span="1" word="exists" lemma="exist" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP[thr])/NP" />
    <rule type="ba" cat="NP">
     <rule type="fa" cat="NP[nb]">
      <lf start="2" span="1" word="an" lemma="an" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="3" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="lex" cat="NP\NP">
      <rule type="fa" cat="S[adj]\NP">
       <lf start="4" span="1" word="expr0" lemma="expr0" pos="CD" chunk="I-NP" entity="O" cat="(S[adj]\NP)/(S[adj]\NP)" />
       <rule type="fa" cat="S[adj]\NP">
        <lf start="5" span="1" word="such" lemma="such" pos="JJ" chunk="I-NP" entity="O" cat="(S[adj]\NP)/S[em]" />
        <rule type="fa" cat="S[em]">
         <lf start="6" span="1" word="that" lemma="that" pos="IN" chunk="I-NP" entity="O" cat="S[em]/S[dcl]" />
         <rule type="rp" cat="S[dcl]">
          <rule type="ba" cat="S[dcl]">
           <rule type="ba" cat="NP[nb]">
            <rule type="lex" cat="NP">
             <lf start="7" span="1" word="expr1" lemma="expr1" pos="CD" chunk="I-NP" entity="O" cat="N" />
            </rule>
            <rule type="conj" cat="NP[nb]\NP[nb]">
             <lf start="8" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
             <rule type="fa" cat="NP[nb]">
              <lf start="9" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
              <rule type="fa" cat="N">
               <lf start="10" span="1" word="following" lemma="following" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
               <lf start="11" span="1" word="conditions" lemma="condition" pos="NNS" chunk="I-NP" entity="O" cat="N" />
              </rule>
             </rule>
            </rule>
           </rule>
           <rule type="fa" cat="S[dcl]\NP">
            <lf start="12" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
            <lf start="13" span="1" word="met" lemma="meet" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
           </rule>
          </rule>
          <lf start="14" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat=":" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="15" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
