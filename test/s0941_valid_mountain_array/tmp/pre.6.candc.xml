<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="fa" cat="S[dcl]">
   <rule type="tr" cat="S[X]/(S[X]/NP)">
    <rule type="fa" cat="NP[nb]">
     <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <lf start="1" span="1" word="type_integer_array_" lemma="type_integer_array_" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
   </rule>
   <rule type="fc" cat="S[dcl]/NP">
    <rule type="tr" cat="S[X]/(S[X]\NP)">
     <rule type="lex" cat="NP">
      <lf start="2" span="1" word="param_arr_" lemma="param_arr_" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
    <rule type="fc" cat="(S[dcl]\NP)/NP">
     <lf start="3" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
     <rule type="fc" cat="NP/NP">
      <rule type="lex" cat="NP/(NP\NP)">
       <rule type="ba" cat="NP">
        <rule type="ba" cat="NP">
         <rule type="fa" cat="NP[nb]">
          <lf start="4" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <rule type="fa" cat="N">
           <lf start="5" span="1" word="valid" lemma="valid" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
           <rule type="fa" cat="N">
            <lf start="6" span="1" word="mountain" lemma="mountain" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="7" span="1" word="array" lemma="array" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
         <rule type="fa" cat="NP\NP">
          <lf start="8" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="(NP\NP)/NP" />
          <lf start="9" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="NP" />
         </rule>
        </rule>
        <lf start="10" span="1" word="only" lemma="only" pos="RB" chunk="I-SBAR" entity="O" cat="NP\NP" />
       </rule>
      </rule>
      <rule type="rp" cat="(NP\NP)/NP">
       <lf start="11" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="(NP\NP)/NP" />
       <lf start="12" span="1" word=":" lemma=":" pos=":" chunk="O" entity="O" cat=":" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="13" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
