- public List<List<Integer>> getSkyline(int[][] buildings)
- requires buildings != null && buildings.length >= 1
- requires (\forall int[] building; buildings.contains(building); building.length == 3 && building[0] >= 0 && building[1] >= building[0] && building[2] >= 1)
- requires (\forall int i; 0 <= i < buildings.length - 1; buildings[i][0] <= buildings[i+1][0])
- ensures \result != null
- ensures (\forall List<Integer> point; \result.contains(point); point.size() == 2)
- ensures (\forall int i; 0 <= i < \result.size() - 1; \result.get(i).get(0) <= \result.get(i+1).get(0))
- pure