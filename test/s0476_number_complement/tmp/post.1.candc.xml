<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP[nb]">
     <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <rule type="fa" cat="N">
      <lf start="1" span="1" word="binary" lemma="binary" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
      <lf start="2" span="1" word="representation" lemma="representation" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="3" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
     <rule type="fa" cat="NP[nb]">
      <lf start="4" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="fa" cat="N">
       <lf start="5" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <lf start="6" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="7" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
    <rule type="ba" cat="S[pss]\NP">
     <lf start="8" span="1" word="obtained" lemma="obtain" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
     <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
      <lf start="9" span="1" word="by" lemma="by" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/(S[ng]\NP)" />
      <rule type="ba" cat="S[ng]\NP">
       <rule type="fa" cat="S[ng]\NP">
        <lf start="10" span="1" word="flipping" lemma="flip" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
        <rule type="fa" cat="NP[nb]">
         <lf start="11" span="1" word="all" lemma="all" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="fa" cat="N">
          <lf start="12" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="13" span="1" word="'s" lemma="'s" pos="POS" chunk="B-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
       <rule type="lex" cat="(S[X]\NP)\(S[X]\NP)">
        <rule type="fa" cat="S[to]\NP">
         <lf start="14" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
         <rule type="fa" cat="S[b]\NP">
          <lf start="15" span="1" word="expr_b" lemma="expr_b" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
          <rule type="ba" cat="NP">
           <rule type="lex" cat="NP">
            <lf start="16" span="1" word="'s" lemma="'s" pos="POS" chunk="I-NP" entity="O" cat="N" />
           </rule>
           <rule type="conj" cat="NP\NP">
            <lf start="17" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
            <rule type="ba" cat="NP">
             <rule type="fa" cat="NP[nb]">
              <lf start="18" span="1" word="all" lemma="all" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
              <rule type="fa" cat="N">
               <lf start="19" span="1" word="expr_c" lemma="expr_c" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
               <lf start="20" span="1" word="'s" lemma="'s" pos="POS" chunk="B-NP" entity="O" cat="N" />
              </rule>
             </rule>
             <rule type="lex" cat="NP\NP">
              <rule type="fa" cat="S[to]\NP">
               <lf start="21" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
               <rule type="ba" cat="S[b]\NP">
                <rule type="fa" cat="S[b]\NP">
                 <lf start="22" span="1" word="expr_d" lemma="expr_d" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
                 <rule type="lex" cat="NP">
                  <lf start="23" span="1" word="'s" lemma="'s" pos="POS" chunk="I-NP" entity="O" cat="N" />
                 </rule>
                </rule>
                <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
                 <lf start="24" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
                 <rule type="ba" cat="NP">
                  <rule type="fa" cat="NP[nb]">
                   <lf start="25" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                   <rule type="fa" cat="N">
                    <lf start="26" span="1" word="binary" lemma="binary" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                    <lf start="27" span="1" word="representation" lemma="representation" pos="NN" chunk="I-NP" entity="O" cat="N" />
                   </rule>
                  </rule>
                  <rule type="fa" cat="NP\NP">
                   <lf start="28" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
                   <rule type="fa" cat="NP[nb]">
                    <lf start="29" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                    <rule type="fa" cat="N">
                     <lf start="30" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                     <lf start="31" span="1" word="param_num_" lemma="param_num_" pos="NN" chunk="I-NP" entity="O" cat="N" />
                    </rule>
                   </rule>
                  </rule>
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="32" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
