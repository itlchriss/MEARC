<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S">
  <lf start="0" span="1" word="If" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="S/S[dcl]" />
  <rule type="rp" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <lf start="1" span="1" word="there" lemma="there" pos="EX" chunk="I-NP" entity="O" cat="NP[thr]" />
    <rule type="ba" cat="S[dcl]\NP">
     <rule type="ba" cat="S[dcl]\NP">
      <lf start="2" span="1" word="exist" lemma="exist" pos="VBP" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
      <rule type="ba" cat="(S[X]\NP)\(S[X]\NP)">
       <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
        <lf start="3" span="1" word="two" lemma="two" pos="CD" chunk="I-NP" entity="O" cat="((S\NP)\(S\NP))/((S\NP)\(S\NP))" />
        <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
         <lf start="4" span="1" word="unique" lemma="unique" pos="JJ" chunk="I-NP" entity="O" cat="((S\NP)\(S\NP))/((S\NP)\(S\NP))" />
         <lf start="5" span="1" word="indices" lemma="index" pos="NNS" chunk="I-NP" entity="O" cat="(S\NP)\(S\NP)" />
        </rule>
       </rule>
       <rule type="ba" cat="((S[X]\NP)\(S[X]\NP))\((S[X]\NP)\(S[X]\NP))">
        <lf start="6" span="1" word="_expr0_" lemma="_expr0_" pos="CD" chunk="B-NP" entity="O" cat="((S\NP)\(S\NP))\((S\NP)\(S\NP))" />
        <rule type="conj" cat="(((S[X]\NP)\(S[X]\NP))\((S[X]\NP)\(S[X]\NP)))\(((S[X]\NP)\(S[X]\NP))\((S[X]\NP)\(S[X]\NP)))">
         <lf start="7" span="1" word="and" lemma="and" pos="CC" chunk="I-NP" entity="O" cat="conj" />
         <lf start="8" span="1" word="_expr1_" lemma="_expr1_" pos="CD" chunk="I-NP" entity="O" cat="((S\NP)\(S\NP))\((S\NP)\(S\NP))" />
        </rule>
       </rule>
      </rule>
     </rule>
     <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
      <lf start="9" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
      <rule type="ba" cat="NP">
       <rule type="fa" cat="NP[nb]">
        <lf start="10" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <rule type="fa" cat="N">
         <lf start="11" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
         <rule type="fa" cat="N">
          <lf start="12" span="1" word="type_array_" lemma="type_array_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="13" span="1" word="param_nums_" lemma="param_nums_" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
       <rule type="lex" cat="NP\NP">
        <rule type="fa" cat="S[adj]\NP">
         <lf start="14" span="1" word="such" lemma="such" pos="JJ" chunk="I-PP" entity="O" cat="(S[adj]\NP)/S[em]" />
         <rule type="fa" cat="S[em]">
          <lf start="15" span="1" word="that" lemma="that" pos="IN" chunk="I-NP" entity="O" cat="S[em]/S[dcl]" />
          <rule type="fa" cat="S[dcl]">
           <rule type="rtc" cat="S[X]/S[X]">
            <rule type="lex" cat="NP">
             <rule type="ba" cat="N">
              <lf start="16" span="1" word="_expr2_" lemma="_expr2_" pos="CD" chunk="I-NP" entity="O" cat="N" />
              <rule type="conj" cat="N\N">
               <lf start="17" span="1" word="and" lemma="and" pos="CC" chunk="I-NP" entity="O" cat="conj" />
               <lf start="18" span="1" word="_expr3_" lemma="_expr3_" pos="CD" chunk="I-NP" entity="O" cat="N" />
              </rule>
             </rule>
            </rule>
            <lf start="19" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
           </rule>
           <rule type="ba" cat="S[dcl]">
            <rule type="fa" cat="NP[nb]">
             <lf start="20" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
             <rule type="fa" cat="N">
              <lf start="21" span="1" word="type_boolean_" lemma="type_boolean_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
              <lf start="22" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
            <rule type="fa" cat="S[dcl]\NP">
             <lf start="23" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
             <rule type="ba" cat="S[adj]\NP">
              <lf start="24" span="1" word="equal" lemma="equal" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
              <rule type="fa" cat="(S[adj]\NP)\(S[adj]\NP)">
               <lf start="25" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="((S[adj]\NP)\(S[adj]\NP))/NP" />
               <rule type="fa" cat="NP[nb]">
                <lf start="26" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                <rule type="fa" cat="N">
                 <lf start="27" span="1" word="true" lemma="true" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                 <lf start="28" span="1" word="literal" lemma="literal" pos="NN" chunk="I-NP" entity="O" cat="N" />
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="29" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
  </rule>
 </rule>
</ccg>
</candc>
