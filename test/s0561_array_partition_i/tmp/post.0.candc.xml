<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <rule type="fa" cat="N">
     <lf start="1" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
     <rule type="fa" cat="N">
      <lf start="2" span="1" word="type_array_" lemma="type_array_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
      <lf start="3" span="1" word="param_nums_" lemma="param_nums_" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="4" span="1" word="must" lemma="must" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
    <rule type="fa" cat="S[b]\NP">
     <lf start="5" span="1" word="have" lemma="have" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
     <rule type="ba" cat="NP">
      <rule type="rp" cat="NP">
       <rule type="ba" cat="NP">
        <rule type="fa" cat="NP[nb]">
         <lf start="6" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <lf start="7" span="1" word="length" lemma="length" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="8" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
         <rule type="lex" cat="NP">
          <lf start="9" span="1" word="expr0" lemma="expr0" pos="CD" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
       <lf start="10" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="11" span="1" word="that" lemma="that" pos="IN" chunk="I-SBAR" entity="O" cat="(NP\NP)/S[dcl]" />
       <rule type="ba" cat="S[dcl]">
        <rule type="lex" cat="NP">
         <lf start="12" span="1" word="expr1" lemma="expr1" pos="CD" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="13" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
         <rule type="ba" cat="NP">
          <rule type="fa" cat="NP[nb]">
           <lf start="14" span="1" word="an" lemma="an" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
           <rule type="fa" cat="N">
            <lf start="15" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="16" span="1" word="greater_than_or_equal" lemma="greater_than_or_equal" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
          <rule type="fa" cat="NP\NP">
           <lf start="17" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
           <rule type="ba" cat="NP">
            <rule type="lex" cat="NP">
             <lf start="18" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N" />
            </rule>
            <rule type="conj" cat="NP\NP">
             <lf start="19" span="1" word="and" lemma="and" pos="CC" chunk="I-NP" entity="O" cat="conj" />
             <rule type="ba" cat="NP">
              <rule type="lex" cat="NP">
               <lf start="20" span="1" word="less_than_or_equal" lemma="less_than_or_equal" pos="JJR" chunk="I-NP" entity="O" cat="N" />
              </rule>
              <rule type="fa" cat="NP\NP">
               <lf start="21" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
               <rule type="lex" cat="NP">
                <lf start="22" span="1" word="10000" lemma="10000" pos="CD" chunk="I-NP" entity="O" cat="N" />
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="23" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
