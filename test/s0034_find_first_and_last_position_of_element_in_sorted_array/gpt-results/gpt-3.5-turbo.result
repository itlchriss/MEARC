- public int[] searchRange(int[] nums, int target)
- requires nums != null && nums.length >= 0;
- requires (\forall int i; 0 <= i && i < nums.length - 1; nums[i] <= nums[i + 1]);
- ensures \result != null;
- ensures \result.length == 2;
- ensures (\forall int i; 0 <= i && i < \result.length; -1 <= \result[i] && \result[i] < nums.length);
- ensures (\forall int i; 0 <= i && i < nums.length; nums[i] == target ==> (\result[0] <= i && i <= \result[1]));
- ensures (\forall int i; 0 <= i && i < nums.length; nums[i] != target ==> (\result[0] == -1 && \result[1] == -1));