- requires nums1 != null && nums2 != null;
- requires nums1.length > 0 && nums2.length > 0;
- requires k > 0;
- requires nums1.length <= 100000 && nums2.length <= 100000;
- requires k <= 1000;
- requires (\forall int i; 0 <= i && i < nums1.length - 1; nums1[i] <= nums1[i + 1]);
- requires (\forall int i; 0 <= i && i < nums2.length - 1; nums2[i] <= nums2[i + 1]);
- ensures \result != null;
- ensures \result.size() <= k;
- ensures (\forall int i, j; 0 <= i && i < \result.size() && 0 <= j && j < \result.get(i).size(); \result.get(i).get(j) == nums1[i] + nums2[j]);
- ensures (\forall int i; 0 <= i && i < \result.size() - 1; \result.get(i).get(0) + \result.get(i).get(1) <= \result.get(i + 1).get(0) + \result.get(i + 1).get(1));