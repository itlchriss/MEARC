<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP">
     <lf start="0" span="1" word="All" lemma="all" pos="PDT" chunk="I-NP" entity="O" cat="NP/NP" />
     <rule type="fa" cat="NP[nb]">
      <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="2" span="1" word="values" lemma="value" pos="NNS" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="3" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
     <rule type="fa" cat="NP[nb]">
      <lf start="4" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="fa" cat="N">
       <lf start="5" span="1" word="type_integer_array_" lemma="type_integer_array_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <lf start="6" span="1" word="param_nums_" lemma="param_nums_" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="ba" cat="S[dcl]\NP">
    <rule type="rp" cat="S[dcl]\NP">
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="7" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
      <lf start="8" span="1" word="unique" lemma="unique" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
     </rule>
     <lf start="9" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    </rule>
    <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
     <lf start="10" span="1" word="except" lemma="except" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/PP" />
     <rule type="fa" cat="PP">
      <lf start="11" span="1" word="for" lemma="for" pos="IN" chunk="B-PP" entity="O" cat="PP/NP" />
      <rule type="ba" cat="NP">
       <rule type="lex" cat="NP">
        <rule type="fa" cat="N">
         <lf start="12" span="1" word="one" lemma="one" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="13" span="1" word="value" lemma="value" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
       <rule type="fa" cat="NP\NP">
        <lf start="14" span="1" word="which" lemma="which" pos="WDT" chunk="B-NP" entity="O" cat="(NP\NP)/(S[dcl]\NP)" />
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="15" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
         <rule type="ba" cat="S[pss]\NP">
          <lf start="16" span="1" word="repeated" lemma="repeat" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
          <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
           <lf start="17" span="1" word="expr_a" lemma="expr_a" pos="JJ" chunk="I-NP" entity="O" cat="((S\NP)\(S\NP))/((S\NP)\(S\NP))" />
           <lf start="18" span="1" word="times" lemma="time" pos="NNS" chunk="I-NP" entity="O" cat="(S\NP)\(S\NP)" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="19" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
