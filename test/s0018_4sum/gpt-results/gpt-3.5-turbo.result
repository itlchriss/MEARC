- requires nums != null && nums.length >= 1;
- requires target >= -1000000000 && target <= 1000000000;
- ensures \result != null;
- ensures (\forall List<Integer> list; \result.contains(list); list.size() == 4);
- ensures (\forall List<Integer> list; \result.contains(list); list.get(0) + list.get(1) + list.get(2) + list.get(3) == target);
- ensures (\forall List<Integer> list1, list2; \result.contains(list1) && \result.contains(list2) && list1 != list2; !list1.equals(list2));