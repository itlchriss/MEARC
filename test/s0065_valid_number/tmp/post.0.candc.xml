<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <rule type="fa" cat="N">
     <lf start="1" span="1" word="type_boolean_" lemma="type_boolean_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
     <lf start="2" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
   </rule>
   <rule type="ba" cat="S[dcl]\NP">
    <lf start="3" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
    <rule type="ba" cat="(S[X]\NP)\((S[X]\NP)/(S[adj]\NP))">
     <rule type="bc" cat="(S[X]\NP)\((S[X]\NP)/(S[adj]\NP))">
      <rule type="tr" cat="(S[X]\NP)\((S[X]\NP)/(S[adj]\NP))">
       <rule type="fa" cat="S[adj]\NP">
        <lf start="4" span="1" word="equal" lemma="equal" pos="JJ" chunk="I-ADJP" entity="O" cat="(S[adj]\NP)/PP" />
        <rule type="fa" cat="PP">
         <lf start="5" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="PP/NP" />
         <rule type="fa" cat="NP[nb]">
          <lf start="6" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <rule type="fa" cat="N">
           <lf start="7" span="1" word="true" lemma="true" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
           <lf start="8" span="1" word="literal" lemma="literal" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
      <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
       <lf start="9" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
       <rule type="ba" cat="S[dcl]">
        <rule type="fa" cat="NP[nb]">
         <lf start="10" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="fa" cat="N">
          <lf start="11" span="1" word="string" lemma="string" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="12" span="1" word="param_s_" lemma="param_s_" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="rp" cat="S[dcl]\NP">
         <rule type="fa" cat="S[dcl]\NP">
          <lf start="13" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
          <rule type="fa" cat="NP[nb]">
           <lf start="14" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
           <rule type="fa" cat="N">
            <lf start="15" span="1" word="valid" lemma="valid" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="16" span="1" word="number" lemma="number" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
         <lf start="17" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
        </rule>
       </rule>
      </rule>
     </rule>
     <rule type="conj" cat="((S[X]\NP)\((S[X]\NP)/(S[adj]\NP)))\((S[X]\NP)\((S[X]\NP)/(S[adj]\NP)))">
      <lf start="18" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
      <rule type="bc" cat="(S[X]\NP)\((S[X]\NP)/(S[adj]\NP))">
       <rule type="tr" cat="(S[X]\NP)\((S[X]\NP)/(S[adj]\NP))">
        <lf start="19" span="1" word="false" lemma="false" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
       </rule>
       <lf start="20" span="1" word="otherwise" lemma="otherwise" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="21" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
