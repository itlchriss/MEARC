<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <rule type="fa" cat="N">
     <lf start="1" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
     <lf start="2" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
   </rule>
   <rule type="ba" cat="S[dcl]\NP">
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="3" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
     <rule type="ba" cat="NP">
      <rule type="fa" cat="NP[nb]">
       <lf start="4" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <rule type="fa" cat="N">
        <lf start="5" span="1" word="minimum" lemma="minimum" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="6" span="1" word="score" lemma="score" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="7" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
       <rule type="ba" cat="NP">
        <rule type="fa" cat="NP[nb]">
         <lf start="8" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="fa" cat="N">
          <lf start="9" span="1" word="type_integer_" lemma="type_integer_" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="10" span="1" word="type_array_" lemma="type_array_" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <lf start="11" span="1" word="expr0" lemma="expr0" pos="CD" chunk="I-NP" entity="O" cat="NP\NP" />
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
     <lf start="12" span="1" word="after" lemma="after" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/(S[ng]\NP)" />
     <rule type="fa" cat="S[ng]\NP">
      <lf start="13" span="1" word="applying" lemma="apply" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
      <rule type="ba" cat="NP">
       <lf start="14" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP" />
       <rule type="lex" cat="NP\NP">
        <rule type="fa" cat="S[dcl]\NP">
         <rule type="bx" cat="(S[dcl]\NP)/PP">
          <rule type="fa" cat="(S[dcl]\NP)/PP">
           <lf start="15" span="1" word="mentioned" lemma="mention" pos="VBN" chunk="I-VP" entity="O" cat="((S[dcl]\NP)/PP)/NP" />
           <rule type="ba" cat="NP">
            <rule type="lex" cat="NP">
             <lf start="16" span="1" word="operation" lemma="operation" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
            <rule type="fa" cat="NP\NP">
             <lf start="17" span="1" word="at" lemma="at" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
             <rule type="lex" cat="NP">
              <lf start="18" span="1" word="most" lemma="most" pos="JJS" chunk="I-ADVP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
          </rule>
          <lf start="19" span="1" word="once" lemma="once" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
         </rule>
         <rule type="fa" cat="PP">
          <lf start="20" span="1" word="for" lemma="for" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
          <rule type="ba" cat="NP">
           <rule type="fa" cat="NP[nb]">
            <lf start="21" span="1" word="each" lemma="each" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
            <lf start="22" span="1" word="index" lemma="index" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
           <rule type="fa" cat="NP\NP">
            <lf start="23" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
            <lf start="24" span="1" word="it" lemma="it" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="25" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
