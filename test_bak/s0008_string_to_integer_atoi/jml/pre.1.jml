requires((\exists int i; 0 <= i < str.length(); Character.isAlphabetic(str.charAt(i))) && ((\exists int i; 0 <= i < str.length(); Character.isDigit(str.charAt(i))) && ((\exists int i; 0 <= i < str.length(); Character.isWhitespace(str.charAt(i))) && ((str.contains('+comma-')) && (\exists int i; 0 <= i < str.length(); '.' == (str.charAt(i)))))));
