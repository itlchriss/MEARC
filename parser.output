Grammar

    0 $accept: formula $end

    1 formula: terms

    2 terms: NEG term connective terms
    3      | term connective terms
    4      | term connective '(' terms ')'
    5      | '(' terms ')' connective term
    6      | term
    7      | NEG term

    8 term: predicate_term
    9     | type_term
   10     | param_term
   11     | quantified_term
   12     | event_term
   13     | grammar_term
   14     | KEYWORD_TRUEP
   15     | IDENTIFIER EQUAL IDENTIFIER

   16 connective: AND
   17           | EQUIV
   18           | IMPLY
   19           | OR

   20 grammar_term: TAG '(' arguments ')'

   21 type_term: KEYWORD_TYPE '{' TAG '}' '(' arguments ')'

   22 param_term: KEYWORD_PARAM '{' TAG '}' '(' arguments ')'

   23 predicate_term: PREDICATE '{' TAG '}' '(' arguments ')'
   24               | PREDICATE '{' TAG '}' '(' '(' terms ')' ')'

   25 arguments: arguments COMMA argument
   26          | argument

   27 argument: IDENTIFIER
   28         | terms

   29 event_term: '(' EVENT '(' IDENTIFIER ')' EQUAL IDENTIFIER ')'

   30 quantified_term: KEYWORD_QUANTIFIER IDENTIFIER '.' '(' terms ')'


