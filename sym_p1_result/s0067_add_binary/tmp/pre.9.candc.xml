<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="lex" cat="NP">
    <rule type="ba" cat="N">
     <lf start="0" span="1" word="param_a" lemma="param_a" pos="NN" chunk="I-NP" entity="I-ORG" cat="N" />
     <rule type="conj" cat="N\N">
      <lf start="1" span="1" word="and" lemma="and" pos="CC" chunk="I-NP" entity="O" cat="conj" />
      <lf start="2" span="1" word="param_b" lemma="param_b" pos="NN" chunk="I-NP" entity="I-ORG" cat="N" />
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="3" span="1" word="consist" lemma="consist" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/PP" />
    <rule type="fa" cat="PP">
     <lf start="4" span="1" word="only" lemma="only" pos="RB" chunk="I-ADVP" entity="O" cat="PP/PP" />
     <rule type="fa" cat="PP">
      <lf start="5" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
      <rule type="ba" cat="NP[nb]">
       <rule type="lex" cat="NP">
        <lf start="6" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="I-LOC" cat="N" />
       </rule>
       <rule type="conj" cat="NP[nb]\NP[nb]">
        <lf start="7" span="1" word="or" lemma="or" pos="CC" chunk="O" entity="O" cat="conj" />
        <rule type="fa" cat="NP[nb]">
         <lf start="8" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="fa" cat="N">
          <lf start="9" span="1" word="expr_b" lemma="expr_b" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="10" span="1" word="characters" lemma="character" pos="NNS" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="11" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
