<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="fa" cat="S[dcl]">
   <rule type="tr" cat="S[X]/(S[X]/NP)">
    <rule type="lex" cat="NP">
     <lf start="0" span="1" word="i.e." lemma="i.e." pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
   </rule>
   <rule type="lp" cat="S[dcl]/NP">
    <lf start="1" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    <rule type="fc" cat="S[dcl]/NP">
     <rule type="tr" cat="S[X]/(S[X]\NP)">
      <rule type="lex" cat="NP">
       <lf start="2" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
     <rule type="bx" cat="(S[dcl]\NP)/NP">
      <lf start="3" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      <rule type="rp" cat="(S[X]\NP)\(S[X]\NP)">
       <lf start="4" span="1" word="not" lemma="not" pos="RB" chunk="O" entity="O" cat="(S\NP)\(S\NP)" />
       <lf start="5" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="6" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
