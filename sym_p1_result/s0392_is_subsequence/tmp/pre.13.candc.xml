<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="S[b]\NP">
  <rule type="ba" cat="S[b]\NP">
   <lf start="0" span="1" word="Follow" lemma="follow" pos="VB" chunk="I-VP" entity="O" cat="S[b]\NP" />
   <lf start="1" span="1" word="up" lemma="up" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
  </rule>
  <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
   <lf start="2" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
   <rule type="ba" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <rule type="lex" cat="NP">
      <lf start="3" span="1" word="Suppose" lemma="suppose" pos="VB" chunk="I-VP" entity="O" cat="N" />
     </rule>
     <lf start="4" span="1" word="exist" lemma="exist" pos="VBP" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
    </rule>
    <rule type="lex" cat="S[X]\S[X]">
     <rule type="rp" cat="S[dcl]">
      <rule type="ba" cat="S[dcl]">
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <lf start="5" span="1" word="lots" lemma="lot" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="6" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
         <rule type="lex" cat="NP">
          <rule type="fa" cat="N">
           <lf start="7" span="1" word="incoming" lemma="incoming" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
           <lf start="8" span="1" word="param_s" lemma="param_s" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
       <rule type="lp" cat="S[dcl]\NP">
        <lf start="9" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="10" span="1" word="say" lemma="say" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/S[dcl]" />
         <rule type="ba" cat="S[dcl]">
          <rule type="rp" cat="S[dcl]">
           <rule type="ba" cat="S[dcl]">
            <rule type="ba" cat="S[dcl]">
             <rule type="lex" cat="NP">
              <rule type="fa" cat="N">
               <lf start="11" span="1" word="&lt;" lemma="&lt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
               <rule type="fa" cat="N">
                <lf start="12" span="1" word="code" lemma="code" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                <lf start="13" span="1" word="&gt;" lemma="&gt;" pos="NN" chunk="I-NP" entity="O" cat="N" />
               </rule>
              </rule>
             </rule>
             <rule type="fa" cat="S[dcl]\NP">
              <lf start="14" span="1" word="s" lemma="s" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
              <rule type="ba" cat="NP">
               <rule type="lex" cat="NP">
                <rule type="fa" cat="N">
                 <lf start="15" span="1" word="&lt;" lemma="&lt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                 <lf start="16" span="1" word="sub" lemma="sub" pos="NN" chunk="I-NP" entity="O" cat="N" />
                </rule>
               </rule>
               <rule type="lex" cat="NP\NP">
                <rule type="fa" cat="S[dcl]\NP">
                 <lf start="17" span="1" word="&gt;" lemma="&gt;" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
                 <rule type="lex" cat="NP">
                  <rule type="fa" cat="N">
                   <rule type="fa" cat="N/N">
                    <lf start="18" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="I-TIM" cat="(N/N)/(N/N)" />
                    <lf start="19" span="1" word="&lt;" lemma="&lt;" pos="CD" chunk="I-NP" entity="I-TIM" cat="N/N" />
                   </rule>
                   <rule type="fa" cat="N">
                    <lf start="20" span="1" word="/sub" lemma="/sub" pos="NN" chunk="I-NP" entity="I-TIM" cat="N/N" />
                    <lf start="21" span="1" word="&gt;" lemma="&gt;" pos="NN" chunk="I-NP" entity="I-TIM" cat="N" />
                   </rule>
                  </rule>
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
            <rule type="lp" cat="S[dcl]\S[dcl]">
             <lf start="22" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
             <rule type="rp" cat="S[dcl]\S[dcl]">
              <rule type="fa" cat="S[dcl]\S[dcl]">
               <lf start="23" span="1" word="s" lemma="s" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\S[dcl])/NP" />
               <rule type="ba" cat="NP">
                <rule type="lex" cat="NP">
                 <rule type="fa" cat="N">
                  <lf start="24" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                  <lf start="25" span="1" word="sub" lemma="sub" pos="NN" chunk="I-NP" entity="O" cat="N" />
                 </rule>
                </rule>
                <rule type="lex" cat="NP\NP">
                 <rule type="fa" cat="S[dcl]\NP">
                  <lf start="26" span="1" word="&gt;" lemma="&gt;" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
                  <rule type="lex" cat="NP">
                   <rule type="fa" cat="N">
                    <rule type="fa" cat="N/N">
                     <lf start="27" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="(N/N)/(N/N)" />
                     <lf start="28" span="1" word="&lt;" lemma="&lt;" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
                    </rule>
                    <rule type="fa" cat="N">
                     <lf start="29" span="1" word="/sub" lemma="/sub" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                     <lf start="30" span="1" word="&gt;" lemma="&gt;" pos="NN" chunk="I-NP" entity="O" cat="N" />
                    </rule>
                   </rule>
                  </rule>
                 </rule>
                </rule>
               </rule>
              </rule>
              <lf start="31" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
             </rule>
            </rule>
           </rule>
           <lf start="32" span="1" word="..." lemma="..." pos=":" chunk="O" entity="O" cat=":" />
          </rule>
          <rule type="lp" cat="S[dcl]\S[dcl]">
           <lf start="33" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
           <rule type="fa" cat="S[dcl]\S[dcl]">
            <lf start="34" span="1" word="s" lemma="s" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\S[dcl])/NP" />
            <rule type="ba" cat="NP">
             <rule type="lex" cat="NP">
              <rule type="fa" cat="N">
               <lf start="35" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
               <rule type="fa" cat="N">
                <lf start="36" span="1" word="sub" lemma="sub" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                <rule type="fa" cat="N">
                 <lf start="37" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                 <rule type="fa" cat="N">
                  <lf start="38" span="1" word="k" lemma="k" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                  <rule type="fa" cat="N">
                   <lf start="39" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                   <rule type="fa" cat="N">
                    <lf start="40" span="1" word="/sub" lemma="/sub" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                    <rule type="fa" cat="N">
                     <lf start="41" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                     <rule type="fa" cat="N">
                      <lf start="42" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                      <lf start="43" span="1" word="/code" lemma="/code" pos="NNP" chunk="I-NP" entity="O" cat="N" />
                     </rule>
                    </rule>
                   </rule>
                  </rule>
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
             <rule type="lex" cat="NP\NP">
              <rule type="fa" cat="S[dcl]\NP">
               <lf start="44" span="1" word="&gt;" lemma="&gt;" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/S[em]" />
               <rule type="fa" cat="S[em]">
                <lf start="45" span="1" word="that" lemma="that" pos="IN" chunk="I-SBAR" entity="O" cat="S[em]/S[dcl]" />
                <rule type="ba" cat="S[dcl]">
                 <rule type="ba" cat="NP">
                  <rule type="rp" cat="NP">
                   <rule type="lex" cat="NP">
                    <rule type="fa" cat="N">
                     <lf start="46" span="1" word="&lt;" lemma="&lt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                     <rule type="fa" cat="N">
                      <lf start="47" span="1" word="code" lemma="code" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                      <rule type="fa" cat="N">
                       <lf start="48" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                       <rule type="fa" cat="N">
                        <lf start="49" span="1" word="k" lemma="k" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                        <rule type="fa" cat="N">
                         <lf start="50" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                         <rule type="fa" cat="N">
                          <lf start="51" span="1" word="=" lemma="=" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                          <rule type="fa" cat="N">
                           <lf start="52" span="1" word="10" lemma="10" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
                           <rule type="fa" cat="N">
                            <lf start="53" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                            <rule type="fa" cat="N">
                             <lf start="54" span="1" word="sup" lemma="sup" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                             <rule type="fa" cat="N">
                              <lf start="55" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
                              <rule type="fa" cat="N">
                               <lf start="56" span="1" word="9" lemma="9" pos="CD" chunk="I-NP" entity="I-DAT" cat="N/N" />
                               <rule type="fa" cat="N">
                                <lf start="57" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
                                <rule type="fa" cat="N">
                                 <lf start="58" span="1" word="/sup" lemma="/sup" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
                                 <rule type="fa" cat="N">
                                  <lf start="59" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
                                  <rule type="fa" cat="N">
                                   <lf start="60" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
                                   <rule type="fa" cat="N">
                                    <lf start="61" span="1" word="/code" lemma="/code" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
                                    <lf start="62" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N" />
                                   </rule>
                                  </rule>
                                 </rule>
                                </rule>
                               </rule>
                              </rule>
                             </rule>
                            </rule>
                           </rule>
                          </rule>
                         </rule>
                        </rule>
                       </rule>
                      </rule>
                     </rule>
                    </rule>
                   </rule>
                   <lf start="63" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
                  </rule>
                  <rule type="conj" cat="NP\NP">
                   <lf start="64" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
                   <lf start="65" span="1" word="you" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
                  </rule>
                 </rule>
                 <rule type="fa" cat="S[dcl]\NP">
                  <lf start="66" span="1" word="want" lemma="want" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[to]\NP)" />
                  <rule type="fa" cat="S[to]\NP">
                   <lf start="67" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
                   <rule type="ba" cat="S[b]\NP">
                    <rule type="ba" cat="S[b]\NP">
                     <rule type="fa" cat="S[b]\NP">
                      <lf start="68" span="1" word="check" lemma="check" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
                      <rule type="lex" cat="NP">
                       <lf start="69" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N" />
                      </rule>
                     </rule>
                     <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
                      <lf start="70" span="1" word="by" lemma="by" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
                      <rule type="lex" cat="NP">
                       <lf start="71" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N" />
                      </rule>
                     </rule>
                    </rule>
                    <rule type="lex" cat="(S[X]\NP)\(S[X]\NP)">
                     <rule type="fa" cat="S[to]\NP">
                      <lf start="72" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
                      <rule type="fa" cat="S[b]\NP">
                       <lf start="73" span="1" word="see" lemma="see" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/S[qem]" />
                       <rule type="fa" cat="S[qem]">
                        <lf start="74" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="S[qem]/S[dcl]" />
                        <rule type="ba" cat="S[dcl]">
                         <rule type="lex" cat="NP">
                          <lf start="75" span="1" word="param_t" lemma="param_t" pos="NN" chunk="I-NP" entity="O" cat="N" />
                         </rule>
                         <rule type="fa" cat="S[dcl]\NP">
                          <lf start="76" span="1" word="has" lemma="have" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
                          <rule type="fa" cat="NP[nb]">
                           <lf start="77" span="1" word="its" lemma="its" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                           <lf start="78" span="1" word="subsequence" lemma="subsequence" pos="NN" chunk="I-NP" entity="O" cat="N" />
                          </rule>
                         </rule>
                        </rule>
                       </rule>
                      </rule>
                     </rule>
                    </rule>
                   </rule>
                  </rule>
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
      <lf start="79" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
     </rule>
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
