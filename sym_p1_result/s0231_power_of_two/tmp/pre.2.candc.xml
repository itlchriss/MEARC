<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="An" lemma="an" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <rule type="fa" cat="N">
     <lf start="1" span="1" word="integer" lemma="integer" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
     <lf start="2" span="1" word="param_n" lemma="param_n" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
   </rule>
   <rule type="ba" cat="S[dcl]\NP">
    <rule type="rp" cat="S[dcl]\NP">
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="3" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      <rule type="ba" cat="NP">
       <rule type="fa" cat="NP[nb]">
        <lf start="4" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <lf start="5" span="1" word="power" lemma="power" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
       <rule type="fa" cat="NP\NP">
        <lf start="6" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
        <rule type="lex" cat="NP">
         <lf start="7" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="I-DAT" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
     <lf start="8" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    </rule>
    <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
     <lf start="9" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
     <rule type="ba" cat="S[dcl]">
      <lf start="10" span="1" word="there" lemma="there" pos="EX" chunk="I-NP" entity="O" cat="NP[thr]" />
      <rule type="fa" cat="S[dcl]\NP[thr]">
       <lf start="11" span="1" word="exists" lemma="exist" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP[thr])/NP" />
       <rule type="ba" cat="NP">
        <rule type="fa" cat="NP[nb]">
         <lf start="12" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="fa" cat="N">
          <lf start="13" span="1" word="_type_integer" lemma="_type_integer" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="14" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="lex" cat="NP\NP">
         <rule type="fa" cat="S[adj]\NP">
          <lf start="15" span="1" word="such" lemma="such" pos="JJ" chunk="I-PP" entity="O" cat="(S[adj]\NP)/S[em]" />
          <rule type="fa" cat="S[em]">
           <lf start="16" span="1" word="that" lemma="that" pos="IN" chunk="I-NP" entity="O" cat="S[em]/S[dcl]" />
           <rule type="ba" cat="S[dcl]">
            <rule type="lex" cat="NP">
             <rule type="fa" cat="N">
              <lf start="17" span="1" word="&lt;" lemma="&lt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
              <rule type="fa" cat="N">
               <lf start="18" span="1" word="code" lemma="code" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
               <rule type="fa" cat="N">
                <lf start="19" span="1" word="&gt;" lemma="&gt;" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                <lf start="20" span="1" word="n" lemma="n" pos="NN" chunk="I-NP" entity="O" cat="N" />
               </rule>
              </rule>
             </rule>
            </rule>
            <rule type="fa" cat="S[dcl]\NP">
             <lf start="21" span="1" word="==" lemma="==" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
             <rule type="lex" cat="NP">
              <rule type="fa" cat="N">
               <rule type="fa" cat="N/N">
                <lf start="22" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="(N/N)/(N/N)" />
                <lf start="23" span="1" word="&lt;" lemma="&lt;" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
               </rule>
               <rule type="fa" cat="N">
                <lf start="24" span="1" word="sup" lemma="sup" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                <rule type="fa" cat="N">
                 <lf start="25" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                 <rule type="fa" cat="N">
                  <lf start="26" span="1" word="x" lemma="x" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                  <rule type="fa" cat="N">
                   <lf start="27" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                   <rule type="fa" cat="N">
                    <lf start="28" span="1" word="/sup" lemma="/sup" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                    <rule type="fa" cat="N">
                     <lf start="29" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                     <rule type="fa" cat="N">
                      <lf start="30" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                      <rule type="fa" cat="N">
                       <lf start="31" span="1" word="/code" lemma="/code" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                       <lf start="32" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="O" cat="N" />
                      </rule>
                     </rule>
                    </rule>
                   </rule>
                  </rule>
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="33" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
