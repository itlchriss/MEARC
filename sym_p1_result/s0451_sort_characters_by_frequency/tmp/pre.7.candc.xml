<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="lex" cat="NP">
   <lf start="0" span="1" word="Explanation" lemma="explanation" pos="NN" chunk="I-NP" entity="O" cat="N" />
  </rule>
  <rule type="fa" cat="NP\NP">
   <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/S[dcl]" />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <rule type="lex" cat="NP">
      <lf start="2" span="1" word="strx_a" lemma="strx_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="ba" cat="S[dcl]\NP">
      <rule type="ba" cat="S[dcl]\NP">
       <lf start="3" span="1" word="appears" lemma="appear" pos="VBZ" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
       <lf start="4" span="1" word="twice" lemma="twice" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
      </rule>
      <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
       <lf start="5" span="1" word="while" lemma="while" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
       <rule type="fa" cat="S[dcl]">
        <rule type="lex" cat="S[X]/S[X]">
         <rule type="ba" cat="S[adj]\NP">
          <lf start="6" span="1" word="strx_b" lemma="strx_b" pos="JJ" chunk="I-NP" entity="O" cat="S[adj]\NP" />
          <rule type="conj" cat="(S[adj]\NP)\(S[adj]\NP)">
           <lf start="7" span="1" word="and" lemma="and" pos="CC" chunk="I-NP" entity="O" cat="conj" />
           <lf start="8" span="1" word="strx_c" lemma="strx_c" pos="JJ" chunk="I-NP" entity="O" cat="S[adj]\NP" />
          </rule>
         </rule>
        </rule>
        <rule type="ba" cat="S[dcl]">
         <lf start="9" span="1" word="both" lemma="both" pos="DT" chunk="I-NP" entity="O" cat="NP" />
         <rule type="ba" cat="S[dcl]\NP">
          <lf start="10" span="1" word="appear" lemma="appear" pos="VBP" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
          <lf start="11" span="1" word="once" lemma="once" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="12" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
