<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[dcl]">
  <lf start="0" span="1" word="So" lemma="so" pos="RB" chunk="O" entity="O" cat="S/S" />
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <lf start="1" span="1" word="you" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
    <lf start="2" span="1" word="should" lemma="should" pos="MD" chunk="O" entity="O" cat="S[dcl]\NP" />
   </rule>
   <rule type="lex" cat="S[X]\S[X]">
    <rule type="rp" cat="S[dcl]">
     <rule type="ba" cat="S[dcl]">
      <rule type="fa" cat="NP[nb]">
       <lf start="3" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <lf start="4" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="ba" cat="S[dcl]\NP">
       <rule type="fa" cat="S[dcl]\NP">
        <lf start="5" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
        <rule type="lex" cat="NP">
         <lf start="6" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
       <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
        <lf start="7" span="1" word="because" lemma="because" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
        <rule type="fa" cat="S[dcl]">
         <rule type="tr" cat="S[X]/(S[X]/NP)">
          <rule type="lex" cat="NP">
           <lf start="8" span="1" word="exists" lemma="exist" pos="VBZ" chunk="I-VP" entity="O" cat="N" />
          </rule>
         </rule>
         <rule type="fc" cat="S[dcl]/NP">
          <rule type="tr" cat="S[X]/(S[X]\NP)">
           <rule type="lex" cat="NP">
            <rule type="fa" cat="N">
             <rule type="fa" cat="N/N">
              <lf start="9" span="1" word="only" lemma="only" pos="RB" chunk="I-NP" entity="O" cat="(N/N)/(N/N)" />
              <lf start="10" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="I-PCT" cat="N/N" />
             </rule>
             <lf start="11" span="1" word="bulb" lemma="bulb" pos="NN" chunk="I-NP" entity="I-PCT" cat="N" />
            </rule>
           </rule>
          </rule>
          <rule type="fc" cat="(S[dcl]\NP)/NP">
           <lf start="12" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/PP" />
           <lf start="13" span="1" word="on" lemma="on" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
     <lf start="14" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
