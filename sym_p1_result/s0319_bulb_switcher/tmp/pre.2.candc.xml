<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[b]">
  <rule type="ba" cat="S[b]">
   <rule type="ba" cat="S[b]">
    <lf start="0" span="1" word="You" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
    <rule type="fa" cat="S[b]\NP">
     <lf start="1" span="1" word="first" lemma="first" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)/(S\NP)" />
     <rule type="fa" cat="S[b]\NP">
      <lf start="2" span="1" word="turn" lemma="turn" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/PP" />
      <rule type="fa" cat="PP">
       <lf start="3" span="1" word="on" lemma="on" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
       <rule type="fa" cat="NP">
        <lf start="4" span="1" word="all" lemma="all" pos="PDT" chunk="I-NP" entity="O" cat="NP/NP" />
        <rule type="fa" cat="NP[nb]">
         <lf start="5" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <lf start="6" span="1" word="bulbs" lemma="bulb" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="lex" cat="S[X]\S[X]">
    <rule type="lp" cat="S[dcl]">
     <lf start="7" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
     <rule type="fa" cat="S[dcl]">
      <lf start="8" span="1" word="then" lemma="then" pos="RB" chunk="O" entity="O" cat="S/S" />
      <rule type="ba" cat="S[dcl]">
       <lf start="9" span="1" word="you" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
       <rule type="fa" cat="S[dcl]\NP">
        <rule type="bx" cat="(S[dcl]\NP)/NP">
         <lf start="10" span="1" word="turn" lemma="turn" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
         <lf start="11" span="1" word="off" lemma="off" pos="RP" chunk="I-PRT" entity="O" cat="(S\NP)\(S\NP)" />
        </rule>
        <rule type="fa" cat="NP[nb]">
         <lf start="12" span="1" word="every" lemma="every" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="fa" cat="N">
          <lf start="13" span="1" word="second" lemma="second" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="14" span="1" word="bulb" lemma="bulb" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="15" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
