<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[b]\NP">
  <lf start="0" span="1" word="Return" lemma="return" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
  <rule type="rp" cat="NP">
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP[nb]">
     <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <lf start="2" span="1" word="number" lemma="number" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="3" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
     <rule type="ba" cat="NP">
      <rule type="lex" cat="NP">
       <lf start="4" span="1" word="bulbs" lemma="bulb" pos="NNS" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="5" span="1" word="that" lemma="that" pos="WDT" chunk="B-NP" entity="O" cat="(NP\NP)/(S[dcl]\NP)" />
       <rule type="fa" cat="S[dcl]\NP">
        <lf start="6" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/PP" />
        <rule type="fa" cat="PP">
         <lf start="7" span="1" word="on" lemma="on" pos="IN" chunk="I-PP" entity="O" cat="PP/PP" />
         <rule type="fa" cat="PP">
          <lf start="8" span="1" word="after" lemma="after" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="9" span="1" word="param_n" lemma="param_n" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="10" span="1" word="rounds" lemma="round" pos="NNS" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="11" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
  </rule>
 </rule>
</ccg>
</candc>
