<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="lex" cat="NP">
   <rule type="fa" cat="N">
    <lf start="0" span="1" word="Return" lemma="Return" pos="NNP" chunk="I-NP" entity="I-PER" cat="N/N" />
    <lf start="1" span="1" word="expr_a" lemma="expr_a" pos="NNP" chunk="I-NP" entity="I-PER" cat="N" />
   </rule>
  </rule>
  <rule type="fa" cat="NP\NP">
   <lf start="2" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="(NP\NP)/S[dcl]" />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <lf start="3" span="1" word="it" lemma="it" pos="PRP" chunk="I-NP" entity="O" cat="NP[expl]" />
     <rule type="fa" cat="S[dcl]\NP[expl]">
      <rule type="fa" cat="(S[dcl]\NP[expl])/S[em]">
       <lf start="4" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="((S[dcl]\NP[expl])/S[em])/(S[adj]\NP)" />
       <lf start="5" span="1" word="possible" lemma="possible" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
      </rule>
      <rule type="fa" cat="S[em]">
       <lf start="6" span="1" word="that" lemma="that" pos="IN" chunk="I-SBAR" entity="O" cat="S[em]/S[dcl]" />
       <rule type="ba" cat="S[dcl]">
        <lf start="7" span="1" word="it" lemma="it" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
        <rule type="ba" cat="S[dcl]\NP">
         <rule type="rp" cat="S[dcl]\NP">
          <rule type="fa" cat="S[dcl]\NP">
           <lf start="8" span="1" word="was" lemma="be" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
           <rule type="fa" cat="NP[nb]">
            <lf start="9" span="1" word="your" lemma="your" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
            <rule type="fa" cat="N">
             <lf start="10" span="1" word="friends" lemma="friend" pos="NNS" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="11" span="1" word="name" lemma="name" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
          <lf start="12" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
         </rule>
         <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
          <rule type="fa" cat="((S[X]\NP)\(S[X]\NP))/(S[ng]\NP)">
           <lf start="13" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="(((S\NP)\(S\NP))/(S[ng]\NP))/NP" />
           <rule type="ba" cat="NP">
            <rule type="lex" cat="NP">
             <lf start="14" span="1" word="characters" lemma="character" pos="NNS" chunk="I-NP" entity="O" cat="N" />
            </rule>
            <rule type="rp" cat="NP\NP">
             <rule type="fa" cat="NP\NP">
              <lf start="15" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
              <rule type="lex" cat="NP">
               <rule type="fa" cat="N">
                <lf start="16" span="1" word="possibly" lemma="possibly" pos="RB" chunk="I-ADVP" entity="O" cat="N/N" />
                <lf start="17" span="1" word="none" lemma="none" pos="NN" chunk="I-NP" entity="O" cat="N" />
               </rule>
              </rule>
             </rule>
             <lf start="18" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
            </rule>
           </rule>
          </rule>
          <rule type="fa" cat="S[ng]\NP">
           <rule type="bx" cat="(S[ng]\NP)/(S[pss]\NP)">
            <lf start="19" span="1" word="being" lemma="be" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/(S[pss]\NP)" />
            <lf start="20" span="1" word="long" lemma="long" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)\(S\NP)" />
           </rule>
           <lf start="21" span="1" word="pressed" lemma="press" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="22" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
