<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <rule type="ba" cat="NP">
     <rule type="lex" cat="NP">
      <lf start="0" span="1" word="Explanation" lemma="explanation" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="fa" cat="NP\NP">
      <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
      <rule type="lex" cat="NP">
       <lf start="2" span="1" word="strx_a" lemma="strx_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="3" span="1" word="must" lemma="must" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
     <rule type="fa" cat="S[b]\NP">
      <lf start="4" span="1" word="have" lemma="have" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/(S[pt]\NP)" />
      <rule type="fa" cat="S[pt]\NP">
       <lf start="5" span="1" word="been" lemma="be" pos="VBN" chunk="I-VP" entity="O" cat="(S[pt]\NP)/(S[pss]\NP)" />
       <rule type="ba" cat="S[pss]\NP">
        <lf start="6" span="1" word="pressed" lemma="press" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
        <lf start="7" span="1" word="twice" lemma="twice" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="conj" cat="S[dcl]\S[dcl]">
    <lf start="8" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    <rule type="conj" cat="S[dcl]\S[dcl]">
     <lf start="9" span="1" word="but" lemma="but" pos="CC" chunk="O" entity="O" cat="conj" />
     <rule type="ba" cat="S[dcl]">
      <lf start="10" span="1" word="it" lemma="it" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
      <rule type="fa" cat="S[dcl]\NP">
       <rule type="bx" cat="(S[dcl]\NP)/PP">
        <lf start="11" span="1" word="was" lemma="be" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/PP" />
        <lf start="12" span="1" word="not" lemma="not" pos="RB" chunk="O" entity="O" cat="(S\NP)\(S\NP)" />
       </rule>
       <rule type="fa" cat="PP">
        <lf start="13" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
        <rule type="fa" cat="NP[nb]">
         <lf start="14" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="fa" cat="N">
          <lf start="15" span="1" word="typed" lemma="typed" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="16" span="1" word="output" lemma="output" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="17" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
