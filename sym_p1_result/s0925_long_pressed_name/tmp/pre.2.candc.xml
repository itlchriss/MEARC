<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="S[dcl]">
    <lf start="0" span="1" word="Sometimes" lemma="sometimes" pos="RB" chunk="I-ADVP" entity="O" cat="S/S" />
    <rule type="lp" cat="S[dcl]">
     <lf start="1" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
     <rule type="fa" cat="S[dcl]">
      <rule type="fa" cat="S[X]/S[X]">
       <lf start="2" span="1" word="when" lemma="when" pos="WRB" chunk="I-ADVP" entity="O" cat="(S/S)/(S[ng]\NP)" />
       <rule type="fa" cat="S[ng]\NP">
        <lf start="3" span="1" word="typing" lemma="type" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
        <rule type="fa" cat="NP[nb]">
         <lf start="4" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="fa" cat="N">
          <lf start="5" span="1" word="character" lemma="character" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="6" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
      <rule type="lp" cat="S[dcl]">
       <lf start="7" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
       <rule type="ba" cat="S[dcl]">
        <rule type="fa" cat="NP[nb]">
         <lf start="8" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <lf start="9" span="1" word="key" lemma="key" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="10" span="1" word="might" lemma="might" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
         <rule type="fa" cat="S[b]\NP">
          <lf start="11" span="1" word="get" lemma="get" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/(S[adj]\NP)" />
          <rule type="fa" cat="S[adj]\NP">
           <lf start="12" span="1" word="long" lemma="long" pos="RB" chunk="I-VP" entity="O" cat="(S[adj]\NP)/(S[adj]\NP)" />
           <lf start="13" span="1" word="pressed" lemma="press" pos="VBN" chunk="I-VP" entity="O" cat="S[adj]\NP" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="conj" cat="S[dcl]\S[dcl]">
    <lf start="14" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    <rule type="conj" cat="S[dcl]\S[dcl]">
     <lf start="15" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
     <rule type="ba" cat="S[dcl]">
      <rule type="fa" cat="NP[nb]">
       <lf start="16" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <lf start="17" span="1" word="character" lemma="character" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="18" span="1" word="will" lemma="will" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
       <rule type="fa" cat="S[b]\NP">
        <lf start="19" span="1" word="be" lemma="be" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/(S[pss]\NP)" />
        <rule type="fa" cat="S[pss]\NP">
         <lf start="20" span="1" word="typed" lemma="type" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/NP" />
         <rule type="lex" cat="NP">
          <rule type="fa" cat="N">
           <rule type="ba" cat="N/N">
            <lf start="21" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
            <rule type="conj" cat="(N/N)\(N/N)">
             <lf start="22" span="1" word="or" lemma="or" pos="CC" chunk="I-NP" entity="O" cat="conj" />
             <lf start="23" span="1" word="more" lemma="more" pos="JJR" chunk="I-NP" entity="O" cat="N/N" />
            </rule>
           </rule>
           <lf start="24" span="1" word="times" lemma="time" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="25" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
