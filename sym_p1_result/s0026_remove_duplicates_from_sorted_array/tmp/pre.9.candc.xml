<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <lf start="0" span="1" word="It" lemma="it" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
   <rule type="fa" cat="S[dcl]\NP">
    <rule type="bx" cat="(S[dcl]\NP)/(S[b]\NP)">
     <lf start="1" span="1" word="does" lemma="do" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
     <lf start="2" span="1" word="not" lemma="not" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)\(S\NP)" />
    </rule>
    <rule type="ba" cat="S[b]\NP">
     <rule type="fa" cat="S[b]\NP">
      <lf start="3" span="1" word="matter" lemma="matter" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/S[qem]" />
      <rule type="fa" cat="S[qem]">
       <lf start="4" span="1" word="what" lemma="what" pos="WP" chunk="I-NP" entity="O" cat="S[qem]/(S[dcl]/NP)" />
       <rule type="fc" cat="S[dcl]/NP">
        <rule type="tr" cat="S[X]/(S[X]\NP)">
         <lf start="5" span="1" word="you" lemma="you" pos="PRP" chunk="B-NP" entity="O" cat="NP" />
        </rule>
        <lf start="6" span="1" word="leave" lemma="leave" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
       </rule>
      </rule>
     </rule>
     <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
      <lf start="7" span="1" word="beyond" lemma="beyond" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
      <rule type="fa" cat="NP[nb]">
       <lf start="8" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <rule type="fa" cat="N">
        <lf start="9" span="1" word="first" lemma="first" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
        <rule type="fa" cat="N">
         <lf start="10" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="11" span="1" word="elements" lemma="element" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="12" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
