<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <lf start="0" span="1" word="It" lemma="it" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
   <rule type="fa" cat="S[dcl]\NP">
    <rule type="bx" cat="(S[dcl]\NP)/(S[b]\NP)">
     <lf start="1" span="1" word="does" lemma="do" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
     <lf start="2" span="1" word="not" lemma="not" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)\(S\NP)" />
    </rule>
    <lf start="3" span="1" word="matter" lemma="matter" pos="VB" chunk="I-VP" entity="O" cat="S[b]\NP" />
   </rule>
  </rule>
  <rule type="lex" cat="S[X]\S[X]">
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <rule type="ba" cat="S[dcl]">
      <rule type="fa" cat="NP">
       <lf start="4" span="1" word="what" lemma="what" pos="WP" chunk="I-NP" entity="O" cat="NP/(S[dcl]/NP)" />
       <rule type="fc" cat="S[dcl]/NP">
        <rule type="tr" cat="S[X]/(S[X]\NP)">
         <lf start="5" span="1" word="you" lemma="you" pos="PRP" chunk="B-NP" entity="O" cat="NP" />
        </rule>
        <rule type="bx" cat="(S[dcl]\NP)/NP">
         <lf start="6" span="1" word="leave" lemma="leave" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
         <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
          <lf start="7" span="1" word="beyond" lemma="beyond" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
          <rule type="fa" cat="NP">
           <lf start="8" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP/NP" />
           <rule type="fa" cat="NP[nb]">
            <lf start="9" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
            <lf start="10" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="11" span="1" word="ised" lemma="ise" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
       <rule type="lex" cat="NP">
        <lf start="12" span="1" word="k" lemma="k" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
     <rule type="rp" cat="S[X]\S[X]">
      <rule type="fa" cat="S[X]\S[X]">
       <lf start="13" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(S\S)/S[dcl]" />
       <rule type="fa" cat="S[dcl]">
        <lf start="14" span="1" word="hence" lemma="hence" pos="RB" chunk="I-ADVP" entity="O" cat="S/S" />
        <rule type="ba" cat="S[dcl]">
         <lf start="15" span="1" word="they" lemma="they" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
         <rule type="fa" cat="S[dcl]\NP">
          <lf start="16" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
          <rule type="lex" cat="NP">
           <lf start="17" span="1" word="underscores" lemma="underscore" pos="NNS" chunk="I-VP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
      <lf start="18" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
     </rule>
    </rule>
    <lf start="19" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
