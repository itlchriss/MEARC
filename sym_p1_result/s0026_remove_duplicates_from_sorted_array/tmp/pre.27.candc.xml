<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="rp" cat="NP">
    <rule type="ba" cat="NP">
     <rule type="lex" cat="NP">
      <lf start="0" span="1" word="Output" lemma="output" pos="NN" chunk="I-NP" entity="I-TIM" cat="N" />
     </rule>
     <rule type="fa" cat="NP\NP">
      <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="I-TIM" cat="(NP\NP)/NP" />
      <rule type="lex" cat="NP">
       <lf start="2" span="1" word="5" lemma="5" pos="CD" chunk="I-NP" entity="I-TIM" cat="N" />
      </rule>
     </rule>
    </rule>
    <lf start="3" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="4" span="1" word="nums" lemma="num" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
    <rule type="ba" cat="NP">
     <rule type="lex" cat="NP">
      <rule type="fa" cat="N">
       <lf start="5" span="1" word="=" lemma="=" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="ba" cat="N">
        <rule type="rp" cat="N">
         <rule type="ba" cat="N">
          <rule type="rp" cat="N">
           <rule type="ba" cat="N">
            <rule type="rp" cat="N">
             <rule type="ba" cat="N">
              <lf start="6" span="1" word="[" lemma="[" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N" />
              <lf start="7" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="I-DAT" cat="N\N" />
             </rule>
             <lf start="8" span="1" word="," lemma="," pos="," chunk="I-NP" entity="I-DAT" cat="," />
            </rule>
            <lf start="9" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="I-DAT" cat="N\N" />
           </rule>
           <lf start="10" span="1" word="," lemma="," pos="," chunk="I-NP" entity="I-DAT" cat="," />
          </rule>
          <lf start="11" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="I-DAT" cat="N\N" />
         </rule>
         <lf start="12" span="1" word="," lemma="," pos="," chunk="I-NP" entity="I-DAT" cat="," />
        </rule>
        <lf start="13" span="1" word="3" lemma="3" pos="CD" chunk="I-NP" entity="I-DAT" cat="N\N" />
       </rule>
      </rule>
     </rule>
     <rule type="conj" cat="NP\NP">
      <lf start="14" span="1" word="," lemma="," pos="," chunk="I-NP" entity="I-DAT" cat="," />
      <rule type="ba" cat="NP">
       <rule type="rp" cat="NP">
        <rule type="lex" cat="NP">
         <lf start="15" span="1" word="4" lemma="4" pos="CD" chunk="I-NP" entity="I-DAT" cat="N" />
        </rule>
        <lf start="16" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
       </rule>
       <rule type="ba" cat="NP\NP">
        <lf start="17" span="1" word="\" lemma="\" pos="NNP" chunk="I-NP" entity="I-LOC" cat="NP\NP" />
        <rule type="conj" cat="(NP\NP)\(NP\NP)">
         <lf start="18" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
         <rule type="ba" cat="NP\NP">
          <lf start="19" span="1" word="\" lemma="\" pos="NNP" chunk="I-NP" entity="I-LOC" cat="NP\NP" />
          <rule type="conj" cat="(NP\NP)\(NP\NP)">
           <lf start="20" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
           <rule type="ba" cat="NP\NP">
            <lf start="21" span="1" word="\" lemma="\" pos="NNP" chunk="I-NP" entity="I-LOC" cat="NP\NP" />
            <rule type="conj" cat="(NP\NP)\(NP\NP)">
             <lf start="22" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
             <rule type="ba" cat="NP\NP">
              <lf start="23" span="1" word="\" lemma="\" pos="NNP" chunk="I-NP" entity="I-LOC" cat="NP\NP" />
              <rule type="conj" cat="(NP\NP)\(NP\NP)">
               <lf start="24" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
               <rule type="fa" cat="NP\NP">
                <lf start="25" span="1" word="\" lemma="\" pos="NNP" chunk="I-NP" entity="I-LOC" cat="(NP\NP)/(NP\NP)" />
                <lf start="26" span="1" word="]" lemma="]" pos="NNP" chunk="I-NP" entity="I-LOC" cat="NP\NP" />
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="27" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
