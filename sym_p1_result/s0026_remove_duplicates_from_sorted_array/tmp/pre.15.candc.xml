<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="lex" cat="NP">
    <rule type="fa" cat="N">
     <lf start="0" span="1" word="int" lemma="int" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
     <lf start="1" span="1" word="[" lemma="[" pos="NNS" chunk="I-NP" entity="O" cat="N" />
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <rule type="fa" cat="(S[dcl]\NP)/NP">
     <lf start="2" span="1" word="]" lemma="]" pos="VBP" chunk="I-VP" entity="O" cat="((S[dcl]\NP)/NP)/NP" />
     <rule type="ba" cat="NP">
      <rule type="lex" cat="NP">
       <rule type="fa" cat="N">
        <lf start="3" span="1" word="expectedNums" lemma="expectedNums" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
        <rule type="fa" cat="N">
         <lf start="4" span="1" word="=" lemma="=" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="5" span="1" word="[" lemma="[" pos="NNP" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
      <rule type="lp" cat="NP\NP">
       <lf start="6" span="1" word="..." lemma="..." pos=":" chunk="O" entity="O" cat=":" />
       <rule type="fa" cat="NP\NP">
        <lf start="7" span="1" word="]" lemma="]" pos="NNP" chunk="I-NP" entity="O" cat="(NP\NP)/NP" />
        <rule type="lp" cat="NP">
         <lf start="8" span="1" word=";" lemma=";" pos=";" chunk="O" entity="O" cat=";" />
         <rule type="lex" cat="NP">
          <lf start="9" span="1" word="//" lemma="//" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="ba" cat="NP">
     <rule type="fa" cat="NP[nb]">
      <lf start="10" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="fa" cat="N">
       <lf start="11" span="1" word="expected" lemma="expect" pos="VBN" chunk="I-NP" entity="O" cat="N/N" />
       <lf start="12" span="1" word="answer" lemma="answer" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
     <rule type="fa" cat="NP\NP">
      <lf start="13" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
      <rule type="lex" cat="NP">
       <rule type="fa" cat="N">
        <lf start="14" span="1" word="correct" lemma="correct" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="15" span="1" word="length" lemma="length" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="16" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
