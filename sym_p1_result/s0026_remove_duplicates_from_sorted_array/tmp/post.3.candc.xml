<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="lex" cat="NP">
     <lf start="0" span="1" word="Explanation" lemma="explanation" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
     <rule type="fa" cat="NP[nb]">
      <lf start="2" span="1" word="Your" lemma="your" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="3" span="1" word="function" lemma="function" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
   <lf start="4" span="1" word="should" lemma="should" pos="MD" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
  </rule>
  <rule type="lex" cat="S[X]\S[X]">
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <rule type="fa" cat="NP[nb]">
      <lf start="5" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="6" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="ba" cat="S[dcl]\NP">
      <rule type="rp" cat="S[dcl]\NP">
       <rule type="fa" cat="S[dcl]\NP">
        <lf start="7" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
        <rule type="lex" cat="NP">
         <rule type="fa" cat="N">
          <lf start="8" span="1" word="k" lemma="k" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <rule type="ba" cat="N">
           <lf start="9" span="1" word="=" lemma="=" pos="NN" chunk="I-NP" entity="O" cat="N" />
           <lf start="10" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N\N" />
          </rule>
         </rule>
        </rule>
       </rule>
       <lf start="11" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
      </rule>
      <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
       <rule type="fa" cat="((S[X]\NP)\(S[X]\NP))/(S[ng]\NP)">
        <lf start="12" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="(((S\NP)\(S\NP))/(S[ng]\NP))/NP" />
        <rule type="ba" cat="NP">
         <rule type="fa" cat="NP[nb]">
          <lf start="13" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <rule type="fa" cat="N">
           <lf start="14" span="1" word="first" lemma="first" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
           <rule type="fa" cat="N">
            <lf start="15" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="16" span="1" word="elements" lemma="element" pos="NNS" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
         <rule type="fa" cat="NP\NP">
          <lf start="17" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
          <rule type="lex" cat="NP">
           <lf start="18" span="1" word="nums" lemma="num" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
       <rule type="ba" cat="S[ng]\NP">
        <rule type="fa" cat="S[ng]\NP">
         <lf start="19" span="1" word="being" lemma="be" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
         <rule type="lex" cat="NP">
          <rule type="ba" cat="N">
           <lf start="20" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N" />
           <rule type="conj" cat="N\N">
            <lf start="21" span="1" word="and" lemma="and" pos="CC" chunk="I-NP" entity="O" cat="conj" />
            <lf start="22" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
        <lf start="23" span="1" word="respectively" lemma="respectively" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="24" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
