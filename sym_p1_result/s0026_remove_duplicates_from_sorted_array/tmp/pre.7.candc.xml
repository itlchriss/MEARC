<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[b]">
  <rule type="fa" cat="S[X]/S[X]">
   <lf start="0" span="1" word="Given" lemma="Give" pos="VBN" chunk="I-PP" entity="O" cat="(S/S)/NP" />
   <rule type="fa" cat="NP[nb]">
    <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <lf start="2" span="1" word="_type_integer" lemma="_type_integer" pos="NN" chunk="I-NP" entity="O" cat="N" />
   </rule>
  </rule>
  <rule type="rp" cat="S[b]">
   <rule type="ba" cat="S[b]">
    <rule type="rp" cat="NP">
     <rule type="ba" cat="NP">
      <rule type="lex" cat="NP">
       <rule type="fa" cat="N">
        <lf start="3" span="1" word="array" lemma="array" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="4" span="1" word="param_nums" lemma="param_nums" pos="NNS" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
      <rule type="lex" cat="NP\NP">
       <rule type="ba" cat="S[pss]\NP">
        <lf start="5" span="1" word="sorted" lemma="sort" pos="VBD" chunk="I-VP" entity="O" cat="S[pss]\NP" />
        <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
         <lf start="6" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
         <rule type="lex" cat="NP">
          <lf start="7" span="1" word="ascending_order" lemma="ascending_order" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
     <lf start="8" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    </rule>
    <rule type="fa" cat="S[b]\NP">
     <lf start="9" span="1" word="remove" lemma="remove" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
     <rule type="ba" cat="NP">
      <rule type="fa" cat="NP[nb]">
       <lf start="10" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <lf start="11" span="1" word="duplicates" lemma="duplicate" pos="NNS" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="lex" cat="NP\NP">
       <rule type="fa" cat="S[dcl]\NP">
        <lf start="12" span="1" word="[" lemma="[" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
        <rule type="ba" cat="NP">
         <rule type="ba" cat="NP">
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="13" span="1" word="in-place" lemma="in-place" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="14" span="1" word="]" lemma="]" pos="NNS" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
          <rule type="rp" cat="NP\NP">
           <rule type="fa" cat="NP\NP">
            <lf start="15" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
            <rule type="ba" cat="NP">
             <rule type="lex" cat="NP">
              <lf start="16" span="1" word="https" lemma="http" pos="NNS" chunk="I-NP" entity="O" cat="N" />
             </rule>
             <rule type="fa" cat="NP\NP">
              <lf start="17" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
              <rule type="lex" cat="NP">
               <lf start="18" span="1" word="//en.wikipedia.org/wiki/In-placealgorithm" lemma="//en.wikipedia.org/wiki/In-placealgorithm" pos="NNP" chunk="I-NP" entity="I-LOC" cat="N" />
              </rule>
             </rule>
            </rule>
           </rule>
           <lf start="19" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
          </rule>
         </rule>
         <rule type="lex" cat="NP\NP">
          <rule type="fa" cat="S[adj]\NP">
           <lf start="20" span="1" word="such" lemma="such" pos="JJ" chunk="I-PP" entity="O" cat="(S[adj]\NP)/S[em]" />
           <rule type="fa" cat="S[em]">
            <lf start="21" span="1" word="that" lemma="that" pos="IN" chunk="I-SBAR" entity="O" cat="S[em]/S[dcl]" />
            <rule type="ba" cat="S[dcl]">
             <rule type="fa" cat="NP[nb]">
              <lf start="22" span="1" word="each" lemma="each" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
              <rule type="fa" cat="N">
               <lf start="23" span="1" word="unique" lemma="unique" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
               <lf start="24" span="1" word="element" lemma="element" pos="NN" chunk="I-NP" entity="O" cat="N" />
              </rule>
             </rule>
             <rule type="ba" cat="S[dcl]\NP">
              <lf start="25" span="1" word="appears" lemma="appear" pos="VBZ" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
              <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
               <lf start="26" span="1" word="only" lemma="only" pos="RB" chunk="I-ADVP" entity="O" cat="((S\NP)\(S\NP))/((S\NP)\(S\NP))" />
               <lf start="27" span="1" word="once" lemma="once" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="28" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
  </rule>
 </rule>
</ccg>
</candc>
