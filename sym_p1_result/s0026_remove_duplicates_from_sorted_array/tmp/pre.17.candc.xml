<candc>
<ccg>
 <rule type="rp" cat="NP">
  <rule type="rp" cat="NP">
   <rule type="lex" cat="NP">
    <rule type="fa" cat="N">
     <lf start="0" span="1" word="assert" lemma="assert" pos="JJ" chunk="I-VP" entity="O" cat="N/N" />
     <rule type="fa" cat="N">
      <lf start="1" span="1" word="k" lemma="k" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
      <rule type="fa" cat="N">
       <lf start="2" span="1" word="==" lemma="==" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <lf start="3" span="1" word="expectedNums.length" lemma="expectedNums.length" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="4" span="1" word=";" lemma=";" pos=";" chunk="O" entity="O" cat=";" />
  </rule>
  <lf start="5" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
