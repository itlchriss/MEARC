<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="Its" lemma="its" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <rule type="fa" cat="N">
     <lf start="1" span="1" word="maximum" lemma="maximum" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
     <rule type="fa" cat="N">
      <lf start="2" span="1" word="jump" lemma="jump" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
      <lf start="3" span="1" word="length" lemma="length" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="4" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
    <rule type="ba" cat="NP">
     <rule type="lex" cat="NP">
      <lf start="5" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="lp" cat="NP\NP">
      <lf start="6" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
      <rule type="fa" cat="NP\NP">
       <lf start="7" span="1" word="which" lemma="which" pos="WDT" chunk="I-NP" entity="O" cat="(NP\NP)/(S[dcl]\NP)" />
       <rule type="fa" cat="S[dcl]\NP">
        <rule type="fa" cat="(S[dcl]\NP)/(S[to]\NP)">
         <rule type="fa" cat="((S[dcl]\NP)/(S[to]\NP))/(S[adj]\NP)">
          <lf start="8" span="1" word="makes" lemma="make" pos="VBZ" chunk="I-VP" entity="O" cat="(((S[dcl]\NP)/(S[to]\NP))/(S[adj]\NP))/NP[expl]" />
          <lf start="9" span="1" word="it" lemma="it" pos="PRP" chunk="I-NP" entity="O" cat="NP[expl]" />
         </rule>
         <lf start="10" span="1" word="impossible" lemma="impossible" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
        </rule>
        <rule type="fa" cat="S[to]\NP">
         <lf start="11" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
         <rule type="fa" cat="S[b]\NP">
          <lf start="12" span="1" word="reach" lemma="reach" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
          <rule type="fa" cat="NP[nb]">
           <lf start="13" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
           <rule type="fa" cat="N">
            <lf start="14" span="1" word="last" lemma="last" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="15" span="1" word="index" lemma="index" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="16" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
