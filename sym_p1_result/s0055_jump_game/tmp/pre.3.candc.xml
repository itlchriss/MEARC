<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="lex" cat="NP">
   <rule type="fa" cat="N">
    <lf start="0" span="1" word="Return" lemma="Return" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
    <lf start="1" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
   </rule>
  </rule>
  <rule type="fa" cat="NP\NP">
   <lf start="2" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="(NP\NP)/S[dcl]" />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <lf start="3" span="1" word="you" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="4" span="1" word="can" lemma="can" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
      <rule type="ba" cat="S[b]\NP">
       <rule type="fa" cat="S[b]\NP">
        <lf start="5" span="1" word="reach" lemma="reach" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
        <rule type="ba" cat="NP[nb]">
         <rule type="fa" cat="NP[nb]">
          <lf start="6" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <rule type="fa" cat="N">
           <lf start="7" span="1" word="last" lemma="last" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
           <lf start="8" span="1" word="index" lemma="index" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
         <rule type="conj" cat="NP[nb]\NP[nb]">
          <lf start="9" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
          <rule type="conj" cat="NP[nb]\NP[nb]">
           <lf start="10" span="1" word="or" lemma="or" pos="CC" chunk="O" entity="O" cat="conj" />
           <rule type="fa" cat="NP[nb]">
            <lf start="11" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
            <lf start="12" span="1" word="expr_b" lemma="expr_b" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
       <lf start="13" span="1" word="otherwise" lemma="otherwise" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
      </rule>
     </rule>
    </rule>
    <lf start="14" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
