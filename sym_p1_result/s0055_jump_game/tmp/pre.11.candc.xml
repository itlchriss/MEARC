<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="lex" cat="NP">
   <lf start="0" span="1" word="Explanation" lemma="explanation" pos="NN" chunk="I-NP" entity="O" cat="N" />
  </rule>
  <rule type="fa" cat="NP\NP">
   <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/S[dcl]" />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <lf start="2" span="1" word="You" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
     <rule type="fa" cat="S[dcl]\NP">
      <rule type="bx" cat="(S[dcl]\NP)/(S[b]\NP)">
       <lf start="3" span="1" word="will" lemma="will" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
       <lf start="4" span="1" word="always" lemma="always" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)\(S\NP)" />
      </rule>
      <rule type="fa" cat="S[b]\NP">
       <lf start="5" span="1" word="arrive" lemma="arrive" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/PP" />
       <rule type="fa" cat="PP">
        <lf start="6" span="1" word="at" lemma="at" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
        <rule type="ba" cat="NP">
         <rule type="lex" cat="NP">
          <rule type="ba" cat="N">
           <lf start="7" span="1" word="index" lemma="index" pos="NN" chunk="I-NP" entity="O" cat="N" />
           <lf start="8" span="1" word="3" lemma="3" pos="CD" chunk="B-NP" entity="O" cat="N\N" />
          </rule>
         </rule>
         <rule type="fa" cat="NP\NP">
          <lf start="9" span="1" word="no" lemma="no" pos="DT" chunk="B-NP" entity="O" cat="(NP\NP)/N" />
          <rule type="fa" cat="N">
           <lf start="10" span="1" word="matter" lemma="matter" pos="NN" chunk="I-NP" entity="O" cat="N/NP" />
           <rule type="lex" cat="NP">
            <lf start="11" span="1" word="what" lemma="what" pos="WP" chunk="B-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="12" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
