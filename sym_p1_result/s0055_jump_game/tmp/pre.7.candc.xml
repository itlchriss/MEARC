<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="NP">
  <rule type="ba" cat="NP">
   <rule type="lex" cat="NP">
    <lf start="0" span="1" word="Explanation" lemma="explanation" pos="NN" chunk="I-NP" entity="O" cat="N" />
   </rule>
   <rule type="fa" cat="NP\NP">
    <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
    <rule type="ba" cat="NP">
     <rule type="ba" cat="NP">
      <rule type="lex" cat="NP">
       <rule type="fa" cat="N">
        <lf start="2" span="1" word="Jump" lemma="Jump" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
        <rule type="fa" cat="N">
         <lf start="3" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="4" span="1" word="step" lemma="step" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="5" span="1" word="from" lemma="from" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <lf start="6" span="1" word="index" lemma="index" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="ba" cat="NP\NP">
         <lf start="7" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="O" cat="NP\NP" />
         <rule type="fa" cat="(NP\NP)\(NP\NP)">
          <lf start="8" span="1" word="to" lemma="to" pos="TO" chunk="I-NP" entity="O" cat="((NP\NP)\(NP\NP))/NP" />
          <rule type="lex" cat="NP">
           <lf start="9" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
     <rule type="conj" cat="NP\NP">
      <lf start="10" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
      <rule type="ba" cat="NP">
       <rule type="lex" cat="NP">
        <rule type="fa" cat="N">
         <lf start="11" span="1" word="then" lemma="then" pos="RB" chunk="I-ADVP" entity="O" cat="N/N" />
         <rule type="fa" cat="N">
          <lf start="12" span="1" word="3" lemma="3" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="13" span="1" word="steps" lemma="step" pos="NNS" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
       <rule type="fa" cat="NP\NP">
        <lf start="14" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
        <rule type="fa" cat="NP[nb]">
         <lf start="15" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="fa" cat="N">
          <lf start="16" span="1" word="last" lemma="last" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="17" span="1" word="index" lemma="index" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="18" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
