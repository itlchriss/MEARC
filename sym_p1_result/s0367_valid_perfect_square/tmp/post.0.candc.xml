<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[b]">
  <rule type="lex" cat="S[X]/S[X]">
   <lf start="0" span="1" word="Given" lemma="Give" pos="VBN" chunk="I-PP" entity="O" cat="S[pss]\NP" />
  </rule>
  <rule type="ba" cat="S[b]">
   <rule type="fa" cat="NP[nb]">
    <lf start="1" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <rule type="fa" cat="N">
     <lf start="2" span="1" word="positive" lemma="positive" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
     <rule type="fa" cat="N">
      <lf start="3" span="1" word="integer" lemma="integer" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
      <lf start="4" span="1" word="num" lemma="num" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
   <rule type="lp" cat="S[b]\NP">
    <lf start="5" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    <rule type="fa" cat="S[b]\NP">
     <lf start="6" span="1" word="write" lemma="write" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
     <rule type="ba" cat="NP">
      <rule type="fa" cat="NP[nb]">
       <lf start="7" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <lf start="8" span="1" word="function" lemma="function" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="9" span="1" word="which" lemma="which" pos="WDT" chunk="B-NP" entity="O" cat="(NP\NP)/S[dcl]" />
       <rule type="rp" cat="S[dcl]">
        <rule type="ba" cat="S[dcl]">
         <rule type="fa" cat="NP[nb]">
          <lf start="10" span="1" word="the" lemma="the" pos="DT" chunk="B-NP" entity="O" cat="NP[nb]/N" />
          <lf start="11" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
         <rule type="ba" cat="S[dcl]\NP">
          <rule type="fa" cat="S[dcl]\NP">
           <lf start="12" span="1" word="iss" lemma="iss" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
           <lf start="13" span="1" word="True" lemma="true" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
          </rule>
          <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
           <lf start="14" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
           <rule type="ba" cat="S[dcl]">
            <rule type="lex" cat="NP">
             <lf start="15" span="1" word="num" lemma="num" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
            <rule type="fa" cat="S[dcl]\NP">
             <lf start="16" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
             <rule type="ba" cat="NP">
              <rule type="fa" cat="NP[nb]">
               <lf start="17" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
               <rule type="fa" cat="N">
                <lf start="18" span="1" word="perfect" lemma="perfect" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                <lf start="19" span="1" word="square" lemma="square" pos="NN" chunk="I-NP" entity="O" cat="N" />
               </rule>
              </rule>
              <rule type="ba" cat="NP\NP">
               <lf start="20" span="1" word="else" lemma="else" pos="RB" chunk="I-NP" entity="O" cat="NP\NP" />
               <lf start="21" span="1" word="False" lemma="False" pos="NNP" chunk="I-NP" entity="O" cat="(NP\NP)\(NP\NP)" />
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
        <lf start="22" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
