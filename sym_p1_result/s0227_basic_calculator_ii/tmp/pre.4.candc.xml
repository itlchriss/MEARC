<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="lex" cat="NP">
   <lf start="0" span="1" word="Note" lemma="note" pos="VB" chunk="I-VP" entity="O" cat="N" />
  </rule>
  <rule type="fa" cat="NP\NP">
   <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/S[dcl]" />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <lf start="2" span="1" word="You" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
     <rule type="fa" cat="S[dcl]\NP">
      <rule type="bx" cat="(S[dcl]\NP)/(S[pss]\NP)">
       <lf start="3" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
       <lf start="4" span="1" word="not" lemma="not" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)\(S\NP)" />
      </rule>
      <rule type="fa" cat="S[pss]\NP">
       <lf start="5" span="1" word="allowed" lemma="allow" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/(S[to]\NP)" />
       <rule type="fa" cat="S[to]\NP">
        <lf start="6" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
        <rule type="fa" cat="S[b]\NP">
         <lf start="7" span="1" word="use" lemma="use" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
         <rule type="ba" cat="NP">
          <rule type="fa" cat="NP[nb]">
           <lf start="8" span="1" word="any" lemma="any" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
           <rule type="fa" cat="N">
            <lf start="9" span="1" word="built-in" lemma="built-in" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="10" span="1" word="function" lemma="function" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
          <rule type="fa" cat="NP\NP">
           <lf start="11" span="1" word="which" lemma="which" pos="WDT" chunk="B-NP" entity="O" cat="(NP\NP)/(S[dcl]\NP)" />
           <rule type="fa" cat="S[dcl]\NP">
            <rule type="fa" cat="(S[dcl]\NP)/PP">
             <lf start="12" span="1" word="evaluates" lemma="evaluate" pos="VBZ" chunk="I-VP" entity="O" cat="((S[dcl]\NP)/PP)/NP" />
             <rule type="lex" cat="NP">
              <lf start="13" span="1" word="strings" lemma="string" pos="NNS" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
            <rule type="fa" cat="PP">
             <lf start="14" span="1" word="as" lemma="as" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
             <rule type="ba" cat="NP">
              <rule type="rp" cat="NP">
               <rule type="lex" cat="NP">
                <rule type="fa" cat="N">
                 <lf start="15" span="1" word="mathematical" lemma="mathematical" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                 <lf start="16" span="1" word="expressions" lemma="expression" pos="NNS" chunk="I-NP" entity="O" cat="N" />
                </rule>
               </rule>
               <lf start="17" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
              </rule>
              <rule type="fa" cat="NP\NP">
               <lf start="18" span="1" word="such" lemma="such" pos="JJ" chunk="I-PP" entity="O" cat="(NP\NP)/(NP\NP)" />
               <rule type="fa" cat="NP\NP">
                <lf start="19" span="1" word="as" lemma="as" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
                <rule type="lex" cat="NP">
                 <lf start="20" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="21" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
