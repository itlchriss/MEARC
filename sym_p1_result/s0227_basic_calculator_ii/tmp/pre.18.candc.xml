<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP">
     <lf start="0" span="1" word="All" lemma="all" pos="PDT" chunk="I-NP" entity="O" cat="NP/NP" />
     <rule type="fa" cat="NP[nb]">
      <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="2" span="1" word="integers" lemma="integer" pos="NNS" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="3" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
     <rule type="fa" cat="NP[nb]">
      <lf start="4" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="5" span="1" word="expression" lemma="expression" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="6" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
    <rule type="ba" cat="NP">
     <rule type="ba" cat="NP">
      <rule type="ba" cat="NP">
       <rule type="lex" cat="NP">
        <rule type="fa" cat="N">
         <lf start="7" span="1" word="non-negative" lemma="non-negative" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="8" span="1" word="integers" lemma="integer" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
       <rule type="fa" cat="NP\NP">
        <lf start="9" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
        <rule type="fa" cat="NP[nb]">
         <lf start="10" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <lf start="11" span="1" word="range" lemma="range" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="12" span="1" word="&lt;" lemma="&lt;" pos="NN" chunk="I-NP" entity="O" cat="(NP\NP)/(NP\NP)" />
       <lf start="13" span="1" word="code" lemma="code" pos="NN" chunk="I-NP" entity="O" cat="NP\NP" />
      </rule>
     </rule>
     <rule type="fa" cat="NP\NP">
      <lf start="14" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="I-PER" cat="(NP\NP)/(NP\NP)" />
      <rule type="fa" cat="NP\NP">
       <lf start="15" span="1" word="arr_a" lemma="arr_a" pos="NNP" chunk="I-NP" entity="I-PER" cat="(NP\NP)/(NP\NP)" />
       <rule type="fa" cat="NP\NP">
        <lf start="16" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="I-PER" cat="(NP\NP)/(NP\NP)" />
        <rule type="fa" cat="NP\NP">
         <lf start="17" span="1" word="/code" lemma="/code" pos="NNP" chunk="I-NP" entity="I-PER" cat="(NP\NP)/(NP\NP)" />
         <lf start="18" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="I-PER" cat="NP\NP" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="19" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
