<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="lex" cat="NP">
   <lf start="0" span="1" word="Explanation" lemma="explanation" pos="NN" chunk="I-NP" entity="O" cat="N" />
  </rule>
  <rule type="fa" cat="NP\NP">
   <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/S[dcl]" />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <lf start="2" span="1" word="There" lemma="there" pos="EX" chunk="I-NP" entity="O" cat="NP[thr]" />
     <rule type="fa" cat="S[dcl]\NP[thr]">
      <lf start="3" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP[thr])/NP" />
      <rule type="ba" cat="NP">
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <rule type="fa" cat="N">
          <lf start="4" span="1" word="4" lemma="4" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
          <rule type="fa" cat="N">
           <lf start="5" span="1" word="1-diff" lemma="1-diff" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
           <lf start="6" span="1" word="pairs" lemma="pair" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="7" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
         <rule type="rp" cat="NP[nb]">
          <rule type="fa" cat="NP[nb]">
           <lf start="8" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
           <lf start="9" span="1" word="array" lemma="array" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
          <lf start="10" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
         </rule>
        </rule>
       </rule>
       <rule type="rp" cat="NP\NP">
        <rule type="ba" cat="NP\NP">
         <rule type="rp" cat="NP\NP">
          <rule type="ba" cat="NP\NP">
           <rule type="rp" cat="NP\NP">
            <rule type="ba" cat="NP\NP">
             <rule type="rp" cat="NP\NP">
              <rule type="fa" cat="NP\NP">
               <lf start="11" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
               <rule type="ba" cat="NP">
                <rule type="lex" cat="NP">
                 <lf start="12" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N" />
                </rule>
                <rule type="conj" cat="NP\NP">
                 <lf start="13" span="1" word="," lemma="," pos="," chunk="I-NP" entity="O" cat="," />
                 <rule type="lex" cat="NP">
                  <lf start="14" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N" />
                 </rule>
                </rule>
               </rule>
              </rule>
              <lf start="15" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
             </rule>
             <rule type="conj" cat="(NP\NP)\(NP\NP)">
              <lf start="16" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
              <rule type="fa" cat="NP\NP">
               <lf start="17" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
               <rule type="ba" cat="NP">
                <rule type="lex" cat="NP">
                 <lf start="18" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N" />
                </rule>
                <rule type="conj" cat="NP\NP">
                 <lf start="19" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
                 <rule type="lex" cat="NP">
                  <lf start="20" span="1" word="3" lemma="3" pos="CD" chunk="I-NP" entity="O" cat="N" />
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
            <lf start="21" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
           </rule>
           <rule type="conj" cat="(NP\NP)\(NP\NP)">
            <lf start="22" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
            <rule type="fa" cat="NP\NP">
             <lf start="23" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
             <rule type="ba" cat="NP">
              <rule type="lex" cat="NP">
               <lf start="24" span="1" word="3" lemma="3" pos="CD" chunk="I-NP" entity="O" cat="N" />
              </rule>
              <rule type="conj" cat="NP\NP">
               <lf start="25" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
               <rule type="lex" cat="NP">
                <lf start="26" span="1" word="4" lemma="4" pos="CD" chunk="I-NP" entity="O" cat="N" />
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
          <lf start="27" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
         </rule>
         <rule type="conj" cat="(NP\NP)\(NP\NP)">
          <lf start="28" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
          <rule type="fa" cat="NP\NP">
           <lf start="29" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
           <rule type="ba" cat="NP">
            <rule type="lex" cat="NP">
             <lf start="30" span="1" word="4" lemma="4" pos="CD" chunk="I-NP" entity="O" cat="N" />
            </rule>
            <rule type="conj" cat="NP\NP">
             <lf start="31" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
             <rule type="lex" cat="NP">
              <lf start="32" span="1" word="5" lemma="5" pos="CD" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
        <lf start="33" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="34" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
