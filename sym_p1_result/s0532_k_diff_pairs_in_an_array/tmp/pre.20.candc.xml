<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="ba" cat="NP">
     <rule type="lex" cat="NP">
      <rule type="fa" cat="N">
       <lf start="0" span="1" word="&lt;" lemma="&lt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="fa" cat="N">
        <lf start="1" span="1" word="code" lemma="code" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="2" span="1" word="&gt;" lemma="&gt;" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
     <rule type="lex" cat="NP\NP">
      <rule type="fc" cat="S[dcl]/NP">
       <rule type="tr" cat="S[X]/(S[X]\NP)">
        <rule type="lex" cat="NP">
         <rule type="fa" cat="N">
          <lf start="3" span="1" word="-10" lemma="-10" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <rule type="fa" cat="N">
           <lf start="4" span="1" word="&lt;" lemma="&lt;" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
           <lf start="5" span="1" word="sup" lemma="sup" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
       <lf start="6" span="1" word="&gt;" lemma="&gt;" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      </rule>
     </rule>
    </rule>
    <rule type="lex" cat="NP\NP">
     <rule type="bx" cat="S[dcl]/NP">
      <rule type="fc" cat="S[dcl]/NP">
       <rule type="tr" cat="S[X]/(S[X]\NP)">
        <rule type="lex" cat="NP">
         <rule type="fa" cat="N">
          <lf start="7" span="1" word="7" lemma="7" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
          <rule type="fa" cat="N">
           <lf start="8" span="1" word="&lt;" lemma="&lt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
           <rule type="fa" cat="N">
            <lf start="9" span="1" word="/sup" lemma="/sup" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="10" span="1" word="&gt;" lemma="&gt;" pos="NNS" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
       <lf start="11" span="1" word="&lt;" lemma="&lt;" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      </rule>
      <rule type="lex" cat="S[X]\S[X]">
       <rule type="ba" cat="S[dcl]">
        <rule type="lex" cat="NP">
         <rule type="fa" cat="N">
          <lf start="12" span="1" word="=" lemma="=" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="13" span="1" word="nums" lemma="num" pos="NNS" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="14" span="1" word="[" lemma="[" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
         <rule type="lex" cat="NP">
          <rule type="fa" cat="N">
           <lf start="15" span="1" word="i" lemma="i" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
           <rule type="fa" cat="N">
            <lf start="16" span="1" word="]" lemma="]" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
            <rule type="fa" cat="N">
             <lf start="17" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
             <rule type="fa" cat="N">
              <lf start="18" span="1" word="=" lemma="=" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
              <rule type="fa" cat="N">
               <lf start="19" span="1" word="10" lemma="10" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
               <rule type="fa" cat="N">
                <lf start="20" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                <lf start="21" span="1" word="sup" lemma="sup" pos="NN" chunk="I-NP" entity="O" cat="N" />
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="22" span="1" word="&gt;" lemma="&gt;" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
    <rule type="ba" cat="NP">
     <rule type="lex" cat="NP">
      <rule type="fa" cat="N">
       <lf start="23" span="1" word="7" lemma="7" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="fa" cat="N">
        <lf start="24" span="1" word="&lt;" lemma="&lt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
        <rule type="fa" cat="N">
         <lf start="25" span="1" word="/sup" lemma="/sup" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="26" span="1" word="&gt;" lemma="&gt;" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
     <rule type="lex" cat="NP\NP">
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="27" span="1" word="&lt;" lemma="&lt;" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
       <rule type="lex" cat="NP">
        <rule type="fa" cat="N">
         <lf start="28" span="1" word="/code" lemma="/code" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="29" span="1" word="&gt;" lemma="&gt;" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="30" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
