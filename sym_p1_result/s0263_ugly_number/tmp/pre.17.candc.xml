<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="lex" cat="NP">
   <lf start="0" span="1" word="Explanation" lemma="explanation" pos="NN" chunk="I-NP" entity="O" cat="N" />
  </rule>
  <rule type="fa" cat="NP\NP">
   <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/S[dcl]" />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <rule type="ba" cat="S[dcl]">
      <rule type="lex" cat="NP">
       <lf start="2" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="3" span="1" word="has" lemma="have" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
       <rule type="fa" cat="NP[nb]">
        <lf start="4" span="1" word="no" lemma="no" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <rule type="fa" cat="N">
         <lf start="5" span="1" word="prime" lemma="prime" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="6" span="1" word="factors" lemma="factor" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
     <rule type="conj" cat="S[dcl]\S[dcl]">
      <lf start="7" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
      <rule type="ba" cat="S[dcl]">
       <rule type="fa" cat="NP">
        <lf start="8" span="1" word="therefore" lemma="therefore" pos="RB" chunk="I-ADVP" entity="O" cat="NP/NP" />
        <rule type="ba" cat="NP">
         <lf start="9" span="1" word="all" lemma="all" pos="DT" chunk="I-NP" entity="O" cat="NP" />
         <rule type="fa" cat="NP\NP">
          <lf start="10" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
          <rule type="fa" cat="NP[nb]">
           <lf start="11" span="1" word="its" lemma="its" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
           <rule type="fa" cat="N">
            <lf start="12" span="1" word="prime" lemma="prime" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="13" span="1" word="factors" lemma="factor" pos="NNS" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
       <rule type="fa" cat="S[dcl]\NP">
        <lf start="14" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
        <rule type="fa" cat="S[pss]\NP">
         <lf start="15" span="1" word="limited" lemma="limit" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/PP" />
         <rule type="fa" cat="PP">
          <lf start="16" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="PP/NP" />
          <rule type="lex" cat="NP">
           <rule type="ba" cat="N">
            <lf start="17" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N" />
            <rule type="conj" cat="N\N">
             <lf start="18" span="1" word="," lemma="," pos="," chunk="I-NP" entity="O" cat="," />
             <rule type="ba" cat="N">
              <lf start="19" span="1" word="3" lemma="3" pos="CD" chunk="I-NP" entity="O" cat="N" />
              <rule type="conj" cat="N\N">
               <lf start="20" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
               <rule type="conj" cat="N\N">
                <lf start="21" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
                <lf start="22" span="1" word="5" lemma="5" pos="CD" chunk="I-NP" entity="O" cat="N" />
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="23" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
