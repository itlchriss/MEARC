<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="PP">
  <rule type="fa" cat="PP">
   <lf start="0" span="1" word="On" lemma="on" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP[nb]">
     <lf start="1" span="1" word="each" lemma="each" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <lf start="2" span="1" word="turn" lemma="turn" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="conj" cat="NP\NP">
     <lf start="3" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
     <rule type="ba" cat="NP">
      <rule type="fa" cat="NP[nb]">
       <lf start="4" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <lf start="5" span="1" word="person" lemma="person" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="fa" cat="NP\NP">
       <rule type="fa" cat="(NP\NP)/(S[dcl]\NP)">
        <lf start="6" span="1" word="whose" lemma="whose" pos="WP$" chunk="B-NP" entity="O" cat="((NP\NP)/(S[dcl]\NP))/N" />
        <rule type="fa" cat="N">
         <lf start="7" span="1" word="turn" lemma="turn" pos="NN" chunk="I-NP" entity="O" cat="N/S[dcl]" />
         <rule type="ba" cat="S[dcl]">
          <lf start="8" span="1" word="it" lemma="it" pos="PRP" chunk="B-NP" entity="O" cat="NP" />
          <lf start="9" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
         </rule>
        </rule>
       </rule>
       <rule type="fa" cat="S[dcl]\NP">
        <lf start="10" span="1" word="will" lemma="will" pos="MD" chunk="B-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
        <rule type="fa" cat="S[b]\NP">
         <rule type="fa" cat="(S[b]\NP)/PP">
          <rule type="fa" cat="((S[b]\NP)/PP)/PP">
           <lf start="11" span="1" word="remove" lemma="remove" pos="VB" chunk="I-VP" entity="O" cat="(((S[b]\NP)/PP)/PP)/NP" />
           <rule type="lex" cat="NP">
            <lf start="12" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N[num]" />
           </rule>
          </rule>
          <rule type="fa" cat="PP">
           <lf start="13" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="PP/NP" />
           <rule type="lex" cat="NP">
            <rule type="fa" cat="N">
             <lf start="14" span="1" word="3" lemma="3" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="15" span="1" word="stones" lemma="stone" pos="NNS" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
         <rule type="fa" cat="PP">
          <lf start="16" span="1" word="from" lemma="from" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
          <rule type="fa" cat="NP[nb]">
           <lf start="17" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
           <lf start="18" span="1" word="heap" lemma="heap" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="19" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
