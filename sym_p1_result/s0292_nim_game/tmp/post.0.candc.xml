<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[dcl]">
  <rule type="rtc" cat="S[X]/S[X]">
   <rule type="ba" cat="NP">
    <rule type="lex" cat="NP">
     <rule type="fa" cat="N">
      <lf start="0" span="1" word="Given" lemma="Give" pos="VBN" chunk="I-VP" entity="O" cat="N/N" />
      <lf start="1" span="1" word="param_n" lemma="param_n" pos="NN" chunk="I-NP" entity="I-ORG" cat="N" />
     </rule>
    </rule>
    <rule type="conj" cat="NP\NP">
     <lf start="2" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
     <rule type="ba" cat="NP">
      <rule type="ba" cat="NP">
       <rule type="fa" cat="NP[nb]">
        <lf start="3" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <lf start="4" span="1" word="number" lemma="number" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
       <rule type="fa" cat="NP\NP">
        <lf start="5" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
        <rule type="lex" cat="NP">
         <lf start="6" span="1" word="stones" lemma="stone" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="7" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
       <rule type="fa" cat="NP[nb]">
        <lf start="8" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <lf start="9" span="1" word="heap" lemma="heap" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="10" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
  </rule>
  <rule type="rp" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <rule type="fa" cat="NP[nb]">
     <lf start="11" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <lf start="12" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="13" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
     <rule type="ba" cat="S[pss]\NP">
      <lf start="14" span="1" word="expr_a" lemma="expr_a" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
      <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
       <lf start="15" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
       <rule type="ba" cat="S[dcl]">
        <rule type="ba" cat="S[dcl]">
         <lf start="16" span="1" word="you" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
         <rule type="fa" cat="S[dcl]\NP">
          <lf start="17" span="1" word="can" lemma="can" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
          <rule type="ba" cat="S[b]\NP">
           <rule type="fa" cat="S[b]\NP">
            <lf start="18" span="1" word="win" lemma="win" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
            <rule type="fa" cat="NP[nb]">
             <lf start="19" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
             <lf start="20" span="1" word="game" lemma="game" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
           <rule type="lex" cat="(S[X]\NP)\(S[X]\NP)">
            <rule type="ba" cat="S[ng]\NP">
             <rule type="fa" cat="S[ng]\NP">
              <lf start="21" span="1" word="assuming" lemma="assume" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
              <rule type="fa" cat="NP">
               <lf start="22" span="1" word="both" lemma="both" pos="DT" chunk="I-NP" entity="O" cat="NP/NP" />
               <rule type="ba" cat="NP[nb]">
                <lf start="23" span="1" word="you" lemma="you" pos="PRP" chunk="B-NP" entity="O" cat="NP" />
                <rule type="conj" cat="NP[nb]\NP[nb]">
                 <lf start="24" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
                 <rule type="fa" cat="NP[nb]">
                  <lf start="25" span="1" word="your" lemma="your" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                  <rule type="fa" cat="N">
                   <lf start="26" span="1" word="friend" lemma="friend" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                   <lf start="27" span="1" word="play" lemma="play" pos="NN" chunk="I-NP" entity="O" cat="N" />
                  </rule>
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
             <lf start="28" span="1" word="optimally" lemma="optimally" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
        <rule type="conj" cat="S[dcl]\S[dcl]">
         <lf start="29" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
         <rule type="fa" cat="S[dcl]">
          <lf start="30" span="1" word="otherwise" lemma="otherwise" pos="RB" chunk="I-ADVP" entity="O" cat="S/S" />
          <rule type="ba" cat="S[dcl]">
           <rule type="fa" cat="NP[nb]">
            <lf start="31" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
            <lf start="32" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
           <rule type="fa" cat="S[dcl]\NP">
            <lf start="33" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
            <rule type="lex" cat="NP">
             <lf start="34" span="1" word="expr_b" lemma="expr_b" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="35" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
  </rule>
 </rule>
</ccg>
</candc>
