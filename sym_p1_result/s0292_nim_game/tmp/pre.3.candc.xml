<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <rule type="ba" cat="NP[nb]">
     <lf start="0" span="1" word="You" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
     <rule type="conj" cat="NP[nb]\NP[nb]">
      <lf start="1" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
      <rule type="fa" cat="NP[nb]">
       <lf start="2" span="1" word="your" lemma="your" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <lf start="3" span="1" word="friend" lemma="friend" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="4" span="1" word="will" lemma="will" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
     <rule type="fa" cat="S[b]\NP">
      <lf start="5" span="1" word="alternate" lemma="alternate" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/(S[ng]\NP)" />
      <rule type="fa" cat="S[ng]\NP">
       <lf start="6" span="1" word="taking" lemma="take" pos="VBG" chunk="I-NP" entity="O" cat="(S[ng]\NP)/NP" />
       <rule type="lex" cat="NP">
        <lf start="7" span="1" word="turns" lemma="turn" pos="NNS" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="conj" cat="S[dcl]\S[dcl]">
    <lf start="8" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    <rule type="conj" cat="S[dcl]\S[dcl]">
     <lf start="9" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
     <rule type="ba" cat="S[dcl]">
      <lf start="10" span="1" word="you" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
      <rule type="ba" cat="S[dcl]\NP">
       <lf start="11" span="1" word="go" lemma="go" pos="VBP" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
       <lf start="12" span="1" word="first" lemma="first" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="13" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
