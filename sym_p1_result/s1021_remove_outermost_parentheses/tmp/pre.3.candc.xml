<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <rule type="fa" cat="NP[nb]">
     <lf start="0" span="1" word="A" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <rule type="fa" cat="N">
      <lf start="1" span="1" word="valid" lemma="valid" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
      <rule type="fa" cat="N">
       <lf start="2" span="1" word="parentheses" lemma="parenthesis" pos="NNS" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="fa" cat="N">
        <lf start="3" span="1" word="string" lemma="string" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="4" span="1" word="param_s" lemma="param_s" pos="NNS" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="ba" cat="S[dcl]\NP">
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="5" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
      <lf start="6" span="1" word="primitive" lemma="primitive" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
     </rule>
     <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
      <lf start="7" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
      <rule type="ba" cat="S[dcl]">
       <lf start="8" span="1" word="it" lemma="it" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
       <rule type="fa" cat="S[dcl]\NP">
        <lf start="9" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
        <lf start="10" span="1" word="nonempty" lemma="nonempty" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="conj" cat="S[dcl]\S[dcl]">
    <lf start="11" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    <rule type="conj" cat="S[dcl]\S[dcl]">
     <lf start="12" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
     <rule type="ba" cat="S[dcl]">
      <lf start="13" span="1" word="there" lemma="there" pos="EX" chunk="I-NP" entity="O" cat="NP[thr]" />
      <rule type="fa" cat="S[dcl]\NP">
       <rule type="bx" cat="(S[dcl]\NP)/(S[b]\NP)">
        <lf start="14" span="1" word="does" lemma="do" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
        <lf start="15" span="1" word="not" lemma="not" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)\(S\NP)" />
       </rule>
       <rule type="ba" cat="S[b]\NP">
        <rule type="ba" cat="S[b]\NP">
         <lf start="16" span="1" word="exist" lemma="exist" pos="VB" chunk="I-VP" entity="O" cat="S[b]\NP" />
         <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
          <lf start="17" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="((S\NP)\(S\NP))/N" />
          <lf start="18" span="1" word="way" lemma="way" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="lex" cat="(S[X]\NP)\(S[X]\NP)">
         <rule type="fa" cat="S[to]\NP">
          <lf start="19" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
          <rule type="ba" cat="S[b]\NP">
           <rule type="rp" cat="S[b]\NP">
            <rule type="fa" cat="S[b]\NP">
             <rule type="fa" cat="(S[b]\NP)/PP">
              <lf start="20" span="1" word="split" lemma="split" pos="VB" chunk="I-VP" entity="O" cat="((S[b]\NP)/PP)/NP" />
              <lf start="21" span="1" word="it" lemma="it" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
             </rule>
             <rule type="fa" cat="PP">
              <lf start="22" span="1" word="into" lemma="into" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
              <rule type="lex" cat="NP">
               <lf start="23" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
              </rule>
             </rule>
            </rule>
            <lf start="24" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
           </rule>
           <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
            <lf start="25" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
            <rule type="ba" cat="NP">
             <rule type="lex" cat="NP">
              <lf start="26" span="1" word="expr_b" lemma="expr_b" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
             <rule type="conj" cat="NP\NP">
              <lf start="27" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
              <rule type="lex" cat="NP">
               <rule type="fa" cat="N">
                <lf start="28" span="1" word="expr_c" lemma="expr_c" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                <rule type="fa" cat="N">
                 <lf start="29" span="1" word="nonempty" lemma="nonempty" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                 <rule type="fa" cat="N">
                  <lf start="30" span="1" word="valid" lemma="valid" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                  <rule type="fa" cat="N">
                   <lf start="31" span="1" word="parentheses" lemma="parenthesis" pos="NNS" chunk="I-NP" entity="O" cat="N/N" />
                   <lf start="32" span="1" word="strings" lemma="string" pos="NNS" chunk="I-NP" entity="O" cat="N" />
                  </rule>
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="33" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
