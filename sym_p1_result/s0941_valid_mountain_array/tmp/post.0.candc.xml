<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[qem]">
  <rule type="fa" cat="S[X]/S[X]">
   <lf start="0" span="1" word="Given" lemma="Give" pos="VBN" chunk="I-PP" entity="O" cat="(S/S)/NP" />
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP[nb]">
     <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <rule type="fa" cat="N">
      <lf start="2" span="1" word="_type_integer_array" lemma="_type_integer_array" pos="NN" chunk="I-NP" entity="I-ORG" cat="N/N" />
      <lf start="3" span="1" word="param_arr" lemma="param_arr" pos="NN" chunk="I-NP" entity="I-ORG" cat="N" />
     </rule>
    </rule>
    <rule type="lex" cat="NP\NP">
     <rule type="lp" cat="S[dcl]">
      <lf start="4" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
      <rule type="ba" cat="S[dcl]">
       <rule type="fa" cat="NP[nb]">
        <lf start="5" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <lf start="6" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
       <rule type="fa" cat="S[dcl]\NP">
        <lf start="7" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
        <lf start="8" span="1" word="expr_a" lemma="expr_a" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <rule type="fa" cat="S[qem]">
   <rule type="ba" cat="S[qem]/S[dcl]">
    <lf start="9" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="S[qem]/S[dcl]" />
    <rule type="conj" cat="(S[qem]/S[dcl])\(S[qem]/S[dcl])">
     <lf start="10" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
     <rule type="fc" cat="S[qem]/S[dcl]">
      <lf start="11" span="1" word="only" lemma="only" pos="RB" chunk="I-SBAR" entity="O" cat="S/S" />
      <lf start="12" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="S[qem]/S[dcl]" />
     </rule>
    </rule>
   </rule>
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <lf start="13" span="1" word="it" lemma="it" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="14" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      <rule type="fa" cat="NP[nb]">
       <lf start="15" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <rule type="fa" cat="N">
        <lf start="16" span="1" word="valid" lemma="valid" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
        <rule type="fa" cat="N">
         <lf start="17" span="1" word="mountain" lemma="mountain" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="18" span="1" word="array" lemma="array" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="19" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
