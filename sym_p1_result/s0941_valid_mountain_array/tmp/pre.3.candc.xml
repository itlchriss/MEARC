<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <lf start="0" span="1" word="There" lemma="there" pos="EX" chunk="I-NP" entity="O" cat="NP[thr]" />
   <rule type="rp" cat="S[dcl]\NP">
    <rule type="fa" cat="S[dcl]\NP">
     <rule type="fa" cat="(S[dcl]\NP)/PP">
      <lf start="1" span="1" word="exists" lemma="exist" pos="VBZ" chunk="I-VP" entity="O" cat="((S[dcl]\NP)/PP)/NP" />
      <rule type="lex" cat="NP">
       <lf start="2" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
     <rule type="fa" cat="PP">
      <lf start="3" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
      <rule type="lex" cat="NP">
       <rule type="fa" cat="N">
        <lf start="4" span="1" word="expr_b" lemma="expr_b" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <rule type="ba" cat="N">
         <lf start="5" span="1" word="such" lemma="such" pos="JJ" chunk="I-PP" entity="O" cat="N" />
         <lf start="6" span="1" word="that" lemma="that" pos="IN" chunk="I-NP" entity="O" cat="N\N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="7" span="1" word=":" lemma=":" pos=":" chunk="O" entity="O" cat=":" />
   </rule>
  </rule>
  <lf start="8" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
