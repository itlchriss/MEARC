<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="lex" cat="NP">
    <rule type="fa" cat="N">
     <rule type="fa" cat="N/N">
      <lf start="0" span="1" word="Only" lemma="only" pos="RB" chunk="I-NP" entity="O" cat="(N/N)/(N/N)" />
      <lf start="1" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
     </rule>
     <rule type="fa" cat="N">
      <lf start="2" span="1" word="valid" lemma="valid" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
      <lf start="3" span="1" word="answer" lemma="answer" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
   <lf start="4" span="1" word="exists" lemma="exist" pos="VBZ" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
  </rule>
  <lf start="5" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
