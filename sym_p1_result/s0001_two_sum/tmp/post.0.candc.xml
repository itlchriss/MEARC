<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[dcl]">
  <rule type="fa" cat="S[X]/S[X]">
   <lf start="0" span="1" word="Given" lemma="Give" pos="VBN" chunk="I-PP" entity="O" cat="(S/S)/NP" />
   <rule type="ba" cat="NP[nb]">
    <rule type="fa" cat="NP[nb]">
     <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <rule type="fa" cat="N">
      <lf start="2" span="1" word="_type_integer_array" lemma="_type_integer_array" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
      <lf start="3" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
    <rule type="conj" cat="NP[nb]\NP[nb]">
     <lf start="4" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
     <rule type="fa" cat="NP[nb]">
      <lf start="5" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="fa" cat="N">
       <lf start="6" span="1" word="_type_integer" lemma="_type_integer" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <lf start="7" span="1" word="param_target" lemma="param_target" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <rule type="lp" cat="S[dcl]">
   <lf start="8" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <rule type="fa" cat="NP[nb]">
      <lf start="9" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="10" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="11" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      <rule type="ba" cat="NP">
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <lf start="12" span="1" word="indices" lemma="index" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="13" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
         <rule type="fa" cat="NP[nb]">
          <lf start="14" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <rule type="fa" cat="N">
           <lf start="15" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
           <lf start="16" span="1" word="numbers" lemma="number" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
       <rule type="fa" cat="NP\NP">
        <lf start="17" span="1" word="such" lemma="such" pos="JJ" chunk="I-PP" entity="O" cat="(NP\NP)/(NP\NP)" />
        <rule type="fa" cat="NP\NP">
         <lf start="18" span="1" word="that" lemma="that" pos="IN" chunk="I-SBAR" entity="O" cat="(NP\NP)/(S[dcl]/NP)" />
         <rule type="fc" cat="S[dcl]/NP">
          <rule type="tr" cat="S[X]/(S[X]\NP)">
           <lf start="19" span="1" word="they" lemma="they" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
          </rule>
          <rule type="bx" cat="(S[dcl]\NP)/NP">
           <rule type="bx" cat="(S[dcl]\NP)/NP">
            <lf start="20" span="1" word="add" lemma="add" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
            <lf start="21" span="1" word="up" lemma="up" pos="RP" chunk="I-PRT" entity="O" cat="(S\NP)\(S\NP)" />
           </rule>
           <rule type="lex" cat="(S[X]\NP)\(S[X]\NP)">
            <rule type="fa" cat="S[to]\NP">
             <lf start="22" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
             <lf start="23" span="1" word="param_target" lemma="param_target" pos="VB" chunk="I-VP" entity="O" cat="S[b]\NP" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="24" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
