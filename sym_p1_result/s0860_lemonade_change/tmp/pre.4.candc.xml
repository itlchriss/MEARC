<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="S[dcl]">
  <lf start="0" span="1" word="You" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
  <rule type="fa" cat="S[dcl]\NP">
   <lf start="1" span="1" word="must" lemma="must" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
   <rule type="ba" cat="S[b]\NP">
    <rule type="fa" cat="S[b]\NP">
     <lf start="2" span="1" word="provide" lemma="provide" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
     <rule type="ba" cat="NP">
      <rule type="fa" cat="NP[nb]">
       <lf start="3" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <rule type="fa" cat="N">
        <lf start="4" span="1" word="correct" lemma="correct" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="5" span="1" word="change" lemma="change" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="6" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
       <rule type="fa" cat="NP[nb]">
        <lf start="7" span="1" word="each" lemma="each" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <lf start="8" span="1" word="customer" lemma="customer" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
     <lf start="9" span="1" word="so" lemma="so" pos="RB" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/((S\NP)\(S\NP))" />
     <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
      <lf start="10" span="1" word="that" lemma="that" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
      <rule type="rp" cat="S[dcl]">
       <rule type="ba" cat="S[dcl]">
        <rule type="fa" cat="NP[nb]">
         <lf start="11" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="fa" cat="N">
          <lf start="12" span="1" word="net" lemma="net" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="13" span="1" word="transaction" lemma="transaction" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="14" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/S[em]" />
         <rule type="fa" cat="S[em]">
          <lf start="15" span="1" word="that" lemma="that" pos="IN" chunk="I-SBAR" entity="O" cat="S[em]/S[dcl]" />
          <rule type="ba" cat="S[dcl]">
           <rule type="fa" cat="NP[nb]">
            <lf start="16" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
            <lf start="17" span="1" word="customer" lemma="customer" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
           <rule type="fa" cat="S[dcl]\NP">
            <lf start="18" span="1" word="pays" lemma="pay" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
            <rule type="lp" cat="NP">
             <lf start="19" span="1" word="`" lemma="`" pos="LQU" chunk="I-NP" entity="O" cat="LQU" />
             <rule type="lex" cat="NP">
              <rule type="fa" cat="N">
               <lf start="20" span="1" word="$" lemma="$" pos="$" chunk="I-NP" entity="I-MON" cat="N/N[num]" />
               <lf start="21" span="1" word="5`" lemma="5`" pos="CD" chunk="I-NP" entity="I-MON" cat="N[num]" />
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
       <lf start="22" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
