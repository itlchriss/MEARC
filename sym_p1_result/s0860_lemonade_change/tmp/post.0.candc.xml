<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="S[dcl]">
    <rule type="fa" cat="S[X]/S[X]">
     <lf start="0" span="1" word="Given" lemma="Give" pos="VBN" chunk="I-PP" entity="O" cat="(S/S)/NP" />
     <rule type="ba" cat="NP">
      <rule type="ba" cat="NP">
       <rule type="fa" cat="NP[nb]">
        <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <rule type="fa" cat="N">
         <lf start="2" span="1" word="_type_integer" lemma="_type_integer" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="3" span="1" word="array" lemma="array" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
       <rule type="lex" cat="NP\NP">
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="4" span="1" word="param_bills" lemma="param_bills" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/S[em]" />
         <rule type="fa" cat="S[em]">
          <lf start="5" span="1" word="that" lemma="that" pos="IN" chunk="I-SBAR" entity="O" cat="S[em]/S[dcl]" />
          <rule type="ba" cat="S[dcl]">
           <rule type="lex" cat="NP">
            <lf start="6" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
           <rule type="fa" cat="S[dcl]\NP">
            <lf start="7" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
            <rule type="ba" cat="NP">
             <rule type="fa" cat="NP[nb]">
              <lf start="8" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
              <lf start="9" span="1" word="bill" lemma="bill" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
             <rule type="lex" cat="NP\NP">
              <rule type="fc" cat="S[dcl]/NP">
               <rule type="tr" cat="S[X]/(S[X]\NP)">
                <rule type="fa" cat="NP[nb]">
                 <lf start="10" span="1" word="the" lemma="the" pos="DT" chunk="B-NP" entity="O" cat="NP[nb]/N" />
                 <rule type="fa" cat="N">
                  <lf start="11" span="1" word="&lt;" lemma="&lt;" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                  <rule type="fa" cat="N">
                   <lf start="12" span="1" word="code" lemma="code" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                   <rule type="fa" cat="N">
                    <lf start="13" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                    <rule type="fa" cat="N">
                     <lf start="14" span="1" word="i" lemma="i" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                     <rule type="fa" cat="N">
                      <lf start="15" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                      <lf start="16" span="1" word="sup" lemma="sup" pos="NN" chunk="I-NP" entity="O" cat="N" />
                     </rule>
                    </rule>
                   </rule>
                  </rule>
                 </rule>
                </rule>
               </rule>
               <lf start="17" span="1" word="&gt;" lemma="&gt;" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
      <rule type="lex" cat="NP\NP">
       <rule type="fc" cat="S[dcl]/NP">
        <rule type="tr" cat="S[X]/(S[X]\NP)">
         <rule type="lex" cat="NP">
          <rule type="fa" cat="N">
           <lf start="18" span="1" word="th" lemma="th" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
           <lf start="19" span="1" word="&lt;" lemma="&lt;" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
        <lf start="20" span="1" word="/sup" lemma="/sup" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="ba" cat="S[dcl]">
     <rule type="lex" cat="NP">
      <rule type="fa" cat="N">
       <lf start="21" span="1" word="&gt;" lemma="&gt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
       <lf start="22" span="1" word="&lt;" lemma="&lt;" pos="NNS" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="23" span="1" word="/code" lemma="/code" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      <rule type="ba" cat="NP">
       <rule type="lex" cat="NP">
        <rule type="fa" cat="N">
         <lf start="24" span="1" word="&gt;" lemma="&gt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="25" span="1" word="customer" lemma="customer" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
       <rule type="lex" cat="NP\NP">
        <lf start="26" span="1" word="pays" lemma="pay" pos="VBZ" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="conj" cat="S[dcl]\S[dcl]">
    <lf start="27" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    <rule type="ba" cat="S[dcl]">
     <rule type="fa" cat="NP[nb]">
      <lf start="28" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="29" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="30" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
      <rule type="ba" cat="S[pss]\NP">
       <lf start="31" span="1" word="expr_b" lemma="expr_b" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
       <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
        <lf start="32" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
        <rule type="ba" cat="S[dcl]">
         <lf start="33" span="1" word="you" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
         <rule type="fa" cat="S[dcl]\NP">
          <lf start="34" span="1" word="can" lemma="can" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
          <rule type="ba" cat="S[b]\NP">
           <rule type="fa" cat="S[b]\NP">
            <rule type="fa" cat="(S[b]\NP)/PP">
             <lf start="35" span="1" word="provide" lemma="provide" pos="VB" chunk="I-VP" entity="O" cat="((S[b]\NP)/PP)/NP" />
             <rule type="fa" cat="NP[nb]">
              <lf start="36" span="1" word="every" lemma="every" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
              <lf start="37" span="1" word="customer" lemma="customer" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
            <rule type="fa" cat="PP">
             <lf start="38" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
             <rule type="ba" cat="NP[nb]">
              <rule type="fa" cat="NP[nb]">
               <lf start="39" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
               <rule type="fa" cat="N">
                <lf start="40" span="1" word="correct" lemma="correct" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                <lf start="41" span="1" word="change" lemma="change" pos="NN" chunk="I-NP" entity="O" cat="N" />
               </rule>
              </rule>
              <rule type="conj" cat="NP[nb]\NP[nb]">
               <lf start="42" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
               <rule type="conj" cat="NP[nb]\NP[nb]">
                <lf start="43" span="1" word="or" lemma="or" pos="CC" chunk="O" entity="O" cat="conj" />
                <rule type="fa" cat="NP[nb]">
                 <lf start="44" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                 <lf start="45" span="1" word="expr_c" lemma="expr_c" pos="NN" chunk="I-NP" entity="O" cat="N" />
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
           <lf start="46" span="1" word="otherwise" lemma="otherwise" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="47" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
