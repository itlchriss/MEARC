<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[dcl]">
  <rule type="fa" cat="S[X]/S[X]">
   <lf start="0" span="1" word="At" lemma="at" pos="IN" chunk="I-PP" entity="O" cat="(S/S)/NP" />
   <rule type="fa" cat="NP[nb]">
    <lf start="1" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <rule type="fa" cat="N">
     <lf start="2" span="1" word="lemonade" lemma="lemonade" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
     <lf start="3" span="1" word="stand" lemma="stand" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
   </rule>
  </rule>
  <rule type="lp" cat="S[dcl]">
   <lf start="4" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <rule type="fa" cat="NP[nb]">
      <lf start="5" span="1" word="each" lemma="each" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="6" span="1" word="lemonade" lemma="lemonade" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="7" span="1" word="costs" lemma="cost" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      <rule type="lp" cat="NP">
       <lf start="8" span="1" word="`" lemma="`" pos="LQU" chunk="I-NP" entity="O" cat="LQU" />
       <rule type="lex" cat="NP">
        <rule type="fa" cat="N">
         <lf start="9" span="1" word="$" lemma="$" pos="$" chunk="I-NP" entity="I-MON" cat="N/N[num]" />
         <lf start="10" span="1" word="5`" lemma="5`" pos="CD" chunk="I-NP" entity="I-MON" cat="N[num]" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="11" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
