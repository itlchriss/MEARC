       <rule type="lex" cat="NP">
        <lf start="2" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N" />
       </rule>
       <rule type="conj" cat="NP\NP">
        <lf start="3" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
        <rule type="ba" cat="NP">
         <rule type="lex" cat="NP">
          <rule type="fa" cat="N">
           <lf start="4" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
           <rule type="lp" cat="N">
            <lf start="5" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
            <rule type="fa" cat="N">
             <lf start="6" span="1" word="+" lemma="+" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="7" span="1" word="min" lemma="min" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
         <rule type="fa" cat="NP\NP">
          <lf start="8" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
          <rule type="ba" cat="NP">
           <rule type="lex" cat="NP">
            <lf start="9" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N" />
           </rule>
           <rule type="conj" cat="NP\NP">
            <lf start="10" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
            <rule type="ba" cat="NP">
             <rule type="lex" cat="NP">
              <rule type="fa" cat="N">
               <lf start="11" span="1" word="5" lemma="5" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
               <rule type="lp" cat="N">
                <lf start="12" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
                <rule type="fa" cat="N">
                 <lf start="13" span="1" word="+" lemma="+" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                 <lf start="14" span="1" word="min" lemma="min" pos="NN" chunk="I-NP" entity="O" cat="N" />
                </rule>
               </rule>
              </rule>
             </rule>
             <rule type="fa" cat="NP\NP">
              <lf start="15" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
              <rule type="ba" cat="NP">
               <rule type="lex" cat="NP">
                <lf start="16" span="1" word="6" lemma="6" pos="CD" chunk="I-NP" entity="O" cat="N" />
               </rule>
               <rule type="conj" cat="NP\NP">
                <lf start="17" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
                <rule type="lex" cat="NP">
                 <lf start="18" span="1" word="6" lemma="6" pos="CD" chunk="I-NP" entity="O" cat="N" />
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
     <lf start="19" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
    </rule>
   </rule>
   <rule type="fa" cat="NP\NP">
    <lf start="20" span="1" word="=" lemma="=" pos="IN" chunk="I-NP" entity="O" cat="(NP\NP)/NP" />
    <rule type="lex" cat="NP">
     <rule type="fa" cat="N">
      <lf start="21" span="1" word="9" lemma="9" pos="CD" chunk="I-NP" entity="I-TIM" cat="N/N" />
      <rule type="ba" cat="N">
       <lf start="22" span="1" word="=" lemma="=" pos="NN" chunk="I-NP" entity="I-TIM" cat="N" />
       <lf start="23" span="1" word="9" lemma="9" pos="CD" chunk="I-NP" entity="I-TIM" cat="N\N" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="24" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
