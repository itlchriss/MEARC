<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="NP">
  <rule type="ba" cat="NP">
   <rule type="ba" cat="NP">
    <rule type="lex" cat="NP">
     <lf start="0" span="1" word="min" lemma="min" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="rp" cat="NP\NP">
     <rule type="fa" cat="NP\NP">
      <lf start="1" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
