<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="lex" cat="NP">
     <lf start="0" span="1" word="Explanation" lemma="explanation" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
     <rule type="fa" cat="NP[nb]">
      <rule type="ba" cat="NP[nb]/N">
       <rule type="lex" cat="NP">
        <lf start="2" span="1" word="version1" lemma="version1" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
       <lf start="3" span="1" word="'s" lemma="'s" pos="POS" chunk="B-NP" entity="O" cat="(NP[nb]/N)\NP" />
      </rule>
      <rule type="ba" cat="N">
       <lf start="4" span="1" word="revision" lemma="revision" pos="NN" chunk="I-NP" entity="O" cat="N" />
       <lf start="5" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="O" cat="N\N" />
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="ba" cat="S[dcl]\NP">
    <rule type="rp" cat="S[dcl]\NP">
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="6" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
      <lf start="7" span="1" word="stry_a" lemma="stry_a" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
     </rule>
     <lf start="8" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    </rule>
    <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
     <lf start="9" span="1" word="while" lemma="while" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
     <rule type="ba" cat="S[dcl]">
      <rule type="fa" cat="NP[nb]">
       <rule type="ba" cat="NP[nb]/N">
        <rule type="lex" cat="NP">
         <lf start="10" span="1" word="version2" lemma="version2" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <lf start="11" span="1" word="'s" lemma="'s" pos="POS" chunk="B-NP" entity="O" cat="(NP[nb]/N)\NP" />
       </rule>
       <rule type="ba" cat="N">
        <lf start="12" span="1" word="revision" lemma="revision" pos="NN" chunk="I-NP" entity="O" cat="N" />
        <lf start="13" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="O" cat="N\N" />
       </rule>
      </rule>
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="14" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
       <lf start="15" span="1" word="stry_b" lemma="stry_b" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="16" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
