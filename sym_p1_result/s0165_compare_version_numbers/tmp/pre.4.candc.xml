<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="lex" cat="NP">
    <rule type="fa" cat="N">
     <lf start="0" span="1" word="Version" lemma="Version" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
     <lf start="1" span="1" word="numbers" lemma="number" pos="NNS" chunk="I-NP" entity="O" cat="N" />
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="2" span="1" word="consist" lemma="consist" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/PP" />
    <rule type="fa" cat="PP">
     <lf start="3" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
     <rule type="ba" cat="NP">
      <rule type="lex" cat="NP">
       <rule type="fa" cat="N">
        <rule type="ba" cat="N/N">
         <lf start="4" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
         <rule type="conj" cat="(N/N)\(N/N)">
          <lf start="5" span="1" word="or" lemma="or" pos="CC" chunk="I-NP" entity="O" cat="conj" />
          <lf start="6" span="1" word="more" lemma="more" pos="JJR" chunk="I-NP" entity="O" cat="N/N" />
         </rule>
        </rule>
        <lf start="7" span="1" word="revisions" lemma="revision" pos="NNS" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
      <rule type="lex" cat="NP\NP">
       <rule type="ba" cat="S[pss]\NP">
        <lf start="8" span="1" word="joined" lemma="join" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
        <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
         <lf start="9" span="1" word="by" lemma="by" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
         <rule type="fa" cat="NP[nb]">
          <lf start="10" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <rule type="fa" cat="N">
           <lf start="11" span="1" word="dot" lemma="dot" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
           <lf start="12" span="1" word="`period" lemma="`period" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="13" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
