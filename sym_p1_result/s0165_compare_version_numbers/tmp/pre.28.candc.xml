<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="lex" cat="NP">
   <rule type="fa" cat="N">
    <lf start="0" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="I-TIM" cat="N/N" />
    <rule type="ba" cat="N">
     <lf start="1" span="1" word="&lt;" lemma="&lt;" pos="NN" chunk="I-NP" entity="I-TIM" cat="N" />
     <lf start="2" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="I-TIM" cat="N\N" />
    </rule>
   </rule>
  </rule>
  <rule type="conj" cat="NP\NP">
   <lf start="3" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
   <rule type="rp" cat="NP">
    <rule type="lex" cat="NP">
     <rule type="fa" cat="N">
      <rule type="fa" cat="N/N">
       <lf start="4" span="1" word="so" lemma="so" pos="RB" chunk="I-ADVP" entity="O" cat="(N/N)/(N/N)" />
       <lf start="5" span="1" word="version1" lemma="version1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
      </rule>
      <rule type="fa" cat="N">
       <lf start="6" span="1" word="&lt;" lemma="&lt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
       <lf start="7" span="1" word="version2" lemma="version2" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
    <lf start="8" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
