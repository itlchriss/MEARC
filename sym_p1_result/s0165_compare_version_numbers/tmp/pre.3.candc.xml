<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[b]">
  <rule type="fa" cat="S[X]/S[X]">
   <lf start="0" span="1" word="Given" lemma="Give" pos="VBN" chunk="I-VP" entity="O" cat="(S/S)/NP" />
   <rule type="ba" cat="NP">
    <rule type="lex" cat="NP">
     <rule type="fa" cat="N">
      <lf start="1" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
      <lf start="2" span="1" word="version" lemma="version" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
    <lf start="3" span="1" word="numbers" lemma="number" pos="NNS" chunk="I-NP" entity="O" cat="NP\NP" />
   </rule>
  </rule>
  <rule type="lp" cat="S[b]">
   <lf start="4" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
   <rule type="rp" cat="S[b]">
    <rule type="ba" cat="S[b]">
     <rule type="lex" cat="NP">
      <rule type="ba" cat="N">
       <lf start="5" span="1" word="param_version1" lemma="param_version1" pos="NN" chunk="I-NP" entity="O" cat="N" />
       <rule type="conj" cat="N\N">
        <lf start="6" span="1" word="and" lemma="and" pos="CC" chunk="I-NP" entity="O" cat="conj" />
        <lf start="7" span="1" word="param_version2" lemma="param_version2" pos="NN" chunk="I-NP" entity="I-ORG" cat="N" />
       </rule>
      </rule>
     </rule>
     <rule type="lp" cat="S[b]\NP">
      <lf start="8" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
      <rule type="fa" cat="S[b]\NP">
       <lf start="9" span="1" word="compare" lemma="compare" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
       <lf start="10" span="1" word="them" lemma="they" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
      </rule>
     </rule>
    </rule>
    <lf start="11" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
