<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="lex" cat="NP">
    <lf start="0" span="1" word="Revisions" lemma="revision" pos="NNS" chunk="I-NP" entity="O" cat="N" />
   </rule>
   <rule type="ba" cat="S[dcl]\NP">
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="1" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
     <lf start="2" span="1" word="0-indexed" lemma="0-indexed" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
    </rule>
    <rule type="ba" cat="(S[X]\NP)\(S[X]\NP)">
     <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
      <lf start="3" span="1" word="from" lemma="from" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
      <rule type="ba" cat="NP">
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <lf start="4" span="1" word="left" lemma="leave" pos="VBN" chunk="I-VP" entity="O" cat="N" />
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="5" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
         <rule type="rp" cat="NP">
          <rule type="lex" cat="NP">
           <lf start="6" span="1" word="right" lemma="right" pos="JJ" chunk="I-ADJP" entity="O" cat="N" />
          </rule>
          <lf start="7" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
         </rule>
        </rule>
       </rule>
       <rule type="fa" cat="NP\NP">
        <lf start="8" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
        <rule type="ba" cat="NP">
         <rule type="fa" cat="NP[nb]">
          <lf start="9" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <rule type="fa" cat="N">
           <lf start="10" span="1" word="leftmost" lemma="leftmost" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
           <lf start="11" span="1" word="revision" lemma="revision" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
         <rule type="lex" cat="NP\NP">
          <rule type="fa" cat="S[ng]\NP">
           <lf start="12" span="1" word="being" lemma="be" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
           <rule type="rp" cat="NP">
            <rule type="ba" cat="NP">
             <rule type="lex" cat="NP">
              <rule type="ba" cat="N">
               <lf start="13" span="1" word="revision" lemma="revision" pos="NN" chunk="I-NP" entity="O" cat="N" />
               <lf start="14" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="O" cat="N\N" />
              </rule>
             </rule>
             <rule type="conj" cat="NP\NP">
              <lf start="15" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
              <rule type="ba" cat="NP">
               <rule type="fa" cat="NP[nb]">
                <lf start="16" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                <rule type="fa" cat="N">
                 <lf start="17" span="1" word="next" lemma="next" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                 <lf start="18" span="1" word="revision" lemma="revision" pos="NN" chunk="I-NP" entity="O" cat="N" />
                </rule>
               </rule>
               <rule type="lex" cat="NP\NP">
                <rule type="fa" cat="S[ng]\NP">
                 <lf start="19" span="1" word="being" lemma="be" pos="VBG" chunk="I-NP" entity="O" cat="(S[ng]\NP)/NP" />
                 <rule type="lex" cat="NP">
                  <rule type="ba" cat="N">
                   <lf start="20" span="1" word="revision" lemma="revision" pos="NN" chunk="I-NP" entity="O" cat="N" />
                   <lf start="21" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="I-DAT" cat="N\N" />
                  </rule>
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
            <lf start="22" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
     <rule type="conj" cat="((S[X]\NP)\(S[X]\NP))\((S[X]\NP)\(S[X]\NP))">
      <lf start="23" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
      <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
       <lf start="24" span="1" word="so" lemma="so" pos="RB" chunk="I-ADVP" entity="O" cat="((S\NP)\(S\NP))/((S\NP)\(S\NP))" />
       <lf start="25" span="1" word="on" lemma="on" pos="IN" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="26" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
