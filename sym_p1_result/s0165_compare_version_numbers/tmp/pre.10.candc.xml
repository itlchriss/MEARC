<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[dcl]">
  <rule type="lex" cat="S[X]/S[X]">
   <rule type="fa" cat="S[to]\NP">
    <lf start="0" span="1" word="To" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
    <rule type="fa" cat="S[b]\NP">
     <lf start="1" span="1" word="compare" lemma="compare" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
     <rule type="lex" cat="NP">
      <lf start="2" span="1" word="version" lemma="version" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
  </rule>
  <rule type="rp" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <rule type="lex" cat="NP">
     <lf start="3" span="1" word="numbers" lemma="number" pos="NNS" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="lp" cat="S[dcl]\NP">
     <lf start="4" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
     <rule type="fa" cat="S[dcl]\NP">
      <rule type="fa" cat="(S[dcl]\NP)/PP">
       <lf start="5" span="1" word="compare" lemma="compare" pos="VBP" chunk="I-VP" entity="O" cat="((S[dcl]\NP)/PP)/NP" />
       <rule type="fa" cat="NP[nb]">
        <lf start="6" span="1" word="their" lemma="their" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <lf start="7" span="1" word="revisions" lemma="revision" pos="NNS" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
      <rule type="fa" cat="PP">
       <lf start="8" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
       <rule type="lex" cat="NP">
        <rule type="fa" cat="N">
         <lf start="9" span="1" word="left-to-right" lemma="left-to-right" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="10" span="1" word="order" lemma="order" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="11" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
  </rule>
 </rule>
</ccg>
</candc>
