<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="lex" cat="NP">
     <lf start="0" span="1" word="Explanation" lemma="explanation" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
     <rule type="lex" cat="NP">
      <lf start="2" span="1" word="stry_a" lemma="stry_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="3" span="1" word="could" lemma="could" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
    <rule type="fa" cat="S[b]\NP">
     <lf start="4" span="1" word="be" lemma="be" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/(S[pss]\NP)" />
     <rule type="fa" cat="S[pss]\NP">
      <lf start="5" span="1" word="decoded" lemma="decode" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/PP" />
      <rule type="fa" cat="PP">
       <lf start="6" span="1" word="as" lemma="as" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
       <rule type="ba" cat="NP">
        <rule type="rp" cat="NP">
         <rule type="ba" cat="NP">
          <rule type="lex" cat="NP">
           <lf start="7" span="1" word="stry_b" lemma="stry_b" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
          <rule type="rp" cat="NP\NP">
           <rule type="fa" cat="NP\NP">
            <lf start="8" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
            <rule type="ba" cat="NP">
             <rule type="rp" cat="NP">
              <rule type="lex" cat="NP">
               <rule type="fa" cat="N">
                <lf start="9" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
                <lf start="10" span="1" word="26" lemma="26" pos="CD" chunk="I-NP" entity="O" cat="N[num]" />
               </rule>
              </rule>
              <lf start="11" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
             </rule>
             <rule type="conj" cat="NP\NP">
              <lf start="12" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
              <rule type="lex" cat="NP">
               <rule type="fa" cat="N">
                <lf start="13" span="1" word="stry_c" lemma="stry_c" pos="JJ" chunk="I-ADJP" entity="O" cat="N/N" />
                <rule type="lp" cat="N">
                 <lf start="14" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
                 <rule type="fa" cat="N">
                  <lf start="15" span="1" word="22" lemma="22" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
                  <lf start="16" span="1" word="6" lemma="6" pos="CD" chunk="I-NP" entity="O" cat="N" />
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
           <lf start="17" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
          </rule>
         </rule>
         <lf start="18" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
        </rule>
        <rule type="conj" cat="NP\NP">
         <lf start="19" span="1" word="or" lemma="or" pos="CC" chunk="O" entity="O" cat="conj" />
         <rule type="ba" cat="NP">
          <rule type="lex" cat="NP">
           <lf start="20" span="1" word="stry_d" lemma="stry_d" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
          <rule type="rp" cat="NP\NP">
           <rule type="fa" cat="NP\NP">
            <lf start="21" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
            <rule type="lex" cat="NP">
             <rule type="fa" cat="N">
              <rule type="fa" cat="N/N">
               <lf start="22" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="(N/N)/(N/N)" />
               <lf start="23" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
              </rule>
              <lf start="24" span="1" word="6" lemma="6" pos="CD" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
           <lf start="25" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="26" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
