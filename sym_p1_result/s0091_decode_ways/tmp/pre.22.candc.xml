<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="lex" cat="NP">
    <lf start="0" span="1" word="Hence" lemma="Hence" pos="NNP" chunk="I-NP" entity="O" cat="N" />
   </rule>
   <rule type="lp" cat="S[dcl]\NP">
    <lf start="1" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    <rule type="ba" cat="S[dcl]\NP">
     <rule type="ba" cat="S[dcl]\NP">
      <lf start="2" span="1" word="exist" lemma="exist" pos="VBP" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
      <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
       <lf start="3" span="1" word="no" lemma="no" pos="DT" chunk="I-NP" entity="O" cat="((S\NP)\(S\NP))/((S\NP)\(S\NP))" />
       <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
        <lf start="4" span="1" word="valid" lemma="valid" pos="JJ" chunk="I-NP" entity="O" cat="((S\NP)\(S\NP))/((S\NP)\(S\NP))" />
        <lf start="5" span="1" word="ways" lemma="way" pos="NNS" chunk="I-NP" entity="O" cat="(S\NP)\(S\NP)" />
       </rule>
      </rule>
     </rule>
     <rule type="lex" cat="(S[X]\NP)\(S[X]\NP)">
      <rule type="fa" cat="S[to]\NP">
       <lf start="6" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
       <rule type="ba" cat="S[b]\NP">
        <rule type="fa" cat="S[b]\NP">
         <lf start="7" span="1" word="decode" lemma="decode" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
         <lf start="8" span="1" word="this" lemma="this" pos="DT" chunk="I-NP" entity="O" cat="NP" />
        </rule>
        <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
         <lf start="9" span="1" word="since" lemma="since" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
         <rule type="ba" cat="S[dcl]">
          <rule type="fa" cat="NP[nb]">
           <lf start="10" span="1" word="all" lemma="all" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
           <lf start="11" span="1" word="digits" lemma="digit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
          <rule type="fa" cat="S[dcl]\NP">
           <lf start="12" span="1" word="need" lemma="need" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[to]\NP)" />
           <rule type="fa" cat="S[to]\NP">
            <lf start="13" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
            <rule type="fa" cat="S[b]\NP">
             <lf start="14" span="1" word="be" lemma="be" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/(S[pss]\NP)" />
             <lf start="15" span="1" word="mapped" lemma="map" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="16" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
