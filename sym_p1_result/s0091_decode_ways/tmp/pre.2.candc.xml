<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="NP">
  <rule type="ba" cat="NP">
   <rule type="ba" cat="NP">
    <rule type="ba" cat="NP">
     <lf start="0" span="1" word="strx_a" lemma="strx_a" pos="SYM" chunk="O" entity="O" cat="NP" />
     <rule type="fa" cat="NP\NP">
      <lf start="1" span="1" word="-" lemma="-" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
