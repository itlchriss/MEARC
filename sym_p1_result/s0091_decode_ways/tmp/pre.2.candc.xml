         </rule>
         <lf start="9" span="1" word="strx_c" lemma="strx_c" pos="SYM" chunk="O" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
     <lf start="10" span="1" word="-" lemma="-" pos=":" chunk="O" entity="O" cat=":" />
    </rule>
   </rule>
   <rule type="fa" cat="NP\NP">
    <lf start="11" span="1" word="&gt;" lemma="&gt;" pos="JJ" chunk="I-NP" entity="O" cat="(NP\NP)/(NP\NP)" />
    <lf start="12" span="1" word="stry_c" lemma="stry_c" pos="NN" chunk="I-NP" entity="O" cat="NP\NP" />
   </rule>
  </rule>
  <lf start="13" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
