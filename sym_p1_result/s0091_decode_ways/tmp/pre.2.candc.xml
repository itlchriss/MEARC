        <rule type="fa" cat="N">
         <lf start="3" span="1" word="stry_a" lemma="stry_a" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="4" span="1" word="strx_b" lemma="strx_b" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="rp" cat="NP\NP">
     <rule type="fa" cat="NP\NP">
      <lf start="5" span="1" word="-" lemma="-" pos=":" chunk="O" entity="O" cat="(NP\NP)/NP" />
