<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[dcl]">
  <rule type="lex" cat="S[X]/S[X]">
   <rule type="fa" cat="S[to]\NP">
    <lf start="0" span="1" word="To" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
    <rule type="fa" cat="S[b]\NP">
     <lf start="1" span="1" word="decode" lemma="decode" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
     <rule type="fa" cat="NP[nb]">
      <lf start="2" span="1" word="an" lemma="an" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="fa" cat="N">
       <lf start="3" span="1" word="encoded" lemma="encoded" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
       <lf start="4" span="1" word="message" lemma="message" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <rule type="lp" cat="S[dcl]">
   <lf start="5" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <rule type="ba" cat="NP">
      <rule type="fa" cat="NP">
       <lf start="6" span="1" word="all" lemma="all" pos="PDT" chunk="I-NP" entity="O" cat="NP/NP" />
       <rule type="fa" cat="NP[nb]">
        <lf start="7" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <lf start="8" span="1" word="digits" lemma="digit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
      <rule type="lex" cat="NP\NP">
       <rule type="fa" cat="S[dcl]\NP">
        <lf start="9" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
        <lf start="10" span="1" word="grouped" lemma="group" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
       </rule>
      </rule>
     </rule>
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="11" span="1" word="then" lemma="then" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)/(S\NP)" />
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="12" span="1" word="mapped" lemma="map" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
       <rule type="fa" cat="S[adj]\NP">
        <lf start="13" span="1" word="back" lemma="back" pos="RB" chunk="I-ADVP" entity="O" cat="(S[adj]\NP)/PP" />
        <rule type="fa" cat="PP">
         <lf start="14" span="1" word="into" lemma="into" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
         <rule type="ba" cat="NP">
          <rule type="lex" cat="NP">
           <lf start="15" span="1" word="letters" lemma="letter" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
          <rule type="rp" cat="NP\NP">
           <rule type="lex" cat="NP\NP">
            <rule type="fa" cat="S[ng]\NP">
             <lf start="16" span="1" word="using" lemma="use" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
             <rule type="ba" cat="NP">
              <rule type="fa" cat="NP[nb]">
               <lf start="17" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
               <lf start="18" span="1" word="reverse" lemma="reverse" pos="NN" chunk="I-NP" entity="O" cat="N" />
              </rule>
              <rule type="fa" cat="NP\NP">
               <lf start="19" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
               <rule type="ba" cat="NP">
                <rule type="fa" cat="NP[nb]">
                 <lf start="20" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                 <lf start="21" span="1" word="mapping" lemma="mapping" pos="NN" chunk="I-NP" entity="O" cat="N" />
                </rule>
                <rule type="fa" cat="NP\NP">
                 <lf start="22" span="1" word="above" lemma="above" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
                 <rule type="lp" cat="NP">
                  <lf start="23" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
                  <rule type="ba" cat="NP">
                   <lf start="24" span="1" word="there" lemma="there" pos="EX" chunk="I-NP" entity="O" cat="NP[thr]" />
                   <rule type="lex" cat="NP\NP">
                    <rule type="fa" cat="S[dcl]\NP[thr]">
                     <lf start="25" span="1" word="may" lemma="may" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP[thr])/(S[b]\NP)" />
                     <rule type="fa" cat="S[b]\NP">
                      <lf start="26" span="1" word="be" lemma="be" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
                      <rule type="lex" cat="NP">
                       <rule type="fa" cat="N">
                        <lf start="27" span="1" word="multiple" lemma="multiple" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                        <lf start="28" span="1" word="ways" lemma="way" pos="NNS" chunk="I-NP" entity="O" cat="N" />
                       </rule>
                      </rule>
                     </rule>
                    </rule>
                   </rule>
                  </rule>
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
           <lf start="29" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="30" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
