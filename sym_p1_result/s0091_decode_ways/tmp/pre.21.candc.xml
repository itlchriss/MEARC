<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP[nb]">
     <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <rule type="fa" cat="N">
      <lf start="1" span="1" word="only" lemma="only" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
      <rule type="fa" cat="N">
       <lf start="2" span="1" word="valid" lemma="valid" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
       <lf start="3" span="1" word="mappings" lemma="mapping" pos="NNS" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="4" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
     <rule type="lex" cat="NP">
      <lf start="5" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
   <rule type="ba" cat="S[dcl]\NP">
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="6" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
     <lf start="7" span="1" word="strx_a" lemma="strx_a" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
    </rule>
    <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
     <lf start="8" span="1" word="-" lemma="-" pos="IN" chunk="O" entity="O" cat="((S\NP)\(S\NP))/NP" />
     <rule type="ba" cat="NP">
      <rule type="rp" cat="NP">
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <rule type="fa" cat="N">
          <lf start="9" span="1" word="&gt;" lemma="&gt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="10" span="1" word="stry_a" lemma="stry_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="conj" cat="NP\NP">
         <lf start="11" span="1" word="and" lemma="and" pos="CC" chunk="I-NP" entity="O" cat="conj" />
         <rule type="ba" cat="NP">
          <rule type="lex" cat="NP">
           <lf start="12" span="1" word="strx_b" lemma="strx_b" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
          <rule type="lp" cat="NP\NP">
           <lf start="13" span="1" word="-" lemma="-" pos=":" chunk="I-NP" entity="O" cat=":" />
           <rule type="fa" cat="NP\NP">
            <lf start="14" span="1" word="&gt;" lemma="&gt;" pos="JJ" chunk="I-NP" entity="O" cat="(NP\NP)/(NP\NP)" />
            <lf start="15" span="1" word="stry_b" lemma="stry_b" pos="NN" chunk="I-NP" entity="O" cat="NP\NP" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
       <lf start="16" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
      </rule>
      <rule type="fa" cat="NP\NP">
       <rule type="ba" cat="(NP\NP)/(S[dcl]\NP)">
        <rule type="fc" cat="NP/NP">
         <rule type="lex" cat="NP/(NP\NP)">
          <lf start="17" span="1" word="neither" lemma="neither" pos="DT" chunk="I-NP" entity="O" cat="NP" />
         </rule>
         <lf start="18" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
        </rule>
        <lf start="19" span="1" word="which" lemma="which" pos="WDT" chunk="I-NP" entity="O" cat="((NP\NP)/(S[dcl]\NP))\(NP/NP)" />
       </rule>
       <rule type="ba" cat="S[dcl]\NP">
        <lf start="20" span="1" word="start" lemma="start" pos="NN" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
        <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
         <lf start="21" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
         <rule type="lex" cat="NP">
          <lf start="22" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="I-DAT" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="23" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
