<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="lex" cat="NP">
     <lf start="0" span="1" word="Explanation" lemma="explanation" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
     <rule type="lex" cat="NP">
      <lf start="2" span="1" word="stry_a" lemma="stry_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <rule type="bx" cat="(S[dcl]\NP)/(S[b]\NP)">
     <lf start="3" span="1" word="can" lemma="can" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
     <lf start="4" span="1" word="not" lemma="not" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)\(S\NP)" />
    </rule>
    <rule type="fa" cat="S[b]\NP">
     <lf start="5" span="1" word="be" lemma="be" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/(S[pss]\NP)" />
     <rule type="fa" cat="S[pss]\NP">
      <lf start="6" span="1" word="mapped" lemma="map" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/(S[to]\NP)" />
      <rule type="fa" cat="S[to]\NP">
       <lf start="7" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
       <rule type="ba" cat="S[b]\NP">
        <lf start="8" span="1" word="stry_b" lemma="stry_b" pos="VB" chunk="I-VP" entity="O" cat="S[b]\NP" />
        <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
         <lf start="9" span="1" word="because" lemma="because" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/PP" />
         <rule type="fa" cat="PP">
          <lf start="10" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
          <rule type="ba" cat="NP">
           <rule type="fa" cat="NP[nb]">
            <lf start="11" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
            <rule type="fa" cat="N">
             <lf start="12" span="1" word="leading" lemma="lead" pos="VBG" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="13" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
           <rule type="rp" cat="NP\NP">
            <rule type="fa" cat="NP\NP">
             <lf start="14" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/S[dcl]" />
             <rule type="ba" cat="S[dcl]">
              <rule type="lex" cat="NP">
               <lf start="15" span="1" word="stry_c" lemma="stry_c" pos="NN" chunk="I-NP" entity="O" cat="N" />
              </rule>
              <rule type="fa" cat="S[dcl]\NP">
               <lf start="16" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
               <rule type="fa" cat="S[adj]\NP">
                <lf start="17" span="1" word="different" lemma="different" pos="JJ" chunk="I-ADJP" entity="O" cat="(S[adj]\NP)/PP" />
                <rule type="fa" cat="PP">
                 <lf start="18" span="1" word="from" lemma="from" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
                 <rule type="lex" cat="NP">
                  <lf start="19" span="1" word="stry_d" lemma="stry_d" pos="NN" chunk="I-NP" entity="O" cat="N" />
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
            <lf start="20" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="21" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
