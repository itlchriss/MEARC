<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[b]">
  <rule type="fa" cat="S[X]/S[X]">
   <lf start="0" span="1" word="Given" lemma="Give" pos="VBN" chunk="I-PP" entity="O" cat="(S/S)/NP" />
   <rule type="fa" cat="NP[nb]">
    <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <rule type="fa" cat="N">
     <lf start="2" span="1" word="_type_string" lemma="_type_string" pos="VBG" chunk="I-NP" entity="O" cat="N/N" />
     <lf start="3" span="1" word="param_s" lemma="param_s" pos="NNS" chunk="I-NP" entity="O" cat="N" />
    </rule>
   </rule>
  </rule>
  <rule type="rp" cat="S[b]">
   <rule type="ba" cat="S[b]">
    <rule type="lex" cat="NP">
     <rule type="fa" cat="S[ng]\NP">
      <lf start="4" span="1" word="containing" lemma="contain" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
      <rule type="lex" cat="NP">
       <rule type="rp" cat="N">
        <rule type="ba" cat="N">
         <rule type="fa" cat="N">
          <lf start="5" span="1" word="just" lemma="just" pos="RB" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="6" span="1" word="leftp" lemma="leftp" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
         <rule type="conj" cat="N\N">
          <lf start="7" span="1" word="," lemma="," pos="," chunk="I-NP" entity="O" cat="," />
          <rule type="ba" cat="N">
           <lf start="8" span="1" word="rightp" lemma="rightp" pos="NN" chunk="I-NP" entity="O" cat="N" />
           <rule type="conj" cat="N\N">
            <lf start="9" span="1" word="," lemma="," pos="," chunk="I-NP" entity="O" cat="," />
            <rule type="ba" cat="N">
             <lf start="10" span="1" word="leftb" lemma="leftb" pos="NN" chunk="I-NP" entity="O" cat="N" />
             <rule type="conj" cat="N\N">
              <lf start="11" span="1" word="," lemma="," pos="," chunk="I-NP" entity="O" cat="," />
              <rule type="ba" cat="N">
               <lf start="12" span="1" word="rightb" lemma="rightb" pos="NN" chunk="I-NP" entity="O" cat="N" />
               <rule type="conj" cat="N\N">
                <lf start="13" span="1" word="," lemma="," pos="," chunk="I-NP" entity="O" cat="," />
                <rule type="ba" cat="N">
                 <lf start="14" span="1" word="leftbp" lemma="leftbp" pos="NN" chunk="I-NP" entity="O" cat="N" />
                 <rule type="conj" cat="N\N">
                  <lf start="15" span="1" word="and" lemma="and" pos="CC" chunk="I-NP" entity="O" cat="conj" />
                  <lf start="16" span="1" word="rightbp" lemma="rightbp" pos="NN" chunk="I-NP" entity="O" cat="N" />
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
        <lf start="17" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="fa" cat="S[b]\NP">
     <lf start="18" span="1" word="determine" lemma="determine" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/S[qem]" />
     <rule type="fa" cat="S[qem]">
      <lf start="19" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="S[qem]/S[dcl]" />
      <rule type="ba" cat="S[dcl]">
       <rule type="fa" cat="NP[nb]">
        <lf start="20" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <rule type="fa" cat="N">
         <lf start="21" span="1" word="input" lemma="input" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="22" span="1" word="string" lemma="string" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
       <rule type="fa" cat="S[dcl]\NP">
        <lf start="23" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
        <lf start="24" span="1" word="valid" lemma="valid" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="25" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
  </rule>
 </rule>
</ccg>
</candc>
