<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="S[dcl]">
  <rule type="fa" cat="S[adj]\NP">
   <lf start="0" span="1" word="Given" lemma="Give" pos="VBN" chunk="I-PP" entity="O" cat="(S[adj]\NP)/NP" />
   <rule type="ba" cat="NP[nb]">
    <rule type="fa" cat="NP[nb]">
     <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <rule type="fa" cat="N">
      <lf start="2" span="1" word="_type_integer" lemma="_type_integer" pos="NN" chunk="I-NP" entity="I-ORG" cat="N/N" />
      <lf start="3" span="1" word="param_n" lemma="param_n" pos="NN" chunk="I-NP" entity="I-ORG" cat="N" />
     </rule>
    </rule>
    <rule type="conj" cat="NP[nb]\NP[nb]">
     <lf start="4" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
     <rule type="fa" cat="NP[nb]">
      <lf start="5" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="6" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
  </rule>
  <rule type="rp" cat="S[dcl]\(S[adj]\NP)">
   <rule type="rp" cat="S[dcl]\(S[adj]\NP)">
    <rule type="fa" cat="S[dcl]\(S[adj]\NP)">
     <lf start="7" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\(S[adj]\NP))/NP" />
     <rule type="fa" cat="NP[nb]">
      <lf start="8" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="fa" cat="N">
       <lf start="9" span="1" word="_type_string" lemma="_type_string" pos="VBG" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="fa" cat="N">
        <lf start="10" span="1" word="array" lemma="array" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <rule type="fa" cat="N">
         <lf start="11" span="1" word="keyword_result" lemma="keyword_result" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
         <rule type="fa" cat="N">
          <rule type="rp" cat="N/N">
           <rule type="fa" cat="N/N">
            <lf start="12" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(N/N)/(S[adj]\NP)" />
            <lf start="13" span="1" word="1-indexed" lemma="1-indexed" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
           </rule>
           <lf start="14" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
          </rule>
          <lf start="15" span="1" word="that" lemma="that" pos="IN" chunk="I-SBAR" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="16" span="1" word=":" lemma=":" pos=":" chunk="O" entity="O" cat=":" />
   </rule>
   <lf start="17" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
  </rule>
 </rule>
</ccg>
</candc>
