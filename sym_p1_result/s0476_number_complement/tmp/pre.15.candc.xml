<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="lex" cat="NP">
   <lf start="0" span="1" word="Note" lemma="Note" pos="NNP" chunk="I-NP" entity="I-LOC" cat="N" />
  </rule>
  <rule type="fa" cat="NP\NP">
   <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/S[dcl]" />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <rule type="fa" cat="NP[nb]">
      <lf start="2" span="1" word="This" lemma="this" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="3" span="1" word="question" lemma="question" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="4" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      <rule type="ba" cat="NP">
       <rule type="ba" cat="NP">
        <rule type="fa" cat="NP[nb]">
         <lf start="5" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="fa" cat="N">
          <lf start="6" span="1" word="same" lemma="same" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <rule type="fa" cat="N">
           <lf start="7" span="1" word="as" lemma="as" pos="IN" chunk="I-PP" entity="O" cat="N/N" />
           <lf start="8" span="1" word="1009" lemma="1009" pos="CD" chunk="I-NP" entity="I-TIM" cat="N" />
          </rule>
         </rule>
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="9" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="I-TIM" cat="(NP\NP)/NP" />
         <rule type="ba" cat="NP">
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="10" span="1" word="[" lemma="[" pos="JJ" chunk="I-NP" entity="I-TIM" cat="N/N" />
            <lf start="11" span="1" word="https" lemma="http" pos="NNS" chunk="I-NP" entity="I-TIM" cat="N" />
           </rule>
          </rule>
          <rule type="fa" cat="NP\NP">
           <lf start="12" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="I-TIM" cat="(NP\NP)/NP" />
           <rule type="lex" cat="NP">
            <rule type="fa" cat="N">
             <lf start="13" span="1" word="//leetcode.com/problems/complement-of-base-10-integer/" lemma="//leetcode.com/problems/complement-of-base-10-integer/" pos="JJ" chunk="I-NP" entity="I-TIM" cat="N/N" />
             <lf start="14" span="1" word="]" lemma="]" pos="NN" chunk="I-NP" entity="I-TIM" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
       <rule type="rp" cat="NP\NP">
        <rule type="fa" cat="NP\NP">
         <lf start="15" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
         <rule type="ba" cat="NP">
          <rule type="lex" cat="NP">
           <lf start="16" span="1" word="https" lemma="http" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
          <rule type="fa" cat="NP\NP">
           <lf start="17" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
           <rule type="lex" cat="NP">
            <lf start="18" span="1" word="//leetcode.com/problems/complement-of-base-10-integer/" lemma="//leetcode.com/problems/complement-of-base-10-integer/" pos="JJ" chunk="I-ADJP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
        <lf start="19" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="20" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
