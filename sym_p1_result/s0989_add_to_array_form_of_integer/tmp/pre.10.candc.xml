<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="NP">
  <rule type="ba" cat="NP">
   <rule type="lex" cat="NP">
    <lf start="0" span="1" word="Explanation" lemma="explanation" pos="NN" chunk="I-NP" entity="I-TIM" cat="N" />
   </rule>
   <rule type="fa" cat="NP\NP">
    <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="I-TIM" cat="(NP\NP)/NP" />
    <rule type="lex" cat="NP">
     <rule type="ba" cat="N">
      <rule type="fa" cat="N">
       <lf start="2" span="1" word="455" lemma="455" pos="CD" chunk="I-NP" entity="I-TIM" cat="N/N" />
       <lf start="3" span="1" word="=" lemma="=" pos="NN" chunk="I-NP" entity="I-TIM" cat="N" />
      </rule>
      <lf start="4" span="1" word="455" lemma="455" pos="CD" chunk="I-NP" entity="I-TIM" cat="N\N" />
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="5" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
