<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[dcl]">
  <rule type="fa" cat="S[X]/S[X]">
   <lf start="0" span="1" word="Prior" lemma="prior" pos="RB" chunk="I-ADVP" entity="O" cat="(S/S)/PP" />
   <rule type="fa" cat="PP">
    <lf start="1" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="PP/(S[ng]\NP)" />
    <rule type="fa" cat="S[ng]\NP">
     <lf start="2" span="1" word="being" lemma="be" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/(S[pss]\NP)" />
     <rule type="fa" cat="S[pss]\NP">
      <lf start="3" span="1" word="passed" lemma="pass" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/PP" />
      <rule type="fa" cat="PP">
       <lf start="4" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="PP/NP" />
       <rule type="fa" cat="NP[nb]">
        <lf start="5" span="1" word="your" lemma="your" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <lf start="6" span="1" word="function" lemma="function" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <rule type="lp" cat="S[dcl]">
   <lf start="7" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <rule type="lex" cat="NP">
      <lf start="8" span="1" word="param_nums" lemma="param_nums" pos="NNS" chunk="I-NP" entity="I-ORG" cat="N" />
     </rule>
     <rule type="fa" cat="S[dcl]\NP">
      <rule type="bx" cat="(S[dcl]\NP)/(S[pss]\NP)">
       <lf start="9" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
       <lf start="10" span="1" word="possibly" lemma="possibly" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)\(S\NP)" />
      </rule>
      <rule type="ba" cat="S[pss]\NP">
       <lf start="11" span="1" word="rotated" lemma="rotate" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
       <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
        <lf start="12" span="1" word="at" lemma="at" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
        <rule type="ba" cat="NP">
         <rule type="fa" cat="NP[nb]">
          <lf start="13" span="1" word="an" lemma="an" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <rule type="fa" cat="N">
           <lf start="14" span="1" word="unknown" lemma="unknown" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
           <rule type="fa" cat="N">
            <lf start="15" span="1" word="pivot" lemma="pivot" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
            <rule type="fa" cat="N">
             <lf start="16" span="1" word="index" lemma="index" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="17" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
         <rule type="rp" cat="NP\NP">
          <rule type="fa" cat="NP\NP">
           <lf start="18" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
           <rule type="ba" cat="NP">
            <rule type="rp" cat="NP">
             <rule type="ba" cat="NP">
              <rule type="rp" cat="NP">
               <rule type="lex" cat="NP">
                <lf start="19" span="1" word="expr_b" lemma="expr_b" pos="NN" chunk="O" entity="O" cat="N" />
               </rule>
               <lf start="20" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
              </rule>
              <rule type="lex" cat="NP\NP">
               <rule type="fa" cat="S[adj]\NP">
                <lf start="21" span="1" word="such" lemma="such" pos="JJ" chunk="I-PP" entity="O" cat="(S[adj]\NP)/S[em]" />
                <rule type="fa" cat="S[em]">
                 <lf start="22" span="1" word="that" lemma="that" pos="IN" chunk="I-SBAR" entity="O" cat="S[em]/S[dcl]" />
                 <rule type="ba" cat="S[dcl]">
                  <rule type="fa" cat="NP[nb]">
                   <lf start="23" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                   <rule type="fa" cat="N">
                    <lf start="24" span="1" word="resulting" lemma="result" pos="VBG" chunk="I-NP" entity="O" cat="N/N" />
                    <lf start="25" span="1" word="array" lemma="array" pos="NN" chunk="I-NP" entity="O" cat="N" />
                   </rule>
                  </rule>
                  <rule type="fa" cat="S[dcl]\NP">
                   <lf start="26" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
                   <lf start="27" span="1" word="expr_c" lemma="expr_c" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
                  </rule>
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
             <lf start="28" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
            </rule>
            <rule type="lex" cat="NP\NP">
             <lf start="29" span="1" word="0-indexed" lemma="0-indexed" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
            </rule>
           </rule>
          </rule>
          <lf start="30" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="31" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
