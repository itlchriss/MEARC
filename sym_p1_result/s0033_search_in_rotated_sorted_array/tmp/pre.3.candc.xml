<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[dcl]">
  <rule type="fa" cat="S[X]/S[X]">
   <lf start="0" span="1" word="For" lemma="for" pos="IN" chunk="I-PP" entity="O" cat="(S/S)/NP" />
   <rule type="lex" cat="NP">
    <lf start="1" span="1" word="example" lemma="example" pos="NN" chunk="I-NP" entity="O" cat="N" />
   </rule>
  </rule>
  <rule type="rp" cat="S[dcl]">
   <rule type="lp" cat="S[dcl]">
    <lf start="2" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    <rule type="ba" cat="S[dcl]">
     <rule type="lex" cat="NP">
      <lf start="3" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="4" span="1" word="might" lemma="might" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
      <rule type="ba" cat="S[b]\NP">
       <rule type="fa" cat="S[b]\NP">
        <lf start="5" span="1" word="be" lemma="be" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/(S[pss]\NP)" />
        <rule type="ba" cat="S[pss]\NP">
         <lf start="6" span="1" word="rotated" lemma="rotate" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
         <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
          <lf start="7" span="1" word="at" lemma="at" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="8" span="1" word="pivot" lemma="pivot" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
            <rule type="fa" cat="N">
             <lf start="9" span="1" word="index" lemma="index" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="10" span="1" word="expr_b" lemma="expr_b" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
       <rule type="conj" cat="(S[b]\NP)\(S[b]\NP)">
        <lf start="11" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
        <rule type="fa" cat="S[b]\NP">
         <lf start="12" span="1" word="become" lemma="become" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/(S[adj]\NP)" />
         <lf start="13" span="1" word="expr_c" lemma="expr_c" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="14" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
  </rule>
 </rule>
</ccg>
</candc>
