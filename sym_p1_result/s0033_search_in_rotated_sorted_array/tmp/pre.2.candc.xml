<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <lf start="0" span="1" word="There" lemma="there" pos="EX" chunk="I-NP" entity="O" cat="NP[thr]" />
   <rule type="fa" cat="S[dcl]\NP[thr]">
    <lf start="1" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP[thr])/NP" />
    <rule type="ba" cat="NP">
     <rule type="fa" cat="NP[nb]">
      <lf start="2" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="fa" cat="N">
       <lf start="3" span="1" word="_type_integer" lemma="_type_integer" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="fa" cat="N">
        <lf start="4" span="1" word="array" lemma="array" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="5" span="1" word="param_nums" lemma="param_nums" pos="NNS" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
     <rule type="lex" cat="NP\NP">
      <rule type="ba" cat="S[pss]\NP">
       <lf start="6" span="1" word="sorted" lemma="sort" pos="VBD" chunk="I-VP" entity="O" cat="S[pss]\NP" />
       <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
        <lf start="7" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
        <rule type="ba" cat="NP">
         <rule type="lex" cat="NP">
          <lf start="8" span="1" word="ascending_order" lemma="ascending_order" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
         <rule type="lp" cat="NP\NP">
          <lf start="9" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
          <rule type="rp" cat="NP\NP">
           <rule type="fa" cat="NP\NP">
            <lf start="10" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
            <rule type="lex" cat="NP">
             <rule type="fa" cat="N">
              <lf start="11" span="1" word="unique" lemma="unique" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
              <lf start="12" span="1" word="values" lemma="value" pos="NNS" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
           <lf start="13" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="14" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
