<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="(S[X]\NP)\((S[X]\NP)/NP)">
  <rule type="bc" cat="(S[X]\NP)\((S[X]\NP)/NP)">
   <rule type="tr" cat="(S[X]\NP)\((S[X]\NP)/NP)">
    <rule type="lex" cat="NP">
     <lf start="0" span="1" word="Keep" lemma="Keep" pos="NNP" chunk="I-NP" entity="I-PER" cat="N" />
    </rule>
   </rule>
   <rule type="lex" cat="(S[X]\NP)\(S[X]\NP)">
    <rule type="ba" cat="S[ng]\NP">
     <rule type="ba" cat="S[ng]\NP">
      <rule type="fa" cat="S[ng]\NP">
       <lf start="1" span="1" word="repeating" lemma="repeat" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
       <rule type="fa" cat="NP[nb]">
        <lf start="2" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <lf start="3" span="1" word="steps" lemma="step" pos="NNS" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
      <lf start="4" span="1" word="again" lemma="again" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
     </rule>
     <rule type="conj" cat="(S[ng]\NP)\(S[ng]\NP)">
      <lf start="5" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
      <rule type="fa" cat="S[ng]\NP">
       <lf start="6" span="1" word="alternating" lemma="alternate" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/(S[pss]\NP)" />
       <rule type="fa" cat="S[pss]\NP">
        <lf start="7" span="1" word="left" lemma="leave" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/PP" />
        <rule type="fa" cat="PP">
         <lf start="8" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="PP/(S[adj]\NP)" />
         <lf start="9" span="1" word="right" lemma="right" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <rule type="conj" cat="((S[X]\NP)\((S[X]\NP)/NP))\((S[X]\NP)\((S[X]\NP)/NP))">
   <lf start="10" span="1" word="and" lemma="and" pos="CC" chunk="I-ADJP" entity="O" cat="conj" />
   <rule type="bc" cat="(S[X]\NP)\((S[X]\NP)/NP)">
    <rule type="tr" cat="(S[X]\NP)\((S[X]\NP)/NP)">
     <rule type="lex" cat="NP">
      <rule type="ba" cat="N">
       <lf start="11" span="1" word="right" lemma="right" pos="JJ" chunk="I-ADJP" entity="O" cat="N" />
       <rule type="lex" cat="N\N">
        <rule type="fa" cat="S[to]\NP">
         <lf start="12" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
         <rule type="rp" cat="S[b]\NP">
          <lf start="13" span="1" word="left" lemma="leave" pos="VB" chunk="I-VP" entity="O" cat="S[b]\NP" />
          <lf start="14" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
     <lf start="15" span="1" word="until" lemma="until" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
     <rule type="rp" cat="S[dcl]">
      <rule type="ba" cat="S[dcl]">
       <rule type="fa" cat="NP[nb]">
        <lf start="16" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <rule type="fa" cat="N">
         <lf start="17" span="1" word="single" lemma="single" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="18" span="1" word="number" lemma="number" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
       <lf start="19" span="1" word="remains" lemma="remain" pos="VBZ" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
      </rule>
      <lf start="20" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
     </rule>
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
