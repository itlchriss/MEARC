<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="lex" cat="NP">
   <rule type="fa" cat="N">
    <lf start="0" span="1" word="Other" lemma="other" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
    <lf start="1" span="1" word="subsequences" lemma="subsequence" pos="NNS" chunk="I-NP" entity="O" cat="N" />
   </rule>
  </rule>
  <rule type="fa" cat="NP\NP">
   <lf start="2" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
   <rule type="lp" cat="NP">
    <lf start="3" span="1" word="`" lemma="`" pos="LQU" chunk="O" entity="O" cat="LQU" />
    <rule type="rp" cat="NP">
     <rule type="ba" cat="NP">
      <rule type="ba" cat="NP">
       <rule type="rp" cat="NP">
        <rule type="rp" cat="NP">
         <rule type="lex" cat="NP">
          <rule type="ba" cat="N">
           <rule type="ba" cat="N">
            <rule type="ba" cat="N">
             <rule type="ba" cat="N">
              <rule type="ba" cat="N">
               <lf start="4" span="1" word="stry_a" lemma="stry_a" pos="FW" chunk="I-NP" entity="O" cat="N" />
               <lf start="5" span="1" word="expr_a" lemma="expr_a" pos="FW" chunk="I-NP" entity="O" cat="N\N" />
              </rule>
              <lf start="6" span="1" word="stry_b" lemma="stry_b" pos="FW" chunk="I-NP" entity="O" cat="N\N" />
             </rule>
             <lf start="7" span="1" word="expr_b" lemma="expr_b" pos="FW" chunk="I-NP" entity="O" cat="N\N" />
            </rule>
            <lf start="8" span="1" word="stry_c" lemma="stry_c" pos="FW" chunk="I-NP" entity="O" cat="N\N" />
           </rule>
           <lf start="9" span="1" word="expr_c" lemma="expr_c" pos="FW" chunk="I-NP" entity="O" cat="N\N" />
          </rule>
         </rule>
         <lf start="10" span="1" word="''" lemma="''" pos="RQU" chunk="O" entity="O" cat="RQU" />
        </rule>
        <lf start="11" span="1" word="''" lemma="''" pos="RQU" chunk="O" entity="O" cat="RQU" />
       </rule>
       <rule type="lex" cat="NP\NP">
        <rule type="lp" cat="S[adj]\NP">
         <lf start="12" span="1" word="`" lemma="`" pos="LQU" chunk="O" entity="O" cat="LQU" />
         <rule type="lp" cat="S[adj]\NP">
          <lf start="13" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
          <lf start="14" span="1" word="empty" lemma="empty" pos="JJ" chunk="I-NP" entity="O" cat="S[adj]\NP" />
         </rule>
        </rule>
       </rule>
      </rule>
      <rule type="rp" cat="NP\NP">
       <lf start="15" span="1" word="string" lemma="string" pos="NN" chunk="I-NP" entity="O" cat="NP\NP" />
       <lf start="16" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
      </rule>
     </rule>
     <lf start="17" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
