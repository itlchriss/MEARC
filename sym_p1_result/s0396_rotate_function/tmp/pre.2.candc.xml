<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="lex" cat="NP">
    <rule type="fa" cat="N">
     <lf start="0" span="1" word="Assume" lemma="Assume" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
     <rule type="fa" cat="N">
      <lf start="1" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
      <rule type="fa" cat="N">
       <lf start="2" span="1" word="code" lemma="code" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="fa" cat="N">
        <lf start="3" span="1" word="&gt;" lemma="&gt;" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="4" span="1" word="arr" lemma="arr" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="5" span="1" word="&lt;" lemma="&lt;" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
    <rule type="ba" cat="NP">
     <rule type="lex" cat="NP">
      <rule type="fa" cat="N">
       <lf start="6" span="1" word="sub" lemma="sub" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <lf start="7" span="1" word="&gt;" lemma="&gt;" pos="NNS" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
     <rule type="lex" cat="NP\NP">
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="8" span="1" word="k" lemma="k" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <rule type="fa" cat="N">
          <lf start="9" span="1" word="&lt;" lemma="&lt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <rule type="fa" cat="N">
           <lf start="10" span="1" word="/sub" lemma="/sub" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
           <lf start="11" span="1" word="&gt;" lemma="&gt;" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
        <rule type="lex" cat="NP\NP">
         <rule type="fa" cat="S[dcl]\NP">
          <lf start="12" span="1" word="&lt;" lemma="&lt;" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
          <rule type="ba" cat="NP">
           <rule type="lex" cat="NP">
            <rule type="fa" cat="N">
             <lf start="13" span="1" word="/code" lemma="/code" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="14" span="1" word="&gt;" lemma="&gt;" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
           <rule type="lex" cat="NP\NP">
            <rule type="fa" cat="S[to]\NP">
             <lf start="15" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
             <rule type="fa" cat="S[b]\NP">
              <lf start="16" span="1" word="be" lemma="be" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
              <rule type="ba" cat="NP">
               <rule type="fa" cat="NP[nb]">
                <lf start="17" span="1" word="an" lemma="an" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                <lf start="18" span="1" word="array" lemma="array" pos="NN" chunk="I-NP" entity="O" cat="N" />
               </rule>
               <rule type="lex" cat="NP\NP">
                <rule type="ba" cat="S[pss]\NP">
                 <lf start="19" span="1" word="obtained" lemma="obtain" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
                 <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
                  <lf start="20" span="1" word="by" lemma="by" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/(S[ng]\NP)" />
                  <rule type="ba" cat="S[ng]\NP">
                   <rule type="fa" cat="S[ng]\NP">
                    <lf start="21" span="1" word="rotating" lemma="rotate" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
                    <rule type="lex" cat="NP">
                     <lf start="22" span="1" word="param_nums" lemma="param_nums" pos="NNS" chunk="I-NP" entity="O" cat="N" />
                    </rule>
                   </rule>
                   <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
                    <lf start="23" span="1" word="by" lemma="by" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/(S[ng]\NP)" />
                    <rule type="fa" cat="S[ng]\NP">
                     <lf start="24" span="1" word="expr_a" lemma="expr_a" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
                     <rule type="ba" cat="NP">
                      <rule type="lex" cat="NP">
                       <lf start="25" span="1" word="positions" lemma="position" pos="NNS" chunk="I-NP" entity="O" cat="N" />
                      </rule>
                      <rule type="lex" cat="NP\NP">
                       <lf start="26" span="1" word="clock-wise" lemma="clock-wise" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
                      </rule>
                     </rule>
                    </rule>
                   </rule>
                  </rule>
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="27" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
