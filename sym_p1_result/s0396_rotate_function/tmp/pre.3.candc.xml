<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <lf start="0" span="1" word="We" lemma="we" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="1" span="1" word="define" lemma="define" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/S[dcl]" />
    <rule type="ba" cat="S[dcl]">
     <rule type="ba" cat="NP">
      <rule type="fa" cat="NP[nb]">
       <lf start="2" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <rule type="fa" cat="N">
        <lf start="3" span="1" word="rotation" lemma="rotation" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <rule type="fa" cat="N">
         <lf start="4" span="1" word="function" lemma="function" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="5" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="6" span="1" word="on" lemma="on" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <lf start="7" span="1" word="param_nums" lemma="param_nums" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <lf start="8" span="1" word="as" lemma="as" pos="RB" chunk="I-ADVP" entity="O" cat="NP\NP" />
       </rule>
      </rule>
     </rule>
     <rule type="rp" cat="S[dcl]\NP">
      <lf start="9" span="1" word="follow" lemma="follow" pos="VBP" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
      <lf start="10" span="1" word=":" lemma=":" pos=":" chunk="O" entity="O" cat=":" />
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="11" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
