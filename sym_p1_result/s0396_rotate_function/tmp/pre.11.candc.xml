<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="ba" cat="NP">
   <rule type="ba" cat="NP">
    <rule type="ba" cat="NP">
     <rule type="ba" cat="NP">
      <rule type="ba" cat="NP">
       <rule type="lex" cat="NP">
        <lf start="0" span="1" word="F" lemma="F" pos="NNP" chunk="I-NP" entity="I-ORG" cat="N" />
       </rule>
       <rule type="fa" cat="NP\NP">
        <lf start="1" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
        <rule type="lex" cat="NP">
         <rule type="fa" cat="N">
          <lf start="2" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
          <rule type="lp" cat="N">
           <lf start="3" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
           <lf start="4" span="1" word="=" lemma="=" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="5" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
       <rule type="lex" cat="NP">
        <rule type="fa" cat="N">
         <rule type="fa" cat="N/N">
          <lf start="6" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="O" cat="(N/N)/(N/N)" />
          <lf start="7" span="1" word="4" lemma="4" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
         </rule>
         <rule type="lp" cat="N">
          <lf start="8" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
          <lf start="9" span="1" word="+" lemma="+" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
     <rule type="fa" cat="NP\NP">
      <lf start="10" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
      <rule type="lex" cat="NP">
       <rule type="fa" cat="N">
        <lf start="11" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
        <rule type="fa" cat="N">
         <lf start="12" span="1" word="3" lemma="3" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
         <rule type="lp" cat="N">
          <lf start="13" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
          <lf start="14" span="1" word="+" lemma="+" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="rp" cat="NP\NP">
     <rule type="fa" cat="NP\NP">
      <lf start="15" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
      <rule type="lex" cat="NP">
       <rule type="fa" cat="N">
        <lf start="16" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="17" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N[num]" />
       </rule>
      </rule>
     </rule>
     <lf start="18" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
    </rule>
   </rule>
   <lf start="19" span="1" word="+" lemma="+" pos="NN" chunk="I-NP" entity="O" cat="NP\NP" />
  </rule>
  <rule type="fa" cat="NP\NP">
   <lf start="20" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
   <rule type="rp" cat="NP">
    <rule type="ba" cat="NP">
     <rule type="lex" cat="NP">
      <rule type="fa" cat="N">
       <lf start="21" span="1" word="3" lemma="3" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="fa" cat="N">
        <lf start="22" span="1" word="6" lemma="6" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
        <rule type="ba" cat="N">
         <rule type="lp" cat="N">
          <lf start="23" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
          <lf start="24" span="1" word="=" lemma="=" pos="SYM" chunk="I-NP" entity="O" cat="N" />
         </rule>
         <lf start="25" span="1" word="25" lemma="25" pos="CD" chunk="I-NP" entity="O" cat="N\N" />
        </rule>
       </rule>
      </rule>
     </rule>
     <rule type="fa" cat="NP\NP">
      <lf start="26" span="1" word="=" lemma="=" pos="NNP" chunk="I-NP" entity="I-DAT" cat="(NP\NP)/N[num]" />
      <lf start="27" span="1" word="25" lemma="25" pos="CD" chunk="I-NP" entity="I-DAT" cat="N[num]" />
     </rule>
    </rule>
    <lf start="28" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
