<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="lex" cat="NP">
     <rule type="fa" cat="N">
      <lf start="0" span="1" word="&lt;" lemma="&lt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
      <rule type="fa" cat="N">
       <lf start="1" span="1" word="code" lemma="code" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="fa" cat="N">
        <lf start="2" span="1" word="&gt;" lemma="&gt;" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <rule type="fa" cat="N">
         <lf start="3" span="1" word="F" lemma="F" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
         <rule type="fa" cat="N">
          <rule type="rp" cat="N/N">
           <rule type="fa" cat="N/N">
            <lf start="4" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(N/N)/N" />
            <lf start="5" span="1" word="k" lemma="k" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
           <lf start="6" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
          </rule>
          <lf start="7" span="1" word="=" lemma="=" pos="SYM" chunk="I-VP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="8" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="O" cat="(NP\NP)/(NP\NP)" />
     <rule type="fa" cat="NP\NP">
      <lf start="9" span="1" word="arr" lemma="arr" pos="NN" chunk="I-NP" entity="O" cat="(NP\NP)/(NP\NP)" />
      <rule type="fa" cat="NP\NP">
       <lf start="10" span="1" word="&lt;" lemma="&lt;" pos="NN" chunk="I-NP" entity="O" cat="(NP\NP)/(NP\NP)" />
       <rule type="fa" cat="NP\NP">
        <lf start="11" span="1" word="sub" lemma="sub" pos="NN" chunk="I-NP" entity="O" cat="(NP\NP)/(NP\NP)" />
        <rule type="fa" cat="NP\NP">
         <lf start="12" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="O" cat="(NP\NP)/(NP\NP)" />
         <rule type="fa" cat="NP\NP">
          <lf start="13" span="1" word="k" lemma="k" pos="NNP" chunk="I-NP" entity="O" cat="(NP\NP)/(NP\NP)" />
          <rule type="fa" cat="NP\NP">
           <lf start="14" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="(NP\NP)/(NP\NP)" />
           <rule type="fa" cat="NP\NP">
            <lf start="15" span="1" word="/sub" lemma="/sub" pos="NNP" chunk="I-NP" entity="O" cat="(NP\NP)/(NP\NP)" />
            <rule type="fa" cat="NP\NP">
             <lf start="16" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="O" cat="(NP\NP)/(NP\NP)" />
             <lf start="17" span="1" word="arr_a" lemma="arr_a" pos="NN" chunk="I-NP" entity="O" cat="NP\NP" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <rule type="bx" cat="(S[dcl]\NP)/NP">
     <rule type="fc" cat="(S[dcl]\NP)/NP">
      <lf start="18" span="1" word="+" lemma="+" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      <rule type="fc" cat="NP/NP">
       <rule type="lex" cat="NP/(NP\NP)">
        <rule type="ba" cat="NP">
         <rule type="lex" cat="NP">
          <rule type="fa" cat="N">
           <lf start="19" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
           <rule type="fa" cat="N">
            <lf start="20" span="1" word="arr" lemma="arr" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
            <rule type="fa" cat="N">
             <lf start="21" span="1" word="&lt;" lemma="&lt;" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
             <rule type="fa" cat="N">
              <lf start="22" span="1" word="sub" lemma="sub" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
              <rule type="fa" cat="N">
               <lf start="23" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
               <rule type="fa" cat="N">
                <lf start="24" span="1" word="k" lemma="k" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                <rule type="fa" cat="N">
                 <lf start="25" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                 <rule type="fa" cat="N">
                  <lf start="26" span="1" word="/sub" lemma="/sub" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                  <rule type="fa" cat="N">
                   <lf start="27" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                   <rule type="fa" cat="N">
                    <lf start="28" span="1" word="arr_b" lemma="arr_b" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                    <rule type="fa" cat="N">
                     <rule type="rp" cat="N/N">
                      <lf start="29" span="1" word="+" lemma="+" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                      <lf start="30" span="1" word="..." lemma="..." pos=":" chunk="O" entity="O" cat=":" />
                     </rule>
                     <lf start="31" span="1" word="+" lemma="+" pos="NNS" chunk="I-NP" entity="O" cat="N" />
                    </rule>
                   </rule>
                  </rule>
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
         <rule type="fa" cat="NP\NP">
          <lf start="32" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
          <rule type="fa" cat="NP">
           <lf start="33" span="1" word="n" lemma="n" pos="SYM" chunk="I-NP" entity="O" cat="NP/NP" />
           <rule type="lex" cat="NP">
            <rule type="lp" cat="N">
             <lf start="34" span="1" word="-" lemma="-" pos=":" chunk="O" entity="O" cat=":" />
             <rule type="fa" cat="N">
              <lf start="35" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
              <rule type="lp" cat="N">
               <lf start="36" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
               <rule type="fa" cat="N">
                <lf start="37" span="1" word="arr" lemma="arr" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                <rule type="fa" cat="N">
                 <lf start="38" span="1" word="&lt;" lemma="&lt;" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                 <rule type="fa" cat="N">
                  <lf start="39" span="1" word="sub" lemma="sub" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                  <rule type="fa" cat="N">
                   <lf start="40" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                   <rule type="fa" cat="N">
                    <lf start="41" span="1" word="k" lemma="k" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                    <rule type="fa" cat="N">
                     <lf start="42" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                     <rule type="fa" cat="N">
                      <lf start="43" span="1" word="/sub" lemma="/sub" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                      <rule type="fa" cat="N">
                       <lf start="44" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                       <rule type="fa" cat="N">
                        <lf start="45" span="1" word="[" lemma="[" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                        <lf start="46" span="1" word="n" lemma="n" pos="NN" chunk="I-NP" entity="O" cat="N" />
                       </rule>
                      </rule>
                     </rule>
                    </rule>
                   </rule>
                  </rule>
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
       <lf start="47" span="1" word="-" lemma="-" pos=":" chunk="O" entity="O" cat="(NP\NP)/NP" />
      </rule>
     </rule>
     <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
      <lf start="48" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="((S\NP)\(S\NP))/((S\NP)\(S\NP))" />
      <rule type="rp" cat="(S[X]\NP)\(S[X]\NP)">
       <lf start="49" span="1" word="]" lemma="]" pos="NNP" chunk="I-NP" entity="O" cat="(S\NP)\(S\NP)" />
       <lf start="50" span="1" word="." lemma="." pos="." chunk="I-NP" entity="O" cat="." />
      </rule>
     </rule>
    </rule>
    <rule type="lex" cat="NP">
     <rule type="fa" cat="N">
      <lf start="51" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="I-PER" cat="N/N" />
      <rule type="fa" cat="N">
       <lf start="52" span="1" word="/code" lemma="/code" pos="NNP" chunk="I-NP" entity="I-PER" cat="N/N" />
       <lf start="53" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="I-PER" cat="N" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="54" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
