<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[b]\NP">
  <lf start="0" span="1" word="Write" lemma="write" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
  <rule type="ba" cat="NP">
   <rule type="fa" cat="NP[nb]">
    <lf start="1" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <lf start="2" span="1" word="function" lemma="function" pos="NN" chunk="I-NP" entity="O" cat="N" />
   </rule>
   <rule type="ba" cat="NP\NP">
    <rule type="fa" cat="NP\NP">
     <lf start="3" span="1" word="that" lemma="that" pos="WDT" chunk="B-NP" entity="O" cat="(NP\NP)/(S[dcl]\NP)" />
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="4" span="1" word="takes" lemma="take" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      <rule type="fa" cat="NP[nb]">
       <lf start="5" span="1" word="an" lemma="an" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <rule type="fa" cat="N">
        <lf start="6" span="1" word="unsigned" lemma="unsigned" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="7" span="1" word="integer" lemma="integer" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="conj" cat="(NP\NP)\(NP\NP)">
     <lf start="8" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
     <rule type="lex" cat="NP\NP">
      <rule type="rp" cat="S[dcl]">
       <rule type="ba" cat="S[dcl]">
        <rule type="fa" cat="NP[nb]">
         <lf start="9" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <lf start="10" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="11" span="1" word="iss" lemma="iss" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
         <rule type="ba" cat="NP">
          <rule type="ba" cat="NP">
           <rule type="fa" cat="NP[nb]">
            <lf start="12" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
            <lf start="13" span="1" word="number" lemma="number" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
           <rule type="fa" cat="NP\NP">
            <lf start="14" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
            <rule type="ba" cat="NP">
             <rule type="lex" cat="NP">
              <rule type="fa" cat="N">
               <lf start="15" span="1" word="strx_a" lemma="strx_a" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
               <lf start="16" span="1" word="bits" lemma="bit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
              </rule>
             </rule>
             <rule type="lex" cat="NP\NP">
              <rule type="fc" cat="S[dcl]/NP">
               <rule type="tr" cat="S[X]/(S[X]\NP)">
                <lf start="17" span="1" word="it" lemma="it" pos="PRP" chunk="B-NP" entity="O" cat="NP" />
               </rule>
               <lf start="18" span="1" word="has" lemma="have" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
          <rule type="rp" cat="NP\NP">
           <rule type="rp" cat="NP\NP">
            <rule type="fa" cat="NP\NP">
             <lf start="19" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/(S[pss]\NP)" />
             <rule type="fa" cat="S[pss]\NP">
              <lf start="20" span="1" word="also" lemma="also" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)/(S\NP)" />
              <rule type="fa" cat="S[pss]\NP">
               <lf start="21" span="1" word="known" lemma="know" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/PP" />
               <rule type="fa" cat="PP">
                <lf start="22" span="1" word="as" lemma="as" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
                <rule type="ba" cat="NP">
                 <rule type="fa" cat="NP[nb]">
                  <lf start="23" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                  <rule type="fa" cat="N">
                   <lf start="24" span="1" word="[" lemma="[" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                   <rule type="fa" cat="N">
                    <lf start="25" span="1" word="Hamming" lemma="ham" pos="VBG" chunk="I-VP" entity="O" cat="N/N" />
                    <rule type="fa" cat="N">
                     <lf start="26" span="1" word="weight" lemma="weight" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                     <lf start="27" span="1" word="]" lemma="]" pos="NNS" chunk="I-NP" entity="O" cat="N" />
                    </rule>
                   </rule>
                  </rule>
                 </rule>
                 <rule type="fa" cat="NP\NP">
                  <lf start="28" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
                  <rule type="ba" cat="NP">
                   <rule type="lex" cat="NP">
                    <lf start="29" span="1" word="http" lemma="http" pos="NN" chunk="I-NP" entity="O" cat="N" />
                   </rule>
                   <rule type="fa" cat="NP\NP">
                    <lf start="30" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
                    <rule type="lex" cat="NP">
                     <lf start="31" span="1" word="//en.wikipedia.org/wiki/Hammingweight" lemma="//en.wikipedia.org/wiki/Hammingweight" pos="NNP" chunk="I-NP" entity="I-TIM" cat="N" />
                    </rule>
                   </rule>
                  </rule>
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
            <lf start="32" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
           </rule>
           <lf start="33" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
          </rule>
         </rule>
        </rule>
       </rule>
       <lf start="34" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
