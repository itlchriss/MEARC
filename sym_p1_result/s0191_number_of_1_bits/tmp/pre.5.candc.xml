<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[dcl]">
  <rule type="fa" cat="S[X]/S[X]">
   <lf start="0" span="1" word="In" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(S/S)/NP" />
   <rule type="lex" cat="NP">
    <lf start="1" span="1" word="Java" lemma="Java" pos="NNP" chunk="I-NP" entity="I-LOC" cat="N" />
   </rule>
  </rule>
  <rule type="lp" cat="S[dcl]">
   <lf start="2" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <rule type="fa" cat="NP[nb]">
      <lf start="3" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="4" span="1" word="compiler" lemma="compiler" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="5" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      <rule type="ba" cat="NP">
       <rule type="fa" cat="NP[nb]">
        <lf start="6" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <rule type="fa" cat="N">
         <lf start="7" span="1" word="signed" lemma="signed" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="8" span="1" word="integers" lemma="integer" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
       <rule type="lex" cat="NP\NP">
        <rule type="fa" cat="S[ng]\NP">
         <lf start="9" span="1" word="using" lemma="use" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
         <rule type="ba" cat="NP">
          <rule type="fa" cat="NP[nb]">
           <rule type="ba" cat="NP[nb]/N">
            <rule type="lex" cat="NP">
             <rule type="ba" cat="N">
              <lf start="10" span="1" word="[" lemma="[" pos="NNP" chunk="I-NP" entity="O" cat="N" />
              <lf start="11" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N\N" />
             </rule>
            </rule>
            <lf start="12" span="1" word="'s" lemma="'s" pos="POS" chunk="B-NP" entity="O" cat="(NP[nb]/N)\NP" />
           </rule>
           <rule type="fa" cat="N">
            <lf start="13" span="1" word="complement" lemma="complement" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
            <rule type="fa" cat="N">
             <lf start="14" span="1" word="notation" lemma="notation" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="15" span="1" word="]" lemma="]" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
          <rule type="rp" cat="NP\NP">
           <rule type="fa" cat="NP\NP">
            <lf start="16" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
            <rule type="ba" cat="NP">
             <rule type="lex" cat="NP">
              <lf start="17" span="1" word="https" lemma="http" pos="NNS" chunk="I-NP" entity="O" cat="N" />
             </rule>
             <rule type="fa" cat="NP\NP">
              <lf start="18" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
              <rule type="lex" cat="NP">
               <rule type="fa" cat="N">
                <lf start="19" span="1" word="//en.wikipedia.org/wiki/Two" lemma="//en.wikipedia.org/wiki/Two" pos="NNP" chunk="I-NP" entity="I-PCT" cat="N/N" />
                <rule type="fa" cat="N">
                 <lf start="20" span="1" word="%" lemma="%" pos="NN" chunk="I-NP" entity="I-PCT" cat="N/N" />
                 <lf start="21" span="1" word="27scomplement" lemma="27scomplement" pos="NN" chunk="I-NP" entity="I-PCT" cat="N" />
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
           <lf start="22" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="23" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
