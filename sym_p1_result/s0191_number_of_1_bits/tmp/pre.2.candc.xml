<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[b]\NP">
  <rule type="ba" cat="S[b]\NP">
   <rule type="fa" cat="S[b]\NP">
    <lf start="0" span="1" word="Note" lemma="note" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
    <lf start="1" span="1" word="that" lemma="that" pos="DT" chunk="I-NP" entity="O" cat="NP" />
   </rule>
   <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
    <lf start="2" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
    <rule type="ba" cat="NP">
     <rule type="rp" cat="NP">
      <rule type="ba" cat="NP">
       <rule type="rp" cat="NP">
        <rule type="lex" cat="NP">
         <lf start="3" span="1" word="languages" lemma="language" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <lf start="4" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
       </rule>
       <rule type="fa" cat="NP\NP">
        <lf start="5" span="1" word="such" lemma="such" pos="JJ" chunk="I-PP" entity="O" cat="(NP\NP)/(NP\NP)" />
        <rule type="fa" cat="NP\NP">
         <lf start="6" span="1" word="as" lemma="as" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
         <rule type="lex" cat="NP">
          <lf start="7" span="1" word="Java" lemma="Java" pos="NNP" chunk="I-NP" entity="I-LOC" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
      <lf start="8" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
     </rule>
     <rule type="lex" cat="NP\NP">
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="9" span="1" word="exists" lemma="exist" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
       <rule type="fa" cat="NP[nb]">
        <lf start="10" span="1" word="no" lemma="no" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <rule type="fa" cat="N">
         <lf start="11" span="1" word="unsigned" lemma="unsigned" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
         <rule type="fa" cat="N">
          <lf start="12" span="1" word="integer" lemma="integer" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="13" span="1" word="type" lemma="type" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="14" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
