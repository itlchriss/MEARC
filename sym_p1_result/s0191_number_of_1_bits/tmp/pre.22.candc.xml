<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[wq]">
  <rule type="rp" cat="S[wq]">
   <rule type="fa" cat="S[wq]">
    <rule type="rtc" cat="S[X]/S[X]">
     <rule type="ba" cat="NP">
      <rule type="ba" cat="NP">
       <rule type="lex" cat="NP">
        <lf start="0" span="1" word="Follow" lemma="follow" pos="VB" chunk="I-VP" entity="O" cat="N" />
       </rule>
       <rule type="lex" cat="NP\NP">
        <lf start="1" span="1" word="up" lemma="up" pos="RB" chunk="I-ADVP" entity="O" cat="S[adj]\NP" />
       </rule>
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="2" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/S[dcl]" />
       <rule type="fa" cat="S[dcl]">
        <rule type="fa" cat="S[X]/S[X]">
         <lf start="3" span="1" word="If" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="(S/S)/NP" />
         <lf start="4" span="1" word="this" lemma="this" pos="DT" chunk="I-NP" entity="O" cat="NP" />
        </rule>
        <rule type="ba" cat="S[dcl]">
         <rule type="lex" cat="NP">
          <lf start="5" span="1" word="function" lemma="function" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
         <rule type="fa" cat="S[dcl]\NP">
          <lf start="6" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
          <rule type="fa" cat="S[pss]\NP">
           <lf start="7" span="1" word="called" lemma="call" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/NP" />
           <rule type="lex" cat="NP">
            <rule type="fa" cat="N">
             <lf start="8" span="1" word="many" lemma="many" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="9" span="1" word="times" lemma="time" pos="NNS" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
     <lf start="10" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    </rule>
    <rule type="fa" cat="S[wq]">
     <lf start="11" span="1" word="how" lemma="how" pos="WRB" chunk="I-ADVP" entity="O" cat="S[wq]/S[q]" />
     <rule type="fa" cat="S[q]">
      <rule type="fa" cat="S[q]/(S[b]\NP)">
       <lf start="12" span="1" word="would" lemma="would" pos="MD" chunk="O" entity="O" cat="(S[q]/(S[b]\NP))/NP" />
       <lf start="13" span="1" word="you" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
      </rule>
      <rule type="fa" cat="S[b]\NP">
       <lf start="14" span="1" word="optimize" lemma="optimize" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
       <lf start="15" span="1" word="it" lemma="it" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="16" span="1" word="?" lemma="?" pos="." chunk="O" entity="O" cat="." />
  </rule>
  <lf start="17" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
