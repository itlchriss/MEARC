<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="lex" cat="NP">
   <lf start="0" span="1" word="Explanation" lemma="explanation" pos="NN" chunk="I-NP" entity="O" cat="N" />
  </rule>
  <rule type="fa" cat="NP\NP">
   <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/S[dcl]" />
   <rule type="rp" cat="S[dcl]">
    <rule type="rp" cat="S[dcl]">
     <rule type="ba" cat="S[dcl]">
      <rule type="fa" cat="NP[nb]">
       <lf start="2" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <rule type="fa" cat="N">
        <lf start="3" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="4" span="1" word="tuples" lemma="tuple" pos="NNS" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
      <lf start="5" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
     </rule>
     <lf start="6" span="1" word=":" lemma=":" pos=":" chunk="O" entity="O" cat=":" />
    </rule>
    <lf start="7" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
