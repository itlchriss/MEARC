<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="fa" cat="S[dcl]">
   <rule type="bx" cat="S[dcl]/NP">
    <rule type="fc" cat="S[dcl]/NP">
     <rule type="tr" cat="S[X]/(S[X]\NP)">
      <rule type="lex" cat="NP">
       <rule type="fa" cat="N">
        <lf start="0" span="1" word="&lt;" lemma="&lt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
        <rule type="fa" cat="N">
         <lf start="1" span="1" word="code" lemma="code" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
         <rule type="fa" cat="N">
          <lf start="2" span="1" word="&gt;" lemma="&gt;" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
          <rule type="fa" cat="N">
           <lf start="3" span="1" word="-2" lemma="-2" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
           <rule type="fa" cat="N">
            <lf start="4" span="1" word="&lt;" lemma="&lt;" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="5" span="1" word="sup" lemma="sup" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
     <lf start="6" span="1" word="&gt;" lemma="&gt;" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
    </rule>
    <rule type="lex" cat="S[X]\S[X]">
     <rule type="ba" cat="S[dcl]">
      <rule type="lex" cat="NP">
       <rule type="fa" cat="N">
        <lf start="7" span="1" word="28" lemma="28" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="8" span="1" word="&lt;" lemma="&lt;" pos="NNS" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="9" span="1" word="/sup" lemma="/sup" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <rule type="fa" cat="N">
          <lf start="10" span="1" word="&gt;" lemma="&gt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <rule type="fa" cat="N">
           <lf start="11" span="1" word="&lt;" lemma="&lt;" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
           <rule type="ba" cat="N">
            <lf start="12" span="1" word="=" lemma="=" pos="NN" chunk="I-NP" entity="O" cat="N" />
            <lf start="13" span="1" word="nums1" lemma="nums1" pos="CD" chunk="I-NP" entity="I-DAT" cat="N\N" />
           </rule>
          </rule>
         </rule>
        </rule>
        <rule type="ba" cat="NP\NP">
         <rule type="ba" cat="NP\NP">
          <rule type="fa" cat="NP\NP">
           <lf start="14" span="1" word="[" lemma="[" pos="NNP" chunk="I-NP" entity="I-DAT" cat="(NP\NP)/(NP\NP)" />
           <rule type="fa" cat="NP\NP">
            <lf start="15" span="1" word="i" lemma="i" pos="NNP" chunk="I-NP" entity="I-DAT" cat="(NP\NP)/(NP\NP)" />
            <lf start="16" span="1" word="]" lemma="]" pos="NNP" chunk="I-NP" entity="I-DAT" cat="NP\NP" />
           </rule>
          </rule>
          <rule type="conj" cat="(NP\NP)\(NP\NP)">
           <lf start="17" span="1" word="," lemma="," pos="," chunk="O" entity="I-DAT" cat="," />
           <rule type="ba" cat="NP\NP">
            <rule type="fa" cat="NP\NP">
             <lf start="18" span="1" word="nums2" lemma="nums2" pos="CD" chunk="I-NP" entity="I-DAT" cat="(NP\NP)/(NP\NP)" />
             <rule type="fa" cat="NP\NP">
              <lf start="19" span="1" word="[" lemma="[" pos="NNP" chunk="I-NP" entity="I-DAT" cat="(NP\NP)/(NP\NP)" />
              <rule type="fa" cat="NP\NP">
               <lf start="20" span="1" word="i" lemma="i" pos="NNP" chunk="I-NP" entity="I-DAT" cat="(NP\NP)/(NP\NP)" />
               <lf start="21" span="1" word="]" lemma="]" pos="NNP" chunk="I-NP" entity="I-DAT" cat="NP\NP" />
              </rule>
             </rule>
            </rule>
            <rule type="conj" cat="(NP\NP)\(NP\NP)">
             <lf start="22" span="1" word="," lemma="," pos="," chunk="O" entity="I-DAT" cat="," />
             <rule type="fa" cat="NP\NP">
              <lf start="23" span="1" word="nums3" lemma="nums3" pos="CD" chunk="I-NP" entity="I-DAT" cat="(NP\NP)/(NP\NP)" />
              <rule type="fa" cat="NP\NP">
               <lf start="24" span="1" word="[" lemma="[" pos="NNP" chunk="I-NP" entity="I-DAT" cat="(NP\NP)/(NP\NP)" />
               <rule type="fa" cat="NP\NP">
                <lf start="25" span="1" word="i" lemma="i" pos="NNP" chunk="I-NP" entity="I-DAT" cat="(NP\NP)/(NP\NP)" />
                <lf start="26" span="1" word="]" lemma="]" pos="NNP" chunk="I-NP" entity="I-DAT" cat="NP\NP" />
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
         <rule type="conj" cat="(NP\NP)\(NP\NP)">
          <lf start="27" span="1" word="," lemma="," pos="," chunk="O" entity="I-DAT" cat="," />
          <rule type="lex" cat="NP\NP">
           <rule type="fc" cat="S[dcl]/NP">
            <rule type="tr" cat="S[X]/(S[X]\NP)">
             <rule type="lex" cat="NP">
              <rule type="fa" cat="N">
               <lf start="28" span="1" word="nums4" lemma="nums4" pos="CD" chunk="I-NP" entity="I-DAT" cat="N/N" />
               <rule type="fa" cat="N">
                <lf start="29" span="1" word="[" lemma="[" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
                <rule type="fa" cat="N">
                 <lf start="30" span="1" word="i" lemma="i" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
                 <rule type="fa" cat="N">
                  <lf start="31" span="1" word="]" lemma="]" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
                  <lf start="32" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N" />
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
            <lf start="33" span="1" word="=" lemma="=" pos="VBD" chunk="I-VP" entity="I-DAT" cat="(S[dcl]\NP)/NP" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="lex" cat="NP">
    <rule type="fa" cat="N">
     <rule type="fa" cat="N/N">
      <lf start="34" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="I-DAT" cat="(N/N)/(N/N)" />
      <lf start="35" span="1" word="&lt;" lemma="&lt;" pos="CD" chunk="I-NP" entity="I-DAT" cat="N/N" />
     </rule>
     <rule type="fa" cat="N">
      <lf start="36" span="1" word="sup" lemma="sup" pos="NN" chunk="I-NP" entity="I-DAT" cat="N/N" />
      <rule type="fa" cat="N">
       <lf start="37" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="B-NP" entity="I-DAT" cat="N/N" />
       <rule type="fa" cat="N">
        <lf start="38" span="1" word="28" lemma="28" pos="CD" chunk="I-NP" entity="I-DAT" cat="N/N" />
        <rule type="fa" cat="N">
         <lf start="39" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
         <rule type="fa" cat="N">
          <lf start="40" span="1" word="/sup" lemma="/sup" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
          <rule type="fa" cat="N">
           <lf start="41" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
           <rule type="fa" cat="N">
            <lf start="42" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
            <rule type="fa" cat="N">
             <lf start="43" span="1" word="/code" lemma="/code" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
             <lf start="44" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="45" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
