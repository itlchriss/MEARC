<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="Your" lemma="your" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <lf start="1" span="1" word="tank" lemma="tank" pos="NN" chunk="I-NP" entity="O" cat="N" />
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="2" span="1" word="=" lemma="=" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
    <rule type="lex" cat="NP">
     <rule type="ba" cat="N">
      <rule type="fa" cat="N">
       <lf start="3" span="1" word="4" lemma="4" pos="CD" chunk="I-NP" entity="I-TIM" cat="N/N" />
       <lf start="4" span="1" word="=" lemma="=" pos="NN" chunk="I-NP" entity="I-TIM" cat="N" />
      </rule>
      <lf start="5" span="1" word="4" lemma="4" pos="CD" chunk="I-NP" entity="I-TIM" cat="N\N" />
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="6" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
