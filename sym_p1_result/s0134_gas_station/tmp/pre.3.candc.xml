<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <lf start="0" span="1" word="You" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="1" span="1" word="have" lemma="have" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
     <rule type="ba" cat="NP">
      <rule type="fa" cat="NP[nb]">
       <lf start="2" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <lf start="3" span="1" word="car" lemma="car" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="4" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
       <rule type="fa" cat="NP[nb]">
        <lf start="5" span="1" word="an" lemma="an" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <rule type="fa" cat="N">
         <lf start="6" span="1" word="unlimited" lemma="unlimited" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
         <rule type="fa" cat="N">
          <lf start="7" span="1" word="gas" lemma="gas" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="8" span="1" word="tank" lemma="tank" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="conj" cat="S[dcl]\S[dcl]">
    <lf start="9" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
    <rule type="fa" cat="S[dcl]">
     <rule type="bx" cat="S[dcl]/NP">
      <rule type="fc" cat="S[dcl]/NP">
       <rule type="tr" cat="S[X]/(S[X]\NP)">
        <lf start="10" span="1" word="it" lemma="it" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
       </rule>
       <lf start="11" span="1" word="costs" lemma="cost" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      </rule>
      <rule type="lex" cat="S[X]\S[X]">
       <rule type="ba" cat="S[dcl]">
        <rule type="ba" cat="NP">
         <rule type="ba" cat="NP">
          <rule type="lex" cat="NP">
           <lf start="12" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
          <rule type="fa" cat="NP\NP">
           <lf start="13" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
           <rule type="lex" cat="NP">
            <lf start="14" span="1" word="gas" lemma="gas" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
         <rule type="lex" cat="NP\NP">
          <rule type="fa" cat="S[to]\NP">
           <lf start="15" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
           <rule type="fa" cat="S[b]\NP">
            <lf start="16" span="1" word="travel" lemma="travel" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/PP" />
            <rule type="fa" cat="PP">
             <lf start="17" span="1" word="from" lemma="from" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
             <rule type="ba" cat="NP">
              <rule type="fa" cat="NP[nb]">
               <lf start="18" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
               <rule type="fa" cat="N">
                <lf start="19" span="1" word="&lt;" lemma="&lt;" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                <rule type="fa" cat="N">
                 <lf start="20" span="1" word="code" lemma="code" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                 <rule type="fa" cat="N">
                  <lf start="21" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                  <rule type="fa" cat="N">
                   <lf start="22" span="1" word="i" lemma="i" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                   <rule type="fa" cat="N">
                    <lf start="23" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                    <lf start="24" span="1" word="sup" lemma="sup" pos="NN" chunk="I-NP" entity="O" cat="N" />
                   </rule>
                  </rule>
                 </rule>
                </rule>
               </rule>
              </rule>
              <rule type="lex" cat="NP\NP">
               <rule type="fa" cat="S[dcl]\NP">
                <lf start="25" span="1" word="&gt;" lemma="&gt;" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
                <rule type="lex" cat="NP">
                 <rule type="fa" cat="N">
                  <lf start="26" span="1" word="th" lemma="th" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                  <rule type="fa" cat="N">
                   <lf start="27" span="1" word="&lt;" lemma="&lt;" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                   <lf start="28" span="1" word="/sup" lemma="/sup" pos="NN" chunk="I-NP" entity="O" cat="N" />
                  </rule>
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="29" span="1" word="&gt;" lemma="&gt;" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
         <rule type="ba" cat="NP">
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="30" span="1" word="&lt;" lemma="&lt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
            <rule type="fa" cat="N">
             <lf start="31" span="1" word="/code" lemma="/code" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
             <rule type="fa" cat="N">
              <lf start="32" span="1" word="&gt;" lemma="&gt;" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
              <lf start="33" span="1" word="station" lemma="station" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
          </rule>
          <rule type="fa" cat="NP\NP">
           <lf start="34" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
           <rule type="ba" cat="NP">
            <rule type="fa" cat="NP[nb]">
             <lf start="35" span="1" word="its" lemma="its" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
             <rule type="fa" cat="N">
              <lf start="36" span="1" word="next" lemma="next" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
              <rule type="fa" cat="N">
               <lf start="37" span="1" word="&lt;" lemma="&lt;" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
               <rule type="fa" cat="N">
                <lf start="38" span="1" word="code" lemma="code" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                <lf start="39" span="1" word="&gt;" lemma="&gt;" pos="NN" chunk="I-NP" entity="O" cat="N" />
               </rule>
              </rule>
             </rule>
            </rule>
            <rule type="rp" cat="NP\NP">
             <rule type="fa" cat="NP\NP">
              <lf start="40" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
              <rule type="lex" cat="NP">
               <rule type="ba" cat="N">
                <rule type="ba" cat="N">
                 <lf start="41" span="1" word="i" lemma="i" pos="FW" chunk="I-NP" entity="O" cat="N" />
                 <lf start="42" span="1" word="+" lemma="+" pos="FW" chunk="I-NP" entity="O" cat="N\N" />
                </rule>
                <lf start="43" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N\N" />
               </rule>
              </rule>
             </rule>
             <lf start="44" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
     <rule type="lex" cat="NP">
      <rule type="fa" cat="N">
       <lf start="45" span="1" word="&lt;" lemma="&lt;" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="fa" cat="N">
        <lf start="46" span="1" word="sup" lemma="sup" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <rule type="fa" cat="N">
         <lf start="47" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
         <rule type="fa" cat="N">
          <lf start="48" span="1" word="th" lemma="th" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
          <rule type="fa" cat="N">
           <lf start="49" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
           <rule type="fa" cat="N">
            <lf start="50" span="1" word="/sup" lemma="/sup" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
            <rule type="fa" cat="N">
             <lf start="51" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
             <rule type="fa" cat="N">
              <lf start="52" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
              <rule type="fa" cat="N">
               <lf start="53" span="1" word="/code" lemma="/code" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
               <rule type="fa" cat="N">
                <lf start="54" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                <lf start="55" span="1" word="station" lemma="station" pos="NN" chunk="I-NP" entity="O" cat="N" />
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="56" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
