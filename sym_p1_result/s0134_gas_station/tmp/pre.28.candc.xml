<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[b]\NP">
  <rule type="ba" cat="S[b]\NP">
   <rule type="ba" cat="S[b]\NP">
    <rule type="ba" cat="S[b]\NP">
     <rule type="ba" cat="S[b]\NP">
      <rule type="fa" cat="S[b]\NP">
       <lf start="0" span="1" word="Let" lemma="let" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
       <rule type="lex" cat="NP">
        <lf start="1" span="1" word="'s" lemma="'s" pos="POS" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
      <lf start="2" span="1" word="start" lemma="start" pos="NN" chunk="I-NP" entity="O" cat="(S\NP)\(S\NP)" />
     </rule>
     <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
      <lf start="3" span="1" word="at" lemma="at" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
      <rule type="lex" cat="NP">
       <rule type="ba" cat="N">
        <rule type="ba" cat="N">
         <lf start="4" span="1" word="station" lemma="station" pos="NN" chunk="I-NP" entity="O" cat="N" />
         <lf start="5" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="I-DAT" cat="N\N" />
        </rule>
        <rule type="conj" cat="N\N">
         <lf start="6" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
         <lf start="7" span="1" word="fill" lemma="fill" pos="VB" chunk="I-VP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="8" span="1" word="up" lemma="up" pos="RP" chunk="I-PRT" entity="O" cat="(S\NP)\(S\NP)" />
   </rule>
   <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
    <lf start="9" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
    <rule type="ba" cat="NP">
     <rule type="lex" cat="NP">
      <rule type="fa" cat="N">
       <lf start="10" span="1" word="4" lemma="4" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
       <lf start="11" span="1" word="unit" lemma="unit" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
     <rule type="fa" cat="NP\NP">
      <lf start="12" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
      <rule type="lex" cat="NP">
       <lf start="13" span="1" word="gas" lemma="gas" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="14" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
