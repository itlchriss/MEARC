<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="(S[X]\NP)\((S[X]\NP)/NP)">
  <rule type="bc" cat="(S[X]\NP)\((S[X]\NP)/NP)">
   <rule type="tr" cat="(S[X]\NP)\((S[X]\NP)/NP)">
    <rule type="lex" cat="NP">
     <lf start="0" span="1" word="Start" lemma="Start" pos="NNP" chunk="I-NP" entity="O" cat="N" />
    </rule>
   </rule>
   <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
    <lf start="1" span="1" word="at" lemma="at" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
    <rule type="ba" cat="NP">
     <rule type="lex" cat="NP">
      <rule type="ba" cat="N">
       <lf start="2" span="1" word="station" lemma="station" pos="NN" chunk="I-NP" entity="O" cat="N" />
       <lf start="3" span="1" word="3" lemma="3" pos="CD" chunk="I-NP" entity="I-DAT" cat="N\N" />
      </rule>
     </rule>
     <rule type="rp" cat="NP\NP">
      <rule type="fa" cat="NP\NP">
       <lf start="4" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
       <rule type="lex" cat="NP">
        <rule type="ba" cat="N">
         <lf start="5" span="1" word="index" lemma="index" pos="NN" chunk="I-NP" entity="O" cat="N" />
         <lf start="6" span="1" word="3" lemma="3" pos="CD" chunk="I-NP" entity="O" cat="N\N" />
        </rule>
       </rule>
      </rule>
      <lf start="7" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
     </rule>
    </rule>
   </rule>
  </rule>
  <rule type="conj" cat="((S[X]\NP)\((S[X]\NP)/NP))\((S[X]\NP)\((S[X]\NP)/NP))">
   <lf start="8" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
   <rule type="bc" cat="(S[X]\NP)\((S[X]\NP)/NP)">
    <rule type="bc" cat="(S[X]\NP)\((S[X]\NP)/NP)">
     <rule type="tr" cat="(S[X]\NP)\((S[X]\NP)/NP)">
      <rule type="lex" cat="NP">
       <lf start="9" span="1" word="fill" lemma="fill" pos="VB" chunk="I-VP" entity="O" cat="N" />
      </rule>
     </rule>
     <lf start="10" span="1" word="up" lemma="up" pos="RP" chunk="I-PRT" entity="O" cat="(S\NP)\(S\NP)" />
    </rule>
    <rule type="rp" cat="(S[X]\NP)\(S[X]\NP)">
     <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
      <lf start="11" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
      <rule type="ba" cat="NP">
       <rule type="lex" cat="NP">
        <rule type="fa" cat="N">
         <lf start="12" span="1" word="4" lemma="4" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="13" span="1" word="unit" lemma="unit" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
       <rule type="fa" cat="NP\NP">
        <lf start="14" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
        <rule type="lex" cat="NP">
         <lf start="15" span="1" word="gas" lemma="gas" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
     <lf start="16" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
