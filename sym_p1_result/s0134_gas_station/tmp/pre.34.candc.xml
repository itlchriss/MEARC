<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <lf start="0" span="1" word="You" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
   <rule type="fa" cat="S[dcl]\NP">
    <rule type="bx" cat="(S[dcl]\NP)/(S[b]\NP)">
     <lf start="1" span="1" word="can" lemma="can" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
     <lf start="2" span="1" word="not" lemma="not" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)\(S\NP)" />
    </rule>
    <rule type="ba" cat="S[b]\NP">
     <rule type="rp" cat="S[b]\NP">
      <rule type="ba" cat="S[b]\NP">
       <rule type="ba" cat="S[b]\NP">
        <lf start="3" span="1" word="travel" lemma="travel" pos="VB" chunk="I-VP" entity="O" cat="S[b]\NP" />
        <lf start="4" span="1" word="back" lemma="back" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
       </rule>
       <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
        <lf start="5" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
        <rule type="lex" cat="NP">
         <rule type="ba" cat="N">
          <lf start="6" span="1" word="station" lemma="station" pos="NN" chunk="I-NP" entity="O" cat="N" />
          <lf start="7" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="I-DAT" cat="N\N" />
         </rule>
        </rule>
       </rule>
      </rule>
      <lf start="8" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
     </rule>
     <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
      <lf start="9" span="1" word="as" lemma="as" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
      <rule type="ba" cat="S[dcl]">
       <rule type="ba" cat="S[dcl]">
        <lf start="10" span="1" word="it" lemma="it" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="11" span="1" word="requires" lemma="require" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
         <rule type="ba" cat="NP">
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="12" span="1" word="4" lemma="4" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="13" span="1" word="unit" lemma="unit" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
          <rule type="fa" cat="NP\NP">
           <lf start="14" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
           <rule type="lex" cat="NP">
            <lf start="15" span="1" word="gas" lemma="gas" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
       <rule type="conj" cat="S[dcl]\S[dcl]">
        <lf start="16" span="1" word="but" lemma="but" pos="CC" chunk="O" entity="O" cat="conj" />
        <rule type="ba" cat="S[dcl]">
         <lf start="17" span="1" word="you" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
         <rule type="fa" cat="S[dcl]\NP">
          <lf start="18" span="1" word="only" lemma="only" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)/(S\NP)" />
          <rule type="fa" cat="S[dcl]\NP">
           <lf start="19" span="1" word="have" lemma="have" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
           <rule type="lex" cat="NP">
            <lf start="20" span="1" word="3" lemma="3" pos="CD" chunk="I-NP" entity="I-DAT" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="21" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
