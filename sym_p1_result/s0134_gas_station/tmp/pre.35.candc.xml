<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[dcl]">
  <lf start="0" span="1" word="Therefore" lemma="therefore" pos="RB" chunk="I-ADVP" entity="O" cat="S/S" />
  <rule type="lp" cat="S[dcl]">
   <lf start="1" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <lf start="2" span="1" word="you" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
     <rule type="fa" cat="S[dcl]\NP">
      <rule type="bx" cat="(S[dcl]\NP)/(S[b]\NP)">
       <lf start="3" span="1" word="ca" lemma="can" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
       <lf start="4" span="1" word="n't" lemma="n't" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)\(S\NP)" />
      </rule>
      <rule type="fa" cat="S[b]\NP">
       <rule type="bx" cat="(S[b]\NP)/NP">
        <lf start="5" span="1" word="travel" lemma="travel" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
        <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
         <lf start="6" span="1" word="around" lemma="around" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
         <rule type="fa" cat="NP[nb]">
          <lf start="7" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <lf start="8" span="1" word="circuit" lemma="circuit" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
       <rule type="ba" cat="NP">
        <rule type="fa" cat="NP">
         <lf start="9" span="1" word="once" lemma="once" pos="RB" chunk="I-ADVP" entity="O" cat="NP/NP" />
         <rule type="fa" cat="NP[nb]">
          <lf start="10" span="1" word="no" lemma="no" pos="DT" chunk="I-ADVP" entity="O" cat="NP[nb]/N" />
          <lf start="11" span="1" word="matter" lemma="matter" pos="NN" chunk="I-ADVP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="12" span="1" word="that" lemma="that" pos="IN" chunk="I-SBAR" entity="O" cat="(NP\NP)/(S[dcl]/NP)" />
         <rule type="fc" cat="S[dcl]/NP">
          <rule type="tr" cat="S[X]/(S[X]\NP)">
           <lf start="13" span="1" word="you" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
          </rule>
          <lf start="14" span="1" word="start" lemma="start" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="15" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
