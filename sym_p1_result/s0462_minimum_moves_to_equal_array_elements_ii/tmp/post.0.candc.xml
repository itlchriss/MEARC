<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[dcl]">
  <rule type="lex" cat="S[X]/S[X]">
   <rule type="fa" cat="S[pss]\NP">
    <lf start="0" span="1" word="Given" lemma="Give" pos="VBN" chunk="I-PP" entity="O" cat="(S[pss]\NP)/NP" />
    <rule type="ba" cat="NP">
     <rule type="fa" cat="NP[nb]">
      <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="fa" cat="N">
       <lf start="2" span="1" word="_type_integer" lemma="_type_integer" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="fa" cat="N">
        <lf start="3" span="1" word="array" lemma="array" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="4" span="1" word="param_nums" lemma="param_nums" pos="NNS" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
     <rule type="fa" cat="NP\NP">
      <lf start="5" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
      <rule type="lex" cat="NP">
       <lf start="6" span="1" word="size" lemma="size" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <rule type="fa" cat="S[dcl]">
   <lf start="7" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="S/S" />
   <rule type="lp" cat="S[dcl]">
    <lf start="8" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    <rule type="rp" cat="S[dcl]">
     <rule type="ba" cat="S[dcl]">
      <rule type="fa" cat="NP[nb]">
       <lf start="9" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <lf start="10" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="11" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
       <rule type="ba" cat="NP">
        <rule type="fa" cat="NP[nb]">
         <lf start="12" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="fa" cat="N">
          <lf start="13" span="1" word="minimum" lemma="minimum" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="14" span="1" word="number" lemma="number" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="15" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
         <rule type="ba" cat="NP">
          <rule type="lex" cat="NP">
           <lf start="16" span="1" word="moves" lemma="move" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
          <rule type="lex" cat="NP\NP">
           <rule type="fa" cat="S[pss]\NP">
            <lf start="17" span="1" word="required" lemma="require" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/(S[to]\NP)" />
            <rule type="fa" cat="S[to]\NP">
             <lf start="18" span="1" word="to" lemma="to" pos="TO" chunk="B-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
             <rule type="fa" cat="S[b]\NP">
              <rule type="fa" cat="(S[b]\NP)/(S[adj]\NP)">
               <lf start="19" span="1" word="make" lemma="make" pos="VB" chunk="I-VP" entity="O" cat="((S[b]\NP)/(S[adj]\NP))/NP" />
               <rule type="fa" cat="NP[nb]">
                <lf start="20" span="1" word="all" lemma="all" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                <rule type="fa" cat="N">
                 <lf start="21" span="1" word="array" lemma="array" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                 <lf start="22" span="1" word="elements" lemma="element" pos="NNS" chunk="I-NP" entity="O" cat="N" />
                </rule>
               </rule>
              </rule>
              <lf start="23" span="1" word="equal" lemma="equal" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
     <lf start="24" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
