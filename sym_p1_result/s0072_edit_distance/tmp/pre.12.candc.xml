<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[b]">
  <rule type="ba" cat="S[b]">
   <rule type="ba" cat="NP">
    <rule type="lex" cat="NP">
     <lf start="0" span="1" word="Explanation" lemma="explanation" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
     <rule type="rp" cat="NP">
      <rule type="ba" cat="NP">
       <rule type="lex" cat="NP">
        <lf start="2" span="1" word="intention" lemma="intention" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
       <rule type="fa" cat="NP\NP">
        <lf start="3" span="1" word="-" lemma="-" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
        <rule type="lex" cat="NP">
         <rule type="fa" cat="N">
          <lf start="4" span="1" word="&gt;" lemma="&gt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="5" span="1" word="inention" lemma="inention" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
      <lf start="6" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
     </rule>
    </rule>
   </rule>
   <rule type="ba" cat="S[b]\NP">
    <rule type="fa" cat="S[b]\NP">
     <lf start="7" span="1" word="remove" lemma="remove" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
     <rule type="ba" cat="NP">
      <rule type="lex" cat="NP">
       <rule type="fa" cat="N">
        <lf start="8" span="1" word="strx_a" lemma="strx_a" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <rule type="lp" cat="N">
         <lf start="9" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
         <lf start="10" span="1" word="inention" lemma="inention" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="11" span="1" word="-" lemma="-" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
       <rule type="lex" cat="NP">
        <rule type="fa" cat="N">
         <lf start="12" span="1" word="&gt;" lemma="&gt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="13" span="1" word="enention" lemma="enention" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
     <lf start="14" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="((S\NP)\(S\NP))/(S[b]\NP)" />
     <rule type="ba" cat="S[b]\NP">
      <rule type="fa" cat="S[b]\NP">
       <rule type="fa" cat="(S[b]\NP)/PP">
        <lf start="15" span="1" word="replace" lemma="replace" pos="VB" chunk="I-VP" entity="O" cat="((S[b]\NP)/PP)/NP" />
        <rule type="lex" cat="NP">
         <lf start="16" span="1" word="strx_b" lemma="strx_b" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
       <rule type="fa" cat="PP">
        <lf start="17" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
        <rule type="ba" cat="NP">
         <rule type="lex" cat="NP">
          <rule type="fa" cat="N">
           <lf start="18" span="1" word="strx_c" lemma="strx_c" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
           <rule type="lp" cat="N">
            <lf start="19" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
            <lf start="20" span="1" word="enention" lemma="enention" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
         <rule type="fa" cat="NP\NP">
          <lf start="21" span="1" word="-" lemma="-" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="22" span="1" word="&gt;" lemma="&gt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="23" span="1" word="exention" lemma="exention" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
      <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
       <lf start="24" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="((S\NP)\(S\NP))/(S[b]\NP)" />
       <rule type="ba" cat="S[b]\NP">
        <rule type="fa" cat="S[b]\NP">
         <rule type="fa" cat="(S[b]\NP)/PP">
          <lf start="25" span="1" word="replace" lemma="replace" pos="VB" chunk="I-VP" entity="O" cat="((S[b]\NP)/PP)/NP" />
          <rule type="lex" cat="NP">
           <lf start="26" span="1" word="strx_d" lemma="strx_d" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
         <rule type="fa" cat="PP">
          <lf start="27" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
          <rule type="ba" cat="NP">
           <rule type="lex" cat="NP">
            <rule type="fa" cat="N">
             <lf start="28" span="1" word="strx_e" lemma="strx_e" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
             <rule type="lp" cat="N">
              <lf start="29" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
              <lf start="30" span="1" word="exention" lemma="exention" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
           <rule type="fa" cat="NP\NP">
            <lf start="31" span="1" word="-" lemma="-" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
            <rule type="lex" cat="NP">
             <rule type="fa" cat="N">
              <lf start="32" span="1" word="&gt;" lemma="&gt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
              <lf start="33" span="1" word="exection" lemma="exection" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
        <rule type="rp" cat="(S[X]\NP)\(S[X]\NP)">
         <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
          <lf start="34" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="((S\NP)\(S\NP))/(S[b]\NP)" />
          <rule type="fa" cat="S[b]\NP">
           <rule type="fa" cat="(S[b]\NP)/PP">
            <lf start="35" span="1" word="replace" lemma="replace" pos="VB" chunk="I-VP" entity="O" cat="((S[b]\NP)/PP)/NP" />
            <rule type="lex" cat="NP">
             <lf start="36" span="1" word="strx_f" lemma="strx_f" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
           <rule type="fa" cat="PP">
            <lf start="37" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
            <rule type="ba" cat="NP">
             <rule type="lex" cat="NP">
              <rule type="fa" cat="N">
               <lf start="38" span="1" word="strx_g" lemma="strx_g" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
               <rule type="lp" cat="N">
                <lf start="39" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
                <lf start="40" span="1" word="exection" lemma="exection" pos="NN" chunk="I-NP" entity="O" cat="N" />
               </rule>
              </rule>
             </rule>
             <rule type="fa" cat="NP\NP">
              <lf start="41" span="1" word="-" lemma="-" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
              <rule type="ba" cat="NP">
               <rule type="rp" cat="NP">
                <rule type="lex" cat="NP">
                 <rule type="fa" cat="N">
                  <lf start="42" span="1" word="&gt;" lemma="&gt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                  <lf start="43" span="1" word="execution" lemma="execution" pos="NN" chunk="I-NP" entity="O" cat="N" />
                 </rule>
                </rule>
                <lf start="44" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
               </rule>
               <rule type="fa" cat="NP\NP">
                <lf start="45" span="1" word="insert" lemma="insert" pos="JJ" chunk="I-NP" entity="O" cat="(NP\NP)/(NP\NP)" />
                <lf start="46" span="1" word="strx_h" lemma="strx_h" pos="NN" chunk="I-NP" entity="O" cat="NP\NP" />
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
         <lf start="47" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="48" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
