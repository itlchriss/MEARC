<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="S[b]">
  <rule type="ba" cat="S[b]">
   <rule type="ba" cat="NP">
    <rule type="lex" cat="NP">
     <lf start="0" span="1" word="Explanation" lemma="explanation" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
     <rule type="rp" cat="NP">
      <rule type="lex" cat="NP">
       <rule type="fa" cat="N">
        <lf start="2" span="1" word="horse" lemma="horse" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <rule type="lp" cat="N">
         <lf start="3" span="1" word="-" lemma="-" pos=":" chunk="O" entity="O" cat=":" />
         <rule type="fa" cat="N">
          <lf start="4" span="1" word="&gt;" lemma="&gt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="5" span="1" word="rorse" lemma="rorse" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
      <lf start="6" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[b]\NP">
    <rule type="fa" cat="(S[b]\NP)/PP">
     <lf start="7" span="1" word="replace" lemma="replace" pos="VB" chunk="I-VP" entity="O" cat="((S[b]\NP)/PP)/NP" />
     <rule type="lex" cat="NP">
      <lf start="8" span="1" word="strx_a" lemma="strx_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
    <rule type="fa" cat="PP">
     <lf start="9" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
     <rule type="lex" cat="NP">
      <rule type="fa" cat="N">
       <lf start="10" span="1" word="strx_b" lemma="strx_b" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="lp" cat="N">
        <lf start="11" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
        <lf start="12" span="1" word="rorse" lemma="rorse" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <rule type="lex" cat="S[X]\S[X]">
   <rule type="lp" cat="S[dcl]">
    <lf start="13" span="1" word="-" lemma="-" pos=":" chunk="O" entity="O" cat=":" />
    <rule type="rp" cat="S[dcl]">
     <rule type="ba" cat="S[dcl]">
      <rule type="ba" cat="NP">
       <rule type="lex" cat="NP">
        <lf start="14" span="1" word="&gt;" lemma="&gt;" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
       <rule type="lex" cat="NP\NP">
        <rule type="ba" cat="S[dcl]\NP">
         <lf start="15" span="1" word="rose" lemma="rise" pos="VBD" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
         <rule type="rp" cat="(S[X]\NP)\(S[X]\NP)">
          <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
           <lf start="16" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="((S\NP)\(S\NP))/(S[b]\NP)" />
           <rule type="fa" cat="S[b]\NP">
            <lf start="17" span="1" word="remove" lemma="remove" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
            <rule type="lex" cat="NP">
             <lf start="18" span="1" word="strx_c" lemma="strx_c" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
          <lf start="19" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
         </rule>
        </rule>
       </rule>
      </rule>
      <rule type="ba" cat="S[dcl]\NP">
       <rule type="ba" cat="S[dcl]\NP">
        <lf start="20" span="1" word="rose" lemma="rise" pos="VBD" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
        <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
         <lf start="21" span="1" word="-" lemma="-" pos=":" chunk="O" entity="O" cat="((S\NP)\(S\NP))/NP" />
         <rule type="lex" cat="NP">
          <rule type="fa" cat="N">
           <lf start="22" span="1" word="&gt;" lemma="&gt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
           <lf start="23" span="1" word="ros" lemma="ro" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
       <rule type="rp" cat="(S[X]\NP)\(S[X]\NP)">
        <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
         <lf start="24" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="((S\NP)\(S\NP))/(S[b]\NP)" />
         <rule type="fa" cat="S[b]\NP">
          <lf start="25" span="1" word="remove" lemma="remove" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
          <rule type="lex" cat="NP">
           <lf start="26" span="1" word="strx_d" lemma="strx_d" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
        <lf start="27" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
       </rule>
      </rule>
     </rule>
     <lf start="28" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
