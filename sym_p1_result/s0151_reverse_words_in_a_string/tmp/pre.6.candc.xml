<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]\NP">
  <rule type="fa" cat="S[dcl]\NP">
   <rule type="bx" cat="(S[dcl]\NP)/(S[b]\NP)">
    <lf start="0" span="1" word="Do" lemma="do" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
    <lf start="1" span="1" word="not" lemma="not" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)\(S\NP)" />
   </rule>
   <rule type="fa" cat="S[b]\NP">
    <lf start="2" span="1" word="include" lemma="include" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
    <rule type="fa" cat="NP[nb]">
     <lf start="3" span="1" word="any" lemma="any" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <rule type="fa" cat="N">
      <lf start="4" span="1" word="extra" lemma="extra" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
      <lf start="5" span="1" word="spaces" lemma="space" pos="NNS" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="6" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
