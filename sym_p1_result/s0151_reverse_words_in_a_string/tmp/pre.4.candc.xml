<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[b]\NP">
  <lf start="0" span="1" word="Return" lemma="return" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
  <rule type="ba" cat="NP">
   <rule type="fa" cat="NP[nb]">
    <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <lf start="2" span="1" word="_type_string" lemma="_type_string" pos="NN" chunk="I-NP" entity="O" cat="N" />
   </rule>
   <rule type="fa" cat="NP\NP">
    <lf start="3" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
    <rule type="ba" cat="NP">
     <rule type="fa" cat="NP[nb]">
      <lf start="4" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="5" span="1" word="words" lemma="word" pos="NNS" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="fa" cat="NP\NP">
      <lf start="6" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
      <rule type="rp" cat="NP">
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <rule type="fa" cat="N">
          <lf start="7" span="1" word="reverse" lemma="reverse" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="8" span="1" word="order" lemma="order" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="lex" cat="NP\NP">
         <rule type="ba" cat="S[pss]\NP">
          <lf start="9" span="1" word="concatenated" lemma="concatenate" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
          <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
           <lf start="10" span="1" word="by" lemma="by" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
           <rule type="fa" cat="NP[nb]">
            <lf start="11" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
            <rule type="fa" cat="N">
             <lf start="12" span="1" word="single" lemma="single" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="13" span="1" word="space" lemma="space" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
       <lf start="14" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
