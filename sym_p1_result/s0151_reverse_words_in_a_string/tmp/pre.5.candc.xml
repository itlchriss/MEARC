<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[b]\NP">
  <rule type="fa" cat="S[b]\NP">
   <lf start="0" span="1" word="Note" lemma="note" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/S[dcl]" />
   <rule type="ba" cat="S[dcl]">
    <rule type="fa" cat="NP[nb]">
     <lf start="1" span="1" word="that" lemma="that" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <lf start="2" span="1" word="param_s" lemma="param_s" pos="NNS" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="3" span="1" word="may" lemma="may" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
     <rule type="fa" cat="S[b]\NP">
      <lf start="4" span="1" word="contain" lemma="contain" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/(S[ng]\NP)" />
      <rule type="fa" cat="S[ng]\NP">
       <rule type="ba" cat="(S[ng]\NP)/NP">
        <lf start="5" span="1" word="leading" lemma="lead" pos="VBG" chunk="I-NP" entity="O" cat="(S[ng]\NP)/NP" />
        <rule type="conj" cat="((S[ng]\NP)/NP)\((S[ng]\NP)/NP)">
         <lf start="6" span="1" word="or" lemma="or" pos="CC" chunk="I-NP" entity="O" cat="conj" />
         <lf start="7" span="1" word="trailing" lemma="trail" pos="VBG" chunk="I-NP" entity="O" cat="(S[ng]\NP)/NP" />
        </rule>
       </rule>
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <lf start="8" span="1" word="spaces" lemma="space" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="conj" cat="NP\NP">
         <lf start="9" span="1" word="or" lemma="or" pos="CC" chunk="O" entity="O" cat="conj" />
         <rule type="ba" cat="NP">
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="10" span="1" word="multiple" lemma="multiple" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="11" span="1" word="spaces" lemma="space" pos="NNS" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
          <rule type="fa" cat="NP\NP">
           <lf start="12" span="1" word="between" lemma="between" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
           <rule type="lex" cat="NP">
            <rule type="fa" cat="N">
             <lf start="13" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="14" span="1" word="words" lemma="word" pos="NNS" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="15" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
