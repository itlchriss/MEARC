<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[dcl]">
  <rule type="lex" cat="S[X]/S[X]">
   <rule type="fa" cat="S[pss]\NP">
    <lf start="0" span="1" word="Given" lemma="Give" pos="VBN" chunk="I-PP" entity="O" cat="(S[pss]\NP)/NP" />
    <rule type="ba" cat="NP">
     <rule type="fa" cat="NP[nb]">
      <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="fa" cat="N">
       <lf start="2" span="1" word="_type_integer" lemma="_type_integer" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="fa" cat="N">
        <lf start="3" span="1" word="array" lemma="array" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="4" span="1" word="param_nums" lemma="param_nums" pos="NNS" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
     <rule type="lex" cat="NP\NP">
      <rule type="fa" cat="S[ng]\NP">
       <lf start="5" span="1" word="representing" lemma="represent" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
       <rule type="ba" cat="NP">
        <rule type="ba" cat="NP">
         <rule type="fa" cat="NP[nb]">
          <lf start="6" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <lf start="7" span="1" word="amount" lemma="amount" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
         <rule type="fa" cat="NP\NP">
          <lf start="8" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
          <rule type="lex" cat="NP">
           <lf start="9" span="1" word="money" lemma="money" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="10" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
         <rule type="fa" cat="NP[nb]">
          <lf start="11" span="1" word="each" lemma="each" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <lf start="12" span="1" word="house" lemma="house" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <rule type="lp" cat="S[dcl]">
   <lf start="13" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <rule type="fa" cat="NP[nb]">
      <lf start="14" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="15" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="16" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      <rule type="ba" cat="NP">
       <rule type="ba" cat="NP">
        <rule type="fa" cat="NP[nb]">
         <lf start="17" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="fa" cat="N">
          <lf start="18" span="1" word="maximum" lemma="maximum" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="19" span="1" word="amount" lemma="amount" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="20" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
         <rule type="lex" cat="NP">
          <lf start="21" span="1" word="money" lemma="money" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
       <rule type="lex" cat="NP\NP">
        <rule type="ba" cat="S[dcl]">
         <lf start="22" span="1" word="you" lemma="you" pos="PRP" chunk="B-NP" entity="O" cat="NP" />
         <rule type="fa" cat="S[dcl]\NP">
          <lf start="23" span="1" word="can" lemma="can" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
          <rule type="ba" cat="S[b]\NP">
           <rule type="fa" cat="S[b]\NP">
            <lf start="24" span="1" word="rob" lemma="rob" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
            <rule type="lex" cat="NP">
             <lf start="25" span="1" word="tonight" lemma="tonight" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
           <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
            <lf start="26" span="1" word="without" lemma="without" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/(S[ng]\NP)" />
            <rule type="fa" cat="S[ng]\NP">
             <lf start="27" span="1" word="alerting" lemma="alert" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
             <rule type="fa" cat="NP[nb]">
              <lf start="28" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
              <lf start="29" span="1" word="police" lemma="police" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="30" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
