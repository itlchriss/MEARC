<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="lex" cat="NP">
   <rule type="fa" cat="N">
    <lf start="0" span="1" word="Total" lemma="total" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
    <lf start="1" span="1" word="amount" lemma="amount" pos="NN" chunk="I-NP" entity="O" cat="N" />
   </rule>
  </rule>
  <rule type="lex" cat="NP\NP">
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <lf start="2" span="1" word="you" lemma="you" pos="PRP" chunk="B-NP" entity="O" cat="NP" />
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="3" span="1" word="can" lemma="can" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
      <rule type="fa" cat="S[b]\NP">
       <lf start="4" span="1" word="rob" lemma="rob" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
       <rule type="lex" cat="NP">
        <rule type="fa" cat="N">
         <rule type="fa" cat="N/N">
          <lf start="5" span="1" word="=" lemma="=" pos="RB" chunk="I-NP" entity="O" cat="(N/N)/(N/N)" />
          <lf start="6" span="1" word="4" lemma="4" pos="CD" chunk="I-NP" entity="I-TIM" cat="N/N" />
         </rule>
         <rule type="ba" cat="N">
          <lf start="7" span="1" word="=" lemma="=" pos="NN" chunk="I-NP" entity="I-TIM" cat="N" />
          <lf start="8" span="1" word="4" lemma="4" pos="CD" chunk="I-NP" entity="I-TIM" cat="N\N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="9" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
