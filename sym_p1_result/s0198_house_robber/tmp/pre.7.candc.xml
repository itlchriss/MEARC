<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="lex" cat="NP">
    <rule type="fa" cat="N">
     <lf start="0" span="1" word="Rob" lemma="Rob" pos="NNP" chunk="I-NP" entity="I-PER" cat="N/N" />
     <rule type="fa" cat="N">
      <lf start="1" span="1" word="house" lemma="house" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
      <rule type="fa" cat="N">
       <lf start="2" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="lp" cat="N">
        <lf start="3" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
        <lf start="4" span="1" word="money" lemma="money" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="ba" cat="S[dcl]\NP">
    <rule type="ba" cat="S[dcl]\NP">
     <lf start="5" span="1" word="=" lemma="=" pos="VBD" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
     <rule type="rp" cat="(S[X]\NP)\(S[X]\NP)">
      <lf start="6" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="(S\NP)\(S\NP)" />
      <lf start="7" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
     </rule>
    </rule>
    <rule type="conj" cat="(S[dcl]\NP)\(S[dcl]\NP)">
     <lf start="8" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="9" span="1" word="then" lemma="then" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)/(S\NP)" />
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="10" span="1" word="rob" lemma="rob" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <rule type="ba" cat="N">
          <lf start="11" span="1" word="house" lemma="house" pos="NN" chunk="I-NP" entity="O" cat="N" />
          <lf start="12" span="1" word="3" lemma="3" pos="CD" chunk="I-NP" entity="O" cat="N\N" />
         </rule>
        </rule>
        <rule type="rp" cat="NP\NP">
         <rule type="fa" cat="NP\NP">
          <lf start="13" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="14" span="1" word="money" lemma="money" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
            <rule type="ba" cat="N">
             <lf start="15" span="1" word="=" lemma="=" pos="NN" chunk="I-NP" entity="O" cat="N" />
             <lf start="16" span="1" word="3" lemma="3" pos="CD" chunk="I-NP" entity="O" cat="N\N" />
            </rule>
           </rule>
          </rule>
         </rule>
         <lf start="17" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="18" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
