<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="S[b]\NP">
  <rule type="fa" cat="S[b]\NP">
   <lf start="0" span="1" word="Write" lemma="write" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
   <rule type="fa" cat="NP[nb]">
    <lf start="1" span="1" word="an" lemma="an" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <lf start="2" span="1" word="algorithm" lemma="algorithm" pos="NN" chunk="I-NP" entity="O" cat="N" />
   </rule>
  </rule>
  <rule type="lex" cat="(S[X]\NP)\(S[X]\NP)">
   <rule type="fa" cat="S[to]\NP">
    <lf start="3" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
    <rule type="fa" cat="S[b]\NP">
     <lf start="4" span="1" word="determine" lemma="determine" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/S[qem]" />
     <rule type="fa" cat="S[qem]">
      <lf start="5" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="S[qem]/S[dcl]" />
      <rule type="rp" cat="S[dcl]">
       <rule type="ba" cat="S[dcl]">
        <rule type="fa" cat="NP[nb]">
         <lf start="6" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="fa" cat="N">
          <lf start="7" span="1" word="number" lemma="number" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="8" span="1" word="param_n" lemma="param_n" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="9" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
         <lf start="10" span="1" word="happy" lemma="happy" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
        </rule>
       </rule>
       <lf start="11" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
