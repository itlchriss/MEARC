<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP[nb]">
     <lf start="0" span="1" word="Those" lemma="those" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <lf start="1" span="1" word="numbers" lemma="number" pos="NNS" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="NP\NP">
     <rule type="ba" cat="(NP\NP)/S[dcl]">
      <lf start="2" span="1" word="for" lemma="for" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
      <lf start="3" span="1" word="which" lemma="which" pos="WDT" chunk="I-NP" entity="O" cat="((NP\NP)/S[dcl])\((NP\NP)/NP)" />
     </rule>
     <rule type="ba" cat="S[dcl]">
      <rule type="fa" cat="NP[nb]">
       <lf start="4" span="1" word="this" lemma="this" pos="DT" chunk="B-NP" entity="O" cat="NP[nb]/N" />
       <lf start="5" span="1" word="process" lemma="process" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="ba" cat="S[dcl]\NP">
       <lf start="6" span="1" word="ends" lemma="end" pos="VBZ" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
       <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
        <lf start="7" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
        <rule type="lex" cat="NP">
         <lf start="8" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="9" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
    <lf start="10" span="1" word="happy" lemma="happy" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
   </rule>
  </rule>
  <lf start="11" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
