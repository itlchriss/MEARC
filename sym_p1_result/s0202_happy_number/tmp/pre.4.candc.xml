<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <rule type="ba" cat="NP">
     <rule type="fa" cat="NP">
      <lf start="0" span="1" word="Repeat" lemma="repeat" pos="NN" chunk="I-NP" entity="O" cat="NP/NP" />
      <rule type="fa" cat="NP[nb]">
       <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="B-NP" entity="O" cat="NP[nb]/N" />
       <lf start="2" span="1" word="process" lemma="process" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
     <rule type="fa" cat="NP\NP">
      <lf start="3" span="1" word="until" lemma="until" pos="IN" chunk="I-SBAR" entity="O" cat="(NP\NP)/NP" />
      <rule type="fa" cat="NP[nb]">
       <lf start="4" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <lf start="5" span="1" word="number" lemma="number" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="6" span="1" word="equals" lemma="equal" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
     <rule type="ba" cat="NP">
      <rule type="lex" cat="NP">
       <lf start="7" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="lp" cat="NP\NP">
       <lf start="8" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
       <rule type="rp" cat="NP\NP">
        <rule type="fa" cat="NP\NP">
         <lf start="9" span="1" word="that" lemma="that" pos="IN" chunk="I-SBAR" entity="O" cat="(NP\NP)/(S[dcl]/NP)" />
         <rule type="fc" cat="S[dcl]/NP">
          <rule type="tr" cat="S[X]/(S[X]\NP)">
           <lf start="10" span="1" word="it" lemma="it" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
          </rule>
          <rule type="fc" cat="(S[dcl]\NP)/NP">
           <lf start="11" span="1" word="will" lemma="will" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
           <lf start="12" span="1" word="stay" lemma="stay" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
          </rule>
         </rule>
        </rule>
        <lf start="13" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="conj" cat="S[dcl]\S[dcl]">
    <lf start="14" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    <rule type="conj" cat="S[dcl]\S[dcl]">
     <lf start="15" span="1" word="or" lemma="or" pos="CC" chunk="O" entity="O" cat="conj" />
     <rule type="ba" cat="S[dcl]">
      <lf start="16" span="1" word="it" lemma="it" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
      <rule type="ba" cat="S[dcl]\NP">
       <rule type="ba" cat="S[dcl]\NP">
        <lf start="17" span="1" word="loops" lemma="loop" pos="VBZ" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
        <lf start="18" span="1" word="endlessly" lemma="endlessly" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
       </rule>
       <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
        <lf start="19" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
        <rule type="ba" cat="NP">
         <rule type="fa" cat="NP[nb]">
          <lf start="20" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <lf start="21" span="1" word="cycle" lemma="cycle" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
         <rule type="fa" cat="NP\NP">
          <lf start="22" span="1" word="which" lemma="which" pos="WDT" chunk="B-NP" entity="O" cat="(NP\NP)/(S[dcl]\NP)" />
          <rule type="fa" cat="S[dcl]\NP">
           <rule type="bx" cat="(S[dcl]\NP)/(S[b]\NP)">
            <lf start="23" span="1" word="does" lemma="do" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
            <lf start="24" span="1" word="not" lemma="not" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)\(S\NP)" />
           </rule>
           <rule type="fa" cat="S[b]\NP">
            <lf start="25" span="1" word="include" lemma="include" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
            <rule type="lex" cat="NP">
             <lf start="26" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="I-DAT" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="27" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
