<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[dcl]">
  <rule type="fa" cat="S[X]/S[X]">
   <lf start="0" span="1" word="In" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(S/S)/NP" />
   <rule type="lex" cat="NP">
    <rule type="fa" cat="N">
     <lf start="1" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="I-DAT" cat="N/N" />
     <lf start="2" span="1" word="operation" lemma="operation" pos="NN" chunk="I-NP" entity="I-DAT" cat="N" />
    </rule>
   </rule>
  </rule>
  <rule type="lp" cat="S[dcl]">
   <lf start="3" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <lf start="4" span="1" word="you" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="5" span="1" word="can" lemma="can" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
      <rule type="fa" cat="S[b]\NP">
       <lf start="6" span="1" word="choose" lemma="choose" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
       <rule type="ba" cat="NP">
        <rule type="fa" cat="NP[nb]">
         <lf start="7" span="1" word="any" lemma="any" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="fa" cat="N">
          <lf start="8" span="1" word="index" lemma="index" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="9" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="10" span="1" word="that" lemma="that" pos="IN" chunk="B-NP" entity="O" cat="(NP\NP)/S[dcl]" />
         <rule type="ba" cat="S[dcl]">
          <rule type="ba" cat="NP">
           <rule type="lex" cat="NP">
            <lf start="11" span="1" word="expr_b" lemma="expr_b" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
           <rule type="conj" cat="NP\NP">
            <lf start="12" span="1" word="and" lemma="and" pos="CC" chunk="I-NP" entity="O" cat="conj" />
            <rule type="ba" cat="NP">
             <rule type="ba" cat="NP">
              <rule type="lex" cat="NP">
               <lf start="13" span="1" word="change" lemma="change" pos="NN" chunk="I-NP" entity="O" cat="N" />
              </rule>
              <lf start="14" span="1" word="expr_c" lemma="expr_c" pos="NN" chunk="I-NP" entity="O" cat="NP\NP" />
             </rule>
             <rule type="lex" cat="NP\NP">
              <rule type="fa" cat="S[to]\NP">
               <lf start="15" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
               <rule type="fa" cat="S[b]\NP">
                <lf start="16" span="1" word="expr_d" lemma="expr_d" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
                <rule type="fa" cat="NP[nb]">
                 <lf start="17" span="1" word="that" lemma="that" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                 <lf start="18" span="1" word="expr_e" lemma="expr_e" pos="NN" chunk="I-NP" entity="O" cat="N" />
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
          <rule type="fa" cat="S[dcl]\NP">
           <lf start="19" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
           <rule type="ba" cat="NP">
            <rule type="ba" cat="NP">
             <rule type="fa" cat="NP[nb]">
              <lf start="20" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
              <lf start="21" span="1" word="_type_integer" lemma="_type_integer" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
             <rule type="fa" cat="NP\NP">
              <lf start="22" span="1" word="from" lemma="from" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
              <rule type="fa" cat="NP[nb]">
               <lf start="23" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
               <lf start="24" span="1" word="range" lemma="range" pos="NN" chunk="I-NP" entity="O" cat="N" />
              </rule>
             </rule>
            </rule>
            <lf start="25" span="1" word="expr_f" lemma="expr_f" pos="NN" chunk="I-NP" entity="O" cat="NP\NP" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="26" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
