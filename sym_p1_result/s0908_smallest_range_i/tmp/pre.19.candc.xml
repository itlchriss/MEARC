<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <lf start="1" span="1" word="score" lemma="score" pos="NN" chunk="I-NP" entity="O" cat="N" />
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <rule type="bx" cat="(S[dcl]\NP)/NP">
     <rule type="bx" cat="(S[dcl]\NP)/NP">
      <lf start="2" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      <rule type="lex" cat="(S[X]\NP)\(S[X]\NP)">
       <lf start="3" span="1" word="max" lemma="max" pos="NN" chunk="I-NP" entity="O" cat="S[adj]\NP" />
      </rule>
     </rule>
     <rule type="rp" cat="(S[X]\NP)\(S[X]\NP)">
      <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
       <lf start="4" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="((S\NP)\(S\NP))/NP" />
       <rule type="ba" cat="NP">
        <rule type="rp" cat="NP">
         <rule type="lex" cat="NP">
          <lf start="5" span="1" word="nums" lemma="num" pos="NNS" chunk="I-NP" entity="O" cat="N" />
         </rule>
         <lf start="6" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="7" span="1" word="-" lemma="-" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
         <rule type="lex" cat="NP">
          <rule type="fa" cat="N">
           <lf start="8" span="1" word="min" lemma="min" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
           <rule type="lp" cat="N">
            <lf start="9" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
            <lf start="10" span="1" word="nums" lemma="num" pos="NNS" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
      <lf start="11" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
     </rule>
    </rule>
    <rule type="fa" cat="NP">
     <lf start="12" span="1" word="=" lemma="=" pos="SYM" chunk="I-NP" entity="O" cat="NP/NP" />
     <rule type="lex" cat="NP">
      <rule type="ba" cat="N">
       <rule type="fa" cat="N">
        <lf start="13" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="I-TIM" cat="N/N" />
        <lf start="14" span="1" word="=" lemma="=" pos="NN" chunk="I-NP" entity="I-TIM" cat="N" />
       </rule>
       <lf start="15" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="I-TIM" cat="N\N" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="16" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
