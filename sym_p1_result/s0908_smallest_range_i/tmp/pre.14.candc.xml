<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="fa" cat="NP[nb]">
    <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <lf start="1" span="1" word="score" lemma="score" pos="NN" chunk="I-NP" entity="O" cat="N" />
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="2" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
    <rule type="ba" cat="NP">
     <rule type="lex" cat="NP">
      <lf start="3" span="1" word="max" lemma="max" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="lex" cat="NP\NP">
      <rule type="lp" cat="S[dcl]">
       <lf start="4" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
       <rule type="ba" cat="S[dcl]">
        <rule type="ba" cat="NP">
         <rule type="rp" cat="NP">
          <rule type="lex" cat="NP">
           <lf start="5" span="1" word="nums" lemma="num" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
          <lf start="6" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
         </rule>
         <rule type="fa" cat="NP\NP">
          <lf start="7" span="1" word="-" lemma="-" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
          <rule type="ba" cat="NP">
           <rule type="lex" cat="NP">
            <lf start="8" span="1" word="min" lemma="min" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
           <rule type="rp" cat="NP\NP">
            <rule type="fa" cat="NP\NP">
             <lf start="9" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
             <rule type="lex" cat="NP">
              <lf start="10" span="1" word="nums" lemma="num" pos="NNS" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
            <lf start="11" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
           </rule>
          </rule>
         </rule>
        </rule>
        <rule type="ba" cat="S[dcl]\NP">
         <rule type="fa" cat="S[dcl]\NP">
          <lf start="12" span="1" word="=" lemma="=" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
          <rule type="lex" cat="NP">
           <lf start="13" span="1" word="6" lemma="6" pos="CD" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
         <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
          <lf start="14" span="1" word="=" lemma="=" pos="NNP" chunk="I-NP" entity="I-DAT" cat="((S\NP)\(S\NP))/N[num]" />
          <lf start="15" span="1" word="6" lemma="6" pos="CD" chunk="I-NP" entity="I-DAT" cat="N[num]" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="16" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
