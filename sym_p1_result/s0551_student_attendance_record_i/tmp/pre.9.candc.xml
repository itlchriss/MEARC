<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="(S[X]\NP)\((S[X]\NP)/NP)">
  <rule type="bc" cat="(S[X]\NP)\((S[X]\NP)/NP)">
   <rule type="tr" cat="(S[X]\NP)\((S[X]\NP)/NP)">
    <rule type="lex" cat="NP">
     <rule type="fa" cat="N">
      <lf start="0" span="1" word="Return" lemma="Return" pos="NNP" chunk="I-NP" entity="I-PER" cat="N/N" />
      <lf start="1" span="1" word="expr_a" lemma="expr_a" pos="NNP" chunk="I-NP" entity="I-PER" cat="N" />
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
    <lf start="2" span="1" word="if" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
    <rule type="ba" cat="S[dcl]">
     <rule type="fa" cat="NP[nb]">
      <lf start="3" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="4" span="1" word="student" lemma="student" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="rp" cat="S[dcl]\NP">
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="5" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
       <rule type="fa" cat="S[adj]\NP">
        <lf start="6" span="1" word="eligible" lemma="eligible" pos="JJ" chunk="I-ADJP" entity="O" cat="(S[adj]\NP)/PP" />
        <rule type="fa" cat="PP">
         <lf start="7" span="1" word="for" lemma="for" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
         <rule type="fa" cat="NP[nb]">
          <lf start="8" span="1" word="an" lemma="an" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <rule type="fa" cat="N">
           <lf start="9" span="1" word="attendance" lemma="attendance" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
           <lf start="10" span="1" word="award" lemma="award" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
      <lf start="11" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
     </rule>
    </rule>
   </rule>
  </rule>
  <rule type="conj" cat="((S[X]\NP)\((S[X]\NP)/NP))\((S[X]\NP)\((S[X]\NP)/NP))">
   <lf start="12" span="1" word="or" lemma="or" pos="CC" chunk="O" entity="O" cat="conj" />
   <rule type="bc" cat="(S[X]\NP)\((S[X]\NP)/NP)">
    <rule type="tr" cat="(S[X]\NP)\((S[X]\NP)/NP)">
     <rule type="fa" cat="NP[nb]">
      <lf start="13" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="14" span="1" word="expr_b" lemma="expr_b" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
    <rule type="rp" cat="(S[X]\NP)\(S[X]\NP)">
     <lf start="15" span="1" word="otherwise" lemma="otherwise" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
     <lf start="16" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
