<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="lex" cat="NP">
   <lf start="0" span="1" word="Explanation" lemma="explanation" pos="NN" chunk="I-NP" entity="I-TIM" cat="N" />
  </rule>
  <rule type="fa" cat="NP\NP">
   <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="I-TIM" cat="(NP\NP)/NP" />
   <rule type="rp" cat="NP">
    <rule type="ba" cat="NP">
     <rule type="lex" cat="NP">
      <rule type="fa" cat="N">
       <lf start="2" span="1" word="6" lemma="6" pos="CD" chunk="I-NP" entity="I-TIM" cat="N/N" />
       <rule type="fa" cat="N">
        <rule type="fa" cat="N/N">
         <lf start="3" span="1" word="=" lemma="=" pos="RB" chunk="I-NP" entity="I-TIM" cat="(N/N)/(N/N)" />
         <lf start="4" span="1" word="6" lemma="6" pos="CD" chunk="I-NP" entity="I-TIM" cat="N/N" />
        </rule>
        <lf start="5" span="1" word="=" lemma="=" pos="NNS" chunk="I-NP" entity="I-TIM" cat="N" />
       </rule>
      </rule>
     </rule>
     <rule type="lex" cat="NP\NP">
      <rule type="ba" cat="S[adj]\NP">
       <lf start="6" span="1" word="negative" lemma="negative" pos="JJ" chunk="I-ADJP" entity="I-TIM" cat="S[adj]\NP" />
       <lf start="7" span="1" word="18" lemma="18" pos="CD" chunk="I-NP" entity="I-TIM" cat="(S[adj]\NP)\(S[adj]\NP)" />
      </rule>
     </rule>
    </rule>
    <lf start="8" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
