<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[b]">
  <rule type="ba" cat="S[b]">
   <rule type="ba" cat="NP">
    <rule type="lex" cat="NP">
     <lf start="0" span="1" word="Explanation" lemma="explanation" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/S[dcl]" />
     <rule type="ba" cat="S[dcl]">
      <rule type="lex" cat="NP">
       <lf start="2" span="1" word="transactions" lemma="transaction" pos="NNS" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="rp" cat="S[dcl]\NP">
       <rule type="fa" cat="S[dcl]\NP">
        <lf start="3" span="1" word="=" lemma="=" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
        <rule type="ba" cat="NP">
         <rule type="lex" cat="NP">
          <rule type="fa" cat="N">
           <lf start="4" span="1" word="[" lemma="[" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
           <lf start="5" span="1" word="buy" lemma="buy" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
         <rule type="conj" cat="NP\NP">
          <lf start="6" span="1" word="," lemma="," pos="," chunk="I-NP" entity="O" cat="," />
          <rule type="ba" cat="NP">
           <rule type="lex" cat="NP">
            <lf start="7" span="1" word="sell" lemma="sell" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
           <rule type="conj" cat="NP\NP">
            <lf start="8" span="1" word="," lemma="," pos="," chunk="I-NP" entity="O" cat="," />
            <rule type="lex" cat="NP">
             <lf start="9" span="1" word="cooldown" lemma="cooldown" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
       <lf start="10" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[b]\NP">
    <lf start="11" span="1" word="buy" lemma="buy" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
    <rule type="lex" cat="NP">
     <rule type="lp" cat="N">
      <lf start="12" span="1" word="," lemma="," pos="," chunk="I-VP" entity="O" cat="," />
      <rule type="fa" cat="N">
       <lf start="13" span="1" word="sell" lemma="sell" pos="VB" chunk="I-VP" entity="O" cat="N/N" />
       <lf start="14" span="1" word="]" lemma="]" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="15" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
