<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <lf start="0" span="1" word="You" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="1" span="1" word="may" lemma="may" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
    <rule type="rp" cat="S[b]\NP">
     <rule type="ba" cat="S[b]\NP">
      <rule type="ba" cat="S[b]\NP">
       <lf start="2" span="1" word="complete" lemma="complete" pos="VB" chunk="I-VP" entity="O" cat="S[b]\NP" />
       <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
        <lf start="3" span="1" word="as" lemma="as" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
        <rule type="ba" cat="NP">
         <rule type="ba" cat="NP">
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="4" span="1" word="many" lemma="many" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="5" span="1" word="transactions" lemma="transaction" pos="NNS" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
          <rule type="fa" cat="NP\NP">
           <lf start="6" span="1" word="as" lemma="as" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
           <lf start="7" span="1" word="you" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
          </rule>
         </rule>
         <rule type="fa" cat="NP\NP">
          <lf start="8" span="1" word="like" lemma="like" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
          <rule type="lex" cat="NP">
           <rule type="lp" cat="N">
            <lf start="9" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
            <lf start="10" span="1" word="i.e." lemma="i.e." pos="FW" chunk="O" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
      <rule type="conj" cat="(S[b]\NP)\(S[b]\NP)">
       <lf start="11" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
       <rule type="ba" cat="S[b]\NP">
        <rule type="fa" cat="S[b]\NP">
         <lf start="12" span="1" word="buy" lemma="buy" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
         <rule type="lex" cat="NP">
          <lf start="13" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="conj" cat="(S[b]\NP)\(S[b]\NP)">
         <lf start="14" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
         <rule type="fa" cat="S[b]\NP">
          <rule type="fa" cat="(S[b]\NP)/PP">
           <lf start="15" span="1" word="sell" lemma="sell" pos="VB" chunk="I-VP" entity="O" cat="((S[b]\NP)/PP)/NP" />
           <rule type="rp" cat="NP">
            <rule type="ba" cat="NP">
             <rule type="lex" cat="NP">
              <rule type="fa" cat="N">
               <lf start="16" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
               <lf start="17" span="1" word="share" lemma="share" pos="NN" chunk="I-NP" entity="O" cat="N" />
              </rule>
             </rule>
             <rule type="fa" cat="NP\NP">
              <lf start="18" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
              <rule type="fa" cat="NP[nb]">
               <lf start="19" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
               <rule type="fa" cat="N">
                <lf start="20" span="1" word="stock" lemma="stock" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                <rule type="fa" cat="N">
                 <lf start="21" span="1" word="multiple" lemma="multiple" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                 <lf start="22" span="1" word="times" lemma="time" pos="NNS" chunk="I-NP" entity="O" cat="N" />
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
            <lf start="23" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
           </rule>
          </rule>
          <rule type="fa" cat="PP">
           <lf start="24" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
           <rule type="fa" cat="NP[nb]">
            <lf start="25" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
            <rule type="fa" cat="N">
             <lf start="26" span="1" word="following" lemma="follow" pos="VBG" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="27" span="1" word="restrictions" lemma="restriction" pos="NNS" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
     <lf start="28" span="1" word=":" lemma=":" pos=":" chunk="O" entity="O" cat=":" />
    </rule>
   </rule>
  </rule>
  <lf start="29" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
