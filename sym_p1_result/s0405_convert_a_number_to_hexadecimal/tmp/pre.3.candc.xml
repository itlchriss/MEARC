<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="lex" cat="NP">
   <lf start="0" span="1" word="Note" lemma="note" pos="VB" chunk="I-VP" entity="O" cat="N" />
  </rule>
  <rule type="fa" cat="NP\NP">
   <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/S[dcl]" />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <lf start="2" span="1" word="You" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
     <rule type="fa" cat="S[dcl]\NP">
      <rule type="bx" cat="(S[dcl]\NP)/(S[pss]\NP)">
       <lf start="3" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
       <lf start="4" span="1" word="not" lemma="not" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)\(S\NP)" />
      </rule>
      <rule type="fa" cat="S[pss]\NP">
       <lf start="5" span="1" word="allowed" lemma="allow" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/(S[to]\NP)" />
       <rule type="fa" cat="S[to]\NP">
        <lf start="6" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
        <rule type="ba" cat="S[b]\NP">
         <rule type="fa" cat="S[b]\NP">
          <lf start="7" span="1" word="use" lemma="use" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
          <rule type="fa" cat="NP[nb]">
           <lf start="8" span="1" word="any" lemma="any" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
           <rule type="fa" cat="N">
            <lf start="9" span="1" word="built-in" lemma="built-in" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
            <rule type="fa" cat="N">
             <lf start="10" span="1" word="library" lemma="library" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="11" span="1" word="method" lemma="method" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
         <rule type="lex" cat="(S[X]\NP)\(S[X]\NP)">
          <rule type="fa" cat="S[to]\NP">
           <lf start="12" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
           <rule type="fa" cat="S[b]\NP">
            <lf start="13" span="1" word="directly" lemma="directly" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)/(S\NP)" />
            <rule type="fa" cat="S[b]\NP">
             <lf start="14" span="1" word="solve" lemma="solve" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
             <rule type="fa" cat="NP[nb]">
              <lf start="15" span="1" word="this" lemma="this" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
              <lf start="16" span="1" word="problem" lemma="problem" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="17" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
