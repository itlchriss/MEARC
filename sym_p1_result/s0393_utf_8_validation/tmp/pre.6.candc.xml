<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="bc" cat="(S[X]\NP)\((S[X]\NP)/NP)">
  <rule type="tr" cat="(S[X]\NP)\((S[X]\NP)/NP)">
   <lf start="0" span="1" word="This" lemma="this" pos="DT" chunk="I-NP" entity="O" cat="NP" />
  </rule>
  <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
   <lf start="1" span="1" word="how" lemma="how" pos="WRB" chunk="I-ADVP" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <rule type="fa" cat="NP[nb]">
      <lf start="2" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="fa" cat="N">
       <lf start="3" span="1" word="UTF-8" lemma="UTF-8" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
       <lf start="4" span="1" word="encoding" lemma="encoding" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
     <rule type="rp" cat="S[dcl]\NP">
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="5" span="1" word="would" lemma="would" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
       <lf start="6" span="1" word="work" lemma="work" pos="VB" chunk="I-VP" entity="O" cat="S[b]\NP" />
      </rule>
      <lf start="7" span="1" word=":" lemma=":" pos=":" chunk="O" entity="O" cat=":" />
     </rule>
    </rule>
    <lf start="8" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
