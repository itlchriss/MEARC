<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="NP">
  <rule type="lex" cat="NP">
   <rule type="ba" cat="N">
    <rule type="fa" cat="N">
     <rule type="fa" cat="N/N">
      <lf start="0" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="I-TIM" cat="(N/N)/(N/N)" />
      <lf start="1" span="1" word="0080-0000" lemma="0080-0000" pos="CD" chunk="I-NP" entity="I-TIM" cat="N/N" />
     </rule>
     <rule type="fa" cat="N">
      <lf start="2" span="1" word="07FF" lemma="07FF" pos="NNP" chunk="I-NP" entity="I-TIM" cat="N/N" />
      <rule type="ba" cat="N">
       <lf start="3" span="1" word="|" lemma="|" pos="NNP" chunk="I-NP" entity="I-TIM" cat="N" />
       <lf start="4" span="1" word="110xxxxx" lemma="110xxxxx" pos="CD" chunk="I-NP" entity="I-TIM" cat="N\N" />
      </rule>
     </rule>
    </rule>
    <lf start="5" span="1" word="10xxxxxx" lemma="10xxxxxx" pos="CD" chunk="I-NP" entity="I-TIM" cat="N\N" />
   </rule>
  </rule>
  <lf start="6" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
