<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="rp" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <rule type="ba" cat="NP">
     <rule type="fa" cat="NP[nb]">
      <lf start="0" span="1" word="A" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="1" span="1" word="character" lemma="character" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="fa" cat="NP\NP">
      <lf start="2" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
      <rule type="lex" cat="NP">
       <lf start="3" span="1" word="UTF8" lemma="UTF8" pos="NNP" chunk="I-NP" entity="I-LOC" cat="N" />
      </rule>
     </rule>
    </rule>
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="4" span="1" word="can" lemma="can" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
     <rule type="ba" cat="S[b]\NP">
      <rule type="rp" cat="S[b]\NP">
       <rule type="ba" cat="S[b]\NP">
        <rule type="fa" cat="S[b]\NP">
         <lf start="5" span="1" word="be" lemma="be" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/PP" />
         <rule type="fa" cat="PP">
          <rule type="fa" cat="PP/PP">
           <lf start="6" span="1" word="from" lemma="from" pos="IN" chunk="I-PP" entity="O" cat="(PP/PP)/NP" />
           <rule type="lex" cat="NP">
            <lf start="7" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
          <rule type="fa" cat="PP">
           <lf start="8" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="PP/NP" />
           <rule type="lex" cat="NP">
            <rule type="fa" cat="N">
             <lf start="9" span="1" word="4" lemma="4" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="10" span="1" word="bytes" lemma="byte" pos="NNS" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
        <lf start="11" span="1" word="long" lemma="long" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
       </rule>
       <lf start="12" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
      </rule>
      <rule type="lex" cat="(S[X]\NP)\(S[X]\NP)">
       <rule type="fa" cat="S[pss]\NP">
        <lf start="13" span="1" word="subjected" lemma="subject" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/PP" />
        <rule type="fa" cat="PP">
         <lf start="14" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="PP/NP" />
         <rule type="fa" cat="NP[nb]">
          <lf start="15" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <rule type="fa" cat="N">
           <lf start="16" span="1" word="following" lemma="following" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
           <lf start="17" span="1" word="rules" lemma="rule" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="18" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat=":" />
  </rule>
  <lf start="19" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
