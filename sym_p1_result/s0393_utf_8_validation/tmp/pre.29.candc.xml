<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[dcl]">
  <lf start="0" span="1" word="But" lemma="but" pos="CC" chunk="O" entity="O" cat="S/S" />
  <rule type="rp" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <rule type="fa" cat="NP[nb]">
     <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <rule type="fa" cat="N">
      <lf start="2" span="1" word="second" lemma="second" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
      <rule type="fa" cat="N">
       <lf start="3" span="1" word="continuation" lemma="continuation" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <lf start="4" span="1" word="byte" lemma="byte" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
    <rule type="fa" cat="S[dcl]\NP">
     <rule type="bx" cat="(S[dcl]\NP)/(S[b]\NP)">
      <lf start="5" span="1" word="does" lemma="do" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
      <lf start="6" span="1" word="not" lemma="not" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)\(S\NP)" />
     </rule>
     <rule type="fa" cat="S[b]\NP">
      <lf start="7" span="1" word="start" lemma="start" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/PP" />
      <rule type="fa" cat="PP">
       <lf start="8" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <lf start="9" span="1" word="10" lemma="10" pos="CD" chunk="I-NP" entity="I-DAT" cat="N" />
        </rule>
        <rule type="lex" cat="NP\NP">
         <rule type="lp" cat="S[dcl]">
          <lf start="10" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
          <rule type="fa" cat="S[dcl]">
           <lf start="11" span="1" word="so" lemma="so" pos="RB" chunk="I-ADVP" entity="O" cat="S/S" />
           <rule type="ba" cat="S[dcl]">
            <lf start="12" span="1" word="it" lemma="it" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
            <rule type="fa" cat="S[dcl]\NP">
             <lf start="13" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
             <lf start="14" span="1" word="invalid" lemma="invalid" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="15" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
  </rule>
 </rule>
</ccg>
</candc>
