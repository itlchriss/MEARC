<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="lp" cat="NP">
  <lf start="0" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
  <rule type="rp" cat="NP">
   <rule type="ba" cat="NP">
    <rule type="lex" cat="NP">
     <rule type="fa" cat="N">
      <lf start="1" span="1" word="hexadecimal" lemma="hexadecimal" pos="JJ" chunk="O" entity="O" cat="N/N" />
      <rule type="lp" cat="N">
       <lf start="2" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
       <lf start="3" span="1" word="|" lemma="|" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
    <rule type="rp" cat="NP\NP">
     <rule type="fa" cat="NP\NP">
      <lf start="4" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/(S[adj]\NP)" />
      <lf start="5" span="1" word="binary" lemma="binary" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
     </rule>
     <lf start="6" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
    </rule>
   </rule>
   <lf start="7" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
  </rule>
 </rule>
</ccg>
</candc>
