<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="lex" cat="NP">
   <rule type="fa" cat="N">
    <lf start="0" span="1" word="&lt;" lemma="&lt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
    <rule type="fa" cat="N">
     <lf start="1" span="1" word="code" lemma="code" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
     <rule type="fa" cat="N">
      <lf start="2" span="1" word="&gt;" lemma="&gt;" pos="NN" chunk="I-NP" entity="I-DAT" cat="N/N" />
      <rule type="fa" cat="N">
       <lf start="3" span="1" word="0" lemma="0" pos="CD" chunk="I-NP" entity="I-DAT" cat="N/N" />
       <rule type="fa" cat="N">
        <lf start="4" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
        <rule type="fa" cat="N">
         <lf start="5" span="1" word="=" lemma="=" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
         <rule type="fa" cat="N">
          <lf start="6" span="1" word="n" lemma="n" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
          <rule type="fa" cat="N">
           <lf start="7" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
           <rule type="fa" cat="N">
            <lf start="8" span="1" word="=" lemma="=" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
            <rule type="fa" cat="N">
             <lf start="9" span="1" word="10" lemma="10" pos="CD" chunk="I-NP" entity="I-DAT" cat="N/N" />
             <rule type="fa" cat="N">
              <lf start="10" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
              <rule type="fa" cat="N">
               <lf start="11" span="1" word="sup" lemma="sup" pos="NN" chunk="I-NP" entity="I-DAT" cat="N/N" />
               <rule type="fa" cat="N">
                <lf start="12" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="I-DAT" cat="N/N" />
                <rule type="fa" cat="N">
                 <lf start="13" span="1" word="9" lemma="9" pos="CD" chunk="I-NP" entity="I-DAT" cat="N/N" />
                 <rule type="fa" cat="N">
                  <lf start="14" span="1" word="&lt;" lemma="&lt;" pos="NN" chunk="I-NP" entity="I-DAT" cat="N/N" />
                  <lf start="15" span="1" word="/sup" lemma="/sup" pos="NN" chunk="I-NP" entity="I-DAT" cat="N" />
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <rule type="fa" cat="NP\NP">
   <lf start="16" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="I-DAT" cat="(NP\NP)/(NP\NP)" />
   <rule type="fa" cat="NP\NP">
    <lf start="17" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="I-DAT" cat="(NP\NP)/(NP\NP)" />
    <rule type="fa" cat="NP\NP">
     <lf start="18" span="1" word="/code" lemma="/code" pos="NNP" chunk="I-NP" entity="I-DAT" cat="(NP\NP)/(NP\NP)" />
     <rule type="rp" cat="NP\NP">
      <lf start="19" span="1" word="&gt;" lemma="&gt;" pos="NNP" chunk="I-NP" entity="I-DAT" cat="NP\NP" />
      <lf start="20" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
     </rule>
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
