<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[X]/S[X]">
  <lf start="0" span="1" word="When" lemma="when" pos="WRB" chunk="I-ADVP" entity="O" cat="(S/S)/S[dcl]" />
  <rule type="rp" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <rule type="fa" cat="NP[nb]">
     <lf start="1" span="1" word="your" lemma="your" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <lf start="2" span="1" word="friend" lemma="friend" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="3" span="1" word="makes" lemma="make" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
     <rule type="ba" cat="NP">
      <rule type="fa" cat="NP[nb]">
       <lf start="4" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <lf start="5" span="1" word="guess" lemma="guess" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="lex" cat="NP\NP">
       <rule type="lp" cat="S[dcl]/NP">
        <lf start="6" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
        <rule type="fc" cat="S[dcl]/NP">
         <rule type="tr" cat="S[X]/(S[X]\NP)">
          <lf start="7" span="1" word="you" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
         </rule>
         <rule type="fc" cat="(S[dcl]\NP)/NP">
          <lf start="8" span="1" word="provide" lemma="provide" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
          <rule type="fc" cat="NP/NP">
           <rule type="lex" cat="NP/(NP\NP)">
            <rule type="ba" cat="NP">
             <rule type="fa" cat="NP[nb]">
              <lf start="9" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
              <lf start="10" span="1" word="hint" lemma="hint" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
             <rule type="fa" cat="NP\NP">
              <lf start="11" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
              <rule type="fa" cat="NP[nb]">
               <lf start="12" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
               <rule type="fa" cat="N">
                <lf start="13" span="1" word="following" lemma="follow" pos="VBG" chunk="I-NP" entity="O" cat="N/N" />
                <lf start="14" span="1" word="info" lemma="info" pos="NN" chunk="I-NP" entity="O" cat="N" />
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
           <lf start="15" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="16" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
  </rule>
 </rule>
</ccg>
</candc>
