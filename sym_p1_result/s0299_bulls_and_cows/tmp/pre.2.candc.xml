<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <lf start="0" span="1" word="You" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
   <rule type="ba" cat="S[dcl]\NP">
    <rule type="fa" cat="S[dcl]\NP">
     <rule type="bx" cat="(S[dcl]\NP)/NP">
      <lf start="1" span="1" word="write" lemma="write" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      <lf start="2" span="1" word="down" lemma="down" pos="RP" chunk="I-PRT" entity="O" cat="(S\NP)\(S\NP)" />
     </rule>
     <rule type="fa" cat="NP[nb]">
      <lf start="3" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <rule type="fa" cat="N">
       <lf start="4" span="1" word="secret" lemma="secret" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
       <lf start="5" span="1" word="number" lemma="number" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
    <rule type="conj" cat="(S[dcl]\NP)\(S[dcl]\NP)">
     <lf start="6" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="7" span="1" word="ask" lemma="ask" pos="VB" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      <rule type="fa" cat="NP[nb]">
       <lf start="8" span="1" word="your" lemma="your" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <rule type="ba" cat="N">
        <lf start="9" span="1" word="friend" lemma="friend" pos="NN" chunk="I-NP" entity="O" cat="N" />
        <rule type="lex" cat="N\N">
         <rule type="fa" cat="S[to]\NP">
          <lf start="10" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
          <rule type="fa" cat="S[b]\NP">
           <lf start="11" span="1" word="guess" lemma="guess" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
           <rule type="fa" cat="NP">
            <lf start="12" span="1" word="what" lemma="what" pos="WP" chunk="I-NP" entity="O" cat="NP/(S[dcl]/NP)" />
            <rule type="fc" cat="S[dcl]/NP">
             <rule type="tr" cat="S[X]/(S[X]\NP)">
              <rule type="fa" cat="NP[nb]">
               <lf start="13" span="1" word="the" lemma="the" pos="DT" chunk="B-NP" entity="O" cat="NP[nb]/N" />
               <lf start="14" span="1" word="number" lemma="number" pos="NN" chunk="I-NP" entity="O" cat="N" />
              </rule>
             </rule>
             <lf start="15" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="16" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
