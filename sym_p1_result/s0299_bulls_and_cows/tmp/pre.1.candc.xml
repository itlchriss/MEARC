<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <lf start="0" span="1" word="You" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="1" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[ng]\NP)" />
    <rule type="ba" cat="S[ng]\NP">
     <rule type="fa" cat="S[ng]\NP">
      <lf start="2" span="1" word="playing" lemma="play" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
      <rule type="ba" cat="NP">
       <rule type="fa" cat="NP[nb]">
        <lf start="3" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <rule type="fa" cat="N">
         <lf start="4" span="1" word="[" lemma="[" pos="NNP" chunk="I-NP" entity="I-ORG" cat="N/N" />
         <lf start="5" span="1" word="Bulls" lemma="Bulls" pos="NNP" chunk="I-NP" entity="I-ORG" cat="N" />
        </rule>
       </rule>
       <rule type="conj" cat="NP\NP">
        <lf start="6" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="I-ORG" cat="conj" />
        <rule type="ba" cat="NP">
         <rule type="lex" cat="NP">
          <rule type="fa" cat="N">
           <lf start="7" span="1" word="Cows" lemma="Cows" pos="NNP" chunk="I-NP" entity="I-ORG" cat="N/N" />
           <rule type="fa" cat="N">
            <lf start="8" span="1" word="]" lemma="]" pos="NNP" chunk="I-NP" entity="I-ORG" cat="N/N" />
            <rule type="lp" cat="N">
             <lf start="9" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
             <lf start="10" span="1" word="https" lemma="http" pos="NNS" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
         <rule type="fa" cat="NP\NP">
          <lf start="11" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="12" span="1" word="//en.wikipedia.org/wiki/BullsandCows" lemma="//en.wikipedia.org/wiki/BullsandCows" pos="NNS" chunk="I-NP" entity="O" cat="N/N" />
            <rule type="lp" cat="N">
             <lf start="13" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
             <lf start="14" span="1" word="game" lemma="game" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
     <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
      <lf start="15" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
      <rule type="fa" cat="NP[nb]">
       <lf start="16" span="1" word="your" lemma="your" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <lf start="17" span="1" word="friend" lemma="friend" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="18" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
