<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="rp" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <rule type="lex" cat="NP">
      <lf start="0" span="1" word="Bulls" lemma="bull" pos="NNS" chunk="I-NP" entity="I-PER" cat="N" />
     </rule>
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="1" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
      <rule type="fa" cat="S[pss]\NP">
       <lf start="2" span="1" word="connected" lemma="connect" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/PP" />
       <rule type="fa" cat="PP">
        <lf start="3" span="1" word="with" lemma="with" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
        <rule type="fa" cat="NP[nb]">
         <lf start="4" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <lf start="5" span="1" word="strx_a" lemma="strx_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="conj" cat="S[dcl]\S[dcl]">
     <lf start="6" span="1" word="and" lemma="and" pos="CC" chunk="I-NP" entity="O" cat="conj" />
     <rule type="ba" cat="S[dcl]">
      <rule type="lex" cat="NP">
       <lf start="7" span="1" word="cows" lemma="cow" pos="NNS" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="8" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
       <lf start="9" span="1" word="underlined" lemma="underlined" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="10" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat=":" />
  </rule>
  <lf start="11" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
