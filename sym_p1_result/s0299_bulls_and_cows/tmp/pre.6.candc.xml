<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="fa" cat="NP">
   <lf start="0" span="1" word="Specifically" lemma="specifically" pos="RB" chunk="I-ADVP" entity="O" cat="NP/NP" />
   <rule type="lp" cat="NP[nb]">
    <lf start="1" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
    <rule type="fa" cat="NP[nb]">
     <lf start="2" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <rule type="fa" cat="N">
      <lf start="3" span="1" word="non-bull" lemma="non-bull" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
      <lf start="4" span="1" word="digits" lemma="digit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
  </rule>
  <rule type="fa" cat="NP\NP">
   <lf start="5" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP[nb]">
     <lf start="6" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <lf start="7" span="1" word="guess" lemma="guess" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="8" span="1" word="that" lemma="that" pos="WDT" chunk="B-NP" entity="O" cat="(NP\NP)/(S[dcl]\NP)" />
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="9" span="1" word="could" lemma="could" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
      <rule type="fa" cat="S[b]\NP">
       <lf start="10" span="1" word="be" lemma="be" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/(S[pss]\NP)" />
       <rule type="fa" cat="S[pss]\NP">
        <lf start="11" span="1" word="rearranged" lemma="rearrange" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/(S[adj]\NP)" />
        <rule type="fa" cat="S[adj]\NP">
         <lf start="12" span="1" word="such" lemma="such" pos="JJ" chunk="I-PP" entity="O" cat="(S[adj]\NP)/S[em]" />
         <rule type="fa" cat="S[em]">
          <lf start="13" span="1" word="that" lemma="that" pos="IN" chunk="I-SBAR" entity="O" cat="S[em]/S[dcl]" />
          <rule type="rp" cat="S[dcl]">
           <rule type="ba" cat="S[dcl]">
            <lf start="14" span="1" word="they" lemma="they" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
            <rule type="fa" cat="S[dcl]\NP">
             <lf start="15" span="1" word="become" lemma="become" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
             <rule type="lex" cat="NP">
              <lf start="16" span="1" word="bulls" lemma="bull" pos="NNS" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
           <lf start="17" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
