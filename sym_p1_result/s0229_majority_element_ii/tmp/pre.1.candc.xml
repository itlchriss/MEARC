<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[b]">
  <rule type="fa" cat="S[X]/S[X]">
   <lf start="0" span="1" word="Given" lemma="Give" pos="VBN" chunk="I-PP" entity="O" cat="(S/S)/NP" />
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP[nb]">
     <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <rule type="fa" cat="N">
      <lf start="2" span="1" word="_type_integer" lemma="_type_integer" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
      <lf start="3" span="1" word="array" lemma="array" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="4" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
     <rule type="lex" cat="NP">
      <lf start="5" span="1" word="size" lemma="size" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
  </rule>
  <rule type="rp" cat="S[b]">
   <rule type="ba" cat="S[b]">
    <rule type="lex" cat="NP">
     <lf start="6" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="lp" cat="S[b]\NP">
     <lf start="7" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
     <rule type="fa" cat="S[b]\NP">
      <rule type="fa" cat="(S[b]\NP)/NP">
       <lf start="8" span="1" word="find" lemma="find" pos="VB" chunk="I-VP" entity="O" cat="((S[b]\NP)/NP)/NP" />
       <rule type="ba" cat="NP">
        <rule type="fa" cat="NP[nb]">
         <lf start="9" span="1" word="all" lemma="all" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <lf start="10" span="1" word="elements" lemma="element" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="11" span="1" word="that" lemma="that" pos="WDT" chunk="B-NP" entity="O" cat="(NP\NP)/(S[dcl]\NP)" />
         <lf start="12" span="1" word="appear" lemma="appear" pos="VBP" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
        </rule>
       </rule>
      </rule>
      <rule type="lex" cat="NP">
       <rule type="fa" cat="N">
        <rule type="fa" cat="N/N">
         <rule type="ba" cat="(N/N)/(N/N)">
          <lf start="13" span="1" word="more" lemma="more" pos="JJR" chunk="I-NP" entity="O" cat="S[adj]\NP" />
          <lf start="14" span="1" word="than" lemma="than" pos="IN" chunk="I-NP" entity="O" cat="((N/N)/(N/N))\(S[adj]\NP)" />
         </rule>
         <lf start="15" span="1" word="`⌊" lemma="`⌊" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
        </rule>
        <rule type="fa" cat="N">
         <lf start="16" span="1" word="n/3" lemma="n/3" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
         <rule type="fa" cat="N">
          <lf start="17" span="1" word="⌋`" lemma="⌋`" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="18" span="1" word="times" lemma="time" pos="NNS" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="19" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
  </rule>
 </rule>
</ccg>
</candc>
