<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[b]">
  <rule type="lex" cat="S[X]/S[X]">
   <lf start="0" span="1" word="Given" lemma="Give" pos="VBN" chunk="I-PP" entity="O" cat="S[pss]\NP" />
  </rule>
  <rule type="rp" cat="S[b]">
   <rule type="ba" cat="S[b]">
    <rule type="fa" cat="NP[nb]">
     <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <rule type="fa" cat="N">
      <lf start="2" span="1" word="_type_integer" lemma="_type_integer" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
      <rule type="fa" cat="N">
       <lf start="3" span="1" word="array" lemma="array" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <lf start="4" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
    </rule>
    <rule type="lp" cat="S[b]\NP">
     <lf start="5" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
     <rule type="fa" cat="S[b]\NP">
      <lf start="6" span="1" word="find" lemma="find" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
      <rule type="ba" cat="NP">
       <rule type="fa" cat="NP[nb]">
        <lf start="7" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <rule type="fa" cat="N">
         <lf start="8" span="1" word="contiguous" lemma="contiguous" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
         <rule type="fa" cat="N">
          <lf start="9" span="1" word="non-empty" lemma="non-empty" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="10" span="1" word="subarray" lemma="subarray" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
       <rule type="fa" cat="NP\NP">
        <lf start="11" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
        <rule type="ba" cat="NP">
         <rule type="fa" cat="NP[nb]">
          <lf start="12" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <lf start="13" span="1" word="array" lemma="array" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
         <rule type="ba" cat="NP\NP">
          <rule type="fa" cat="NP\NP">
           <lf start="14" span="1" word="that" lemma="that" pos="WDT" chunk="B-NP" entity="O" cat="(NP\NP)/(S[dcl]\NP)" />
           <rule type="rp" cat="S[dcl]\NP">
            <rule type="fa" cat="S[dcl]\NP">
             <lf start="15" span="1" word="has" lemma="have" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
             <rule type="fa" cat="NP[nb]">
              <lf start="16" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
              <rule type="fa" cat="N">
               <lf start="17" span="1" word="largest" lemma="largest" pos="JJS" chunk="I-NP" entity="O" cat="N/N" />
               <lf start="18" span="1" word="product" lemma="product" pos="NN" chunk="I-NP" entity="O" cat="N" />
              </rule>
             </rule>
            </rule>
            <lf start="19" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
           </rule>
          </rule>
          <rule type="conj" cat="(NP\NP)\(NP\NP)">
           <lf start="20" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
           <rule type="lex" cat="NP\NP">
            <rule type="ba" cat="S[dcl]">
             <rule type="fa" cat="NP[nb]">
              <lf start="21" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
              <lf start="22" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
             <rule type="fa" cat="S[dcl]\NP">
              <lf start="23" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
              <rule type="fa" cat="NP[nb]">
               <lf start="24" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
               <lf start="25" span="1" word="product" lemma="product" pos="NN" chunk="I-NP" entity="O" cat="N" />
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="26" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
  </rule>
 </rule>
</ccg>
</candc>
