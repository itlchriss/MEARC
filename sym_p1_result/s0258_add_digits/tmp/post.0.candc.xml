<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[b]">
  <rule type="lex" cat="S[X]/S[X]">
   <lf start="0" span="1" word="Given" lemma="Give" pos="VBN" chunk="I-PP" entity="O" cat="S[pss]\NP" />
  </rule>
  <rule type="rp" cat="S[b]">
   <rule type="ba" cat="S[b]">
    <rule type="fa" cat="NP[nb]">
     <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <rule type="fa" cat="N">
      <lf start="2" span="1" word="_type_integer" lemma="_type_integer" pos="NN" chunk="I-NP" entity="I-ORG" cat="N/N" />
      <lf start="3" span="1" word="param_num" lemma="param_num" pos="NN" chunk="I-NP" entity="I-ORG" cat="N" />
     </rule>
    </rule>
    <rule type="lp" cat="S[b]\NP">
     <lf start="4" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
     <rule type="fa" cat="S[b]\NP">
      <lf start="5" span="1" word="repeatedly" lemma="repeatedly" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)/(S\NP)" />
      <rule type="ba" cat="S[b]\NP">
       <rule type="fa" cat="S[b]\NP">
        <rule type="bx" cat="(S[b]\NP)/NP">
         <lf start="6" span="1" word="add" lemma="add" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
         <lf start="7" span="1" word="all" lemma="all" pos="DT" chunk="I-NP" entity="O" cat="(S\NP)\(S\NP)" />
        </rule>
        <rule type="fa" cat="NP[nb]">
         <lf start="8" span="1" word="its" lemma="its" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <lf start="9" span="1" word="digits" lemma="digit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
       <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
        <lf start="10" span="1" word="until" lemma="until" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
        <rule type="ba" cat="S[dcl]">
         <rule type="ba" cat="S[dcl]">
          <rule type="fa" cat="NP[nb]">
           <lf start="11" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
           <lf start="12" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
          <rule type="fa" cat="S[dcl]\NP">
           <lf start="13" span="1" word="has" lemma="have" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
           <rule type="lex" cat="NP">
            <rule type="fa" cat="N">
             <rule type="fa" cat="N/N">
              <lf start="14" span="1" word="only" lemma="only" pos="RB" chunk="I-NP" entity="O" cat="(N/N)/(N/N)" />
              <lf start="15" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="I-PCT" cat="N/N" />
             </rule>
             <lf start="16" span="1" word="digit" lemma="digit" pos="NN" chunk="I-NP" entity="I-PCT" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
         <rule type="conj" cat="S[dcl]\S[dcl]">
          <lf start="17" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
          <rule type="conj" cat="S[dcl]\S[dcl]">
           <lf start="18" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
           <rule type="ba" cat="S[dcl]">
            <rule type="fa" cat="NP[nb]">
             <lf start="19" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
             <lf start="20" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
            <rule type="fa" cat="S[dcl]\NP">
             <lf start="21" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
             <lf start="22" span="1" word="it" lemma="it" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="23" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
  </rule>
 </rule>
</ccg>
</candc>
