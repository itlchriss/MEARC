<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="lex" cat="NP">
     <lf start="0" span="1" word="Input" lemma="Input" pos="NNP" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="fa" cat="NP\NP">
     <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
     <rule type="ba" cat="NP">
      <rule type="lex" cat="NP">
       <rule type="fa" cat="N">
        <lf start="2" span="1" word="nums1" lemma="nums1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
        <rule type="fa" cat="N">
         <lf start="3" span="1" word="=" lemma="=" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="4" span="1" word="arr_a" lemma="arr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
      <rule type="conj" cat="NP\NP">
       <lf start="5" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <rule type="fa" cat="N">
          <lf start="6" span="1" word="nums2" lemma="nums2" pos="NN" chunk="I-NP" entity="I-PCT" cat="N/N" />
          <rule type="fa" cat="N">
           <lf start="7" span="1" word="=" lemma="=" pos="NN" chunk="I-NP" entity="I-PCT" cat="N/N" />
           <lf start="8" span="1" word="arr_b" lemma="arr_b" pos="NN" chunk="I-NP" entity="I-PCT" cat="N" />
          </rule>
         </rule>
        </rule>
        <rule type="conj" cat="NP\NP">
         <lf start="9" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
         <rule type="lex" cat="NP">
          <lf start="10" span="1" word="k" lemma="k" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="ba" cat="S[dcl]\NP">
    <lf start="11" span="1" word="=" lemma="=" pos="VBD" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
    <lf start="12" span="1" word="3" lemma="3" pos="CD" chunk="I-NP" entity="O" cat="(S\NP)\(S\NP)" />
   </rule>
  </rule>
  <lf start="13" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
