<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <rule type="fa" cat="NP[nb]">
     <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <rule type="fa" cat="N">
      <lf start="1" span="1" word="string" lemma="string" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
      <lf start="2" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="3" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
     <rule type="ba" cat="S[pss]\NP">
      <lf start="4" span="1" word="written" lemma="write" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
      <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
       <lf start="5" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
       <rule type="ba" cat="NP">
        <rule type="fa" cat="NP[nb]">
         <lf start="6" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="fa" cat="N">
          <lf start="7" span="1" word="zigzag" lemma="zigzag" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="8" span="1" word="pattern" lemma="pattern" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="9" span="1" word="on" lemma="on" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
         <rule type="ba" cat="NP">
          <rule type="fa" cat="NP[nb]">
           <lf start="10" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
           <rule type="fa" cat="N">
            <lf start="11" span="1" word="given" lemma="give" pos="VBN" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="12" span="1" word="number" lemma="number" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
          <rule type="fa" cat="NP\NP">
           <lf start="13" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
           <rule type="ba" cat="NP">
            <rule type="lex" cat="NP">
             <lf start="14" span="1" word="rows" lemma="row" pos="NNS" chunk="I-NP" entity="O" cat="N" />
            </rule>
            <rule type="fa" cat="NP\NP">
             <lf start="15" span="1" word="like" lemma="like" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
             <lf start="16" span="1" word="this" lemma="this" pos="DT" chunk="I-NP" entity="O" cat="NP" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[X]\S[X]">
    <lf start="17" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(S\S)/S[dcl]" />
    <rule type="lp" cat="S[dcl]">
     <lf start="18" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
     <rule type="ba" cat="S[dcl]">
      <lf start="19" span="1" word="you" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="20" span="1" word="may" lemma="may" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
       <rule type="fa" cat="S[b]\NP">
        <lf start="21" span="1" word="want" lemma="want" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/(S[to]\NP)" />
        <rule type="fa" cat="S[to]\NP">
         <lf start="22" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
         <rule type="ba" cat="S[b]\NP">
          <rule type="ba" cat="S[b]\NP">
           <rule type="fa" cat="S[b]\NP">
            <lf start="23" span="1" word="display" lemma="display" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
            <rule type="fa" cat="NP[nb]">
             <lf start="24" span="1" word="this" lemma="this" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
             <lf start="25" span="1" word="pattern" lemma="pattern" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
           <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
            <lf start="26" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
            <rule type="fa" cat="NP[nb]">
             <lf start="27" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
             <rule type="fa" cat="N">
              <lf start="28" span="1" word="fixed" lemma="fixed" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
              <lf start="29" span="1" word="font" lemma="font" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
          </rule>
          <rule type="rp" cat="(S[X]\NP)\(S[X]\NP)">
           <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
            <lf start="30" span="1" word="for" lemma="for" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
            <rule type="lex" cat="NP">
             <rule type="fa" cat="N">
              <lf start="31" span="1" word="better" lemma="better" pos="JJR" chunk="I-NP" entity="O" cat="N/N" />
              <lf start="32" span="1" word="legibility" lemma="legibility" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
           <lf start="33" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="34" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
