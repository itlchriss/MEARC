<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[b]\NP">
  <lf start="0" span="1" word="Write" lemma="write" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
  <rule type="ba" cat="NP">
   <rule type="fa" cat="NP[nb]">
    <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <lf start="2" span="1" word="code" lemma="code" pos="NN" chunk="I-NP" entity="O" cat="N" />
   </rule>
   <rule type="fa" cat="NP\NP">
    <lf start="3" span="1" word="that" lemma="that" pos="WDT" chunk="B-NP" entity="O" cat="(NP\NP)/(S[dcl]\NP)" />
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="4" span="1" word="will" lemma="will" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
     <rule type="rp" cat="S[b]\NP">
      <rule type="rp" cat="S[b]\NP">
       <rule type="ba" cat="S[b]\NP">
        <rule type="fa" cat="S[b]\NP">
         <lf start="5" span="1" word="take" lemma="take" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
         <rule type="fa" cat="NP[nb]">
          <lf start="6" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <lf start="7" span="1" word="_type_string" lemma="_type_string" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="conj" cat="(S[b]\NP)\(S[b]\NP)">
         <lf start="8" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
         <rule type="fa" cat="S[b]\NP">
          <lf start="9" span="1" word="make" lemma="make" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
          <rule type="ba" cat="NP">
           <rule type="fa" cat="NP[nb]">
            <lf start="10" span="1" word="this" lemma="this" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
            <lf start="11" span="1" word="conversion" lemma="conversion" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
           <rule type="lex" cat="NP\NP">
            <rule type="fa" cat="S[pss]\NP">
             <lf start="12" span="1" word="given" lemma="give" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/NP" />
             <rule type="ba" cat="NP">
              <rule type="fa" cat="NP[nb]">
               <lf start="13" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
               <lf start="14" span="1" word="number" lemma="number" pos="NN" chunk="I-NP" entity="O" cat="N" />
              </rule>
              <rule type="fa" cat="NP\NP">
               <lf start="15" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
               <rule type="lex" cat="NP">
                <lf start="16" span="1" word="rows" lemma="row" pos="NNS" chunk="I-NP" entity="O" cat="N" />
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
       <lf start="17" span="1" word=":" lemma=":" pos=":" chunk="O" entity="O" cat=":" />
      </rule>
      <lf start="18" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
     </rule>
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
