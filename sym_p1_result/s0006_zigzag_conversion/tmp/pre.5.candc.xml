<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="rp" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <rule type="lex" cat="NP">
     <lf start="0" span="1" word="string" lemma="string" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="ba" cat="S[dcl]\NP">
     <lf start="1" span="1" word="convert" lemma="convert" pos="VBP" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
     <rule type="rp" cat="(S[X]\NP)\(S[X]\NP)">
      <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
       <lf start="2" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
       <rule type="ba" cat="S[dcl]">
        <rule type="lex" cat="NP">
         <lf start="3" span="1" word="string" lemma="string" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="ba" cat="S[dcl]\NP">
         <lf start="4" span="1" word="s" lemma="s" pos="VBZ" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
         <rule type="ltc" cat="(S[X]\NP)\(S[X]\NP)">
          <lf start="5" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="6" span="1" word="int" lemma="int" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="7" span="1" word="numRows" lemma="numrow" pos="NNS" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
      <lf start="8" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
     </rule>
    </rule>
   </rule>
   <lf start="9" span="1" word=";" lemma=";" pos=";" chunk="O" entity="O" cat=";" />
  </rule>
  <lf start="10" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
