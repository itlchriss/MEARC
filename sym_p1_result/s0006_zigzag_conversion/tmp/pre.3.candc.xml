<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="S[dcl]\NP">
  <rule type="fa" cat="S[dcl]\NP">
   <lf start="0" span="1" word="And" lemma="and" pos="CC" chunk="O" entity="O" cat="(S\NP)/(S\NP)" />
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="1" span="1" word="then" lemma="then" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)/(S\NP)" />
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="2" span="1" word="read" lemma="read" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
     <rule type="lex" cat="NP">
      <lf start="3" span="1" word="line" lemma="line" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
  </rule>
  <rule type="rp" cat="(S[X]\NP)\(S[X]\NP)">
   <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
    <lf start="4" span="1" word="by" lemma="by" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
    <rule type="ba" cat="NP">
     <rule type="lex" cat="NP">
      <lf start="5" span="1" word="line" lemma="line" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="fa" cat="NP\NP">
      <lf start="6" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
      <rule type="lex" cat="NP">
       <lf start="7" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="I-LOC" cat="N" />
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="8" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
  </rule>
 </rule>
</ccg>
</candc>
