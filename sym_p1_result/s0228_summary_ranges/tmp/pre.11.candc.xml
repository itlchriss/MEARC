<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="lex" cat="NP">
   <lf start="0" span="1" word="Explanation" lemma="explanation" pos="NN" chunk="I-NP" entity="O" cat="N" />
  </rule>
  <rule type="fa" cat="NP\NP">
   <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/S[dcl]" />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <rule type="fa" cat="NP[nb]">
      <lf start="2" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
      <lf start="3" span="1" word="ranges" lemma="range" pos="NNS" chunk="I-NP" entity="O" cat="N" />
     </rule>
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="4" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/PP" />
      <rule type="fa" cat="PP">
       <lf start="5" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="PP/NP" />
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <lf start="6" span="1" word="arr_a" lemma="arr_a" pos="NN" chunk="I-NP" entity="I-LOC" cat="N" />
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="7" span="1" word="--" lemma="--" pos=":" chunk="O" entity="O" cat="(NP\NP)/NP" />
         <rule type="ba" cat="NP">
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="8" span="1" word="&gt;" lemma="&gt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
            <rule type="fa" cat="N">
             <lf start="9" span="1" word="stry_a" lemma="stry_a" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
             <lf start="10" span="1" word="arr_b" lemma="arr_b" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
          <rule type="fa" cat="NP\NP">
           <lf start="11" span="1" word="--" lemma="--" pos=":" chunk="O" entity="O" cat="(NP\NP)/NP" />
           <rule type="ba" cat="NP">
            <rule type="lex" cat="NP">
             <rule type="fa" cat="N">
              <rule type="fa" cat="N/N">
               <lf start="12" span="1" word="&gt;" lemma="&gt;" pos="RB" chunk="I-NP" entity="O" cat="(N/N)/(N/N)" />
               <lf start="13" span="1" word="stry_b" lemma="stry_b" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
              </rule>
              <lf start="14" span="1" word="arr_c" lemma="arr_c" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
            <rule type="fa" cat="NP\NP">
             <lf start="15" span="1" word="--" lemma="--" pos=":" chunk="O" entity="O" cat="(NP\NP)/NP" />
             <rule type="lex" cat="NP">
              <rule type="fa" cat="N">
               <lf start="16" span="1" word="&gt;" lemma="&gt;" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
               <lf start="17" span="1" word="stry_c" lemma="stry_c" pos="NN" chunk="I-NP" entity="O" cat="N" />
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="18" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
