<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="NP">
  <rule type="ba" cat="NP">
   <rule type="rp" cat="NP">
    <rule type="lex" cat="NP">
     <rule type="fa" cat="N">
      <rule type="ba" cat="N/N">
       <lf start="0" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
       <rule type="conj" cat="(N/N)\(N/N)">
        <lf start="1" span="1" word="or" lemma="or" pos="CC" chunk="I-NP" entity="O" cat="conj" />
        <lf start="2" span="1" word="more" lemma="more" pos="JJR" chunk="I-NP" entity="O" cat="N/N" />
       </rule>
      </rule>
      <lf start="3" span="1" word="digits" lemma="digit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
    <lf start="4" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
   </rule>
   <rule type="lex" cat="NP\NP">
    <rule type="ba" cat="S[pss]\NP">
     <lf start="5" span="1" word="followed" lemma="follow" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
     <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
      <lf start="6" span="1" word="by" lemma="by" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
      <rule type="fa" cat="NP[nb]">
       <lf start="7" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <rule type="fa" cat="N">
        <lf start="8" span="1" word="dot" lemma="dot" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="9" span="1" word="`period" lemma="`period" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="10" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
