<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="lex" cat="NP">
    <lf start="0" span="1" word="param_s" lemma="param_s" pos="NNS" chunk="I-NP" entity="O" cat="N" />
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="1" span="1" word="only" lemma="only" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)/(S\NP)" />
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="2" span="1" word="contains" lemma="contain" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
     <rule type="ba" cat="NP">
      <rule type="lex" cat="NP">
       <lf start="3" span="1" word="alphabets" lemma="alphabet" pos="NNS" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="conj" cat="NP\NP">
       <lf start="4" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <lf start="5" span="1" word="digits" lemma="digit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
        <rule type="ba" cat="NP\NP">
         <rule type="rp" cat="NP\NP">
          <rule type="fa" cat="NP\NP">
           <lf start="6" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
           <rule type="lex" cat="NP">
            <lf start="7" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
          <lf start="8" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
         </rule>
         <rule type="conj" cat="(NP\NP)\(NP\NP)">
          <lf start="9" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
          <rule type="conj" cat="NP\NP">
           <lf start="10" span="1" word="plus" lemma="plus" pos="CC" chunk="O" entity="O" cat="conj" />
           <rule type="ba" cat="NP">
            <rule type="lex" cat="NP">
             <lf start="11" span="1" word="expr_b" lemma="expr_b" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
            <rule type="conj" cat="NP\NP">
             <lf start="12" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
             <rule type="ba" cat="NP">
              <rule type="lex" cat="NP">
               <rule type="fa" cat="N">
                <lf start="13" span="1" word="minus" lemma="minus" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                <lf start="14" span="1" word="expr_c" lemma="expr_c" pos="NN" chunk="I-NP" entity="O" cat="N" />
               </rule>
              </rule>
              <rule type="conj" cat="NP\NP">
               <lf start="15" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
               <rule type="conj" cat="NP\NP">
                <lf start="16" span="1" word="or" lemma="or" pos="CC" chunk="O" entity="O" cat="conj" />
                <rule type="lex" cat="NP">
                 <rule type="fa" cat="N">
                  <lf start="17" span="1" word="dot" lemma="dot" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                  <lf start="18" span="1" word="`period" lemma="`period" pos="NN" chunk="I-NP" entity="O" cat="N" />
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="19" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
