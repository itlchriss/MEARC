<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="N">
  <rule type="ba" cat="N/N">
   <lf start="0" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
   <rule type="conj" cat="(N/N)\(N/N)">
    <lf start="1" span="1" word="or" lemma="or" pos="CC" chunk="I-NP" entity="O" cat="conj" />
    <lf start="2" span="1" word="more" lemma="more" pos="JJR" chunk="I-NP" entity="O" cat="N/N" />
   </rule>
  </rule>
  <rule type="rp" cat="N">
   <lf start="3" span="1" word="digits" lemma="digit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
   <lf start="4" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
  </rule>
 </rule>
</ccg>
</candc>
