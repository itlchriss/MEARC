<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="rp" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <rule type="fa" cat="NP[nb]">
     <lf start="0" span="1" word="A" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <rule type="fa" cat="N">
      <lf start="1" span="1" word="decimal" lemma="decimal" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
      <lf start="2" span="1" word="number" lemma="number" pos="NN" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="3" span="1" word="can" lemma="can" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
     <rule type="fa" cat="S[b]\NP">
      <lf start="4" span="1" word="be" lemma="be" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/(S[pss]\NP)" />
      <rule type="ba" cat="S[pss]\NP">
       <rule type="fa" cat="S[pss]\NP">
        <rule type="bx" cat="(S[pss]\NP)/PP">
         <lf start="5" span="1" word="split" lemma="split" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/PP" />
         <lf start="6" span="1" word="up" lemma="up" pos="RP" chunk="I-PRT" entity="O" cat="(S\NP)\(S\NP)" />
        </rule>
        <rule type="fa" cat="PP">
         <lf start="7" span="1" word="into" lemma="into" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
         <rule type="fa" cat="NP[nb]">
          <lf start="8" span="1" word="these" lemma="these" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <lf start="9" span="1" word="components" lemma="component" pos="NNS" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
       <rule type="lp" cat="(S[X]\NP)\(S[X]\NP)">
        <lf start="10" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
        <rule type="rp" cat="(S[X]\NP)\(S[X]\NP)">
         <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
          <lf start="11" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
          <rule type="lex" cat="NP">
           <lf start="12" span="1" word="order" lemma="order" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
         <lf start="13" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="14" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat=":" />
  </rule>
  <lf start="15" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
