<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="lp" cat="S[pss]\NP">
  <lf start="0" span="1" word="`" lemma="`" pos="LQU" chunk="O" entity="O" cat="LQU" />
  <rule type="lp" cat="S[pss]\NP">
   <lf start="1" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
   <rule type="ba" cat="S[pss]\NP">
    <lf start="2" span="1" word="followed" lemma="follow" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
    <rule type="rp" cat="(S[X]\NP)\(S[X]\NP)">
     <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
      <lf start="3" span="1" word="by" lemma="by" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
      <rule type="lex" cat="NP">
       <rule type="fa" cat="N">
        <rule type="ba" cat="N/N">
         <lf start="4" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
         <rule type="conj" cat="(N/N)\(N/N)">
          <lf start="5" span="1" word="or" lemma="or" pos="CC" chunk="I-NP" entity="O" cat="conj" />
          <lf start="6" span="1" word="more" lemma="more" pos="JJR" chunk="I-NP" entity="O" cat="N/N" />
         </rule>
        </rule>
        <lf start="7" span="1" word="digits" lemma="digit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
     <lf start="8" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
