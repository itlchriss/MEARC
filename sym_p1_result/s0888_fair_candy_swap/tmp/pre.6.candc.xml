<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <lf start="0" span="1" word="It" lemma="it" pos="PRP" chunk="I-NP" entity="O" cat="NP[expl]" />
   <rule type="fa" cat="S[dcl]\NP[expl]">
    <rule type="fa" cat="(S[dcl]\NP[expl])/S[em]">
     <lf start="1" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="((S[dcl]\NP[expl])/S[em])/(S[adj]\NP)" />
     <lf start="2" span="1" word="guaranteed" lemma="guarantee" pos="VBN" chunk="I-VP" entity="O" cat="S[adj]\NP" />
    </rule>
    <rule type="fa" cat="S[em]">
     <lf start="3" span="1" word="that" lemma="that" pos="IN" chunk="I-SBAR" entity="O" cat="S[em]/S[dcl]" />
     <rule type="fa" cat="S[dcl]">
      <rule type="fa" cat="S[X]/S[X]">
       <lf start="4" span="1" word="at" lemma="at" pos="IN" chunk="I-NP" entity="O" cat="(S/S)/(S[asup]\NP)" />
       <lf start="5" span="1" word="least" lemma="least" pos="JJS" chunk="I-NP" entity="O" cat="S[asup]\NP" />
      </rule>
      <rule type="ba" cat="S[dcl]">
       <rule type="lex" cat="NP">
        <rule type="fa" cat="N">
         <lf start="6" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="7" span="1" word="answer" lemma="answer" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
       <lf start="8" span="1" word="exists" lemma="exist" pos="VBZ" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="9" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
