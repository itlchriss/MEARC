<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[dcl]">
  <rule type="fa" cat="S[X]/S[X]">
   <lf start="0" span="1" word="Since" lemma="since" pos="IN" chunk="I-SBAR" entity="O" cat="(S/S)/S[dcl]" />
   <rule type="ba" cat="S[dcl]">
    <lf start="1" span="1" word="they" lemma="they" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
    <rule type="fa" cat="S[dcl]\NP">
     <lf start="2" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
     <rule type="lex" cat="NP">
      <lf start="3" span="1" word="friends" lemma="friend" pos="NNS" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
   </rule>
  </rule>
  <rule type="lp" cat="S[dcl]">
   <lf start="4" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <lf start="5" span="1" word="they" lemma="they" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="6" span="1" word="would" lemma="would" pos="MD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
      <rule type="fa" cat="S[b]\NP">
       <lf start="7" span="1" word="like" lemma="like" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/(S[to]\NP)" />
       <rule type="fa" cat="S[to]\NP">
        <lf start="8" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
        <rule type="fa" cat="S[b]\NP">
         <rule type="bx" cat="(S[b]\NP)/PP">
          <rule type="fa" cat="(S[b]\NP)/PP">
           <lf start="9" span="1" word="exchange" lemma="exchange" pos="VB" chunk="I-VP" entity="O" cat="((S[b]\NP)/PP)/NP" />
           <rule type="lex" cat="NP">
            <rule type="fa" cat="N">
             <lf start="10" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
             <rule type="fa" cat="N">
              <lf start="11" span="1" word="candy" lemma="candy" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
              <lf start="12" span="1" word="box" lemma="box" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
          </rule>
          <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
           <lf start="13" span="1" word="each" lemma="each" pos="DT" chunk="B-NP" entity="O" cat="((S\NP)\(S\NP))/N" />
           <rule type="ba" cat="N">
            <lf start="14" span="1" word="so" lemma="so" pos="SO" chunk="I-ADJP" entity="O" cat="N" />
            <lf start="15" span="1" word="that" lemma="that" pos="WDT" chunk="I-SBAR" entity="O" cat="N\N" />
           </rule>
          </rule>
         </rule>
         <rule type="fa" cat="PP">
          <lf start="16" span="1" word="after" lemma="after" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
          <rule type="ba" cat="NP">
           <rule type="fa" cat="NP[nb]">
            <lf start="17" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
            <lf start="18" span="1" word="exchange" lemma="exchange" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
           <rule type="lex" cat="NP\NP">
            <rule type="lp" cat="S[dcl]">
             <lf start="19" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
             <rule type="ba" cat="S[dcl]">
              <rule type="ba" cat="NP">
               <lf start="20" span="1" word="they" lemma="they" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
               <lf start="21" span="1" word="both" lemma="both" pos="DT" chunk="O" entity="O" cat="NP\NP" />
              </rule>
              <rule type="fa" cat="S[dcl]\NP">
               <lf start="22" span="1" word="have" lemma="have" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
               <rule type="ba" cat="NP">
                <rule type="fa" cat="NP[nb]">
                 <lf start="23" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                 <rule type="fa" cat="N">
                  <lf start="24" span="1" word="same" lemma="same" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                  <rule type="fa" cat="N">
                   <lf start="25" span="1" word="total" lemma="total" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
                   <lf start="26" span="1" word="amount" lemma="amount" pos="NN" chunk="I-NP" entity="O" cat="N" />
                  </rule>
                 </rule>
                </rule>
                <rule type="fa" cat="NP\NP">
                 <lf start="27" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
                 <rule type="lex" cat="NP">
                  <lf start="28" span="1" word="candy" lemma="candy" pos="NN" chunk="I-NP" entity="O" cat="N" />
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="29" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
