<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="fa" cat="NP[nb]">
   <lf start="0" span="1" word="This" lemma="this" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
   <rule type="fa" cat="N">
    <rule type="fa" cat="N/N">
     <lf start="1" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="(N/N)/(N/N)" />
     <lf start="2" span="1" word="great" lemma="great" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
    </rule>
    <lf start="3" span="1" word="question" lemma="question" pos="NN" chunk="I-NP" entity="O" cat="N" />
   </rule>
  </rule>
  <rule type="lex" cat="NP\NP">
   <rule type="fa" cat="S[to]\NP">
    <lf start="4" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
    <rule type="rp" cat="S[b]\NP">
     <rule type="ba" cat="S[b]\NP">
      <lf start="5" span="1" word="ask" lemma="ask" pos="VB" chunk="I-VP" entity="O" cat="S[b]\NP" />
      <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
       <lf start="6" span="1" word="during" lemma="during" pos="IN" chunk="I-PP" entity="O" cat="((S\NP)\(S\NP))/NP" />
       <rule type="fa" cat="NP[nb]">
        <lf start="7" span="1" word="an" lemma="an" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <lf start="8" span="1" word="interview" lemma="interview" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
     <lf start="9" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
