<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="NP">
  <rule type="rp" cat="NP/NP">
   <rule type="fc" cat="NP/NP">
    <rule type="lex" cat="NP/(NP\NP)">
     <rule type="ba" cat="NP">
      <lf start="0" span="1" word="This" lemma="this" pos="DT" chunk="I-NP" entity="O" cat="NP" />
      <rule type="lex" cat="NP\NP">
       <rule type="fa" cat="S[adj]\NP">
        <lf start="1" span="1" word="consistent" lemma="consistent" pos="JJ" chunk="I-NP" entity="O" cat="(S[adj]\NP)/PP" />
        <rule type="fa" cat="PP">
         <lf start="2" span="1" word="to" lemma="to" pos="TO" chunk="I-PP" entity="O" cat="PP/NP" />
         <rule type="fa" cat="NP[nb]">
          <rule type="ba" cat="NP[nb]/N">
           <rule type="lex" cat="NP">
            <lf start="3" span="1" word="C" lemma="C" pos="NNP" chunk="I-NP" entity="O" cat="N" />
           </rule>
           <lf start="4" span="1" word="'s" lemma="'s" pos="POS" chunk="B-NP" entity="O" cat="(NP[nb]/N)\NP" />
          </rule>
          <rule type="fa" cat="N">
           <lf start="5" span="1" word="[" lemma="[" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
           <lf start="6" span="1" word="strstr" lemma="strstr" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="7" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
   </rule>
   <lf start="8" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
  </rule>
  <rule type="ba" cat="NP">
   <rule type="ba" cat="NP">
    <rule type="lex" cat="NP">
     <lf start="9" span="1" word="]" lemma="]" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="rp" cat="NP\NP">
     <rule type="fa" cat="NP\NP">
      <lf start="10" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
      <rule type="ba" cat="NP">
       <rule type="lex" cat="NP">
        <lf start="11" span="1" word="http" lemma="http" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
       <rule type="fa" cat="NP\NP">
        <lf start="12" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
        <rule type="lex" cat="NP">
         <lf start="13" span="1" word="//www.cplusplus.com/reference/cstring/strstr/" lemma="//www.cplusplus.com/reference/cstring/strstr/" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
     <lf start="14" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
    </rule>
   </rule>
   <rule type="conj" cat="NP\NP">
    <lf start="15" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
    <rule type="ba" cat="NP">
     <rule type="ba" cat="NP">
      <rule type="fa" cat="NP[nb]">
       <rule type="ba" cat="NP[nb]/N">
        <rule type="lex" cat="NP">
         <lf start="16" span="1" word="Java" lemma="Java" pos="NNP" chunk="I-NP" entity="I-ORG" cat="N" />
        </rule>
        <lf start="17" span="1" word="'s" lemma="'s" pos="POS" chunk="B-NP" entity="I-ORG" cat="(NP[nb]/N)\NP" />
       </rule>
       <rule type="fa" cat="N">
        <lf start="18" span="1" word="[" lemma="[" pos="NNP" chunk="I-NP" entity="I-ORG" cat="N/N" />
        <lf start="19" span="1" word="indexOf" lemma="indexOf" pos="NNP" chunk="I-NP" entity="I-ORG" cat="N" />
       </rule>
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="20" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
       <rule type="lex" cat="NP">
        <rule type="lp" cat="N">
         <lf start="21" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
         <lf start="22" span="1" word="]" lemma="]" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
     <rule type="fa" cat="NP\NP">
      <lf start="23" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
      <rule type="ba" cat="NP">
       <rule type="lex" cat="NP">
        <lf start="24" span="1" word="https" lemma="http" pos="NNS" chunk="I-NP" entity="O" cat="N" />
       </rule>
       <rule type="fa" cat="NP\NP">
        <lf start="25" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
        <rule type="rp" cat="NP">
         <rule type="lex" cat="NP">
          <rule type="fa" cat="N">
           <lf start="26" span="1" word="//docs.oracle.com/javase/7/docs/api/java/lang/String.html" lemma="//docs.oracle.com/javase/7/docs/api/java/lang/String.html" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
           <rule type="fa" cat="N">
            <lf start="27" span="1" word="#" lemma="#" pos="#" chunk="I-NP" entity="O" cat="N/N[num]" />
            <rule type="fa" cat="N">
             <lf start="28" span="1" word="indexOf" lemma="indexOf" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
             <rule type="lp" cat="N">
              <lf start="29" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
              <lf start="30" span="1" word="java.lang" lemma="java.lang" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
         <lf start="31" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
