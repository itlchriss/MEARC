<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP[nb]">
     <lf start="0" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <lf start="1" span="1" word="[" lemma="[" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="lex" cat="NP\NP">
     <rule type="fa" cat="S[ng]\NP">
      <lf start="2" span="1" word="Hamming" lemma="ham" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
      <rule type="ba" cat="NP">
       <rule type="ba" cat="NP">
        <rule type="lex" cat="NP">
         <rule type="fa" cat="N">
          <lf start="3" span="1" word="distance" lemma="distance" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="4" span="1" word="]" lemma="]" pos="NNS" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="rp" cat="NP\NP">
         <rule type="fa" cat="NP\NP">
          <lf start="5" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
          <rule type="ba" cat="NP">
           <rule type="lex" cat="NP">
            <lf start="6" span="1" word="https" lemma="http" pos="NNS" chunk="I-NP" entity="O" cat="N" />
           </rule>
           <rule type="fa" cat="NP\NP">
            <lf start="7" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/NP" />
            <rule type="lex" cat="NP">
             <lf start="8" span="1" word="//en.wikipedia.org/wiki/Hammingdistance" lemma="//en.wikipedia.org/wiki/Hammingdistance" pos="NNP" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
         <lf start="9" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
        </rule>
       </rule>
       <rule type="fa" cat="NP\NP">
        <lf start="10" span="1" word="between" lemma="between" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
        <rule type="lex" cat="NP">
         <rule type="fa" cat="N">
          <lf start="11" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="12" span="1" word="integers" lemma="integer" pos="NNS" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="13" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
    <rule type="ba" cat="NP">
     <rule type="ba" cat="NP">
      <rule type="fa" cat="NP[nb]">
       <lf start="14" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <lf start="15" span="1" word="number" lemma="number" pos="NN" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="fa" cat="NP\NP">
       <lf start="16" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
       <rule type="lex" cat="NP">
        <lf start="17" span="1" word="positions" lemma="position" pos="NNS" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
     <rule type="fa" cat="NP\NP">
      <rule type="ba" cat="(NP\NP)/S[dcl]">
       <lf start="18" span="1" word="at" lemma="at" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
       <lf start="19" span="1" word="which" lemma="which" pos="WDT" chunk="I-NP" entity="O" cat="((NP\NP)/S[dcl])\((NP\NP)/NP)" />
      </rule>
      <rule type="ba" cat="S[dcl]">
       <rule type="fa" cat="NP[nb]">
        <lf start="20" span="1" word="the" lemma="the" pos="DT" chunk="B-NP" entity="O" cat="NP[nb]/N" />
        <rule type="fa" cat="N">
         <lf start="21" span="1" word="corresponding" lemma="corresponding" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="22" span="1" word="bits" lemma="bit" pos="NNS" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
       <rule type="fa" cat="S[dcl]\NP">
        <lf start="23" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
        <lf start="24" span="1" word="different" lemma="different" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="25" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
