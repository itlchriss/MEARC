                        <lf start="31" span="1" word="," lemma="," pos="," chunk="I-NP" entity="O" cat="," />
                        <rule type="ba" cat="N">
                         <lf start="32" span="1" word="77" lemma="77" pos="CD" chunk="I-NP" entity="O" cat="N" />
                         <rule type="conj" cat="N\N">
                          <lf start="33" span="1" word="," lemma="," pos="," chunk="I-NP" entity="O" cat="," />
                          <rule type="ba" cat="N">
                           <lf start="34" span="1" word="88" lemma="88" pos="CD" chunk="I-NP" entity="O" cat="N" />
                           <rule type="conj" cat="N\N">
                            <lf start="35" span="1" word="," lemma="," pos="," chunk="I-NP" entity="O" cat="," />
