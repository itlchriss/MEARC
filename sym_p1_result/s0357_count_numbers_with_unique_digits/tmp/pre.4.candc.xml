                <lf start="14" span="1" word="≤" lemma="≤" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                <rule type="ba" cat="N">
                 <rule type="fa" cat="N">
                  <lf start="15" span="1" word="x" lemma="x" pos="NNP" chunk="I-NP" entity="O" cat="N/N" />
                  <lf start="16" span="1" word="&lt;" lemma="&lt;" pos="NNP" chunk="I-NP" entity="O" cat="N" />
                 </rule>
                 <lf start="17" span="1" word="100" lemma="100" pos="CD" chunk="I-NP" entity="O" cat="N\N" />
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
           <lf start="18" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
          </rule>
          <rule type="fa" cat="NP\NP">
           <lf start="19" span="1" word="excluding" lemma="exclude" pos="VBG" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
