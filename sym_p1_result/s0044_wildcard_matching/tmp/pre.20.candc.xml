<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[dcl]\NP">
  <lf start="0" span="1" word="matches" lemma="match" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
  <rule type="rp" cat="NP">
   <rule type="ba" cat="NP">
    <rule type="lex" cat="NP">
     <lf start="1" span="1" word="strx_a" lemma="strx_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="conj" cat="NP\NP">
     <lf start="2" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
     <rule type="conj" cat="NP\NP">
      <lf start="3" span="1" word="but" lemma="but" pos="CC" chunk="O" entity="O" cat="conj" />
      <rule type="ba" cat="NP">
       <rule type="rp" cat="NP">
        <rule type="ba" cat="NP">
         <rule type="fa" cat="NP[nb]">
          <lf start="4" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <rule type="fa" cat="N">
           <lf start="5" span="1" word="second" lemma="second" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
           <lf start="6" span="1" word="letter" lemma="letter" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
         <rule type="lex" cat="NP\NP">
          <rule type="fa" cat="S[dcl]\NP">
           <lf start="7" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
           <rule type="lex" cat="NP">
            <lf start="8" span="1" word="strx_b" lemma="strx_b" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
        <lf start="9" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
       </rule>
       <rule type="fa" cat="NP\NP">
        <lf start="10" span="1" word="which" lemma="which" pos="WDT" chunk="I-NP" entity="O" cat="(NP\NP)/(S[dcl]\NP)" />
        <rule type="fa" cat="S[dcl]\NP">
         <rule type="bx" cat="(S[dcl]\NP)/(S[b]\NP)">
          <lf start="11" span="1" word="does" lemma="do" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
          <lf start="12" span="1" word="not" lemma="not" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)\(S\NP)" />
         </rule>
         <rule type="fa" cat="S[b]\NP">
          <lf start="13" span="1" word="match" lemma="match" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
          <rule type="lex" cat="NP">
           <lf start="14" span="1" word="strx_c" lemma="strx_c" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="15" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
  </rule>
 </rule>
</ccg>
</candc>
