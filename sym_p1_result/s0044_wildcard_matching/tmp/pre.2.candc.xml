<candc>
<ccg>
 <rule type="rp" cat="NP">
  <rule type="rp" cat="NP">
   <rule type="lex" cat="NP">
    <rule type="ba" cat="N">
     <lf start="0" span="1" word="expr_a''`" lemma="expr_a''`" pos="NN" chunk="I-NP" entity="O" cat="N" />
     <lf start="1" span="1" word="that" lemma="that" pos="IN" chunk="B-NP" entity="O" cat="N\N" />
    </rule>
   </rule>
   <lf start="2" span="1" word=":" lemma=":" pos=":" chunk="O" entity="O" cat=":" />
  </rule>
  <lf start="3" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
