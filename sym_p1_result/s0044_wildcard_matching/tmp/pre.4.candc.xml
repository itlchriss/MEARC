<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="lp" cat="N">
  <lf start="0" span="1" word="`" lemma="`" pos="LQU" chunk="O" entity="O" cat="LQU" />
  <rule type="fa" cat="N">
   <rule type="fa" cat="N/N">
    <lf start="1" span="1" word="Matches" lemma="Matches" pos="NNPS" chunk="I-NP" entity="O" cat="(N/N)/(N/N)" />
    <rule type="fa" cat="N/N">
     <lf start="2" span="1" word="any" lemma="any" pos="DT" chunk="I-NP" entity="O" cat="(N/N)/(N/N)" />
     <lf start="3" span="1" word="single" lemma="single" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
    </rule>
   </rule>
   <rule type="rp" cat="N">
    <lf start="4" span="1" word="character" lemma="character" pos="NN" chunk="I-NP" entity="O" cat="N" />
    <lf start="5" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
