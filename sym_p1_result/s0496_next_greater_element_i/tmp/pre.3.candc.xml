<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[dcl]">
  <lf start="0" span="1" word="For" lemma="for" pos="IN" chunk="I-PP" entity="O" cat="S/S" />
  <rule type="rp" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <rule type="fa" cat="NP[nb]">
     <lf start="1" span="1" word="each" lemma="each" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <lf start="2" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="lp" cat="S[dcl]\NP">
     <lf start="3" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="4" span="1" word="find" lemma="find" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/S[dcl]" />
      <rule type="ba" cat="S[dcl]">
       <rule type="fa" cat="NP[nb]">
        <lf start="5" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <lf start="6" span="1" word="index" lemma="index" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
       <rule type="ba" cat="S[dcl]\NP">
        <rule type="fa" cat="S[dcl]\NP">
         <lf start="7" span="1" word="expr_b" lemma="expr_b" pos="VBD" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
         <rule type="fa" cat="NP">
          <lf start="8" span="1" word="such" lemma="such" pos="JJ" chunk="I-NP" entity="O" cat="NP/NP" />
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="9" span="1" word="that" lemma="that" pos="IN" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="10" span="1" word="expr_c" lemma="expr_c" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
        <rule type="conj" cat="(S[dcl]\NP)\(S[dcl]\NP)">
         <lf start="11" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
         <rule type="fa" cat="S[dcl]\NP">
          <rule type="fa" cat="(S[dcl]\NP)/PP">
           <lf start="12" span="1" word="determine" lemma="determine" pos="VB" chunk="I-VP" entity="O" cat="((S[dcl]\NP)/PP)/NP" />
           <rule type="ba" cat="NP">
            <rule type="fa" cat="NP[nb]">
             <lf start="13" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
             <rule type="fa" cat="N">
              <lf start="14" span="1" word="next" lemma="next" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
              <rule type="fa" cat="N">
               <lf start="15" span="1" word="greater" lemma="greater" pos="JJR" chunk="I-NP" entity="O" cat="N/N" />
               <lf start="16" span="1" word="element" lemma="element" pos="NN" chunk="I-NP" entity="O" cat="N" />
              </rule>
             </rule>
            </rule>
            <rule type="fa" cat="NP\NP">
             <lf start="17" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
             <rule type="lex" cat="NP">
              <lf start="18" span="1" word="expr_d" lemma="expr_d" pos="NN" chunk="I-NP" entity="I-LOC" cat="N" />
             </rule>
            </rule>
           </rule>
          </rule>
          <rule type="fa" cat="PP">
           <lf start="19" span="1" word="in" lemma="in" pos="IN" chunk="I-PP" entity="O" cat="PP/NP" />
           <rule type="lex" cat="NP">
            <lf start="20" span="1" word="param_nums2" lemma="param_nums2" pos="NN" chunk="I-NP" entity="I-LOC" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="21" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
  </rule>
 </rule>
</ccg>
</candc>
