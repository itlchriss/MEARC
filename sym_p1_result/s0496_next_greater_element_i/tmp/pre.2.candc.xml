<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <lf start="0" span="1" word="You" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="1" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pss]\NP)" />
    <rule type="fa" cat="S[pss]\NP">
     <lf start="2" span="1" word="given" lemma="give" pos="VBN" chunk="I-VP" entity="O" cat="(S[pss]\NP)/NP" />
     <rule type="ba" cat="NP">
      <rule type="lex" cat="NP">
       <rule type="fa" cat="N">
        <lf start="3" span="1" word="2" lemma="2" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
        <rule type="fa" cat="N">
         <lf start="4" span="1" word="unique" lemma="unique" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
         <rule type="fa" cat="N">
          <lf start="5" span="1" word="0-indexed" lemma="0-indexed" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <rule type="fa" cat="N">
           <lf start="6" span="1" word="integer" lemma="integer" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
           <rule type="fa" cat="N">
            <lf start="7" span="1" word="arrays" lemma="array" pos="NNS" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="8" span="1" word="param_nums1" lemma="param_nums1" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
      <rule type="conj" cat="NP\NP">
       <lf start="9" span="1" word="and" lemma="and" pos="CC" chunk="I-NP" entity="O" cat="conj" />
       <rule type="ba" cat="NP">
        <rule type="rp" cat="NP">
         <rule type="lex" cat="NP">
          <lf start="10" span="1" word="param_nums2" lemma="param_nums2" pos="NN" chunk="I-NP" entity="I-ORG" cat="N" />
         </rule>
         <lf start="11" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="12" span="1" word="that" lemma="that" pos="IN" chunk="I-SBAR" entity="O" cat="(NP\NP)/S[dcl]" />
         <rule type="ba" cat="S[dcl]">
          <rule type="lex" cat="NP">
           <lf start="13" span="1" word="param_nums1" lemma="param_nums1" pos="NN" chunk="I-NP" entity="I-ORG" cat="N" />
          </rule>
          <rule type="fa" cat="S[dcl]\NP">
           <lf start="14" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
           <rule type="ba" cat="NP">
            <rule type="fa" cat="NP[nb]">
             <lf start="15" span="1" word="a" lemma="a" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
             <lf start="16" span="1" word="subset" lemma="subset" pos="NN" chunk="I-NP" entity="O" cat="N" />
            </rule>
            <rule type="fa" cat="NP\NP">
             <lf start="17" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
             <rule type="lex" cat="NP">
              <lf start="18" span="1" word="param_nums2" lemma="param_nums2" pos="NN" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="19" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
