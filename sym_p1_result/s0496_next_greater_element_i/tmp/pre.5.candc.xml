<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="NP">
  <lf start="0" span="1" word="Return" lemma="Return" pos="NNP" chunk="I-NP" entity="O" cat="NP/NP" />
  <rule type="ba" cat="NP">
   <rule type="fa" cat="NP[nb]">
    <lf start="1" span="1" word="an" lemma="an" pos="DT" chunk="B-NP" entity="O" cat="NP[nb]/N" />
    <rule type="fa" cat="N">
     <lf start="2" span="1" word="array" lemma="array" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
     <lf start="3" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
   </rule>
   <rule type="fa" cat="NP\NP">
    <lf start="4" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
    <rule type="ba" cat="NP">
     <rule type="lex" cat="NP">
      <rule type="fa" cat="N">
       <lf start="5" span="1" word="length" lemma="length" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
       <lf start="6" span="1" word="expr_b" lemma="expr_b" pos="NNS" chunk="I-NP" entity="O" cat="N" />
      </rule>
     </rule>
     <rule type="lex" cat="NP\NP">
      <rule type="fa" cat="S[adj]\NP">
       <lf start="7" span="1" word="such" lemma="such" pos="JJ" chunk="I-PP" entity="O" cat="(S[adj]\NP)/S[em]" />
       <rule type="fa" cat="S[em]">
        <lf start="8" span="1" word="that" lemma="that" pos="IN" chunk="I-NP" entity="O" cat="S[em]/S[dcl]" />
        <rule type="rp" cat="S[dcl]">
         <rule type="ba" cat="S[dcl]">
          <rule type="lex" cat="NP">
           <lf start="9" span="1" word="expr_c" lemma="expr_c" pos="NN" chunk="I-NP" entity="O" cat="N" />
          </rule>
          <rule type="ba" cat="S[dcl]\NP">
           <rule type="fa" cat="S[dcl]\NP">
            <lf start="10" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
            <rule type="fa" cat="NP[nb]">
             <lf start="11" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
             <rule type="fa" cat="N">
              <lf start="12" span="1" word="next" lemma="next" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
              <rule type="fa" cat="N">
               <lf start="13" span="1" word="greater" lemma="greater" pos="JJR" chunk="I-NP" entity="O" cat="N/N" />
               <lf start="14" span="1" word="element" lemma="element" pos="NN" chunk="I-NP" entity="O" cat="N" />
              </rule>
             </rule>
            </rule>
           </rule>
           <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
            <lf start="15" span="1" word="as" lemma="as" pos="IN" chunk="I-SBAR" entity="O" cat="((S\NP)\(S\NP))/(S[pss]\NP)" />
            <rule type="ba" cat="S[pss]\NP">
             <lf start="16" span="1" word="described" lemma="describe" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
             <lf start="17" span="1" word="above" lemma="above" pos="IN" chunk="I-PP" entity="O" cat="(S\NP)\(S\NP)" />
            </rule>
           </rule>
          </rule>
         </rule>
         <lf start="18" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
