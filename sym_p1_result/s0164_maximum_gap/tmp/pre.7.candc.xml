<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="ba" cat="S[dcl]">
   <rule type="ba" cat="NP">
    <rule type="lex" cat="NP">
     <lf start="0" span="1" word="Explanation" lemma="explanation" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="ba" cat="NP\NP">
     <rule type="fa" cat="NP\NP">
      <lf start="1" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="(NP\NP)/S[dcl]" />
      <rule type="ba" cat="S[dcl]">
       <rule type="ba" cat="NP">
        <rule type="fa" cat="NP[nb]">
         <lf start="2" span="1" word="The" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="fa" cat="N">
          <lf start="3" span="1" word="sorted" lemma="sorted" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="4" span="1" word="form" lemma="form" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="fa" cat="NP\NP">
         <lf start="5" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
         <rule type="fa" cat="NP[nb]">
          <lf start="6" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
          <lf start="7" span="1" word="array" lemma="array" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
       </rule>
       <rule type="fa" cat="S[dcl]\NP">
        <lf start="8" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
        <rule type="lex" cat="NP">
         <lf start="9" span="1" word="arr_a" lemma="arr_a" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
     <rule type="conj" cat="(NP\NP)\(NP\NP)">
      <lf start="10" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
      <rule type="conj" cat="(NP\NP)\(NP\NP)">
       <lf start="11" span="1" word="either" lemma="either" pos="CC" chunk="O" entity="O" cat="conj" />
       <rule type="rp" cat="NP\NP">
        <rule type="ba" cat="NP\NP">
         <rule type="rp" cat="NP\NP">
          <rule type="fa" cat="NP\NP">
           <lf start="12" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
           <rule type="ba" cat="NP">
            <rule type="lex" cat="NP">
             <lf start="13" span="1" word="3" lemma="3" pos="CD" chunk="I-NP" entity="O" cat="N" />
            </rule>
            <rule type="conj" cat="NP\NP">
             <lf start="14" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
             <rule type="lex" cat="NP">
              <lf start="15" span="1" word="6" lemma="6" pos="CD" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
          </rule>
          <lf start="16" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
         </rule>
         <rule type="conj" cat="(NP\NP)\(NP\NP)">
          <lf start="17" span="1" word="or" lemma="or" pos="CC" chunk="O" entity="O" cat="conj" />
          <rule type="fa" cat="NP\NP">
           <lf start="18" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/NP" />
           <rule type="ba" cat="NP">
            <rule type="lex" cat="NP">
             <lf start="19" span="1" word="6" lemma="6" pos="CD" chunk="I-NP" entity="O" cat="N" />
            </rule>
            <rule type="conj" cat="NP\NP">
             <lf start="20" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
             <rule type="lex" cat="NP">
              <lf start="21" span="1" word="9" lemma="9" pos="CD" chunk="I-NP" entity="O" cat="N" />
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
        <lf start="22" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <rule type="fa" cat="S[dcl]\NP">
    <lf start="23" span="1" word="has" lemma="have" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
    <rule type="fa" cat="NP[nb]">
     <lf start="24" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <rule type="fa" cat="N">
      <lf start="25" span="1" word="maximum" lemma="maximum" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
      <rule type="ba" cat="N">
       <lf start="26" span="1" word="difference" lemma="difference" pos="NN" chunk="I-NP" entity="O" cat="N" />
       <lf start="27" span="1" word="3" lemma="3" pos="CD" chunk="I-NP" entity="O" cat="N\N" />
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="28" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
