<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="NP">
  <rule type="lex" cat="NP">
   <lf start="0" span="1" word="Assume" lemma="Assume" pos="NNP" chunk="I-NP" entity="O" cat="N" />
  </rule>
  <rule type="lex" cat="NP\NP">
   <rule type="rp" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <lf start="1" span="1" word="you" lemma="you" pos="PRP" chunk="B-NP" entity="O" cat="NP" />
     <rule type="ba" cat="S[dcl]\NP">
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="2" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
       <rule type="fa" cat="NP[nb]">
        <lf start="3" span="1" word="an" lemma="an" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
        <rule type="fa" cat="N">
         <lf start="4" span="1" word="awe" lemma="awe" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
         <lf start="5" span="1" word="parent" lemma="parent" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
      <rule type="conj" cat="(S[dcl]\NP)\(S[dcl]\NP)">
       <lf start="6" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
       <rule type="fa" cat="S[dcl]\NP">
        <lf start="7" span="1" word="want" lemma="want" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[to]\NP)" />
        <rule type="fa" cat="S[to]\NP">
         <lf start="8" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
         <rule type="fa" cat="S[b]\NP">
          <rule type="fa" cat="(S[b]\NP)/NP">
           <lf start="9" span="1" word="give" lemma="give" pos="VB" chunk="I-VP" entity="O" cat="((S[b]\NP)/NP)/NP" />
           <rule type="fa" cat="NP[nb]">
            <lf start="10" span="1" word="your" lemma="your" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
            <lf start="11" span="1" word="children" lemma="child" pos="NNS" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
          <rule type="lex" cat="NP">
           <lf start="12" span="1" word="cookies" lemma="cookie" pos="NNS" chunk="I-NP" entity="O" cat="N" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
    <lf start="13" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
