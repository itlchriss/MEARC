<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[dcl]">
  <rule type="rp" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <rule type="ba" cat="S[dcl]">
     <lf start="0" span="1" word="You" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="1" span="1" word="have" lemma="have" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
      <rule type="lex" cat="NP">
       <rule type="fa" cat="N">
        <lf start="2" span="1" word="3" lemma="3" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="3" span="1" word="cookies" lemma="cookie" pos="NNS" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="conj" cat="S[dcl]\S[dcl]">
     <lf start="4" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
     <rule type="ba" cat="S[dcl]">
      <rule type="fa" cat="NP[nb]">
       <lf start="5" span="1" word="their" lemma="their" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <lf start="6" span="1" word="sizes" lemma="size" pos="NNS" chunk="I-NP" entity="O" cat="N" />
      </rule>
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="7" span="1" word="are" lemma="be" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
       <rule type="fa" cat="S[adj]\NP">
        <rule type="bx" cat="(S[adj]\NP)/(S[to]\NP)">
         <lf start="8" span="1" word="big" lemma="big" pos="JJ" chunk="I-ADJP" entity="O" cat="(S[adj]\NP)/(S[to]\NP)" />
         <lf start="9" span="1" word="enough" lemma="enough" pos="JJ" chunk="I-ADJP" entity="O" cat="(S[adj]\NP)\(S[adj]\NP)" />
        </rule>
        <rule type="fa" cat="S[to]\NP">
         <lf start="10" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
         <rule type="fa" cat="S[b]\NP">
          <lf start="11" span="1" word="gratify" lemma="gratify" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
          <rule type="ba" cat="NP">
           <lf start="12" span="1" word="all" lemma="all" pos="DT" chunk="I-NP" entity="O" cat="NP" />
           <rule type="fa" cat="NP\NP">
            <lf start="13" span="1" word="of" lemma="of" pos="IN" chunk="I-PP" entity="O" cat="(NP\NP)/NP" />
            <rule type="fa" cat="NP[nb]">
             <lf start="14" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
             <lf start="15" span="1" word="children" lemma="child" pos="NNS" chunk="I-NP" entity="O" cat="N" />
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="16" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
  </rule>
  <lf start="17" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
