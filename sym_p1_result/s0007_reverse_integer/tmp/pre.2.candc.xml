<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="rp" cat="S[b]\NP">
  <rule type="fa" cat="S[b]\NP">
   <lf start="0" span="1" word="Assume" lemma="assume" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
   <rule type="ba" cat="NP">
    <rule type="fa" cat="NP[nb]">
     <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
     <lf start="2" span="1" word="environment" lemma="environment" pos="NN" chunk="I-NP" entity="O" cat="N" />
    </rule>
    <rule type="lex" cat="NP\NP">
     <rule type="fa" cat="S[dcl]\NP">
      <rule type="bx" cat="(S[dcl]\NP)/(S[b]\NP)">
       <lf start="3" span="1" word="does" lemma="do" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[b]\NP)" />
       <lf start="4" span="1" word="not" lemma="not" pos="RB" chunk="I-VP" entity="O" cat="(S\NP)\(S\NP)" />
      </rule>
      <rule type="fa" cat="S[b]\NP">
       <rule type="fa" cat="(S[b]\NP)/(S[to]\NP)">
        <lf start="5" span="1" word="allow" lemma="allow" pos="VB" chunk="I-VP" entity="O" cat="((S[b]\NP)/(S[to]\NP))/NP" />
        <lf start="6" span="1" word="you" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
       </rule>
       <rule type="fa" cat="S[to]\NP">
        <lf start="7" span="1" word="to" lemma="to" pos="TO" chunk="I-VP" entity="O" cat="(S[to]\NP)/(S[b]\NP)" />
        <rule type="fa" cat="S[b]\NP">
         <lf start="8" span="1" word="store" lemma="store" pos="VB" chunk="I-VP" entity="O" cat="(S[b]\NP)/NP" />
         <rule type="ba" cat="NP">
          <rule type="lex" cat="NP">
           <rule type="fa" cat="N">
            <lf start="9" span="1" word="64-bit" lemma="64-bit" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
            <lf start="10" span="1" word="integers" lemma="integer" pos="NNS" chunk="I-NP" entity="O" cat="N" />
           </rule>
          </rule>
          <rule type="rp" cat="NP\NP">
           <rule type="fa" cat="NP\NP">
            <lf start="11" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="(NP\NP)/(S[pss]\NP)" />
            <rule type="ba" cat="S[pss]\NP">
             <lf start="12" span="1" word="signed" lemma="sign" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
             <rule type="conj" cat="(S[pss]\NP)\(S[pss]\NP)">
              <lf start="13" span="1" word="or" lemma="or" pos="CC" chunk="I-VP" entity="O" cat="conj" />
              <lf start="14" span="1" word="unsigned" lemma="unsign" pos="VBN" chunk="I-VP" entity="O" cat="S[pss]\NP" />
             </rule>
            </rule>
           </rule>
           <lf start="15" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
  </rule>
  <lf start="16" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
 </rule>
</ccg>
</candc>
