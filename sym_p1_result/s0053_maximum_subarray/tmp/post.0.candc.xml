<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="fa" cat="S[dcl]">
  <rule type="fa" cat="S[X]/S[X]">
   <lf start="0" span="1" word="Given" lemma="Give" pos="VBN" chunk="I-PP" entity="O" cat="(S/S)/NP" />
   <rule type="fa" cat="NP[nb]">
    <lf start="1" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
    <lf start="2" span="1" word="_type_integer" lemma="_type_integer" pos="NN" chunk="I-NP" entity="O" cat="N" />
   </rule>
  </rule>
  <rule type="rp" cat="S[dcl]">
   <rule type="ba" cat="S[dcl]">
    <rule type="lex" cat="NP">
     <rule type="fa" cat="N">
      <lf start="3" span="1" word="array" lemma="array" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
      <lf start="4" span="1" word="param_nums" lemma="param_nums" pos="NNS" chunk="I-NP" entity="O" cat="N" />
     </rule>
    </rule>
    <rule type="lp" cat="S[dcl]\NP">
     <lf start="5" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
     <rule type="fa" cat="S[dcl]\NP">
      <lf start="6" span="1" word="find" lemma="find" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/S[dcl]" />
      <rule type="ba" cat="S[dcl]">
       <rule type="ba" cat="NP">
        <rule type="fa" cat="NP[nb]">
         <lf start="7" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <rule type="fa" cat="N">
          <lf start="8" span="1" word="contiguous" lemma="contiguous" pos="JJ" chunk="I-NP" entity="O" cat="N/N" />
          <lf start="9" span="1" word="subarray" lemma="subarray" pos="NN" chunk="I-NP" entity="O" cat="N" />
         </rule>
        </rule>
        <rule type="lp" cat="NP\NP">
         <lf start="10" span="1" word="(" lemma="(" pos="LRB" chunk="O" entity="O" cat="LRB" />
         <rule type="lex" cat="NP\NP">
          <rule type="ba" cat="S[ng]\NP">
           <lf start="11" span="1" word="containing" lemma="contain" pos="VBG" chunk="I-VP" entity="O" cat="S[ng]\NP" />
           <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
            <lf start="12" span="1" word="at" lemma="at" pos="IN" chunk="I-NP" entity="O" cat="((S\NP)\(S\NP))/NP" />
            <rule type="ba" cat="NP">
             <rule type="rp" cat="NP">
              <rule type="lex" cat="NP">
               <rule type="fa" cat="N">
                <lf start="13" span="1" word="least" lemma="least" pos="JJS" chunk="I-NP" entity="O" cat="N/N" />
                <rule type="fa" cat="N">
                 <lf start="14" span="1" word="1" lemma="1" pos="CD" chunk="I-NP" entity="O" cat="N/N" />
                 <lf start="15" span="1" word="number" lemma="number" pos="NN" chunk="I-NP" entity="O" cat="N" />
                </rule>
               </rule>
              </rule>
              <lf start="16" span="1" word=")" lemma=")" pos="RRB" chunk="O" entity="O" cat="RRB" />
             </rule>
             <rule type="fa" cat="NP\NP">
              <lf start="17" span="1" word="which" lemma="which" pos="WDT" chunk="I-NP" entity="O" cat="(NP\NP)/(S[dcl]\NP)" />
              <rule type="fa" cat="S[dcl]\NP">
               <lf start="18" span="1" word="has" lemma="have" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
               <rule type="ba" cat="NP[nb]">
                <rule type="fa" cat="NP[nb]">
                 <lf start="19" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                 <rule type="fa" cat="N">
                  <lf start="20" span="1" word="largest" lemma="largest" pos="JJS" chunk="I-NP" entity="O" cat="N/N" />
                  <lf start="21" span="1" word="sum" lemma="sum" pos="NN" chunk="I-NP" entity="O" cat="N" />
                 </rule>
                </rule>
                <rule type="conj" cat="NP[nb]\NP[nb]">
                 <lf start="22" span="1" word="and" lemma="and" pos="CC" chunk="O" entity="O" cat="conj" />
                 <rule type="fa" cat="NP[nb]">
                  <lf start="23" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                  <lf start="24" span="1" word="result" lemma="result" pos="NN" chunk="I-NP" entity="O" cat="N" />
                 </rule>
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
       <rule type="fa" cat="S[dcl]\NP">
        <lf start="25" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/NP" />
        <rule type="fa" cat="NP[nb]">
         <lf start="26" span="1" word="its" lemma="its" pos="PRP$" chunk="I-NP" entity="O" cat="NP[nb]/N" />
         <lf start="27" span="1" word="sum" lemma="sum" pos="NN" chunk="I-NP" entity="O" cat="N" />
        </rule>
       </rule>
      </rule>
     </rule>
    </rule>
   </rule>
   <lf start="28" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
  </rule>
 </rule>
</ccg>
</candc>
