<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="candc.xml"?>

<candc>
<ccg>
 <rule type="ba" cat="S[b]\NP">
  <rule type="ba" cat="S[b]\NP">
   <lf start="0" span="1" word="Follow" lemma="follow" pos="VB" chunk="I-VP" entity="O" cat="S[b]\NP" />
   <lf start="1" span="1" word="up" lemma="up" pos="RB" chunk="I-ADVP" entity="O" cat="(S\NP)\(S\NP)" />
  </rule>
  <rule type="fa" cat="(S[X]\NP)\(S[X]\NP)">
   <lf start="2" span="1" word=":" lemma=":" pos="IN" chunk="O" entity="O" cat="((S\NP)\(S\NP))/S[dcl]" />
   <rule type="fa" cat="S[dcl]">
    <rule type="fa" cat="S[X]/S[X]">
     <lf start="3" span="1" word="If" lemma="if" pos="IN" chunk="I-SBAR" entity="O" cat="(S/S)/S[dcl]" />
     <rule type="ba" cat="S[dcl]">
      <lf start="4" span="1" word="you" lemma="you" pos="PRP" chunk="I-NP" entity="O" cat="NP" />
      <rule type="fa" cat="S[dcl]\NP">
       <lf start="5" span="1" word="have" lemma="have" pos="VBP" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[pt]\NP)" />
       <rule type="ba" cat="S[pt]\NP">
        <lf start="6" span="1" word="figured" lemma="figure" pos="VBN" chunk="I-VP" entity="O" cat="S[pt]\NP" />
        <lf start="7" span="1" word="out" lemma="out" pos="RP" chunk="I-PRT" entity="O" cat="(S\NP)\(S\NP)" />
       </rule>
      </rule>
     </rule>
    </rule>
    <rule type="rp" cat="S[dcl]">
     <rule type="ba" cat="S[dcl]">
      <rule type="fa" cat="NP[nb]">
       <lf start="8" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
       <rule type="fa" cat="N">
        <lf start="9" span="1" word="expr_a" lemma="expr_a" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
        <lf start="10" span="1" word="solution" lemma="solution" pos="NN" chunk="I-NP" entity="O" cat="N" />
       </rule>
      </rule>
      <rule type="lp" cat="S[dcl]\NP">
       <lf start="11" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
       <rule type="ba" cat="S[dcl]\NP">
        <lf start="12" span="1" word="try" lemma="try" pos="VBP" chunk="I-VP" entity="O" cat="S[dcl]\NP" />
        <rule type="lex" cat="(S[X]\NP)\(S[X]\NP)">
         <rule type="fa" cat="S[ng]\NP">
          <lf start="13" span="1" word="coding" lemma="code" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
          <rule type="ba" cat="NP">
           <rule type="fa" cat="NP[nb]">
            <lf start="14" span="1" word="another" lemma="another" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
            <lf start="15" span="1" word="solution" lemma="solution" pos="NN" chunk="I-NP" entity="O" cat="N" />
           </rule>
           <rule type="lex" cat="NP\NP">
            <rule type="fa" cat="S[ng]\NP">
             <lf start="16" span="1" word="using" lemma="use" pos="VBG" chunk="I-VP" entity="O" cat="(S[ng]\NP)/NP" />
             <rule type="ba" cat="NP">
              <rule type="rp" cat="NP[nb]">
               <rule type="fa" cat="NP[nb]">
                <lf start="17" span="1" word="the" lemma="the" pos="DT" chunk="I-NP" entity="O" cat="NP[nb]/N" />
                <rule type="ba" cat="N">
                 <lf start="18" span="1" word="divide" lemma="divide" pos="NN" chunk="I-NP" entity="O" cat="N" />
                 <rule type="conj" cat="N\N">
                  <lf start="19" span="1" word="and" lemma="and" pos="CC" chunk="I-NP" entity="O" cat="conj" />
                  <rule type="fa" cat="N">
                   <lf start="20" span="1" word="conquer" lemma="conquer" pos="NN" chunk="I-NP" entity="O" cat="N/N" />
                   <lf start="21" span="1" word="approach" lemma="approach" pos="NN" chunk="I-NP" entity="O" cat="N" />
                  </rule>
                 </rule>
                </rule>
               </rule>
               <lf start="22" span="1" word="," lemma="," pos="," chunk="O" entity="O" cat="," />
              </rule>
              <rule type="fa" cat="NP\NP">
               <lf start="23" span="1" word="which" lemma="which" pos="WDT" chunk="I-NP" entity="O" cat="(NP\NP)/(S[dcl]\NP)" />
               <rule type="fa" cat="S[dcl]\NP">
                <lf start="24" span="1" word="is" lemma="be" pos="VBZ" chunk="I-VP" entity="O" cat="(S[dcl]\NP)/(S[adj]\NP)" />
                <rule type="fa" cat="S[adj]\NP">
                 <lf start="25" span="1" word="more" lemma="more" pos="RBR" chunk="I-ADJP" entity="O" cat="(S[adj]\NP)/(S[adj]\NP)" />
                 <lf start="26" span="1" word="subtle" lemma="subtle" pos="JJ" chunk="I-ADJP" entity="O" cat="S[adj]\NP" />
                </rule>
               </rule>
              </rule>
             </rule>
            </rule>
           </rule>
          </rule>
         </rule>
        </rule>
       </rule>
      </rule>
     </rule>
     <lf start="27" span="1" word="." lemma="." pos="." chunk="O" entity="O" cat="." />
    </rule>
   </rule>
  </rule>
 </rule>
</ccg>
</candc>
